_error\": \"Selecciona un proveedor\",\n  \"supplierAlreadyExists\": \"Ya existe un proveedor\",\n  \"supplierAlreadyExistsLegalName\": \"Ya existe un proveedor con el Nombre fiscal proporcionado\",\n  \"supplierAlreadyExistsName\": \"Ya existe un proveedor con el Nombre comercial proporcionado\",\n  \"supplierAlreadyExistsVatID\": \"Ya existe un proveedor con el NIF/CIF proporcionado\",\n  \"termsAndConditions_error\": \"Revisa y acepta las condiciones\",\n  \"type_error\": \"Selecciona un tipo de documento\",\n  \"uom_error\": \"Selecciona una unidad de medida\",\n  \"userName\": \"Introduce un nombre\",\n  \"missingDateError_body\": \"No se ha detectado ninguna fecha en el documento. Por favor, añade la fecha del documento.\",\n  \"missingDateError_title\": \"Fecha no encontrada\",\n  \"invalidDateError_body\": \"No se ha podido leer correctamente el formato de la fecha. Por favor, corrige la fecha del documento.\",\n  \"invalidDateError_title\": \"Formato de fecha inválido\",\n  \"futureDateError_body\": \"La fecha extraída es futura. Por favor, verifica que sea correcta.\",\n  \"futureDateError_title\": \"Fecha futura detectada\",\n  \"wrongDateError_body\": \"No se ha podido validar correctamente la fecha del documento. Por favor, revísala y corrígela si es necesario.\",\n  \"wrongDateError_title\": \"Problema con la fecha\",\n  \"wrongHeaderCalculationError_body\": \"El total no cuadra con el cálculo: subtotal + IVA - IRPF. Revisa estos valores.\",\n  \"wrongHeaderCalculationError_title\": \"Cálculo de total incorrecto\",\n  \"wrongItemCalculationNppuError_body\": \"El precio bruto - descuentos + tasas no coincide con el precio nominal.\",\n  \"wrongItemCalculationNppuError_title\": \"Revisa los descuentos, tasas o el precio bruto del producto.\",\n  \"wrongItemCalculationSubtotalError_body\": \"La cantidad por el precio nominal no es igual al total.\",\n  \"wrongItemCalculationSubtotalError_title\": \"Revisa las cantidades o el total de la línea de producto.\",\n  \"wrongItemCalculationTaxError_title\": \"La información de impuestos es incompleta\",\n  \"wrongItemCalculationTotalError_title\": \"La suma de subtotal más impuestos no encaja con el importe total del producto. Verifica que la cantidad de impuestos es correcta y que el precio es el correcto para esa unidad.\",\n  \"wrongItemCalculationTotalppuError_title\": \"El precio del producto por la cantidad no cuadra con el importe total. Verifica que la cantidad es correcta y que el precio es el correcto para esa unidad.\",\n  \"wrongItemNameError_title\": \"El nombre del producto no es válido. Verifica que el nombre no excede los 200 caracteres.\",\n  \"wrongSubtotalsSumError_body\": \"Los productos no suman el subtotal del desglose y hay una diferencia de {{amount}}. Revisa si hay descuentos o recargos fuera de los productos.\",\n  \"wrongSubtotalsSumError_title\": \"Totales por producto no coinciden con el subtotal\",\n  \"wrongSubtotalsSumError_title_v2\": \"Revisa el total de los productos.\",\n  \"wrongTaxBracketsBaseSumError_body\": \"Las bases imponibles del desglose de IVA no suman el subtotal digitalizado. Revisa los importes base.\",\n  \"wrongTaxBracketsBaseSumError_title\": \"Subtotal por desglose de IVA incorrecto\",\n  \"wrongTaxBracketsPercentageError\": \"Hemos detectado errores en el desglose de IVA\",\n  \"wrongTaxBracketsPercentageError_body\": \"Se ha detectado un tipo de IVA no valido. No se ha incluido en el desglose.\",\n  \"wrongTaxBracketsPercentageError_title\": \"Tipo de IVA no válido\",\n  \"wrongTaxBracketsPercentageError_body_title\": \"Revisa el desglose de IVA\",\n  \"wrongTaxBracketsSumError\": \"Hemos detectado errores en el desglose de IVA\",\n  \"wrongTaxBracketsSumError_body\": \"La suma del desglose de IVA y subtotal no cuadra con el total de la factura. Revisa los importes del desglose.\",\n  \"wrongTaxBracketsSumError_title\": \"Desglose de IVA no coincide con el total\",\n  \"wrongTaxBracketsTaxSumError\": \"Hemos detectado 