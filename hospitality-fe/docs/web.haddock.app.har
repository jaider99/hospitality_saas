            "text": "{\n  \"assign\": \"Asignar\",\n  \"assignToProduct\": \"Asignar a producto\",\n  \"pendingToAssignTooltip\": \"Compra pendiente de asignar a un producto\",\n  \"bannerTitle\": \"Tienes {{count}} compras sin asignar\",\n  \"bannerDescription\": \"Sin asignar estas líneas de producto no podemos calcular bien inventario, escandallos ni evolución de precios. Unos minutos ahora te ahorran descuadres y trabajo manual después.\",\n  \"bannerCta\": \"Asignar ahora\",\n  \"assignmentTitle\": \"Asignación de líneas de compra pendientes\",\n  \"noPendingItems\": \"No hay compras pendientes\",\n  \"sessionCompleteTitle\": \"¡Listo!\",\n  \"sessionCompleteDescription\": \"Resumen de tu sesión de asignación\",\n  \"streak\": \"Racha {{count}} productos\",\n  \"pending\": \"Faltan\",\n  \"skipped\": \"Saltados\",\n  \"discarded\": \"Descartados\",\n  \"assigned\": \"Asignados\",\n  \"productsAssigned\": \"Productos asignados\",\n  \"product\": \"Producto\",\n  \"purchaseLineLabel\": \"Línea de compra\",\n  \"editLineItemName\": \"Editar nombre de la línea\",\n  \"renameLineItemInputLabel\": \"Nombre de la línea\",\n  \"renameLineItemError\": \"Error al guardar el nombre de la línea.\",\n  \"productName\": \"Nombre del producto\",\n  \"productNamePlaceholder\": \"Introduce el nombre del producto\",\n  \"baseUnit\": \"Unidad base\",\n  \"formats\": \"Formatos\",\n  \"formatsInfo\": \"Formato en el que has comprado esta línea de compra.\",\n  \"noFormatsCreated\": \"No hay formatos creados para este producto.\",\n  \"addFormatsToAssign\": \"Para poder asignarlo añade formatos\",\n  \"addNewFormat\": \"Añadir nuevo formato\",\n  \"skipForNow\": \"Saltar por ahora\",\n  \"discard\": \"Descartar\",\n  \"discardError\": \"Error al descartar la compra.\",\n  \"discardGroupConfirmTitle\": \"¿Descartar todo el grupo?\",\n  \"discardGroupConfirmDescription\": \"Esto descartará {{count}} compras pendientes de este grupo del flujo de asignación de producto.\",\n  \"discardGroupConfirmAction\": \"Descartar grupo\",\n  \"assignAndContinue\": \"Asignar y continuar\",\n  \"suggestedProducts\": \"Productos sugeridos\",\n  \"confidenceHigh\": \"Coincidencia alta\",\n  \"confidenceMedium\": \"Coincidencia media\",\n  \"confidenceLow\": \"Coincidencia baja\",\n  \"yourProducts\": \"Tus productos\",\n  \"openPDF\": \"Abrir PDF\",\n  \"viewDocument\": \"Ver documento en nueva pestaña\",\n  \"selectProduct\": \"Selecciona un producto\",\n  \"searchProducts\": \"Buscar productos...\",\n  \"noProductsFound\": \"No se encontraron productos\",\n  \"newProduct\": \"Nuevo producto\",\n  \"new\": \"Nuevo\",\n  \"createNew\": \"Crear nuevo\",\n  \"createNewFormat\": \"Crear nuevo formato\",\n  \"back\": \"Volver\",\n  \"formatName\": \"Nombre formato\",\n  \"copyLineItemName\": \"Copiar nombre de la línea\",\n  \"lineItemNameCopied\": \"Nombre de la línea copiado\",\n  \"purchaseLinesCount\": \"Líneas de compra: {{count}}\",\n  \"pedido\": \"Pedido\",\n  \"inventario\": \"Inventario\",\n  \"addConversion\": \"Añadir conversión\",\n  \"selectFormats\": \"Selecciona los formatos para asignar\",\n  \"noFormatsSelected\": \"No hay formatos seleccionados\",\n  \"draft\": \"Borrador\",\n  \"draftFormatInUse\": \"Este formato no se puede eliminar porque es usado como padre por otro formato\",\n  \"formatAlreadyExists\": \"Este formato ya existe. Selecciónalo de la lista.\",\n  \"cancel\": \"Cancelar\",\n  \"save\": \"Guardar\",\n  \"loadingNextItem\": \"Cargando siguiente producto...\",\n  \"assignError\": \"Error al asignar la compra.\",\n  \"noPropertySelected\": \"No hay propiedad seleccionada.\",\n  \"fillProductDetails\": \"Rellena el nombre del producto y la unidad base.\",\n  \"autoCategoryInfo\": \"La categoría se asignará automáticamente\",\n  \"moveToProduct\": \"Mover a otro producto\",\n  \"editProduct\": \"Editar producto\",\n  \"unlinkPurchase\": \"Desvincular compra\",\n  \"unlinkPurchaseConfirmTitle\": \"¿Desvincular compra?\",\n  \"unlinkPurchaseConfirmDescription\": \"La compra quedará sin asignar y dejará de contar para este producto.\",\n  \"unassignSuccess\": \"Compra desvinculada correctamente.\",\n  \"unassignError\": \"Error al desvincular la compra.\",\n  \"analyzingMessage\": \"Generando sugerencias, por favor espera…\",\n  \"suggestionFeedback\": {\n    \"positiveButtonLabel\": \"Sugerencia correcta\",\n    \"negativeButtonLabel\": \"Sugerencia incorrecta\",\n    \"positivePopoverLabel\": \"¿Qué te ha gustado de esta sugerencia?\",\n    \"positivePopoverPlaceholder\": \"Ej. producto correcto, nombre acertado, unidad bien detectada...\",\n    \"negativePopoverLabel\": \"¿Qué falla en esta sugerencia?\",\n    \"negativePopoverPlaceholder\": \"Ej. producto equivocado, formato incorrecto, unidad no relacionada...\",\n    \"sent\": \"Feedback enviado correctamente\",\n    \"error\": \"No se pudo enviar el feedback\"\n  },\n  \"createProduct\": \"Crear nuevo producto\",\n  \"saveProduct\": \"Crear producto\",\n  \"navigation\": {\n    \"previousPendingPurchase\": \"Ir a la compra pendiente anterior\",\n    \"nextPendingPurchase\": \"Ir a la siguiente compra pendiente\"\n  },\n  \"legacyBaseUnitBlocked\": {\n    \"title\": \"Unidad base no permitida\",\n    \"description\": \"La unidad base {{baseUnit}} no está permitida en este flujo. Elige kg, ud o l para continuar.\"\n  },\n  \"unsavedChanges\": {\n    \"title\": \"¿Salir sin asignar?\",\n    \"description\": \"Si sales ahora, perderás la asignación que estás haciendo.\",\n    \"keepEditing\": \"Seguir editando\",\n    \"discardAndExit\": \"Salir sin guardar\"\n  },\n  \"tour\": {\n    \"intro\": {\n      \"title\": \"Hacemos un recorrido rápido\",\n      \"description\": \"Con el nuevo modal de asignación de líneas de compra generarás una lista de productos limpia y usable para inventariar y pedir con los formatos correctos.\",\n      \"start\": \"Empezar\",\n      \"skip\": \"Ahora no\"\n    },\n    \"relaunch\": \"Volver a ver la guía\",\n    \"steps\": {\n      \"purchaseLineHeader\": {\n        \"title\": \"Revisa la línea de compra.\",\n        \"description\": \"Tendrás que asignarla a un producto. La próxima vez que leamos la próxima línea de compra se integrará automáticamente en ese producto.\"\n      },\n      \"productSelector\": {\n        \"title\": \"Escoge el producto.\",\n        \"description\": \"La IA sugerirá un producto para integrar la línea de compra. Puede ser un producto nuevo o uno de la biblioteca de haddock (con imagen).\"\n      },\n      \"formatsSection\": {\n        \"title\": \"Escoge el formato.\",\n        \"description\": \"La IA sugerirá un formato en el que compras esa línea de compra. Borra los formatos que no sean necesarios.\"\n      },\n      \"footerActions\": {\n        \"title\": \"Termina la asignación.\",\n        \"description\": \"Asigna en caso de estar convencido, salta en caso de dudas o descarta en caso de no querer crear ese producto.\"\n      }\n    }\n  }\n}\n"
          },
