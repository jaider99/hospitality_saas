            "text": "{\n  \"byLocation\": {\n    \"filterByLocation\": \"Filter by {{location}}\",\n    \"noData\": \"No data\",\n    \"noDataTooltip\": \"No data for this location in the selected period.\",\n    \"title\": \"P&G by location\"\n  },\n  \"comparison\": {\n    \"previousMonth\": {\n      \"label\": \"vs. previous month\",\n      \"shortLabel\": \"prev. month\"\n    },\n    \"previousQuarter\": {\n      \"label\": \"vs. previous quarter\",\n      \"shortLabel\": \"prev. quarter\"\n    },\n    \"previousYear\": {\n      \"label\": \"vs. previous year\",\n      \"labelWithYear\": \"vs. previous year\",\n      \"shortLabel\": \"prev. year\"\n    },\n    \"none\": {\n      \"label\": \"No comparison\",\n      \"shortLabel\": \"period\",\n      \"legend\": \"no comparison\"\n    }\n  },\n  \"dates\": {\n    \"selectDate\": \"Select date\",\n    \"selectDates\": \"Select dates\"\n  },\n  \"displayMode\": {\n    \"amount\": \"Amount\",\n    \"ariaLabel\": \"P&G display mode\",\n    \"percentage\": \"Percentage of sales\"\n  },\n  \"errors\": {\n    \"loadFailed\": \"We couldn't load the P&G.\"\n  },\n  \"evolution\": {\n    \"description\": \"Evolution of the main P&G lines for the selected period.\",\n    \"title\": \"P&G evolution\",\n    \"presets\": {\n      \"title\": \"Quick views\",\n      \"onlyEbitda\": \"EBITDA only\",\n      \"result\": \"Result (Sales + Costs + EBITDA)\",\n      \"all\": \"All\"\n    }\n  },\n  \"granularity\": {\n    \"byLocation\": \"By location\",\n    \"monthly\": \"Monthly\",\n    \"prefix\": \"View:\",\n    \"trimester\": \"Quarterly\",\n    \"yearly\": \"Yearly\"\n  },\n  \"noData\": \"No data\",\n  \"hero\": {\n    \"subtitle\": \"Consolidated profit and loss for all selected locations.\",\n    \"title\": \"P&G\"\n  },\n  \"lines\": {\n    \"cleaning\": \"Cleaning\",\n    \"consumables\": \"Consumables\",\n    \"delivery-and-transport\": \"Delivery and transport\",\n    \"drinks\": \"Drinks\",\n    \"drinks-alcoholic\": \"