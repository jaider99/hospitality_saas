            "mimeType": "application/json",
            "text": "{\n  \"accrued\": \"Devengado\",\n  \"accruedAndCompanyContribution\": \"Devengado + aportación empresa <2>(recomendado con nóminas formato oficial)</2>\",\n  \"activeEmployee\": \"Empleado activo\",\n  \"activeEmployees\": \"Empleados activos\",\n  \"activeEmployees_desc\": \"Actualmente trabajan en tu restaurante\",\n  \"activeInactive\": \"Empleado activo o inactivo\",\n  \"activeInactiveDesc1\": \"Este empleado está <strong>activo</strong>, por lo que aparecerá en el proceso de subida de nóminas.\",\n  \"activeInactiveDesc2\": \"Márcalo como <strong>inactivo</strong> si deja de trabajar temporal o definitivamente.\",\n  \"inactiveEmployeeDesc1\": \"Este empleado está <strong>inactivo</strong>, por lo que no aparecerá en el proceso de subida de nóminas.\",\n  \"inactiveEmployeeDesc2\": \"Márcalo como <strong>activo</strong> si vuelve a trabajar en tu restaurante.\",\n  \"addEmployee\": \"Añadir empleado\",\n  \"addEmployee_one\": \"Añadir empleado\",\n  \"addEmployee_other\": \"Añadir empleados\",\n  \"addEmployees_one\": \"Añadir empleado\",\n  \"addEmployees_other\": \"Añadir empleados\",\n  \"addMoreDetails\": \"Añade más detalles\",\n  \"addNewEmployee\": \"Añadir nuevo empleado\",\n  \"addOtherLaborCosts\": \"Añadir otros gastos de personal\",\n  \"attachFile\": \"Adjuntar archivo\",\n  \"attachFiles\": \"Adjuntar archivos\",\n  \"basicInfoAndConfiguration\": \"Información básica y configuración\",\n  \"bulkDuplicateDescription\": \"Esta acción copiará las nóminas de {{period}} al mes que selecciones.\",\n  \"bulkDuplicateTitle\": \"Duplicar nóminas\",\n  \"copyMonthPayrolls_one\": \"Copiar nómina a otro mes\",\n  \"copyMonthPayrolls_other\": \"Copiar nóminas a otro mes\",\n  \"byEmployee\": \"Por empleado\",\n  \"byEmployeeDescription\": \"Subida de nóminas y creación empleados\",\n  \"chef\": \"Cocinero/a\",\n  \"companyContribution\": \"Aportación empresa\",\n  \"companyCost\": \"Coste empresa <1>(recomendado con nóminas formato A3)</1>\",\n  \"companyCostLabel\": \"Coste empresa\",\n  \"concept\": \"Concepto\",\n  \"controlStaffPayrolls\": \"Controla los <strong>costes reales de personal</strong> añadiendo las nóminas, horas extra de tus empleados\",\n  \"createEmployee\": \"Crear empleado\",\n  \"createRole\": \"Crear posición\",\n  \"deletePosition\": \"Eliminar posición\",\n  \"deletePositionConfirm\": \"Se eliminará esta posición. Esta acción no se puede deshacer.\",\n  \"datePeriod\": \"Fecha / Período\",\n  \"cannotDeletePositionInUse\": \"No se puede eliminar esta posición porque está asignada a uno o más empleados.\",\n  \"deleteEmployee\": \"¿Estás seguro de que quieres <2>eliminar el empleado {{name}}</2>?\",\n  \"employeeDeletedSuccess\": \"Empleado eliminado correctamente\",\n  \"employeeCreatedSuccess\": \"Empleado creado correctamente\",\n  \"seeEmployee\": \"Ver empleado\",\n  \"duplicateMonthPayrolls\": \"Duplicar nóminas del mes\",\n  \"duplicateOtherLaborCosts\": \"Duplicar otros gastos de personal\",\n  \"duplicatePayroll\": \"Duplicar gasto de personal\",\n  \"duplicatePayrolls\": \"Duplicar nóminas\",\n  \"editOtherLaborCosts\": \"Editar otros gastos de personal\",\n  \"editPayroll\": \"Editar gasto de personal\",\n  \"editPayrolls\": \"Editar nóminas\",\n  \"emailPlaceholder\": \"Escribe el correo electronico. Ej: capitan@haddock.app\",\n  \"emptyEmployeesNoticeTitle\": \"Necesitas añadir empleados primero\",\n  \"emptyEmployeesNoticeDescription\": \"Para subir nóminas, primero añade tus empleados en la página de Costes de personal.\",\n  \"emptyEmployeesNoticeCta\": \"Ir a Costes de personal\",\n  \"payrollTypeLabel\": \"Introducir con:\",\n  \"atLeastOneEmployee\": \"Añade al menos un empleado\",\n  \"uploadError\": \"No se pudieron subir las nóminas\",\n  \"editError\": \"No se pudo editar la nómina\",\n  \"governmentId\": \"NIF\",\n  \"weeklyHours\": \"Horas semanales\",\n  \"netAmount\": \"Líquido total a percibir\",\n  \"employee\": \"empleado\",\n  \"employeeName\": \"Nombre empleado\",\n  \"employeePayrolls\": \"Nóminas de los empleados\",\n  \"employees\": \"Empleados\",\n  \"employees_one\": \"Empleado\",\n  \"employerSS\": \"Seguridad social a cargo de la empresa\",\n  \"employerSS_short\": \"S. S. EMPRESA\",\n  \"emptyState_byEmployee\": \"Para subir nóminas por empleado, es necesario tener empleados creados. Haz clic a <strong>“Añadir empleado”</strong> para crear a tus empleados activos.\",\n  \"emptyUploadPayrolls\": \"Añade las nóminas de tus empleados\",\n  \"emptyUploadPayrollsDesc\": \"<strong>Controla los costes reales de personal</strong> añadiendo las nóminas, horas extra y otros gastos de tus empleados\",\n  \"errorCreatingPosition\": \"Error creando posición\",\n  \"errorDeletingPosition\": \"Error eliminando posición\",\n  \"errorExtension\": \"Sólo se permite PDF\",\n  \"errorSize\": \"Tamaño máximo 2MB\",\n  \"expenseUploaded\": \"¡Gasto subido!\",\n  \"expenseUploadedDescription\": \"Ya lo puedes ver en tu registro y/o perfil del trabajador\",\n  \"extraTime\": \"Horas extra\",\n  \"grossSalary\": \"Salario bruto\",\n  \"inactiveEmployees\": \"Empleados inactivos\",\n  \"inactiveEmployees_desc\": \"No trabajan temporal o definitivamente en tu restaurante\",\n  \"inputPlaceholder_employees\": \"Busca por el nombre del empleado, mail o posición\",\n  \"introducePayrolls\": \"Introduce las nóminas\",\n  \"introduceRole\": \"Introduce la nueva posición\",\n  \"introduceWith\": \"Introducir con\",\n  \"knowMoreBlog\": \"Blog saber más sobre control de gastos de personal\",\n  \"liquidSalary\": \"(Líquido a percibir + S.S trabajador + IRPF)\",\n  \"loadingPayrolls\": \"Cargando nóminas y preparando el formulario…\\t\",\n  \"maxProfitPayrolls\": \"Saca el máximo partido a Haddock, súbelas con desglose por empleado.\",\n  \"myEmployees\": \"Mis empleados\",\n  \"namePlaceholder\": \"Nombre del trabajador. Ej:Capitán Haddock\",\n  \"newPayroll\": \"NUEVO GASTO DE PERSONAL\",\n  \"newStaffExpense\": \"Nuevo gasto de personal\",\n  \"noAttachedFiles\": \"Sin archivos adjuntos\",\n  \"notesAndObservations\": \"Notas y observaciones\",\n  \"notesAndObservations_placeholder\": \"Escribe notas u observaciones relacionadas con el empleado\",\n  \"other\": \"Otros\",\n  \"otherExpenseFromEmployee\": \"Otros gastos de {{date}} de {{employee}}\",\n  \"otherExpenses\": \"otros gastos\",\n  \"otherLaborCosts\": \"Otros gastos de personal\",\n  \"otherLaborCostsDescription\": \"Control de horas extra fuera de nómina y otros gastos de personal.\",\n  \"payroll\": \"nómina\",\n  \"payrollByEmployeeUploadedDescription\": \"El gasto se ha subido correctamente, ya lo puedes ver en tu espacio de gastos de personal y trabajador.\",\n  \"payrollFromEmployee\": \"Nómina de {{date}} from {{employee}}\",\n  \"payrolls\": \"Nóminas\",\n  \"payrolls_one\": \"Nómina\",\n  \"payrolls_other\": \"Nóminas\",\n  \"payrollsAndOtherCosts\": \"Nóminas y otros gastos\",\n  \"payrollsTotal\": \"Total de nóminas\",\n  \"payrollsTotalAmount\": \"Total nóminas {{amount}}\",\n  \"payrollsUploaded\": \"¡Nóminas subidas!\",\n  \"payrollsUploadedDescription\": \"Todas las nóminas se ha subido correctamente, ya lo puedes ver en tu registro y perfil del trabajador\",\n  \"personnelCost\": \"Coste de personal\",\n  \"preparingDuplicate\": \"Preparando duplicado\",\n  \"reason\": \"Motivo\",\n  \"recommended\": \"Recomendado\",\n  \"recommendedPayrollWithEmployee\": \"Nóminas por empleado <1>(Recomendado)</1>\",\n  \"removeFromUpload\": \"Quitar de esta subida\",\n  \"repeatPayroll\": \"Duplicar nómina\",\n  \"rolePosition\": \"Posición\",\n  \"searchByMonth\": \"Busca por mes, trabajadores...\",\n  \"seeFromAllEmployees\": \"Ver de todos los empleados\",\n  \"seeInactive\": \"Ver inactivos\",\n  \"selectAnEmployee\": \"Selecciona un empleado\",\n  \"selectOrCreateEmployee\": \"Elige un trabajador existente o crea uno nuevo\",\n  \"selectOrCreatePosition\": \"Selecciona o crea la posición para este empleado\",\n  \"selectOrCreateRole\": \"Selecciona o crea una posición\",\n  \"staffCost\": \"Gastos de personal\",\n  \"titlePreview\": \"{{type}} de {{date}} de {{name}}\",\n  \"titlePreviewNoEmployee\": \"{{type}} de {{date}}\",\n  \"totalOtherExpenses\": \"TOTAL otros gastos\",\n  \"totalPayrolls\": \"Total nóminas\",\n  \"uploadByEmployee\": \"Subir nóminas por empleado\",\n  \"uploadFile\": \"Subir archivo\",\n  \"uploadOtherCost\": \"Añadir otro gasto\",\n  \"uploadPayroll\": \"Añadir gasto nóminas\",\n  \"uploadPayroll_one\": \"Añadir gasto nómina\",\n  \"uploadPayroll_other\": \"Registrar nóminas\",\n  \"uploadPayrolls\": \"Añade y almacena nóminas, resúmenes, etc.\",\n  \"uploadPayrollWihoutEmployee\": \"Total de nóminas sin desglose por trabajador\",\n  \"uploadPayrollWithEmployeeDescription\": \"Si quieres subir las nóminas por empleado, recomendamos hacerlo con la <strong>nueva subida de nóminas.</strong>\",\n  \"uploadpPayrollWithEmployee\": \"Sube las nóminas con el control por empleado\",\n  \"uploadpPayrollWithEmployeeDescription\": \"Si quieres subir las nóminas por empleado, recomendamos hacerlo con la <strong>nueva subida de nóminas.</strong>\",\n  \"uploadStaffPayrolls\": \"Añadir gasto nóminas de empleados\",\n  \"viewComment\": \"ver comentario\",\n  \"waiter\": \"Camarero/a\",\n  \"whereCanFindPayrollFormatData\": \"¿Dónde puedo encontrar estos datos y cuál es la diferencia de los formatos?\",\n  \"withoutEmployee\": \"Sin empleado\",\n  \"withoutEmployees\": \"Sin desglose por empleados\",\n  \"withoutEmployeesDescription\": \"Subida del total general de nóminas\",\n  \"withoutPayrolls\": \"Sin nóminas o otros gastos\",\n  \"writeConcept\": \"Escribe el concepto\"\n}\n"
