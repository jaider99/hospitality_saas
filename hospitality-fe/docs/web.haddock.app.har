            "text": "{\n  \"phoneNumbers\": \"Phone Numbers\",\n  \"phoneNumbersSubtitle\": \"Documents you send by WhatsApp from these numbers are digitalized automatically.\",\n  \"addPhoneNumber\": \"Add phone number\",\n  \"phoneNumber\": \"Phone number\",\n  \"phoneNumberPlaceholder\": \"07123 456789\",\n  \"noPhoneNumbers\": \"No phone numbers yet\",\n  \"deletePhoneNumberConfirmation\": \"Are you sure you want to delete this phone number?\",\n  \"phoneNumberCreated\": \"Phone number created\",\n  \"phoneNumberCreationError\": \"Error creating phone number\",\n  \"phoneNumberAlreadyExists\": \"This phone number is already registered\",\n  \"phoneNumberDeleted\": \"Phone number deleted\",\n  \"phoneNumberDeletionError\": \"Error deleting phone number\",\n  \"bannerTitle\": \"Digitalize expenses via WhatsApp\",\n  \"bannerDescription\": \"Send your invoices and receipts through WhatsApp to digitalize them automatically\",\n  \"bannerCta\": \"Add phone numbers\",\n  \"useWhatsapp\": \"Use WhatsApp\",\n  \"qrTitle\": \"Send documents via WhatsApp\",\n  \"qrDescription\": \"Scan the QR code to open a WhatsApp conversation where you can send your invoices and receipts\",\n  \"qrDescriptionMobile\": \"Tap the button below to open a WhatsApp conversation where you can send your invoices and receipts\",\n  \"openWhatsapp\": \"Open WhatsApp\",\n  \"managePhoneNumbers\": \"Manage phone numbers\",\n  \"addedAt\": \"Added {{date}}\",\n  \"unknownNumber\": \"This phone number isn't registered with haddock. To send invoices and receipts via WhatsApp, first add your number from the platform's settings.\",\n  \"scanLimitReached\": \"You've reached your haddock plan's document limit, so this document couldn't be digitalized. To keep sending invoices and receipts via WhatsApp, upgrade your plan.\",\n  \"phoneNumberUpdated\": \"Phone number updated\",\n  \"phoneNumberUpdateError\": \"Error updating phone number\",\n  \"alias\": \"Alias\",\n  \"aliasOptional\": \"Alias (optional)\