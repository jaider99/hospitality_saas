          "content": {
            "size": 10288,
            "mimeType": "application/json",
            "text": "{\n  \"ahaAccount_NotRealAccount\": \"La información de esta cuenta no es de un restaurante real, se ha preparado especificamente a modo de ejemplo.\",\n  \"ahaAccount_discoverBenefits\": \"Descubre <1>cómo se muestra la información</1> una vez has subido los gastos y ventas. Tienes acceso con el <3>rol de gestor</3>, lo que te permite ver toda la información pero sin poder modificarla.\",\n  \"ahaAccount_discoverHowInfoIsShown\": \"Descubre cómo se muestra la información una vez has subido los gastos y ventas. Tienes acceso con el rol de gestor, lo que te permite ver toda la información pero sin poder modificarla.\",\n  \"ahaAccount_welcomeTo\": \"Te damos la bienvenida a tu\",\n  \"blockedPlan\": \"Tu cuenta no está activa\",\n  \"blockedSubscriptionBanner\": \"Tu cuenta ha sido restringida por problemas en el pago. Tus datos y configuraciones siguen guardados de forma segura.\",\n  \"blockedSubscriptionBannerNonAdmin\": \"La cuenta está restringida. Contacta con el administrador de tu cuenta o con soporte@haddock.app para continuar usando haddock.\",\n  \"cannotDelete_dishes\": \"Para proteger la información introducida, no podrás eliminar el plato si está siendo utilizado en un menú.\",\n  \"cannotDelete_employee\": \"Para proteger la información introducida, no puedes eliminar empleados con nóminas o gastos de personal. Como alternativa recomendada, marca al empleado como inactivo.\",\n  \"cannotDelete_preparations\": \"Para proteger la información introducida, no podrás eliminar la preparación si se utiliza como ingrediente en un plato. \",\n  \"comparatorInterestBadge\": \"Nueva funcionalidad de haddock\",\n  \"comparatorInterestConfirm\": \"Ver comparativa gratuita\",\n  \"comparatorInterestDescription\": \"Consulta tu informe y descubre en qué productos podrías estar pagando de más\",\n  \"comparatorInterestDismiss\": \"Ahora no\",\n  \"comparatorInterestTitle\": \"Descubre si tus precios de compra están por encima del mercado\",\n  \"confirmChangeCategory\": \"Se ha establecido <1>{{categoryName}}</1> como categoría en los <4>{{num}} documentos seleccionados</4>\",\n  \"confirmChangeCategoryToSupplier\": \"Se ha establecido <1>{{categoryName}} </1> como categoría en <3>{{num}} documentos</3> del proveedor <5>{{supplierName}}</5>\",\n  \"confirmChangeSupplier\": \"Se ha establecido <1>{{supplierName}}</1> como proveedor en los <4>{{num}} documentos seleccionados</4>\",\n  \"confirmChangeSupplierCategory\": \"Se ha establecido <1>{{supplierName}}</1> como proveedor y <4>{{categoryName}}</4> como categoría en los <7> {{num}} documentos seleccionados</7>\",\n  \"delete\": \"Eliminar\",\n  \"delete_dish\": \"¿Eliminar escandallo?\",\n  \"delete_document\": \"¿ESTÁS SEGURO DE QUE QUIERES ELIMINAR ESTE DOCUMENTO?\",\n  \"delete_employee\": \"¿Eliminar empleado?\",\n  \"delete_expense\": \"¿ESTÁS SEGURO DE QUE QUIERES ELIMINAR ESTE GASTO?\",\n  \"delete_file\": \"¿Estás seguro de que quieres eliminar este archivo?\",\n  \"delete_incident\": \"¿Eliminar incidencia?\",\n  \"delete_ingredient\": \"¿Eliminar ingrediente? \",\n  \"delete_integration\": \"¿ESTÁS SEGURO DE QUE QUIERES ELIMINAR ESTA INTEGRACIÓN?\",\n  \"delete_invitation\": \"El usuario no podrá acceder a la información del restaurante en haddock.\",\n  \"delete_payroll\": \"¿Eliminar nómina/s?\",\n  \"delete_sale\": \"¿ESTÁS SEGURO DE QUE QUIERES ELIMINAR ESTA VENTA?\",\n  \"delete_supplier\": \"¿ESTÁS SEGURO DE QUE QUIERES ELIMINAR ESTE PROVEEDOR?\",\n  \"delete_user\": \"¿Seguro que quieres eliminar el usuario {{user}}?\",\n  \"deliveryNoteCreated\": \"Se ha creado tu albarán\",\n  \"deliveryNoteCreatedDescription\": \"Hemos creado un albarán en base a tu recepción\",\n  \"deliveryNoteError\": \"Error creado tu albarán\",\n  \"deliveryNoteErrorDescription\": \"Se ha producido un error creado tu abarán\",\n  \"discard_suggestion_description\": \"Si descartas esta sugerencia los productos permanecerán separados como están actualmente. ¿Estas seguro de que deseas descartar esta agrupación recomendada?\",\n  \"discardSuggestion\": \"¿Deseas descartar esta sugerencia?\",\n  \"discountAvailable\": \"Descuento disponible durante las primeras 24h\",\n  \"employee\": \"¿Estás seguro de que quieres eliminar este empleado?\",\n  \"errorCreated\": \"Error en la creación.\",\n  \"expenseCreated\": \"¡Gasto creado!\",\n  \"expenseCreatedDescription\": \"El nuevo gasto se ha creado correctamente, ya lo puedes ver junto a los otros gastos\",\n  \"expenseCreationError\": \"Ha fallado la creación\",\n  \"expenseCreationErrorDescription\": \"NO se ha creado correctamente el nuevo gasto. Recarga la página y vuelve a intentarlo.\",\n  \"expenseUploadError\": \"Volver a subir\",\n  \"haddockNoLimit\": \"haddock sin limites\",\n  \"inSubscription\": \"en tu subscripción\",\n  \"manualExpense_title\": \"¿Cerrar nuevo gasto?\",\n  \"newExpenseOk\": \"Gasto creado\",\n  \"newExpenseOk_description\": \"Documento del gasto creado correctamente.\",\n  \"noNever\": \"No, nunca\",\n  \"oneTimeOffer\": \"Oferta única\",\n  \"payThroughHaddock\": \"¿Pagar a través de haddock?\",\n  \"payThroughHaddock_description\": \"¿Tienes interés en poder utilizar haddock para pagar a tus proveedores?\",\n  \"productDelete_description\": \"Opción aún no disponible. Pero ahora que sabemos que necesitas eliminarlo, trabajaremos para darte esta opción muy pronto.\",\n  \"productsQuickAction_archive_one\": \"¿Quieres ocultar el producto seleccionado?\",\n  \"productsQuickAction_archive_other\": \"¿Quieres ocultar los {{count}} productos seleccionados?\",\n  \"productsQuickAction_bookmark_one\": \"¿Quieres marcar el producto seleccionado como favorito?\",\n  \"productsQuickAction_bookmark_other\": \"¿Quieres marcar los {{count}} productos seleccionados como favoritos?\",\n  \"productsQuickAction_delete_one\": \"¿Quieres eliminar el producto seleccionado?\",\n  \"productsQuickAction_delete_other\": \"¿Quieres eliminar los {{count}} productos seleccionados?\",\n  \"productsQuickAction_unarchive_one\": \"¿Quieres mostrar el producto seleccionado?\",\n  \"productsQuickAction_unarchive_other\": \"¿Quieres mostrar los {{count}} productos seleccionados?\",\n  \"productsQuickAction_unbookmark_one\": \"¿Quieres marcar el producto seleccionado como no favorito?\",\n  \"productsQuickAction_unbookmark_other\": \"¿Quieres marcar los {{count}} productos seleccionados como no favoritos?\",\n  \"productUploadError_description\": \"El excel de productos no se ha podido importar, asegurate de que has completado todas las filas obligatorias (en naranja) y los valores son correctos.\",\n  \"productUploadError_reUpload\": \"Volver a subir excel\",\n  \"productUploadError_title\": \"ERROR EN LA CARGA\",\n  \"productUploadSuccess_description\": \"El excel de productos se ha importado correctamente. Ya puedes verlos en tu lista de productos y utilizarlos para hacer escandallos\",\n  \"productUploadSuccess_title\": \"IMPORTADO CON ÉXITO\",\n  \"requestingName\": \"Solicitando la demostración no se te va a aplicar el descuento\",\n  \"requestNow\": \"Solicitar demo\",\n  \"setCategory\": \"¿Establecer <1>{{categoryName}}</1> como categoría en los <4>{{num}} documentos seleccionados?</4>\",\n  \"setCategoryToSupplier\": \"¿Establecer <1>{{categoryName}}</1> como categoría para el proveedor <3>{{supplierName}}</3>?\",\n  \"setMethod\": \"¿Establecer <1>{{method}}</1> como método de pago en los <4>{{num}} documentos seleccionados</4>?\",\n  \"setPayment\": \"¿Quieres marcar como <2>{{paid}}</2> los <5>{{num}} documentos seleccionados</5>?\",\n  \"setPaymentMethod\": \"¿Quieres marcar como <2>{{paid}}</2> y <5>{{method}}</5> como método de pago en los <8>{{num}} documentos seleccionados</8>?\",\n  \"setSupplier\": \"¿Establecer <1>{{supplierName}}</1> como proveedor en los <4>{{num}} documentos seleccionados?</4>\",\n  \"setSupplierCategory\": \"¿Establecer <1>{{supplierName}}</1> como proveedor y <4>{{categoryName}}</4> como categoría en los <7> {{num}} documentos seleccionados?</7>\",\n  \"signatureInterest_HrError\": \"Servicio de HR no disponible temporalmente\",\n  \"signatureInterest_badge\": \"¡SOLO HOY!\",\n  \"signatureInterest_confirmAcquisition\": \"Quiero las 10 firmas por 1€\",\n  \"signatureInterest_confirmWithHR\": \"Quiero haddock HR y las 10 firmas por 1€\",\n  \"signatureInterest_description\": \"Olvídate de papeles: firma nóminas, contratos y turnos en segundos desde un mismo portal.\",\n  \"signatureInterest_dismiss\": \"Ahora no\",\n  \"signatureInterest_error\": \"Ha ocurrido un error al tramitar tu interés. Por favor, inténtalo de nuevo.\",\n  \"signatureInterest_footNote\": \"*10 firmas a canjear en 30 días\",\n  \"signatureInterest_snackConfirm\": \"¡Perfecto! Hemos recibido tu interés\",\n  \"signatureInterest_snackDescription\": \"Te contactaremos pronto con más detalles.\",\n  \"signatureInterest_title\": \"Digitaliza las firmas de tu equipo por 1€\",\n  \"signaturesRetention_badge\": \"RECOMENDADO\",\n  \"signaturesRetention_bySignature\": \"por firma\",\n  \"signaturesRetention_confirm\": \"¡LO QUIERO!\",\n  \"signaturesRetention_subtitle\": \"Escoge el mejor plan anual para ti\",\n  \"signaturesRetention_title\": \"Te has quedado sin firmas\",\n  \"startNow\": \"¡Empezar ya!\",\n  \"subscriptionCanceledPopupNonAdminIntro\": \"Nos alegra verte de nuevo,\",\n  \"subscriptionCanceledPopupNonAdminBody\": \"Tu suscripción a haddock ha caducado. Tus datos y configuraciones siguen guardados de forma segura.\",\n  \"subscriptionCanceledPopupNonAdminSupport\": \"Por favor, contacta con el propietario o administrador de la cuenta para continuar usando haddock.\",\n  \"subscriptionCanceledPopupNonAdminEmail\": \"Si lo prefieres, pídele que contacte con soporte a través del chat o por email en soporte@haddock.app.\",\n  \"subscriptionCanceledPopupAdminIntro\": \"Nos alegra verte de nuevo,\",\n  \"subscriptionCanceledPopupAdminBody\": \"Tu suscripción a haddock ha caducado. Tus datos y configuraciones siguen guardados de forma segura.\",\n  \"subscriptionCanceledPopupAdminSupport\": \"Por favor, contacta con soporte a través del chat para continuar usando haddock.\",\n  \"subscriptionCanceledPopupAdminEmail\": \"O envíanos un email a soporte@haddock.app\",\n  \"tryHaddock\": \"Prueba haddock sin límites. Consigue un <strong>70% de descuento</strong> durante el primer mes si te suscribes <strong>hoy*</strong>.\",\n  \"tryHaddock_snackbarDesktop\": \"Consigue un <strong>70% de descuento</strong> durante el primer mes si te suscribes <strong>hoy*</strong>.\",\n  \"tryHaddock_snackbarMobile\": \"<strong>70% de descuento</strong> si te suscribes <strong>hoy*</strong>.\",\n  \"viewDeliveryNote\": \"Ver albarán\"\n}\n"
