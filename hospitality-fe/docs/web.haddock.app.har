            "text": "{\n  \"byLocation\": {\n    \"filterByLocation\": \"Filtrar por {{location}}\",\n    \"noData\": \"Sin datos\",\n    \"noDataTooltip\": \"Sin datos en este local para el periodo seleccionado.\",\n    \"title\": \"P&G por local\"\n  },\n  \"comparison\": {\n    \"previousMonth\": {\n      \"label\": \"vs. mes anterior\",\n      \"shortLabel\": \"mes ant.\"\n    },\n    \"previousQuarter\": {\n      \"label\": \"vs. trimestre anterior\",\n      \"shortLabel\": \"trimestre ant.\"\n    },\n    \"previousYear\": {\n      \"label\": \"vs. año anterior\",\n      \"labelWithYear\": \"vs. año anterior\",\n      \"shortLabel\": \"año ant.\"\n    },\n    \"none\": {\n      \"label\": \"Sin comparación\",\n      \"shortLabel\": \"periodo\",\n      \"legend\": \"sin comparación\"\n    }\n  },\n  \"dates\": {\n    \"selectDate\": \"Seleccionar fecha\",\n    \"selectDates\": \"Seleccionar fechas\"\n  },\n  \"displayMode\": {\n    \"amount\": \"Importe\",\n    \"ariaLabel\": \"Modo de visualización del P&G\",\n    \"percentage\": \"Porcentaje sobre ventas\"\n  },\n  \"errors\": {\n    \"loadFailed\": \"No hemos podido cargar el P&G.\"\n  },\n  \"evolution\": {\n    \"description\": \"Evolución de las principales líneas del P&G para el periodo seleccionado.\",\n    \"title\": \"Evolución del P&G\",\n    \"presets\": {\n      \"title\": \"Vistas rápidas\",\n      \"onlyEbitda\": \"Solo EBITDA\",\n      \"result\": \"Resultado (Ventas + Costes + EBITDA)\",\n      \"all\": \"Todo\"\n    }\n  },\n  \"granularity\": {\n    \"byLocation\": \"Por local\",\n    \"monthly\": \"Mensual\",\n    \"prefix\": \"Visualización:\",\n    \"trimester\": \"Trimestral\",\n    \"yearly\": \"Anual\"\n  },\n  \"noData\": \"Sin datos\",\n  \"hero\": {\n    \"subtitle\": \"Pérdidas y ganancias consolidadas de todos los locales seleccionados.\",\n    \"title\": \"Pérdidas y Ganancias\"\n  },\n  \"lines\": {\n    \"cleaning\": \"Limpieza\",\n    \"consumables\": \"Consumibles\",\n    \"delivery-and-transport\": \"Distribución y transporte\",\n    \"drinks\": \"Bebidas\",\n    \"drinks-alcoholic\": \"Alcohólicas\",\n    \"drinks-beer\": \"Cerveza\",\n    \"drinks-non-alcoholic\": \"No alcohólicas\",\n    \"drinks-wines\": \"Vinos\",\n    \"equipment-and-furniture\": \"Equipamiento y mobiliario\",\n    \"ebitda\": \"EBITDA\",\n    \"finance\": \"Finanzas\",\n    \"gross-margin\": \"Margen bruto\",\n    \"maintenance\": \"Mantenimiento\",\n    \"management\": \"Servicios\",\n    \"marketing-and-communication\": \"Marketing\",\n    \"other-costs\": \"Gastos\",\n    \"others\": \"Otros\",\n    \"raw-materials\": \"Materias Primas\",\n    \"raw-materials-and-drinks\": \"Costes materia prima\",\n    \"raw-materials-cereal-rice-and-pasta\": \"Cereales, arroz y pasta\",\n    \"raw-materials-egg-dairy-and-derivatives\": \"Huevos, lácteos y derivados\",\n    \"raw-materials-fish-and-seafood\": \"Pescados y mariscos\",\n    \"raw-materials-frozen\": \"Congelados\",\n    \"raw-materials-fruit-and-vegetables\": \"Frutas y verduras\",\n    \"raw-materials-meats\": \"Carnes\",\n    \"raw-materials-preserved-food\": \"Conservas\",\n    \"rent-cost\": \"Coste de alquiler\",\n    \"sales\": \"Ventas\",\n    \"staff-cost\": \"Coste de personal\",\n    \"tech\": \"Tecnología\",\n    \"utilities\": \"Suministros\"\n  },\n  \"nav\": {\n    \"title\": \"P&G\"\n  },\n  \"properties\": {\n    \"all\": \"Todos los locales\",\n    \"count_one\": \"{{count}} local\",\n    \"count_other\": \"{{count}} locales\",\n    \"emptyText\": \"No hay locales.\",\n    \"placeholder\": \"Todos los locales\",\n    \"searchPlaceholder\": \"Buscar locales\"\n  },\n  \"statement\": {\n    \"line\": \"Métrica\",\n    \"quarterLabel\": \"T{{quarter}} {{year}}\",\n    \"sources\": {\n      \"document\": \"Ver documento\",\n      \"empty\": \"No hay documentos vinculados para esta línea.\",\n      \"expenseTypes\": {\n        \"delivery-note\": \"Albarán\",\n        \"invoice\": \"Factura\",\n      