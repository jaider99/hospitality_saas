            "text": "{\n  \"add\": \"Add product\",\n  \"aiRecommendationKeep\": \"Possibly different\",\n  \"aiRecommendationMerge\": \"Looks the same\",\n  \"aiRecommendationReject\": \"Looks different\",\n  \"aiCategory_different_product\": \"Different product\",\n  \"aiCategory_different_variety\": \"Different variety\",\n  \"aiCategory_different_flavor\": \"Different flavor\",\n  \"aiCategory_error_digitalization\": \"Digitalization mismatch\",\n  \"aiCategory_dirty_name\": \"Name with differences\",\n  \"aiCategory_incomplete_name\": \"Incomplete name\",\n  \"aiCategory_identical_product\": \"Identical product\",\n  \"aiCategory_year_for_wines\": \"Different year (wines)\",\n  \"aiCategory_big_quantity_difference\": \"Large quantity difference\",\n  \"aiCategory_sugar_alcohol_content\": \"Different sugar/alcohol content\",\n  \"aiCategory_alcohol_aceite_degree\": \"Different alcohol/oil degree\",\n  \"aiCategory_return_vs_no_return\": \"With/without container return\",\n  \"aiCategory_synonym_or_language_variation\": \"Synonym or language variation\",\n  \"aiCategory_other\": \"Other\",\n  \"addAgreedPrice\": \"Add agreed price\",\n  \"affectedModifierRules\": \"Affected modifier rules\",\n  \"agreedPriceDescription\": \"You can add the price you agreed with your supplier so you can be informed if it varies.\",\n  \"allergen\": \"Allergen\",\n  \"allergen_celery\": \"Celery\",\n  \"allergen_crustaceans\": \"Crustaceans\",\n  \"allergen_eggs\": \"Eggs\",\n  \"allergen_fish\": \"Fish\",\n  \"allergen_gluten\": \"Gluten\",\n  \"allergen_lupins\": \"Lupins\",\n  \"allergen_milk\": \"Dairy\",\n  \"allergen_molluscs\": \"Molluscs\",\n  \"allergen_mustard\": \"Mustard\",\n  \"allergen_nuts\": \"Nuts\",\n  \"allergen_peanuts\": \"Peanuts\",\n  \"allergen_sesame\": \"Sesame\",\n  \"allergen_soy\": \"Soy\",\n  \"allergen_sulphites\": \"Sulphites\",\n  \"allergens\": \"Allergens\",\n  \"allergenInformation\": \"Allergen Information\",\n  \"assign\": \"Assign product\",\n  \"assignBaseUnit\": \"Assign the conversion to a base unit so we can provide better product reporting.\",\n  \"assignNameCode\": \"Assign a name and a code to provide you a better report\",\n  \"averagePrice\": \"Average price\",\n  \"suppliersTableTotalPurchased\": \"Total purchased\",\n  \"suppliersTableTotalSpent\": \"Total spent\",\n  \"lowestPrice\": \"Cheapest\",\n  \"averageReferencePrice\": \"Pondered <strong>Average price</strong>\",\n  \"backToProducts\": \"Back to products\",\n  \"baseUnit\": \"Base unit\",\n  \"baseUnitDescription\": \"Basic unit of consumption of the product.\",\n  \"chooseBaseUnit\": \"Defines how many base units a supplier's purchasing unit is equivalent to to correctly manage consumption and stock.\",\n  \"closeMerge\": \"Close products merge?\",\n  \"closeMergeNotSaved\": \"The product grouping will not be saved\",\n  \"code\": \"Product code\",\n  \"combinedReport\": \"You will now be able to see a combined report of these products.\",\n  \"completeFieldsImport\": \"Complete the fields (product name, unit of measure, unit price, supplier name and CIF) in the following excel template and upload it in step 2.\",\n  \"confirmChangeCategoryWithNoProductsDescription\": \"If you change it, this product will no longer be shown in the product list. Do you want to continue?\",\n  \"confirmChangeCategoryWithNoProductsTitle\": \"Switching to this category will hide the product from the listing.\",\n  \"confirmConversionMatchDescription\": \"While unifying the products, the new product will become the one you selected\",\n  \"confirmConversionMatchTitle\": \"Do you want to match the products?\",\n  \"confirmMassEdit\": \"Modify the <strong>{{fields}}</strong> in the <strong>{{count}} selected products</strong>? \",\n  \"confirmMatchDescription\": \"The new product will become the one you selected.\",\n  \"confirmMatchTitle\": \"You want to match the products?\",\n  \"mergeProductsConfirmationDescription\": \"{{count}} products will be merged into one. While this action can be undone, separating the products afterward is very time-consuming.\",\n  \"mergeProductsConfirmationProductsList\": \"Products to be merged\",\n  \"mergeProductsConfirmationPurchaseItem\": \"Purchase item\",\n  \"mergeProductsConfirmationTitle\": \"Merge products?\",\n  \"mostRecentFirst\": \"Most recent first\",\n  \"oldestFirst\": \"Oldest first\",\n  \"confirmNoMatchDescription\": \"We'll create a new product {{ name }}, with no matching of any of the suggested products.\",\n  \"confirmNoMatchTitle\": \"Do you want to create a new product?\",\n  \"connectProductEmptyState\": \"There are no products in your account\",\n  \"connectProductsEmptyStateText\": \"Create the products to connect them with the sales of your POS\",\n  \"connectProductsNoResultsFor\": \"No results for “{{value}}” in your products\",\n  \"consumption\": \"Consumption\",\n  \"consumptionUnit\": \"Consumption unit\",\n  \"conversionFactor\": \"Conversion factor\",\n  \"conversionFactorDescription\": \"This factor defines how many {{newUnit}} are equivalent to 1{{oldUnit}}. It will be used to convert existing dish or modifier rules quantities from {{oldUnit}} to {{newUnit}}.\",\n  \"conversionToBaseUnit\": \"Conversion to base unit of measure\",\n  \"conversionToBaseUnitDescription\": \"The products that you want to merge use different units of measure. Tell us what is the conversion, so we can calculate the corresponding quantity between the new and the selected products.\",\n  \"convertBeforeAddingProduct\": \"Convert the selected product to a <strong>consumption unit</strong> (kg, litres or pcs), and enter the <strong>quantity in the sales item.</strong>\",\n  \"create\": \"Create product\",\n  \"createManually\": \"Create product manually\",\n  \"createManuallySubtitle\": \"Creating products manually is fine, but it may be easier to create them automatically by digitising invoices or delivery notes.\",\n  \"createProductSuggestionDescription\": \"Adjust the data to be able to create a product from this digitized item.\",\n  \"createProductSuggestionModalDescription\": \"We will create the new product <strong>\\\"{{name}}\\\"</strong> based on your digitized purchase item.\",\n  \"deleteConversion\": \"Delete conversion\",\n  \"disablePurchasingTooltip\": \"This product isn't available for purchase through orders.\",\n  \"discardCreateProductSuggestionModalDescription\": \"<strong>\\\"{{name}}\\\"</strong> will be discarded and cannot be recovered.\",\n  \"discardCreateProductSuggestionModalTitle\": \"Do you want to discard this item?\",\n  \"discardCreateProductSuggestionSuccessBody\": \"It will not be added to the product list\",\n  \"discardCreateProductSuggestionSuccessTitle\": \"Item successfully discarded\",\n  \"discount\": \"Discount\",\n  \"discount_small\": \"DISC\",\n  \"discountAmount\": \"Applied discount\",\n  \"discountedPriceApplied\": \"Discounted product\",\n  \"discountPercentage\": \"Discounts\",\n  \"documentProduct\": \"View product in the document\",\n  \"editGreenDot\": \"Go to the next step to edit the product green point\",\n  \"editIBEE\": \"Go to the next step to edit the product IBEE\",\n  \"editProductDiscount\": \"Go to the next step to edit the product discounts\",\n  \"editProducts\": \"Edit Product\",\n  \"editProductDialogTitle\": \"Edit product\",\n  \"editProductDialogBaseUnitInfo\": \"This is the standard measure (liters, kilos, units) that Haddock will use to calculate your recipe cost and show consistent quantity and price data.\",\n  \"editProductDialogShrinkageInfo\": \"This is the percentage of product that is lost or cannot be used.\",\n  \"editProductDialogFixedPriceInfo\": \"This is the price assigned to new digitized documents that do not include a price.\",\n  \"editProductDialogMinimumStock\": \"Minimum stock\",\n  \"editProductDialogMaximumStock\": \"Maximum stock\",\n  \"editProductDialogStockQuantityError\": \"Stock must be 0 or greater.\",\n  \"editProductDialogStock