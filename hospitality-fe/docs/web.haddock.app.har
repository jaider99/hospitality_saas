            "text": "{\n  \"advanced\": \"Conciliación avanzada\",\n  \"aiAnalized\": \"Analizado con IA\",\n  \"aiAnalizedAt\": \"Analizado con IA el {{date}}\",\n  \"aiConciliationAnalyzing\": \"Analizando...\",\n  \"analyzedByFina\": \"Analizado por Fina\",\n  \"analyzedByFinaAt\": \"Analizado por Fina el {{date}}\",\n  \"dateTimeConnector\": \"a las\",\n  \"aiProcessed\": \"Conciliado con IA\",\n  \"analyzeWithAi\": \"Analizar con IA\",\n  \"analyzeWithFina\": \"Analizar con Fina\",\n  \"anyDiference\": \"Hay algún desajuste? Falta algún documento?\",\n  \"approved\": \"Sin discrepancia\",\n  \"availableDocuments\": \"Documentos disponibles\",\n  \"byItself\": \"El ticket se conciliará directamente con la factura\",\n  \"closeReconciliation\": \"¿cerrar conciliación?\",\n  \"deliveryNotesSelection\": \"Selección de albaranes\",\n  \"dueIn\": \"Vence en {{time}}\",\n  \"eAnalyzeWithAi\": \"Reanalizar con IA\",\n  \"reanalyzeWithFina\": \"Reanalizar con Fina\",\n  \"editAndUndoReconciliation\": \"¿Editar documento y deshacer conciliación?\",\n  \"editAndUndoReconciliation_description\": \"La edición de este documento va a deshacer la conciliación de los documentos relacionados.\",\n  \"emptyState_reconciliation\": \"Ya puedes realizar la conciliación de facturas y albaranes de manera mucho <strong> más eficiente con haddock.</strong> ¡Empieza ahora!\",\n  \"errorAIReconcilingDocuments\": \"Ha ocurrido un error al reconciliar con IA tus documentos\",\n  \"feedbackAIConciliationDescription\": \"Descripción\",\n  \"feedbackAIConciliationPlaceholder\": \"1) Qué hizo mal la IA\\n2) Qué debería haber hecho en su lugar\",\n  \"feedbackSubmitError\": \"Error al enviar el reporte. Por favor, intenta de nuevo.\",\n  \"feedbackSubmittedSuccess\": \"Reporte enviado correctamente. ¡Gracias por tu colaboración!\",\n  \"highDifference_description\": \"Hay un desajuste de {{value}}. \",\n  \"highDifference_title\": \"diferencia muy alta\",\n  \"highDifferenceTitle\": \"¿Conciliar con un desajuste?\",\n  \"incidentDetected\": \"Discrepancia detectada\",\n  \"lookUpAndSelect\": \"Selecciona los documentos que quieres conciliar con la siguiente factura:\",\n  \"makeFirstReconciliation\": \"Realiza tu primera conciliación\",\n  \"manualReconciliation\": \"Conciliación manual\",\n  \"many\": \"Conciliados\",\n  \"missingDocuments\": \"Faltan documentos\",\n  \"negativeDiscrepancy\": \"Discrepancia desfavorable\",\n  \"noChildrenInvoice_description\": \"¿No tienes albaranes a conciliar con esta factura?\",\n  \"noChildrenInvoice_title\": \"Factura sin albaranes\",\n  \"noChildrenTicket_description\": \"¿No tienes una factura para este ticket?\",\n  \"noChildrenTicket_title\": \"Ticket sin factura\",\n  \"noDeliveryNotes\": \"Sin documentos\",\n  \"notAvailableDocuments\": \"No hay documentos disponibles para seleccionar\",\n  \"notInvoice\": \"No es factura\",\n  \"notRelatedDocuments\": \"La factura se conciliará sin documentos asociados\",\n  \"overdueAgo\": \"Vencido hace {{time}}\",\n  \"pendingDocs\": \"Documentos pendientes\",\n  \"pendingInvoices\": \"Facturas pendientes\",\n  \"positiveDiscrepancy\": \"Discrepancia a favor\",\n  \"recentReconciliations\": \"Conciliaciones recientes\",\n  \"recomended\": \"Conciliaciones recomendadas\",\n  \"reconcile\": \"Conciliar\",\n  \"reconcile_manually\": \"Conciliar manualmente\",\n  \"reject\": \"Rechazar\",\n  \"reportAIConciliationError\": \"Reportar error de conciliación AI\",\n  \"reportAIConciliationErrorDescription\": \"Describe el error que encontraste en la conciliación automática. Tu reporte nos ayudará a mejorar.\",\n  \"reportIssue\": \"Reportar error\",\n  \"resultError_description\": \"No ha sido posible conciliar los documentos de tu proveedor {{supplier}}.\",\n  \"resultError_title\": \"error en la conciliación\",\n  \"resultOk_description\": \"Los documentos de {{supplier}} se han conciliado correctamente. Puedes ver la conciliación en la pestaña “CONCILIADOS”.\",\n  \"resultOk_title\": \"¡conciliación hecha!\",\n  \"resultsValidation\": \"Comprobación de resultado y conciliación\",\n  \"searchBy\": \"Busca por proveedor o número de factura\",\n  \"seeReconciledDocuments\": \"Ver documentos conciliados\",\n  \"selectAIDecisionsFilter\": \"Selecciona las decisiones de IA a filtrar\",\n  \"selectCategoriesFilter\": \"Selecciona las categorías a filtrar\",\n  \"selectDeliveryNotes\": \"Seleccionar albaranes\",\n  \"successfullyReconciledDocuments\": \"Documentos conciliados correctamente\",\n  \"undo\": \"Deshacer conciliación\",\n  \"undoQuestion\": \"¿Deshacer conciliación?\",\n  \"validateResult\": \"Comprueba que el resultado es correcto y concilia los documentos\",\n  \"viewingDocumentsBetween\": \"Mostrando documentos de los últimos 90 días\",\n  \"willNotSave\": \"La conciliación de estos documentos no se guardará\",\n  \"withDifferenceOf\": \"Los documentos se conciliarán con una diferencia de {{difference}}\",\n  \"withoutDocumentNumber\": \"Sin número de documento\",\n  \"differenceExplanationAriaLabel\": \"Explicación\"\n}\n"
