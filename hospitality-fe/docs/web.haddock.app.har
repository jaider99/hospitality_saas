            "text": "{\n  \"tpvConnectedOnly\": \"Solo aparecen platos con artículos del TPV conectados\",\n  \"cards\": {\n    \"avgMargin\": {\n      \"help\": \"Margen bruto medio de los platos vendidos.\",\n      \"label\": \"Margen medio\"\n    },\n    \"avgMultiplier\": {\n      \"help\": \"Relación media entre PV y coste.\",\n      \"label\": \"Multiplicador medio\"\n    },\n    \"maxMargin\": {\n      \"help\": \"El escandallo con el margen bruto más alto sobre el precio de venta.\",\n      \"label\": \"Plato con más margen\"\n    },\n    \"maxUnits\": {\n      \"help\": \"El escandallo con más unidades vendidas.\",\n      \"label\": \"Plato con más ventas\"\n    }\n  },\n  \"dates\": {\n    \"selectDate\": \"Seleccionar fecha\",\n    \"selectDates\": \"Seleccionar fechas\"\n  },\n  \"emptyState\": {\n    \"title\": \"Crea tus escandallos y conoce tus márgenes\",\n    \"description\": \"Verás el coste y el margen de cada plato de tu carta.\",\n    \"action\": \"Crear escandallo\"\n  },\n  \"hero\": {\n    \"subtitle\": \"Margen de tus platos consolidado de todos los locales seleccionados.\",\n    \"title\": \"Escandallos\"\n  },\n  \"matrix\": {\n    \"axis\": {\n      \"margin\": \"Margen por plato (€)\",\n      \"units\": \"Unidades vendidas\"\n    },\n    \"empty\": \"No hay platos con ventas y coste en el periodo seleccionado.\",\n    \"filterAll\": \"Todos los platos\",\n    \"quadrant\": {\n      \"dog\": \"Poco margen y ventas\",\n      \"plowhorse\": \"Volumen sin margen\",\n      \"puzzle\": \"Oportunidad\",\n      \"star\": \"Estrellas\"\n    },\n    \"quadrantDescription\": {\n      \"dog\": \"Menos margen y menos ventas\",\n      \"plowhorse\": \"Menos margen y más ventas\",\n      \"puzzle\": \"Más margen y menos ventas\",\n      \"star\": \"Más margen y ventas\"\n    },\n    \"groupCategory\": \"Categoría\",\n    \"groupFamily\": \"Familia\",\n    \"groupLocal\": \"Local\",\n    \"subtitle\": \"Popularidad frente a margen bruto de cada plato.\",\n    \"title\": \"Matriz de ventas y margen bruto\",\n    \"tooltip\": {\n      \"margin\": \"Margen\",\n      \"marginPerDish\": \"Margen/plato\",\n      \"salePrice\": \"PV\",\n      \"unitCost\": \"Coste\",\n      \"units\": \"Uds.\"\n    },\n    \"moreMargin\": \"Más margen\",\n    \"moreUnits\": \"Más unidades\",\n    \"dishCount_one\": \"{{count}} plato\",\n    \"dishCount_other\": \"{{count}} platos\",\n    \"filterActiveCount\": \"{{count}} filtros\",\n    \"filterFamilyCount\": \"{{value}} familias\",\n    \"filterSearchFamily\": \"Buscar familia\"\n  },\n  \"properties\": {\n    \"all\": \"Todos los locales\",\n    \"count_one\": \"{{count}} local\",\n    \"count_other\": \"{{count}} locales\",\n    \"emptyText\": \"No hay locales.\",\n    \"placeholder\": \"Todos los locales\",\n    \"searchPlaceholder\": \"Buscar locales\"\n  },\n  \"rankings\": {\n    \"infoAriaLabel\": \"Más información sobre {{title}}\",\n    \"bottomSubtitle\": \"Platos con menor margen sobre el precio de venta\",\n    \"bottomTitle\": \"Escandallos con menos margen\",\n    \"topSubtitle\": \"Platos con mayor margen sobre el precio de venta\",\n    \"col\": {\n      \"cost\": \"Coste\",\n      \"dish\": \"Plato\",\n      \"margin\": \"Margen\",\n      \"salePrice\": \"PV\",\n      \"units\": \"Uds.\"\n    },\n    \"empty\": \"No hay escandallos en el periodo seleccionado.\",\n    \"rowDetail\": \"Coste {{cost}} · PV {{salePrice}} · {{units}} uds.\",\n    \"showHigher\": \"Mayor\",\n    \"showLower\": \"Menor\",\n    \"subtitle\": \"Platos con menor y mayor margen sobre el precio de venta.\",\n    \"title\": \"Márgenes\",\n    \"topTitle\": \"Escandallos con más margen\"\n  },\n  \"status\": {\n    \"empty\": \"No hay ventas de platos con escandallo en el periodo seleccionado.\",\n    \"error\": \"No hemos podido cargar los escandallos.\",\n    \"loading\": \"Cargando escandallos...\"\n  },\n  \"tabs\": {\n    \"dishes\": \"Platos\",\n    \"menus\": \"Menús\",\n    \"modifiers\": \"Modificadores\",\n    \"posCatalog\": \"Catálogo TPV\",\n    \"preparations\": \"Preparaciones\",\n    \"summary\": \"Resumen\"\n  },\n  \"tabsView\": {\n    \"actions\": \"Acciones\",\n    \"article\": \"Artículo de venta\",\n    \"articlesCount_one\": \"{{count}} artículo\",\n    \"articlesCount_other\": \"{{count}} artículos\",\n    \"connectArticle\": \"Conectar con TPV\",\n    \"connectDish\": \"Conectar plato\",\n    \"link\": \"Escandallo / artículo\",\n    \"location\": \"Local\",\n    \"locationsCount_one\": \"{{count}} local\",\n    \"locationsCount_other\": \"{{count}} locales\",\n    \"metrics\": {\n      \"benefit\": \"Beneficio\",\n      \"cost\": \"Coste\",\n      \"margin\": \"Margen\",\n      \"pv\": \"PV\",\n      \"pvp\": \"PVP\"\n    },\n    \"modifierGroupsCount_one\": \"{{count}} grupo\",\n    \"modifierGroupsCount_other\": \"{{count}} grupos\",\n    \"modifiersCount_one\": \"{{count}} modificador\",\n    \"modifiersCount_other\": \"{{count}} modificadores\",\n    \"openLocation\": \"Abrir en local\",\n    \"search\": \"Buscar por nombre\",\n    \"state\": \"Estado\",\n    \"status\": {\n      \"connected\": \"Conectado\",\n      \"error\": \"Error\",\n      \"new\": \"Nuevo\",\n      \"pending\": \"Pendiente\"\n    },\n    \"unlinked\": \"Sin artículo conectado\",\n    \"filters\": {\n      \"sortName\": \"Nombre (A-Z)\",\n      \"sortPriceDesc\": \"Precio (mayor a menor)\",\n      \"sortPriceAsc\": \"Precio (menor a mayor)\",\n      \"connectionAll\": \"Todas las conexiones\",\n      \"connectionConnected\": \"Conectados\",\n      \"connectionUnconnected\": \"Sin conectar\"\n    }\n  },\n  \"uncategorized\": \"Sin categoría\",\n  \"coverage\": \"{{connected}}/{{total}} conectados\",\n  \"linkDialog\": {\n    \"alreadyLinked\": \"Ya conectado: {{name}}\",\n    \"connect\": \"Conectar\",\n    \"connectAnother\": \"Conectar otro artículo\",\n    \"disconnect\": \"Desconectar\",\n    \"error\": \"No se ha podido actualizar la conexión.\",\n    \"manageLink\": \"Gestionar\",\n    \"searchArticle\": \"Buscar artículo\",\n    \"searchDish\": \"Buscar plato\",\n    \"subtitle\": \"{{name}} · {{location}}\",\n    \"titleArticle\": \"Conectar con artículo de TPV\",\n    \"titleDish\": \"Conectar con plato\",\n    \"titleCombo\": \"Conectar con combo de TPV\",\n    \"searchCombo\": \"Buscar combo\"\n  },\n  \"andMore_one\": \"y {{count}} más\",\n  \"andMore_other\": \"y {{count}} más\",\n  \"usedInPrefix\": \"Usado en\",\n  \"notUsedInDishes\": \"Sin usar en platos\",\n  \"usedInDishes_one\": \"Usado en {{count}} plato\",\n  \"usedInDishes_other\": \"Usado en {{count}} platos\",\n  \"worst\": {\n    \"empty\": \"No hay platos con ventas y coste en el periodo seleccionado.\",\n    \"selectedSubtitle\": \"Menor margen total dentro de la selección\",\n    \"selectedTitle\": \"Menor margen\",\n    \"subtitle\": \"Menor margen total generado\",\n    \"title\": \"Platos con peor rendimiento\"\n  }\n}\n"
