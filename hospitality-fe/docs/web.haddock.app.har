            "mimeType": "application/json",
            "text": "{\n  \"breakdown\": {\n    \"categories\": {\n      \"drinks\": \"Bebidas\",\n      \"rawMaterials\": \"Materia prima\",\n      \"staff\": \"Personal\"\n    },\n    \"description\": \"Categorías por local · {{range}}\",\n    \"otherProperty\": \"Otros\",\n    \"title\": \"Desglose de gastos\"\n  },\n  \"breakdownTable\": {\n    \"columns\": {\n      \"category\": \"Categoría\",\n      \"total\": \"Total\"\n    },\n    \"empty\": \"No hay gastos en el periodo seleccionado.\",\n    \"noData\": \"Sin datos\",\n    \"noDataTooltip\": \"Sin gastos registrados en este local para el periodo seleccionado.\",\n    \"searchPlaceholder\": \"Buscar categoría, familia o subcategoría...\",\n    \"title\": \"Desglose de gastos de productos por local\",\n    \"viewDocuments\": \"Ver documentos de {{category}}\",\n    \"previousColumn\": \"Anterior\",\n    \"nextColumn\": \"Siguiente\"\n  },\n  \"comparison\": {\n    \"previousMonth\": {\n      \"label\": \"vs. mes anterior\",\n      \"shortLabel\": \"mes ant.\"\n    },\n    \"previousQuarter\": {\n      \"label\": \"vs. trimestre anterior\",\n      \"shortLabel\": \"trimestre ant.\"\n    },\n    \"previousYear\": {\n      \"label\": \"vs. año anterior\",\n      \"labelWithYear\": \"vs. año anterior\",\n      \"shortLabel\": \"año ant.\"\n    },\n    \"none\": {\n      \"label\": \"Sin comparación\",\n      \"shortLabel\": \"periodo\",\n      \"legend\": \"sin comparación\"\n    }\n  },\n  \"dates\": {\n    \"pendingRange\": \"Rango pendiente\",\n    \"selectDate\": \"Seleccionar fecha\",\n    \"selectDates\": \"Seleccionar fechas\"\n  },\n  \"emptyState\": {\n    \"title\": \"Sube tus documentos y controla tus gastos\",\n    \"description\": \"Verás tus facturas, tus albaranes y la evolución de tus costes, todo en orden.\",\n    \"action\": \"Subir documentos\"\n  },\n  \"hero\": {\n    \"subtitle\": \"Gastos consolidados de todos los locales seleccionados.\",\n    \"title\": \"Gastos\"\n  },\n  \"operatingMargin\": {\n    \"breakdown\": {\n      \"ebitda\": \"EBITDA\",\n      \"margin\": \"Margen operativo\",\n      \"noData\": \"Sin datos\",\n      \"operatingExpenses\": \"Gastos operativos\",\n      \"sales\": \"Ventas\",\n      \"staffCost\": \"Coste de personal\"\n    },\n    \"clickHint\": \"Haz clic en una barra para ver cómo se calcula\",\n    \"description\": \"Referencia: {{reference}} EBITDA sector · {{range}}\",\n    \"legend\": \"Margen operativo\",\n    \"sheet\": {\n      \"breakdownTitle\": \"Cómo se calcula\",\n      \"ebitdaFormula\": \"EBITDA = Ventas − Gastos operativos − Coste de personal\",\n      \"marginFormula\": \"Margen operativo = EBITDA ÷ Ventas × 100\",\n      \"noSales\": \"No hay ventas registradas en este periodo, por lo que el margen no se puede calcular.\",\n      \"reference\": \"Referencia del sector: {{reference}}\",\n      \"title\": \"Resumen del margen operativo\"\n    },\n    \"title\": \"Evolución del margen operativo\"\n  },\n  \"properties\": {\n    \"all\": \"Todos los locales\",\n    \"count_one\": \"{{count}} local\",\n    \"count_other\": \"{{count}} locales\",\n    \"emptyText\": \"No hay locales.\",\n    \"placeholder\": \"Todos los locales\",\n    \"searchPlaceholder\": \"Buscar locales\"\n  },\n  \"status\": {\n    \"error\": \"No hemos podido cargar los gastos.\",\n    \"loading\": \"Cargando gastos del grupo...\"\n  },\n  \"summary\": {\n    \"deltaComparison\": \"{{delta}} vs {{comparison}}\",\n    \"info\": {\n      \"grossMargin\": \"Margen bruto (ventas − coste de productos) del periodo seleccionado.\",\n      \"rawMaterialsAndDrinks\": \"Compras de materias primas y bebidas del periodo seleccionado.\",\n      \"rentCost\": \"Coste de alquiler del periodo seleccionado.\",\n      \"staffCost\": \"Coste de personal del periodo seleccionado.\"\n    },\n    \"infoAriaLabel\": \"Más información sobre {{title}}\",\n    \"metrics\": {\n      \"grossMargin\": \"Margen bruto\",\n      \"rawMaterialsAndDrinks\": \"Materias primas y bebidas\",\n      \"rentCost\": \"Coste alquiler\",\n      \"staffCost\": \"Coste personal\"\n    }\n  }\n}\n"
