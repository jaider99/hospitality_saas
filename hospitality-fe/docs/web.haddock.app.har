            "text": "{\n  \"action\": \"Acción\",\n  \"actions\": \"Acciones\",\n  \"actionTooltip\": \"Define qué hará el modificador cuando se seleccione\",\n  \"add\": \"Añadir\",\n  \"addModifierRule\": \"Añadir regla en el modificador\",\n  \"addPreparation\": \"Añadir preparación\",\n  \"addPreparationDescription\": \"Este modificador añadirá una preparación al plato original\",\n  \"addProduct\": \"Añadir producto\",\n  \"addProductDescription\": \"Este modificador añadirá un producto al plato original\",\n  \"addRule\": \"Añadir regla\",\n  \"addYourFirstRule\": \"Añade tu primera regla\",\n  \"alreadyUsed\": \"Ya utilizado\",\n  \"assignedDishes\": \"Platos asignados\",\n  \"configuredItemsWarningDescription\": \"Los siguientes elementos no tienen el precio o la unidad base configurados correctamente. Esta regla de modificador no calculará costes/consumo correctamente hasta que se configuren estos elementos:\",\n  \"configuredItemsWarningTitle\": \"no configurados correctamente\",\n  \"connectDish\": \"Conectar plato\",\n  \"connectProductOrPreparation\": \"Conectar producto o preparación\",\n  \"deleteModifierRule\": \"Eliminar regla en el modificador\",\n  \"deleteModifierRuleConfirmation\": \"¿Seguro que quieres eliminar esta regla?\",\n  \"editModifierRule\": \"Modificar regla en el modificador\",\n  \"emptyRulesList\": \"No hay reglas configuradas para este modificador\",\n  \"emptyRulesListDescription\": \"Añade tu primera regla para este modificador\",\n  \"extraPrice\": \"Precio extra\",\n  \"many\": \"Modificadores\",\n  \"modifier\": \"Modificador\",\n  \"modifierAction\": \"Acción del modificador\",\n  \"modifierCostLosingMoney\": \"El coste del modificador supera el incremento de precio aplicado al artículo, resultando en una pérdida\",\n  \"modifierGroup\": \"Grupo modificador\",\n  \"modifiers\": \"Modificadores\",\n  \"modifierWithoutRulesWarning\": \"Este modificador no tiene reglas de acción configuradas\",\n  \"noPreparationsFound\": \"No 