            "text": "{\n  \"addAdditionalDetails\": \"Add additional details\",\n  \"addContactEmail\": \"Add a contact email\",\n  \"addEmailToContact\": \"Add email to {{contact}}\",\n  \"chooseEmailContactTarget\": \"Choose where to add the email\",\n  \"contactNamePlaceholder\": \"e.g. Orders desk\",\n  \"contactNameRequired\": \"Enter a contact name\",\n  \"createNewContact\": \"Create a new contact\",\n  \"existingContact\": \"Existing contact\",\n  \"addContactPhone\": \"Add a contact phone number\",\n  \"additionalCosts\": \"Additional costs\",\n  \"additionalDiscounts\": \"Additional discounts\",\n  \"addWhatsAppGroupLink\": \"Add WhatsApp group link\",\n  \"whatsappGroupUrlPlaceholder\": \"https://chat.whatsapp.com/…\",\n  \"contactEmailPlaceholder\": \"supplier@email.com\",\n  \"contactPhonePlaceholder\": \"600 000 000\",\n  \"addSupplierContactInfoTitle\": \"Add details to send to the supplier\",\n  \"supplierContactInfoSaved\": \"Supplier details updated\",\n  \"attachedFile\": \"Attached: {{filename}}\",\n  \"code\": \"Code\",\n  \"code_tooltip\": \"You can only link DELIVERY NOTES or INVOICES. \",\n  \"comingSoonBannerTitle\": \"Coming soon: new improvements to order review\",\n  \"comingSoonBannerDescription\": \"We're still working on this page. You'll see improvements here very soon.\",\n  \"companyName\": \"Company name\",\n  \"confirmationAlert\": \"Confirm purchase order details\",\n  \"confirmationAlertChecked\": \"Review purchase order details\",\n  \"confirmDetails\": \"Confirm details\",\n  \"confirmEmailSend\": \"Confirm email send\",\n  \"contactEmail\": \"Contact Email\",\n  \"contactPerson\": \"Contact person\",\n  \"collapseProductFormats\": \"Collapse formats for {{product}}\",\n  \"createPurchaseGroup\": \"Create orders\",\n  \"deliverOn\": \"Delivery on\",\n  \"deliveryNoteDate\": \"Delivery note date\",\n  \"destinationAddress\": \"Destination address\",\n  \"email\": \"E-mail\",\n  \"emailFieldCc\": \"CC\",\n  \"emailFieldMessage\": \"Message\",\n  \"emailFieldSubject\": \"Subject\",\n  \"emailFieldTo\": \"For\",\n  \"emailSentFrom\": \"This email will be sent from {{email}}.\",\n  \"errorSavingPurchaseOrder\": \"Error saving order\",\n  \"errorSharingFileDescription\": \"Use the \\\"Download as PDF\\\" option\",\n  \"expandProductFormats\": \"Expand formats for {{product}}\",\n  \"missingPropertyAddressDescription\": \"Set your restaurant's address in Settings to share and download orders.\",\n  \"estimatedTotal\": \"Estimated total\",\n  \"estimatedTotal_desc\": \"Approx. According to latest purchases, prices with discount.\",\n  \"exitPurchaseOrder\": \"Don't worry! We'll save the draft of your order in \\\"Order History\\\".\",\n  \"finishOrder\": \"Finish order\",\n  \"shareOrderDescription\": \"Share the purchase order with your supplier. You can download the PDF or share it later from order history.\",\n  \"markAsSharedWarning\": \"When you mark the order as shared, you won't be able to edit it.\",\n  \"finishAndMarkAsShared\": \"Finish and mark as shared\",\n  \"manageOnMyOwn\": \"Manage on my own\",\n  \"shareWithAnotherApplication\": \"Share with another app\",\n  \"formatsCount_one\": \"{{count}} format\",\n  \"formatsCount_other\": \"{{count}} formats\",\n  \"historicEmptyState\": \"Here you will be able to see the order history. Create the first one from <strong>Suppliers</strong>.\",\n  \"historicEmptyTitle\": \"No orders yet\",\n  \"historyNoResultsDescription\": \"Try adjusting your filters or search to find the order you're looking for.\",\n  \"incidence_defectiveItem\": \"Defective product\",\n  \"incidence_incorrectQuantity\": \"Incorrect amount\",\n  \"incidence_notReceived\": \"Not received\",\n  \"invalidEmail\": \"The email address is invalid. Please verify your address.\",\n  \"isPurchaseOrderCorrect\": \"Order correct?\",\n  \"itemReceived\": \"{{quantity}} {{unitOfMeasure}} received\",\n  \"markAsShared\": \"Mark as shared\",\n  \"markingPurchaseOrderAsSharedDescript