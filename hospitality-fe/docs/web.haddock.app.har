            "mimeType": "application/json",
            "text": "{\n  \"addContactDetails\": \"Add contact details for {{supplierName}}\",\n  \"addContactsToCommunicate\": \"Add your contacts to communicate with them in just one click.\",\n  \"addFirstTag\": \"Add your first tag\",\n  \"Address\": \"Address (optional)\",\n  \"address\": \"Address\",\n  \"addSuppliers\": \"Add {{count}} suppliers\",\n  \"addTagsAndCategorize\": \"Add tags and categorize your suppliers\",\n  \"assignNotification\": \"You can now share suppliers between restaurants! Visit the help center link for more information.\",\n  \"assignReminder\": \"Remember that suppliers are shared between restaurants. By adding a new one, you can also assign it to other restaurants in the group.\",\n  \"assignSupplier\": \"Assign supplier\",\n  \"cantGroupVerifiedSuppliersDesc\": \"The company data for these suppliers has been verified, and therefore cannot be modified or combined. Please include only one verified supplier in your selection.\",\n  \"cantGroupVerifiedSuppliersTitle\": \"Multiple verified suppliers cannot be merged.\",\n  \"cantMergeVerified\": \"One of the selected providers has data verified by Haddock, and therefore cannot be unified with other providers.\",\n  \"categorizeSupplierDocuments\": \"All documents from <3>{{supplier}}</3>  will have the category \\\"<1>{{category}}</1>\\\"\",\n  \"categorizeSupplierDocuments_title\": \"Modify in all documents?\",\n  \"changeSupplierConfig\": \"Change supplier settings\",\n  \"changeSuppliersConfig\": \"Change provider settings\",\n  \"chooseHowInvoicesAreInConciliations\": \"Choose whether invoices from this supplier are displayed in the reconciliation view, and whether reconciliation attempts will be made.\",\n  \"comercialName\": \"Commercial name\",\n  \"confirmProductsSourceChange\": \"Confirm document type change\",\n  \"confirmProductsSourceChangeDescription\": \"Changing this setting will affect which documents are used to calculate product prices for this supplier. Product prices may change as a result.\",\n  \"commercialName\": \"Commercial name\",\n  \"completeFieldsImport\": \"Complete the fields (commercial name) in the following excel template and upload it in step 2.\",\n  \"conciliationBehaviorAlways\": \"Always show invoices for reconciliation (even if they don't have delivery notes)\",\n  \"conciliationBehaviorNever\": \"Do not show any invoices\",\n  \"conciliationBehaviorWithDN\": \"Show only invoices that have delivery notes\",\n  \"contactPreference\": \"Contact preference\",\n  \"contacts\": \"Contacts\",\n  \"controlSupplierPaymentMethods\": \"Control your supplier's payment methods and deadlines.\",\n  \"createConfirmation\": \"The supplier has been successfully created\",\n  \"createError\": \"An error occurred while creating the supplier\",\n  \"createSupplier\": \"Create supplier\",\n  \"createWithoutVAT\": \"Create without VAT\",\n  \"daysBeforeInvoiceData\": \"Number of days from invoice date\",\n  \"daysBeginningNextMonth\": \"Number of days beginning next month\",\n  \"deleteSupplier\": \"Delete supplier?\",\n  \"deleteSupplierExplanation\": \"To protect the digitised information, suppliers with assigned documents cannot be deleted. Edit the documents and assign them to another supplier for deletion.\",\n  \"deleteConfirmation\": \"Supplier deleted successfully\",\n  \"deleteSupplierError\": \"An error occurred while deleting the supplier\",\n  \"documentContextDescription\": \"Personalized instructions the OCR uses when extracting documents from this supplier.\",\n  \"documentContextError\": \"Could not update the document context\",\n  \"documentContextPlaceholder\": \"Write an instruction to guide document extraction for this supplier…\",\n  \"documentContextWarning\": \"⚠️ This field is not visible to the end user. Only the Haddock tech team should modify it.\",\n  \"editDocumentContext\": \"Edit document context\",\n  \"exportError\": \"An error occurred while exporting suppliers\",\n  \"exportSuccess\": \"Suppliers exported successfully\",\n  \"deleteSupplierSnackbar\": \"Edit the documents and assign them to another supplier for deletion.\",\n  \"documentsBelongSupplier\": \"YOU HAVE DOCUMENTS OR IMPORTED PRODUCTS THAT BELONG TO THIS SUPPLIER\",\n  \"ensureDetailsCorrect\": \"Ensure the data is correct, you will not be able to edit it down the line.\",\n  \"fiscalName\": \"Fiscal name\",\n  \"generalInfo\": \"General information\",\n  \"groupSupplier\": \"Group supplier\",\n  \"importSuppliers\": \"Import suppliers\",\n  \"importSuppliersExcel\": \"IMPORT SUPPLIERS WITH EXCEL\",\n  \"insertTitle\": \"Insert a title\",\n  \"invoicesAndDnReconciliation\": \"Invoices and delivery notes reconciliation\",\n  \"invoicesAndDnReconciliationDescription\": \"If this option is disabled, the documents (invoices, delivery notes and tickets) of this supplier are not shown as \\\" to be reconciled \\\". \",\n  \"makesDeliveriesOrInvoices\": \"Makes deliveries or I have invoice for the tickets\",\n  \"makesDeliveriesOrInvoicesDescription\": \"Knowing if this supplier delivers with delivery notes or if you ask invoice for your tickets, allows us to generate better reconciliation proposals and optimize your dashboard information.\",\n  \"modificationsApply\": \"The changes in name will apply to all the documents that have this supplier\",\n  \"modifyPaymentData\": \"Do you want to modify the payment data of the documents already created in the system for this supplier?\",\n  \"monthlyInArrears\": \"Monthly in arrears\",\n  \"multipleSuppliers\": \"Multiple suppliers\",\n  \"newContact\": \"New contact\",\n  \"newMerge\": \"New supplier merging\",\n  \"newNote\": \"New note\",\n  \"newSupplier\": \"New supplier\",\n  \"noContacts\": \"No contacts\",\n  \"noDocumentContext\": \"No instructions yet. Add one to guide the OCR's document extraction.\",\n  \"noSelection\": \"No selection\",\n  \"noTags\": \"No tags\",\n  \"notes\": \"Notes\",\n  \"numDaysConfiguration\": \"Number of days configuration\",\n  \"orderingInformativeBox\": \"Orders available for categories: raw materials, beverages, cleaning and consumable supplies.\",\n  \"paymentMethodDescription\": \"Choose the provider's default payment method\",\n  \"paymentTerms\": \"Payment terms\",\n  \"paymentTermsDescription\": \"Define the payment term based on days\",\n  \"position\": \"Position\",\n  \"provideDayOfTheMonth\": \"Provide day of the month\",\n  \"provideNumberOfDays\": \"Provide number of days\",\n  \"providePaymentTerms\": \"Provide the agreed payment term\",\n  \"purchaseContact\": \"Purchases contact\",\n  \"purchaseContactForm\": \"Main purchasing contact\",\n  \"finaContactForm\": \"Main contact for Fina\",\n  \"purchasesTabTitle\": \"Purchasing information\",\n  \"purchasesTabTitle_dayPickerLabel\": \"Delivery details\",\n  \"purchasesTabTitle_dayPickerSublable1\": \"Number of days delivery takes\",\n  \"purchasesTabTitle_dayPickerSublable1Tooltip\": \"Days the supplier takes to deliver a purchase once the order has been placed \",\n  \"purchasesTabTitle_dayPickerSublable2\": \"Week days on which delivery takes place\",\n  \"purchasesTabTitle_dayPickerSublable2Tooltip\": \"Supplier week delivery days\",\n  \"purchasesTabTitle_desc\": \"Capture information about your supplier in order to facilitate the creation of purchases.\",\n  \"purchasesTabTitle_timePicker\": \"Deadline for dispatch\",\n  \"purchasesTabTitle_timePickerTooltip\": \"Until what time can orders be placed with this supplier to arrive tomorrow.\",\n  \"reviewSuppliers\": \"Check your suppliers <2>here.</2>\",\n  \"searchAndSelect_placeholder\": \"Search and select supplier\",\n  \"searchByDescription\": \"Search by description\",\n  \"searchByFields\": \"Search by name, contact, VAT number, key words\",\n  \"searchingBBDD\": \"Searching in our database\",\n  \"searchOrTypeTag\": \"Search or type a new tag\",\n  \"seeDetailsFromSupplierExpenses\": \"You will be able to see the details of <2>{{label}}</2> from this supplier in products as well as in recipes.\",\n  \"selectSuppliersToMerge\": \"Select the suppliers you want to merge\",\n  \"selectSuppliersToMergeWith\": \"Select other suppliers to merge with\",\n  \"selectTag\": \"Select a tag\",\n  \"showProductsFrom\": \"Which documents do you want to calculate the prices from?\",\n  \"allDocuments\": \"All documents\",\n  \"similar\": \"Similar\",\n  \"specificMonthDay\": \"Specific day of the month\",\n  \"successAssigningSuppliers_body\": \"Find it in the list of suppliers\",\n  \"successAssigningSuppliers_title\": \"Successfully assigned provider\",\n  \"successfulMerged\": \"Suppliers successfully merged\",\n  \"supplierCode\": \"Supplier code\",\n  \"accountingAccount\": \"Accounting account\",\n  \"accountingAccountHelp\": \"Leave it empty to use the A3 generic account when exporting (default {{account}}).\",\n  \"accountingAccountInvalid\": \"Use 6 to 12 digits or leave it empty to use the A3 generic account.\",\n  \"sanitaryRegistrationNumberLabel\": \"Sanitary authorization or registry no.\",\n  \"supplierCount_one\": \"{{count}} supplier\",\n  \"supplierCount_other\": \"{{count}} suppliers\",\n  \"supplierCount\": \"{{count}} supplier\",\n  \"supplierDetails\": \"Supplier details\",\n  \"supplierInfo\": \"Supplier information\",\n  \"supplierIsVerified\": \"This supplier's company details have been verified by Haddock.\",\n  \"supplierSelected\": \"Supplier selected\",\n  \"supplierWithoutVAT\": \"Supplier without VAT number detected\",\n  \"supplierWithoutVAT_description\": \"Complete with VAT (companies) or DNI (self-employed). This allows the documents to be identified and assigned to the supplier automatically during the upload.\",\n  \"tags\": \"Tags\",\n  \"taxID\": \"NIF / CIF\",\n  \"toDeleteMakeSure\": \"To delete a supplier, make sure that you do not have any associated documents.\",\n  \"unknownSupplier\": \"Unknown supplier\",\n  \"updateError\": \"Error when updating supplier\",\n  \"vatID_error\": \"A 