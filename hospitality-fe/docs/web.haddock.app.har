            "text": "{\n  \"assign\": \"Assign\",\n  \"assignToProduct\": \"Assign to product\",\n  \"pendingToAssignTooltip\": \"Purchase pending to assign in a product\",\n  \"bannerTitle\": \"You have {{count}} unassigned purchases\",\n  \"bannerDescription\": \"Without assigning these product lines we cannot properly calculate inventory, cost breakdowns, or price evolution. A few minutes now save you discrepancies and manual work later.\",\n  \"bannerCta\": \"Assign now\",\n  \"assignmentTitle\": \"Assignment of pending purchase lines\",\n  \"noPendingItems\": \"No pending purchases\",\n  \"sessionCompleteTitle\": \"All done!\",\n  \"sessionCompleteDescription\": \"Summary of your assignment session\",\n  \"streak\": \"Streak {{count}} products\",\n  \"pending\": \"Pending\",\n  \"skipped\": \"Skipped\",\n  \"discarded\": \"Discarded\",\n  \"assigned\": \"Assigned\",\n  \"productsAssigned\": \"Products assigned\",\n  \"product\": \"Product\",\n  \"purchaseLineLabel\": \"Purchase line\",\n  \"editLineItemName\": \"Edit line item name\",\n  \"renameLineItemInputLabel\": \"Line item name\",\n  \"renameLineItemError\": \"Failed to save line item name.\",\n  \"productName\": \"Product name\",\n  \"productNamePlaceholder\": \"Enter product name\",\n  \"baseUnit\": \"Base Unit\",\n  \"formats\": \"Formats\",\n  \"formatsInfo\": \"Format used when this line was purchased.\",\n  \"noFormatsCreated\": \"No formats created for this product.\",\n  \"addFormatsToAssign\": \"To assign it, add formats\",\n  \"addNewFormat\": \"Add new format\",\n  \"skipForNow\": \"Skip for now\",\n  \"discard\": \"Discard\",\n  \"discardError\": \"Failed to discard purchase.\",\n  \"discardGroupConfirmTitle\": \"Discard the whole group?\",\n  \"discardGroupConfirmDescription\": \"This will discard {{count}} pending purchases in this group from the product assignment flow.\",\n  \"discardGroupConfirmAction\": \"Discard group\",\n  \"assignAndContinue\": \"Assign and continue\",\n  \"suggestedProducts\": \"Suggested products\",\n  \"confidenceHigh\": \"High match\",\n  \"confidenceMedium\": \"Medium match\",\n  \"confidenceLow\": \"Low match\",\n  \"yourProducts\": \"Your products\",\n  \"openPDF\": \"Open PDF\",\n  \"viewDocument\": \"View document in new tab\",\n  \"selectProduct\": \"Select a product\",\n  \"searchProducts\": \"Search products...\",\n  \"noProductsFound\": \"No products found\",\n  \"newProduct\": \"New product\",\n  \"new\": \"New\",\n  \"createNew\": \"Create new\",\n  \"createNewFormat\": \"Create new format\",\n  \"back\": \"Back\",\n  \"formatName\": \"Format name\",\n  \"copyLineItemName\": \"Copy line item name\",\n  \"lineItemNameCopied\": \"Line item name copied\",\n  \"purchaseLinesCount\": \"Purchase lines: {{count}}\",\n  \"pedido\": \"Order\",\n  \"inventario\": \"Inventory\",\n  \"addConversion\": \"Add conversion\",\n  \"selectFormats\": \"Select the formats to assign\",\n  \"noFormatsSelected\": \"No formats selected\",\n  \"draft\": \"Draft\",\n  \"draftFormatInUse\": \"This format cannot be removed because it is used as parent by another format\",\n  \"formatAlreadyExists\": \"This format already exists. Select it from the list instead.\",\n  \"cancel\": \"Cancel\",\n  \"save\": \"Save\",\n  \"loadingNextItem\": \"Loading next item...\",\n  \"assignError\": \"Failed to assign purchase.\",\n  \"noPropertySelected\": \"No property selected.\",\n  \"fillProductDetails\": \"Please fill in product name and base unit.\",\n  \"autoCategoryInfo\": \"Category will be assigned automatically\",\n  \"moveToProduct\": \"Move to another product\",\n  \"editProduct\": \"Edit product\",\n  \"unlinkPurchase\": \"Unlink purchase\",\n  \"unlinkPurchaseConfirmTitle\": \"Unlink purchase?\",\n  \"unlinkPurchaseConfirmDescription\": \"The purchase will remain unassigned and will stop counting for this product.\",\n  \"unassignSuccess\": \"Purchase unlinked successfully.\",\n  \"unassignError\": \"Failed to unlink purchase.\",\n  \"analyzingMessage\": \"Generating suggestions, please wait…\",\n  \"suggestionFeedback\": {\n    \"positiveButtonLabel\": \"Correct suggestion\",\n    \"negativeButtonLabel\": \"Incorrect suggestion\",\n    \"positivePopoverLabel\": \"What did you like about this suggestion?\",\n    \"positivePopoverPlaceholder\": \"E.g. correct product, right name, well-detected unit...\",\n    \"negativePopoverLabel\": \"What is wrong with this suggestion?\",\n    \"negativePopoverPlaceholder\": \"E.g. wrong product, wrong format, unrelated unit...\",\n    \"sent\": \"Feedback sent successfully\",\n    \"error\": \"Could not send feedback\"\n  },\n  \"createProduct\": \"Create new product\",\n  \"saveProduct\": \"Create product\",\n  \"navigation\": {\n    \"previousPendingPurchase\": \"Go to previous pending purchase\",\n    \"nextPendingPurchase\": \"Go to next pending purchase\"\n  },\n  \"legacyBaseUnitBlocked\": {\n    \"title\": \"Legacy base unit not allowed\",\n    \"description\": \"The base unit {{baseUnit}} is not allowed in this flow. Choose kg, ud, or l to continue.\"\n  },\n  \"unsavedChanges\": {\n    \"title\": \"Leave without assigning?\",\n    \"description\": \"If you leave now, you'll lose the assignment you're making.\",\n    \"keepEditing\": \"Keep editing\",\n    \"discardAndExit\": \"Leave without saving\"\n  },\n  \"tour\": {\n    \"intro\": {\n      \"title\": \"Let's do a quick tour\",\n      \"description\": \"With the new purchase-line assignment modal, you'll create a clean, usable product list for inventory and ordering with the right formats.\",\n      \"start\": \"Start\",\n      \"skip\": \"Not now\"\n    },\n    \"relaunch\": \"View guide again\",\n    \"steps\": {\n      \"purchaseLineHeader\": {\n        \"title\": \"Review the purchase line.\",\n        \"description\": \"You'll need to assign it to a product. The next time we read this purchase line, it will be automatically integrated into that product.\"\n      },\n      \"productSelector\": {\n        \"title\": \"Choose the product.\",\n        \"description\": \"AI will suggest a product to integrate the purchase line into. It can be a new product or one from the Haddock library (with image).\"\n      },\n      \"formatsSection\": {\n        \"title\": \"Choose the format.\",\n        \"description\": \"AI will suggest the format in which you buy that purchase line. Remove any formats that are not needed.\"\n      },\n      \"footerActions\": {\n        \"title\": \"Finish the assignment.\",\n        \"description\": \"Assign if you're confident, skip if you're unsure, or discard if you don't want to create that product.\"\n      }\n    }\n  }\n}\n"
          },
