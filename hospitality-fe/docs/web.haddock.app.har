            "text": "{\n  \"addIncident\": \"Añadir incidencia\",\n  \"addReasonError\": \"Introduce el motivo de la incidencia\",\n  \"amountDifference\": \"Diferencia de importe\",\n  \"anyDifference\": \"Hay algún desajuste? Falta algún documento?\",\n  \"bankTransactionFallbackName\": \"Transacción bancaria\",\n  \"bankTransactionType\": \"Transacción\",\n  \"chooseReason\": \"Selecciona el motivo de la incidencia\",\n  \"chooseSeverity\": \"Selecciona la prioridad\",\n  \"chooseState\": \"Selecciona el estado\",\n  \"closeNewIncident\": \"¿Cerrar nueva incidencia?\",\n  \"contactSupplier\": \"Contactar proveedor\",\n  \"create-incidents\": \"Crear incidencias\",\n  \"createdBy\": \"Creada por\",\n  \"createdIn\": \"Incidencia creada en\",\n  \"createIncident\": \"Crear incidencia\",\n  \"deleteIncidentExplanation\": \"Marca el estado “resuelta” para mantener la incidencia asociada al documento. Si eliminas la incidencia se desvinculará de su documento de compra.\",\n  \"deleteIncidentExplanation_resolved\": \"Si eliminas la incidencia se desvinculará de su documento de compra.\",\n  \"descriptionPlaceholder\": \"Notas de la incidencia. Añade más detalles de cuál ha sido el motivo de la incidencia\",\n  \"discrepancy\": \"Discrepancia\",\n  \"documentsIncidents\": \"Incidentes relacionados con documentos\",\n  \"documentUpload\": \"Subida de documento\",\n  \"emailAt\": \"a las\",\n  \"emailAttachmentCount\": \"{{count}} archivo adjunto\",\n  \"emailAttachmentCount_plural\": \"{{count}} archivos adjuntos\",\n  \"emailAttachmentsList\": \"Lista de archivos adjuntos\",\n  \"emailBody\": \"Cuerpo del mensaje\",\n  \"emailFrom\": \"Emisor\",\n  \"emailHidePreviousMessages\": \"Ocultar mensajes anteriores\",\n  \"emailMessage\": \"Mensaje\",\n  \"emailShowPreviousMessages\": \"Mostrar mensajes anteriores\",\n  \"emailSubject\": \"Asunto\",\n  \"emailTo\": \"Para\",\n  \"emailTypeReceived\": \"Correo recibido\",\n  \"emailTypeSent\": \"Correo enviado\",\n  \"explainControl\": \"Registra y controla los errores de las compras: precios y descuentos no aplicados, artículos defectuosos o no entregados...\",\n  \"faultyGoods\": \"Productos en mal estado\",\n  \"handleLaterOn\": \"Puedes ver, editar y gestionar la incidencia más tarde desde la pantalla incidencias.\",\n  \"highSeverity\": \"Alta\",\n  \"incidentCreated\": \"Incidencia creada\",\n  \"incidentFrom\": \"Incidencia de\",\n  \"incidentNotes\": \"Notas de la incidencia\",\n  \"incidentReason\": \"Motivo incidencia\",\n  \"incidentState\": \"Estado\",\n  \"incidentStatusFilter\": \"Filtro estado de la incidencia\",\n  \"incidentType\": \"Tipo de incidencia\",\n  \"incidentTypeFilter\": \"Filtro tipo de incidencia\",\n  \"incorretPrice\": \"Precios incorrectos\",\n  \"lowSeverity\": \"Baja\",\n  \"mediumSeverity\": \"Media\",\n  \"missingDiscount\": \"Descuentos no aplicados\",\n  \"missingDocuments\": \"Faltan documentos\",\n  \"missingInvoice\": \"Falta factura\",\n  \"missingProducts\": \"Faltan artículos\",\n  \"unorderedProducts\": \"Productos no pedidos\",\n  \"mostRecentFirst\": \"Más reciente arriba\",\n  \"mostUrgentFirst\": \"Más grave arriba\",\n  \"multipleReason\": \"Múltiples razones\",\n  \"noConnectedAccount\": \"Asegúrate de que tienes una cuenta de correo conectada\",\n  \"noIncidentsYet\": \"No tienes incidencias\",\n  \"noIncidentsYetDescription\": \"Crea incidencias en tus pedidos, documentos y durante el proceso de conciliación para controlar los desajustes en precios y descuentos, falta de documentos...\",\n  \"noRecipientEmail\": \"No hay email de destinatario disponible\",\n  \"noSeverity\": \"Sin prioridad\",\n  \"other\": \"Otros\",\n  \"pendingResponse\": \"Pendiente de respuesta\",\n  \"pendingReview\": \"Pendiente de revisión\",\n  \"placeholderDetails\": \"Introduce más detalles de esta incidencia\",\n  \"purchaseIncidents\": \"Incidencias de compra\",\n  \"purchaseOrdersIncidents\": \"Incidentes relacionados con pedidos\",\n  \"reason\": \"Motivo\",\n  \"reconciliationPreviousDescription\": \"Descripción anterior\",\n  \"reconciliationUnsuccessfulDialogDescription\": \"Cambios en la descripción\",\n  \"reconciliationUnsuccessfulDialogTitle\": \"Detalles del intento de conciliación\",\n  \"reconciliationUnsuccessfulPreview\": \"La descripción del incidente se ha actualizado.\",\n  \"reconciliationUpdatedDescription\": \"Descripción actualizada\",\n  \"relatedTransaction\": \"Transacción asociada\",\n  \"reportedbyFilter\": \"Filtro reportado por\",\n  \"searchByIncident\": \"Busca por incidente, proveedor...\",\n  \"searchPlaceholder\": \"Busca por proveedor, motivo, trabajador\",\n  \"seeDocRelated\": \"Ver documento asociado\",\n  \"seeIncident\": \"Ver incidencia\",\n  \"seeNonResolvedIncidents\": \"Ver incidencias no resueltas\",\n  \"seeResolvedIncidents\": \"Ver incidencias resueltas\",\n  \"severity\": \"Prioridad\",\n  \"statusCreated\": \"Nuevo\",\n  \"statusInProgress\": \"En curso\",\n  \"statusResolved\": \"Resuelto\",\n  \"statusType\": \"Estado de la incidencia\",\n  \"statusTypeCreated\": \"Creada\",\n  \"statusTypeResolved\": \"Resuelta\",\n  \"statusUnderReview\": \"Requieren revisión\",\n  \"successfulyCreated\": \"Incidencia creada correctamente\",\n  \"timelineDocumentUploaded\": \"Archivo subido\",\n  \"timelineEmailReceived\": \"El proveedor respondió\",\n  \"timelineEmailSent\": \"Se envió un correo\",\n  \"timelineEmailSuggested\": \"Fina sugirió un correo\",\n  \"timelineEmptyDescription\": \"Cuando el estado del incidente cambie, verás su historial aquí.\",\n  \"timelineEmptyTitle\": \"Sin actividad registrada todavía\",\n  \"timelineErrorDescription\": \"Comprueba tu conexión o vuelve a intentarlo en unos segundos.\",\n  \"timelineErrorTitle\": \"No se pudo cargar el historial del incidente\",\n  \"timelineGenericEvent\": \"Evento registrado\",\n  \"timelineGenericEventDescription\": \"Se registró un evento en la incidencia.\",\n  \"timelineReconciliationUnsuccessful\": \"Se ha in