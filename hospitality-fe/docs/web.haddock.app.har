            "mimeType": "application/json",
            "text": "{\n  \"documentRejectionReasonPasswordProtected\": \"Password protected document\",\n  \"documentRejectionReasonScanFailed\": \"We had a problem scanning the document\",\n  \"documentRejectionReasonUnresolvedProperty\": \"We could not associate the document with a restaurant\",\n  \"documentRejectionReasonUnsupportedFileType\": \"Unsupported file type\",\n  \"documentsProcessedBody\": \"Great news! Your documents have been processed successfully.\",\n  \"documentsProcessedTitle\": \"Documents processed\",\n  \"finaBankReconciliationSummaryDescription\": \"On {{date}} I reconciled {{movements}} and opened {{incidents}}.\",\n  \"finaBankReconciliationSummaryDescriptionNoIncidents\": \"On {{date}} I reconciled {{movements}}.\",\n  \"finaBankReconciliationSummaryIncidents_one\": \"{{count}} missing-invoice incident\",\n  \"finaBankReconciliationSummaryIncidents_other\": \"{{count}} missing-invoice incidents\",\n  \"finaBankReconciliationSummaryMovements_one\": \"{{count}} bank movement\",\n  \"finaBankReconciliationSummaryMovements_other\": \"{{count}} bank movements\",\n  \"finaBankReconciliationSummaryTitle\": \"Bank reconciliation summary\",\n  \"finaConciliationSuccessDescription_one\": \"I've reconciled {{count}} document: {{documentsText}}. Reconciled amount: {{conciliatedAmount}}.\",\n  \"finaConciliationSuccessDescription_other\": \"I've reconciled {{count}} documents: {{documentsText}}. Reconciled amount: {{conciliatedAmount}}.\",\n  \"finaConciliationSuccessTitle\": \"I've successfully completed the reconciliation\",\n  \"finaDigitalizationSuccessDescription\": \"One of your received documents has been successfully digitized.\",\n  \"finaDigitalizationSuccessTitle\": \"Digitization completed\",\n  \"finaDigitalizationValidationFailedAdditionalReasons_one\": \"{{count}} additional reason\",\n  \"finaDigitalizationValidationFailedAdditionalReasons_other\": \"{{count}} additional reasons\",\n  \"finaDigitalizationValidationFailedDescription\": \"I've detected that one of your documents could not be automatically validated. Please review the document.\",\n  \"finaDigitalizationValidationFailedFixAction\": \"Fix document\",\n  \"finaDigitalizationValidationFailedReasonsAction_one\": \"View reason\",\n  \"finaDigitalizationValidationFailedReasonsAction_other\": \"View reasons\",\n  \"finaDigitalizationValidationFailedTitle\": \"I have a document pending review\",\n  \"finaDocumentsAction_one\": \"View document\",\n  \"finaDocumentsAction_other\": \"View documents\",\n  \"finaDocumentsAdditionalDocuments_one\": \"{{count}} additional document\",\n  \"finaDocumentsAdditionalDocuments_other\": \"{{count}} additional documents\",\n  \"finaDocumentsCollectedDescription_one\": \"Document uploaded to haddock.\",\n  \"finaDocumentsCollectedDescription_other\": \"Documents uploaded to haddock.\",\n  \"finaDocumentsCollectedTitle_one\": \"I've collected {{count}} document successfully\",\n  \"finaDocumentsCollectedTitle_other\": \"I've collected {{count}} documents successfully\",\n  \"finaDocumentsRejectedDescription_one\": \"I've found errors while collecting the following documents:\",\n  \"finaDocumentsRejectedDescription_other\": \"I've found errors while collecting the following documents:\",\n  \"finaDocumentsRejectedDescriptionWithReason_one\": \"Review the rejected document: {{documentsText}}. Highlighted reason: {{firstReason}}.\",\n  \"finaDocumentsRejectedDescriptionWithReason_other\": \"Review {{count}} rejected documents: {{documentsText}}. Highlighted reason: {{firstReason}}.\",\n  \"finaDocumentsRejectedPrimaryReason\": \"Main reason: {{reason}}\",\n  \"finaDocumentsRejectedDialogDescription\": \"Check the reasons why I rejected your documents.\",\n  \"finaDocumentsRejectedDialogTitle\": \"My rejection reasons\",\n  \"finaDocumentsRejectedTitle_one\": \"I've rejected {{count}} document\",\n  \"finaDocumentsRejectedTitle_other\": \"I've rejected {{count}} documents\",\n  \"finaDocumentsRejectedUnknownDocumentName\": \"Untitled document\",\n  \"finaDocumentsRejectedUnknownReason\": \"Unknown reason\",\n  \"finaExpenseExportSentDescription_one\": \"I sent {{count}} document for {{period}} to {{recipients}}.\",\n  \"finaExpenseExportSentDescription_other\": \"I sent {{count}} documents for {{period}} to {{recipients}}.\",\n  \"finaExpenseExportSentTitle\": \"I sent the accountant export\",\n  \"finaFallbackDescription\": \"Review recent activity for more details.\",\n  \"finaFallbackTitle\": \"I'm sending a {{type}} notification\",\n  \"finaMissingInvoicesAdditionalSuppliers_one\": \"+ {{count}} more supplier\",\n  \"finaMissingInvoicesAdditionalSuppliers_other\": \"+ {{count}} more suppliers\",\n  \"finaNegativeDiscrepancyDescription\": \"I've detected a shortfall of {{discrepancyAmount}}. Review the incident to resolve it.\",\n  \"finaNegativeDiscrepancyTitle\": \"I've detected an unfavorable discrepancy\",\n  \"finaNotFoundDocumentsDescription\": \"To reconcile the invoice, please upload the missing documents.\",\n  \"finaNotFoundDocumentsDescription_one\": \"I couldn't locate the document: {{documentsText}}. Review the pending items.\",\n  \"finaNotFoundDocumentsDescription_other\": \"I couldn't locate {{count}} documents: {{documentsText}}. Review the pending items.\",\n  \"finaNotFoundDocumentsFallbackDescription\": \"To reconcile the invoice, please upload the missing documents.\",\n  \"finaNotFoundDocumentsFallbackTitle\": \"I couldn't reconcile the invoice due to missing documents.\",\n  \"finaNotFoundDocumentsTitle\": \"I couldn't reconcile {{supplierName}}'s invoice from {{invoiceDate}} because documents are missing.\",\n  \"finaNotFoundDocumentsTitle_one\": \"I couldn't find {{count}} document\",\n  \"finaNotFoundDocumentsTitle_other\": \"I couldn't find {{count}} documents\",\n  \"finaOrphanDeliveryNotesDescription_one\": \"{{count}} delivery note from {{suppliersCount}} supplier is still missing its invoice.\",\n  \"finaOrphanDeliveryNotesDescription_other\": \"{{count}} delivery notes from {{suppliersCount}} suppliers are still missing their invoices.\",\n  \"finaOrphanDeliveryNotesDialogDescription\": \"The following delivery notes are missing their corresponding invoices. Click on each document to view details.\",\n  \"finaOrphanDeliveryNotesDialogTitle\": \"Delivery notes pending invoice\",\n  \"finaOrphanDeliveryNotesTitle_one\": \"I've detected {{count}} supplier without invoice in {{monthName}} for a total of {{totalAmount}}\",\n  \"finaOrphanDeliveryNotesTitle_other\": \"I've detected {{count}} suppliers without invoice in {{monthName}} for a total of {{totalAmount}}\",\n  \"finaPositiveDiscrepancyDescriptionFallback\": \"Review the reconciled amounts.\",\n  \"finaPositiveDiscrepancyDescriptionWithAmount\": \"I’ve detected a difference in favor of +{{discrepancyAmount}}.\",\n  \"finaPositiveDiscrepancyTitle\": \"I've detected a positive discrepancy\",\n  \"finaSupplementaryExpenseExportSentDescription_one\": \"I sent {{count}} late-arriving document amending {{period}} to {{recipients}}.\",\n  \"finaSupplementaryExpenseExportSentDescription_other\": \"I sent {{count}} late-arriving documents amending {{period}} to {{recipients}}.\",\n  \"finaSupplementaryExpenseExportSentTitle\": \"I sent a supplementary accountant export\",\n  \"uploadDocumentsReminderBody\": \"{{name}}, upload documents today to get visibility on your restaurant's margin.\",\n  \"uploadDocumentsReminderTitle\": \"haddock misses you\"\n}\n"
