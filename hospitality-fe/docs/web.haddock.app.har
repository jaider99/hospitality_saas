            "mimeType": "application/json",
            "text": "{\n  \"author\": \"Author\",\n  \"availableSoon\": \"We are working hard to make it available as soon as possible.\",\n  \"baseUnit\": \"individual units\",\n  \"baseUnitTooltip\": \"This is the most basic unit of conversion that we extract directly from the product configuration screen.\",\n  \"changePlural\": \"changes\",\n  \"changeSingle\": \"change\",\n  \"closingInventory\": \"Closing\",\n  \"confirmDeleteTitle\": \"Are you sure you want to delete this inventory?\",\n  \"connectPosBanner\": \"It is necessary to connect your POS to record sales and calculate the theoretical inventory.\",\n  \"editInventory\": \"Edit inventory\",\n  \"editList\": \"Edit list\",\n  \"emptyStateDescription\": \"There is no inventory yet. Create your first inventory now.\",\n  \"establishment\": \"Establishment\",\n  \"exportInventory\": \"Export inventory\",\n  \"exportInventoryDescriptionExcel\": \"Exports the inventory with the current data for editing.\",\n  \"exportInventoryDescriptionPDF\": \"Exports the inventory with blank fields to be filled in manually.\",\n  \"exportInventoryError\": \"Inventory export failed. Please try again later.\",\n  \"exportLast\": \"Export last inventory\",\n  \"final\": \"Closing stock\",\n  \"goToInventories\": \"Go to inventories\",\n  \"hasInitialInventory\": \"With real inventory\",\n  \"haveEditedProducts\": \"You have edited ({{count}}) products\",\n  \"initial\": \"Opening stock\",\n  \"initialInventorySourceTooltip\": \"Value obtained from {{name}} inventory dated {{date}}. Purchased, sold, and wasted quantities are calculated from that date.\",\n  \"inventoriesDescription\": \"Organise your stocks more efficiently\",\n  \"inventoryDate\": \"Inventory date\",\n  \"inventoryDateTooltip\": \"The inventory date must be between your last inventory and today to maintain accurate CoGS calculations\",\n  \"inventoryHistory\": \"Inventory history\",\n  \"inventoryHistory_description\": \"View and export the total cost of the inventory for your administrator in one click including all sections of this inventory.\",\n  \"inventoryName\": \"Inventory name\",\n  \"inventoryOf\": \"Inventory of\",\n  \"inventoryTiming\": \"Timing\",\n  \"inventoryTimingTooltip\": \"Opening inventory: count at start of day. Closing inventory: count at end of day.\",\n  \"inventoryWithoutProducts\": \"There are no products in this inventory\",\n  \"inWarehouse\": \"In warehouse\",\n  \"lastInventory\": \"Last inventory\",\n  \"loadingHistory\": \"Loading inventory history...\",\n  \"loadInventoryError\": \"There was an error loading your inventory\",\n  \"missingConsumedQuantity\": \"It is necessary to have stocks to calculate consumption.\",\n  \"missingDeviationQuantity\": \"It is necessary to have the amount consumed to calculate the variance.\",\n  \"missingInitialQuantity\": \"It is necessary to create an inventory to obtain accurate information.\",\n  \"missingSoldQuantity\": \"This product has not yet been linked to a POS item.\",\n  \"multipleProductFormatsTooltip\": \"{{count}} product formats. Click to expand and select items individually.\",\n  \"multipleSuppliersTooltip\": \"Merged product. The {{count}} different products within this grouping will be added to the inventory.\",\n  \"newInventory\": \"New inventory\",\n  \"newVersion\": \"New version\",\n  \"newVersion_current\": \"Keep quantities\",\n  \"newVersion_empty\": \"Reset quantities to 0\",\n  \"newVersion_resume\": \"Resume draft\",\n  \"draftBanner\": \"You have unsaved changes from a previous session\",\n  \"draftBanner_resume\": \"Resume\",\n  \"draftBanner_discard\": \"Discard\",\n  \"noPurchaseHistory\": \"No purchases\",\n  \"notEnoughDocs\": \"Not enough documents\",\n  \"notEnoughDocs_description\": \"To be able to access Inventories you must have at least 30 documents and have uploaded 15 during the last 30 days.\",\n  \"openInventory\": \"Open inventory\",\n  \"openingInventory\": \"Opening\",\n  \"optionUnavailable\": \"Sorry, this option is not available yet.\",\n  \"pastInventories\": \"Past inventories\",\n  \"pastInventories_description\": \"Inventories are shown in order of export from most recent to least recent\",\n  \"performantTheoreticalInventoryLastChanges\": \"Updated, last changes: {{date}}\",\n  \"posSales\": \"POS sales\",\n  \"printList\": \"Print list\",\n  \"purchasesSinceLastInventory\": \"Purchases from the last inventory onwards\",\n  \"product\": \"product\",\n  \"purchaseFormatTooltip\": \"This is the format extracted from the delivery note or invoice that comes from the supplier.\",\n  \"purchaseUnits\": \"purchase units\",\n  \"quantity\": \"Quantity\",\n  \"salesSinceLastInventory\": \"Sales from the last inventory onwards\",\n  \"salesSinceInventoryDate\": \"Sales since the {{name}} inventory dated {{date}}.\",\n  \"waste\": \"Waste\",\n  \"wasteSinceLastInventory\": \"Waste from the last inventory onwards\",\n  \"searchByName\": \"Search by name\",\n  \"searchInventory\": \"Search for an inventory per month\",\n  \"searchProducts\": \"Search products in this inventory\",\n  \"selectInventoryTiming\": \"Select timing...\",\n  \"stockHeld\": \"Stock held\",\n  \"thankYou\": \"Thank you for your patience.\",\n  \"theoretical\": \"Theoretical inventory\",\n  \"theoreticalInventoryDateRangeInfo\": \"Theoretical inventory calculates quantities from the last real inventory of each product. Purchases, sales, and waste are counted from that date.\",\n  \"totalInventoryValue\": \"Total inventory value\",\n  \"totalInventoryValueTooltip\": \"This value is calculated using the product prices when the inventory version was saved.\",\n  \"totalPrice\": \"Total price\",\n  \"totalUnits\": \"Total units\",\n  \"unitConversionTooltip\": \"Unit of measure conversion is done using conversion to base unit.\",\n  \"units\": \"Units\",\n  \"warehouse\": \"warehouse\",\n  \"weightedAverageCalculation\": \"Calculated using the weighted average price of the product.\",\n  \"withoutStock\": \"Without stock\",\n  \"reason\": \"Reason\",\n  \"itemType\": \"Item type\",\n  \"itemType.product\": \"Product\",\n  \"itemType.dish\": \"Dish\",\n  \"wasteRecordReason.theft\": \"Theft\",\n  \"wasteRecordReason.broken\": \"Broken\",\n  \"wasteRecordReason.personal\": \"Personal consumption\",\n  \"wasteRecordReason.expiration\": \"Expiration\",\n  \"searchByProductOrDish\": \"Search by product or dish name\",\n  \"editWasteRecord\": \"Edit\",\n  \"deleteWasteRecord\": \"Delete\",\n  \"newWasteRecord\": \"New waste\",\n  \"filterWasteRecordsDescription\": \"Filter waste by date, type, and reason\",\n  \"registerWasteRecord\": \"Register waste\",\n  \"registerWasteDescription\": \"Record inventory losses due to theft, breakage, personal consumption, or expiration\",\n  \"selectItem\": \"Select an item\",\n  \"selectReason\": \"Select a reason\",\n  \"wasteDate\": \"Waste date\",\n  \"selectWasteDate\": \"Select waste date\",\n  \"notes\": \"Notes\",\n  \"notesPlaceholder\": \"Add any additional details about this waste...\",\n  \"wasteRecordCreatedSuccess\": \"Waste registered successfully\",\n  \"wasteRecordCreatedError\": \"Failed to register waste. Please try again.\",\n  \"validationProductRequired\": \"Product is required\",\n  \"validationDishRequired\": \"Dish is required\",\n  \"validationQuantityPositive\": \"Quantity must be greater than 0\",\n  \"validationUnitRequired\": \"Unit of measure is required\",\n  \"validationReasonRequired\": \"Reason is required\",\n  \"deleteWasteConfirmation\": \"Are you sure you want to delete the waste for {{name}}?\",\n  \"wasteRecordDeletedSuccess\": \"Waste deleted successfully\",\n  \"wasteRecord\": \"waste\",\n  \"editWasteTitle\": \"Edit waste\",\n  \"editWasteDescription\": \"Update the reason, quantity, or notes for this waste\",\n  \"wasteRecordUpdatedSuccess\": \"Waste updated successfully\",\n  \"wasteRecordUpdatedError\": \"Failed to update waste. Please try again.\",\n  \"wasteRecordIngredients\": \"Ingredients affected\",\n  \"ingredientName\": \"Ingredient\",\n  \"lostQuantity\": \"Lost quantity\",\n  \"noIngredients\": \"No ingredients found\",\n  \"noWasteRecordsFound\": \"No waste records found\",\n  \"noWasteRecordsFoundDescription\": \"There are no waste records matching the selected filters. Try adjusting the filters or register a new waste record.\",\n  \"resetFilters\": \"Clear filters\",\n  \"registerWaste\": \"Register waste\",\n  \"resetConfirmTitle\": \"Reset all quantities?\",\n  \"resetConfirmDescription\": \"This will set all {{count}} products and dishes to 0. Your current inventory value is {{value}}. You can still edit individual quantities before saving.\",\n  \"resetConfirmButton\": \"Reset to 0\",\n  \"bulkZeroWarningTitle\": \"Most quantities set to 0\",\n  \"bulkZeroWarningDescription\": \"You are about to save {{count}} items with quantity 0. Make sure this is intentional.\",\n  \"saveStaleDraftError\": \"Some inventory products have changed. Your pending changes were discarded — please re-enter the quantities.\",\n  \"preparationProductions\": {\n    \"tab\": \"Productions\",\n    \"newProduction\": \"New production\",\n    \"registerProduction\": \"Register production\",\n    \"registerProductionDescription\": \"Record the quantity produced for a local preparation. The unit is taken from the selected preparation.\",\n    \"preparation\": \"Preparation\",\n    \"selectPreparation\": \"Select preparation\",\n    \"searchPreparation\": \"Search preparations\",\n    \"noPreparationsFound\": \"No preparations found\",\n    \"quantityProduced\": \"Produced quantity\",\n    \"producedAt\": \"Produced at\",\n    \"stockEffectsInfo\": \"Preparation productions add stock to the selected preparation and consume its ingredients in theoretical inventory.\",\n    \"emptyTitle\": \"No preparation productions found\",\n    \"emptyDescription\": \"Register a production when the central kitchen finishes preparing a local preparation.\",\n    \"errorTitle\": \"Could not load preparation productions\",\n    \"errorDescription\": \"Try refreshing the page or check the filters.\",\n    \"createSuccess\": \"Preparation production registered successfully\",\n    \"createError\": \"Failed to register preparation production. Please try again.\",\n    \"cancelProduction\": \"Cancel production\",\n    \"cancelProductionTitle\": \"Cancel preparation production\",\n    \"cancelProductionDescription\": \"Explain why the production for {{name}} must be cancelled.\",\n    \"cancellationReason\": \"Cancellation reason\",\n    \"cancellationReasonPlaceholder\": \"Describe why this production is being cancelled\",\n    \"cancelSuccess\": \"Preparation production cancelled successfully\",\n    \"cancelError\": \"Failed to cancel preparation production. Please try again.\",\n    \"validationPreparationRequired\": \"Select a preparation\",\n    \"validationProducedAtRequired\": \"Select production date and time\",\n    \"status\": {\n      \"completed\": \"Completed\",\n      \"cancelled\": \"Cancelled\"\n    }\n  },\n  \"transfers\": {\n    \"emptyTitle\": \"No transfers yet\",\n    \"emptyDescription\": \"Record a transfer of product formats or preparations to another property in this group. Inventory levels update once the transfer is confirmed.\",\n    \"lineSummary_one\": \"{{count}} line\",\n    \"lineSummary_other\": \"{{count}} lines\",\n    \"newTransfer\": \"New transfer\",\n    \"createTitle\": \"New transfer\",\n    \"createDescription\": \"Move stock to another venue in this group.\",\n    \"sourceProperty\": \"Source property\",\n    \"targetProperty\": \"Destination property\",\n    \"targetPropertyPlaceholder\": \"Select destination\",\n    \"noTargetProperties\": \"There are no other properties in this group available for transfers.\",\n    \"noAuthorizedTargetProperties\": \"No destination properties are available for this transfer because you need permission to create inventories in the destination property.\",\n    \"lines\": \"Lines\",\n    \"lineTitle\": \"Line {{number}}\",\n    \"lineType\": \"Type\",\n    \"productFormat\": \"Product format\",\n    \"preparation\": \"Preparation\",\n    \"item\": \"Item\",\n    \"itemPlaceholder\": \"Select item\",\n    \"itemSearchPlaceholder\": \"Search products or preparations\",\n    \"productSearchPlaceholder\": \"Search product formats\",\n    \"preparationSearchPlaceholder\": \"Search preparations\",\n    \"noProductFormatsFound\": \"No product formats found\",\n    \"noPreparationsFound\": \"No preparations found\",\n    \"noItemsFound\": \"No products or preparations found\",\n    \"addLine\": \"Add line\",\n    \"removeLine\": \"Remove\",\n    \"quantity\": \"Quantity\",\n    \"createSuccess\": \"Transfer recorded successfully\",\n    \"createError\": \"Failed to create transfer. Please try again.\",\n    \"status\": {\n      \"draft\": \"Draft\",\n      \"sent\": \"Sent\",\n      \"received\": \"Received\",\n      \"cancelled\": \"Cancelled\"\n    },\n    \"outgoingTab\": \"Outgoing\",\n    \"incomingTab\": \"Incoming\",\n    \"outgoingEmptyTitle\": \"No outgoing transfers\",\n    \"outgoingEmptyDescription\": \"Send stock to another venue.\",\n    \"incomingEmptyTitle\": \"No incoming transfers\",\n    \"incomingEmptyDescription\": \"Incoming transfers will appear here.\",\n    \"receive\": \"Receive\",\n    \"send\": \"Send\",\n    \"cancelTransfer\": \"Cancel transfer\",\n    \"viewOlder\": \"View older\",\n    \"receivedAt\": \"Received at\",\n    \"sentAt\": \"Sent at\",\n    \"createdAt\": \"Created at\",\n    \"sendSuccess\": \"Transfer sent successfully\",\n    \"sendError\": \"Failed to send transfer. Please try again.\",\n    \"receiveSuccess\": \"Transfer received successfully\",\n    \"receiveError\": \"Failed to receive transfer. Please try again.\",\n    \"cancelSuccess\": \"Transfer cancelled successfully\",\n    \"cancelError\": \"Failed to cancel transfer. Please try again.\",\n    \"validation\": {\n      \"i