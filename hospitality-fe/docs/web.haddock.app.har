            "text": "{\n  \"amountOffCouponBlocksAnchor\": \"Disabled: fixed-amount coupons cannot be combined with billing anchored to the 1st of month (Stripe limitation). Use a percentage coupon to enable this option.\",\n  \"billingInfo\": {\n    \"loading\": \"Loading billing information...\",\n    \"loadError\": \"Error loading billing information\",\n    \"title\": \"Stripe billing information\",\n    \"tooltip\": \"This information is stored in our database and synchronised from Stripe\",\n    \"viewInStripe\": \"View in Stripe\",\n    \"legalName\": \"Legal name\",\n    \"billingAddress\": \"Billing address\",\n    \"vatCode\": \"VAT ID\",\n    \"notProvided\": \"Not provided\",\n    \"incompleteWarning\": \"Billing information incomplete. Missing {{field}}. Update it in Stripe before creating the payment link.\",\n    \"missingBothFields\": \"billing address and VAT ID\",\n    \"missingAddress\": \"billing address\",\n    \"missingVatCode\": \"VAT ID\",\n    \"incompleteShort\": \"Incomplete billing info — update in Stripe before charging.\"\n  },\n  \"billingStarts1stOfMonth\": \"Billing cycle starts on 1st of month\",\n  \"cannotImpersonateYourself\": \"Cannot impersonate yourself\",\n  \"copy\": \"Copy\",\n  \"createPaymentLink\": \"Create payment link\",\n  \"currentlyActingAs\": \"Currently Acting As\",\n  \"emailEdit\": {\n    \"activeStatus\": \"ACTIVE\",\n    \"cancel\": \"Cancel\",\n    \"cannotChangeSelfEmailDescription\": \"You cannot change your own email address through the admin interface. Please use your account settings.\",\n    \"cannotChangeSelfEmailTitle\": \"Cannot Change Own Email\",\n    \"confirmEmailChangeTitle\": \"Confirm Email Change\",\n    \"currentEmailLabel\": \"Current Email\",\n    \"editEmailTooltip\": \"Edit email address\",\n    \"emailAlreadyInUseDescription\": \"This email address is already being used by another user. Please choose a different email address.\",\n    \"emailAlreadyInUseTitle\": \"Email Already In Use\"