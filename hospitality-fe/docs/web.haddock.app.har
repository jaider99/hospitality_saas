            "text": "{\n  \"allStepsCompleted\": \"All steps completed!\",\n  \"billingEntity\": \"Billing entity\",\n  \"billingEntityNumber\": \"Billing entity {{number}}\",\n  \"billingInformationHelper\": \"This information will appear on your invoices and helps us create the right legal entities.\",\n  \"createNewBillingEntity\": \"Create new billing entity\",\n  \"firstSteps\": \"FIRST STEPS\",\n  \"fiscalName\": \"Fiscal name\",\n  \"fiscalNameRequired\": \"Fiscal name is required\",\n  \"fiscalNamePlaceholder\": \"My Restaurant Ltd.\",\n  \"home\": {\n    \"advantages\": \"<strong>Advantages:</strong>\",\n    \"downloadApp\": \"Download haddock to your mobile\",\n    \"downloadSteps\": \"Follow these simple steps to get haddock from your mobile:\",\n    \"emailUpload\": \"Send your invoices by email\",\n    \"firstUploads\": \"Upload your first 10 delivery notes\",\n    \"firstUploadsDescription\": \"To start your haddock adventure, we need you to upload 10 delivery notes from your main suppliers. This way you will start to see all that haddock can show you with only 10 delivery notes on the platform!\",\n    \"getReady\": \"Get ready to take full control of your business with haddock\",\n    \"haddockDescription\": \"<strong>haddock</strong> is the first solution that helps you <strong>increase the profitability of your business</strong> by providing you with the information you need at all times.\",\n    \"howWorks\": \"We want to help you improve the profitability of your business by providing you with the information you need at all times.\\nTake a look at this short video to discover what haddock can do for you. \\nBefore we start, we need your attention for no more than 2 minutes.\",\n    \"howWorksTitle\": \"How it works\",\n    \"intro\": \"Intro to haddock\",\n    \"inviteEmployees\": \"Invite your first employees\",\n    \"inviteEmployeesDescription\": \"This will allow you to be much more efficient, as your employees will be able to help you with tasks such as uploading documents to haddock.\",\n    \"knowhaddock\": \"Get to know haddock\",\n    \"moreInfoHelpCenter\": \"More information in our\",\n    \"nextStep\": \"Go to the next section to continue\",\n    \"supportAccess\": \"Access our support center for more detailed and visual information:\",\n    \"uploadByEmail\": \"Send your documents or ask your supplier to forward them to:\",\n    \"welcome\": \"Welcome to the haddock community, are you ready to get started?\"\n  },\n  \"holdingName\": \"Holding name\",\n  \"holdingNameDescription\": \"All tax entities created in this signup will be grouped under the same holding.\",\n  \"holdingNameRequired\": \"Holding name is required\",\n  \"holdingNameTitle\": \"Holding\",\n  \"markAsComplete\": \"Mark as complete\",\n  \"propertyCreationError\": \"Failed to create restaurant. Please check your data and try again.\",\n  \"selectBillingEntity\": \"Select a billing entity\",\n  \"selectedBillingEntity\": \"Selected billing entity\",\n  \"stepsLeft_one\": \"{{count}} step left\",\n  \"stepsLeft_other\": \"{{count}} steps left\",\n  \"taxIdRequired\": \"Tax ID is required\",\n  \"venueInformation\": \"Venue Information\",\n  \"groupNeedsRestaurant\": \"Each group needs at least one restaurant.\",\n  \"operationalGroupNeedsRestaurant\": \"Each operational group needs at least one restaurant.\",\n  \"invalidFiscalEntityReference\": \"The selected billing entity is no longer available.\"\n}\n"
          },
