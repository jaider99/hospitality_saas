            "text": "{\n  \"badSupportExperience\": \"We had a bad experience with support or attention\",\n  \"BOMComplexity\": \"Complexity for making BOMs\",\n  \"chooseAnotherSolution\": \"Did you choose another solution?\",\n  \"chooseProperty\": \"Select a restaurant\",\n  \"closedOrTransferred\": \"We are closing, transferring, or changing owners\",\n  \"closingReason\": \"What happened with your business closure?\",\n  \"dataErrors\": \"Low reliability of the extracted data\",\n  \"definitivelyClosed\": \"Final closure of the restaurant\",\n  \"demoSetWrongExpectations\": \"The demo generated expectations that were later not met.\",\n  \"difficultyUsing\": \"Difficulty of use or unintuitive experience\",\n  \"dontKnowHowItWorks\": \"I don't understand how haddock works\",\n  \"duplicatedOrMisgroupedProducts\": \"Products appear duplicated or incorrectly grouped\",\n  \"expectationsNotMet\": \"haddock did not meet my expectations\",\n  \"expensiveTool\": \"It is an expensive tool\",\n  \"externalReasons\": \"Internal reasons for my business (unrelated to haddock)\",\n  \"foundCheaperAlternative\": \"We have found a cheaper alternative\",\n  \"frequentDataErrors\": \"Common errors in data (in documents, dashboards, etc.)\",\n  \"functionalitiesDoNotCoverNeeds\": \"Current features do not meet our needs\",\n  \"groupManagement\": \"Group Vision / Group Management\",\n  \"hardToNavigate\": \"It's hard to find what we're looking for or navigate the tool.\",\n  \"highCost\": \"The price does not fit our budget or use\",\n  \"highDigitisationTime\": \"Digitization time is very high\",\n  \"highPriceReason\": \"Why do you think the price is high?\",\n  \"HRManagement\": \"HR management\",\n  \"iHaveFinancialIssues\": \"I have financial problems and can't afford it\",\n  \"integrationIssues\": \"Technical problems or limitations with integrations\",\n  \"inventories\": \"Inventories\",\n  \"issueNotResolvedOrVague\": \"They didn't solve our problem or gave us a vague answer.\",\n  \"keyFeaturesMissing\": \"Key features for our workflow are missing\",\n  \"lackFollowupOnboarding\": \"Lack of follow-up and support during initial training\",\n  \"lackOfSupport\": \"I have not received the necessary support to implement haddock\",\n  \"lackOfTime\": \"We don't have enough time or staff to use the tool.\",\n  \"lackOfTimeForTeam\": \"There is no one with the time or profile to lead the adoption of haddock\",\n  \"lackOfTimeForTools\": \"We don't have time to incorporate new tools right now.\",\n  \"lackOfTimeMissingPerson\": \"The assigned person is no longer with the company or did not continue with the tool\",\n  \"missingAssumedIntegrations\": \"Key integrations that were assumed to be available were missing\",\n  \"missingERPIntegration\": \"You are not integrated with my ERP\",\n  \"missingFeatures\": \"I miss more features\",\n  \"missingPOSIntegration\": \"You are not integrated with my POS\",\n  \"missingValuableFeatures\": \"The tool does not offer functions that really add value to us.\",\n  \"moreDetails\": \"Can you give us a little more detail?\",\n  \"needMoreFeatures\": \"I need more features\",\n  \"newOwnerContact\": \"Can you share with us the contact of the new owner?\",\n  \"noAnotherSolution\": \"No, I'll stop doing it.\",\n  \"notEnoughSupport\": \"I did not have enough support\",\n  \"noTimeImplementing\": \"I did not spend time implementing it\",\n  \"notMobileFriendly\": \"It is not well adapted to mobile or small screens\",\n  \"Other\": \"Other\",\n  \"otherSolutionPreferred\": \"I prefer using other solution\",\n  \"permanentlyClosed\": \"Permanently closed\",\n  \"priceTooHigh\": \"Price is too high\",\n  \"productIssues\": \"Problems with the product or technology\",\n  \"reconciliationTooManual\": \"Document reconciliation requires too much manual intervention\",\n  \"reducedCosts\": \"We have reduced expenses and eliminated non-essential tools\",\n  \"restaurantClosed\": \"I am closing my restaurant\",\n  \"salesDemoMismatch\": \"What we saw in sales/demo was not reflected in the real product\",\n  \"seeYouSoon\": \"We hope to see you again.\",\n  \"shareAnything\": \"Share what you want to like with us\",\n  \"slowResponseTimes\": \"It took them a long time to respond to our messages.\",\n  \"solutionChosen\": \"What other solution have you chosen?\",\n  \"requestAccountCancellation\": \"Request account cancellation\",\n  \"cancelSubscription\": \"Cancel subscription\",\n  \"submitError\": \"We could not complete the automatic cancellation. Please contact support.\",\n  \"alreadySubmitted\": \"A cancellation request has already been submitted for this restaurant.\",\n  \"supportNotReceived\": \"I did not receive the expected support\",\n  \"systemNotSupported\": \"Our current system is not compatible or supported\",\n  \"takeAMoment\": \"We are very sorry that we did not meet your expectations.\",\n  \"thankYou\": \"Thank you for answering our questions!\",\n  \"tooManyErrors\": \"I can't trust the system to extract precise information because I've identified several errors\",\n  \"transferredProperty\": \"The restaurant has been transferred or sold\",\n  \"unclearExplanationsOrDocs\": \"The explanations and/or documentation are not clear\",\n  \"unmetExpectations\": \"Expectations, sales process and/or support\",\n  \"unstableIntegrations\": \"Unstable integrations or data synchronization errors\",\n  \"unusedModules\": \"I don't use all the modules so it seems expensive to me\",\n  \"validationTooManual\": \"The validation module forces us to review too many cases by hand\",\n  \"whatHasHappenedInYourBusiness\": \"What has happened in your business?\",\n  \"whichExpectationsUnmet\": \"What expectations have we not met?\",\n  \"whichFeaturesYouMiss\": \"Which features do you miss?\",\n  \"whichProductIssues\": \"What main problem have you had?\",\n  \"whichProperty\": \"Which restaurant do you want to cancel?\",\n  \"whyAreYouCanceling\": \"Why do you want to 