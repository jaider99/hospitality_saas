            "mimeType": "application/json",
            "text": "{\n  \"title\": \"Product Changelog\",\n  \"description\": \"Novedades de producto publicadas para clientes y revisión interna.\",\n  \"modes\": {\n    \"user\": \"Usuario\",\n    \"admin\": \"Admin\"\n  },\n  \"areas\": {\n    \"fina\": \"Fina\",\n    \"haddock_hr\": \"haddock HR\"\n  },\n  \"card\": {\n    \"negativeFeedbackAria\": \"Feedback negativo\",\n    \"positiveFeedbackAria\": \"Feedback positivo\",\n    \"readLess\": \"Leer menos\",\n    \"readMore\": \"Leer más\"\n  },\n  \"empty\": {\n    \"noResults\": \"No hay novedades publicadas para esta búsqueda.\"\n  },\n  \"feedback\": {\n    \"cancel\": \"Cancelar\",\n    \"description\": \"Tu opinión nos ayuda a priorizar mejor las próximas novedades.\",\n    \"dialogCloseLabel\": \"Cerrar\",\n    \"dialogPrompt\": \"Cuéntanos qué esperabas de esta mejora o qué cambiarías\",\n    \"dialogTitle\": \"¿Qué te ha faltado?\",\n    \"inlineTitle\": \"Ayúdanos a mejorar\",\n    \"placeholder\": \"¿Qué es lo que te faltó de esta mejora?\",\n    \"placeholderDialog\": \"Escribe tu opinión aquí\",\n    \"submit\": \"Enviar\",\n    \"submitting\": \"Enviando...\"\n  },\n  \"hero\": {\n    \"description\": \"Estamos siempre trabajando para que tu negocio de restauración siga creciendo con nosotros\",\n    \"title\": \"Novedades de haddock\"\n  },\n  \"nav\": {\n    \"label\": \"Novedades\"\n  },\n  \"search\": {\n    \"label\": \"Buscar novedades\",\n    \"placeholder\": \"Buscar por módulos de haddock...\"\n  },\n  \"states\": {\n    \"loadError\": \"No se han podido cargar las novedades.\",\n    \"retry\": \"Reintentar\",\n    \"retrying\": \"Reintentando...\"\n  },\n  \"tabs\": {\n    \"allWithCount\": \"Todas ({{count}})\",\n    \"areaWithCount\": \"{{area}} ({{count}})\"\n  },\n  \"toasts\": {\n    \"feedbackError\": \"No se ha podido enviar el feedback.\",\n    \"feedbackSuccess\": \"Gracias por tu feedback.\"\n  },\n  \"user\": {\n    \"emptyTitle\": \"No hay novedades publicadas\",\n    \"emptyDescription\": \"Cuando haya novedades listas para clientes aparecerán aquí.\",\n    \"errorTitle\": \"No se ha podido cargar el changelog\",\n    \"errorDescription\": \"Revisa que el changelog esté activado para este restaurante.\"\n  },\n  \"admin\": {\n    \"queueTitle\": \"Cola de revisión\",\n    \"create\": \"Crear novedad\",\n    \"createDraft\": \"Guardar borrador\",\n    \"preview\": \"Vista previa\",\n    \"accept\": \"Aceptar\",\n    \"edit\": \"Editar\",\n    \"save\": \"Guardar\",\n    \"publish\": \"Publicar\",\n    \"unpublish\": \"Despublicar\",\n    \"reject\": \"Rechazar\",\n    \"acceptSuccess\": \"Borrador aceptado.\",\n    \"updateSuccess\": \"Novedad actualizada.\",\n    \"updateError\": \"No se ha podido actualizar la novedad.\",\n    \"publishSuccess\": \"Novedad publicada.\",\n    \"unpublishSuccess\": \"Novedad despublicada.\",\n    \"rejectSuccess\": \"Novedad rechazada.\",\n    \"actionError\": \"No se ha podido aplicar la acción.\",\n    \"createSuccess\": \"Borrador creado.\",\n    \"createError\": \"No se ha podido crear el borrador.\",\n    \"emptyTitle\": \"No hay novedades en este filtro\",\n    \"emptyDescription\": \"Cambia el filtro o crea una novedad.\",\n    \"errorTitle\": \"No se ha podido cargar el modo admin\",\n    \"errorDescription\": \"Revisa permisos o inténtalo de nuevo.\",\n    \"noSelectionTitle\": \"Selecciona una novedad\",\n    \"noSelectionDescription\": \"El detalle y la vista previa aparecerán aquí.\",\n    \"filterLabel\": \"Filtrar novedades de revisión\",\n    \"areaMissing\": \"Falta área\",\n    \"assignAreaBeforePublish\": \"Asigna un área antes de publicar.\",\n    \"filters\": {\n      \"active\": \"Borradores y bloqueadas\",\n      \"rejected\": \"Rechazadas\",\n      \"published\": \"Publicadas\",\n      \"all\": \"Todas\"\n    },\n    \"actionDialog\": {\n      \"reasonLabel\": \"Motivo interno (opcional)\",\n      \"reasonPlaceholder\": \"Añade contexto para auditoría\",\n      \"accept\": {\n        \"title\": \"Aceptar bloqueada\",\n        \"description\": \"La novedad pasará a borrador oculto para poder publicarla después.\",\n        \"confirm\": \"Aceptar\"\n      },\n      \"publish\": {\n        \"title\": \"Publicar borrador\",\n        \"description\": \"La novedad será visible para clientes en el changelog publicado.\",\n        \"confirm\": \"Publicar\"\n      },\n      \"unpublish\": {\n        \"title\": \"Despublicar novedad\",\n        \"description\": \"La novedad dejará de ser visible para clientes y volverá a borrador.\",\n        \"confirm\": \"Despublicar\"\n      },\n      \"reject\": {\n        \"title\": \"Rechazar novedad\",\n        \"description\": \"La novedad saldrá de la cola activa y quedará registrada como rechazada.\",\n        \"confirm\": \"Rechazar\"\n      }\n    },\n    \"status\": {\n      \"draft\": \"Borrador\",\n      \"blocked\": \"Bloqueada\",\n      \"published\": \"Publicada\",\n      \"rejected\": \"Rechazada\"\n    },\n    \"tags\": {\n      \"new_feature\": \"Nueva funcionalidad\",\n      \"improvement\": \"Mejora\",\n      \"automation\": \"Automatización\",\n      \"integration\": \"Integración\",\n      \"ai\": \"IA\"\n    },\n    \"createDialog\": {\n      \"title\": \"Crear novedad\",\n      \"description\": \"Se guardará como borrador oculto y se publicará desde la vista previa.\",\n      \"titleField\": \"Título\",\n      \"summaryField\": \"Resumen\",\n      \"detailsField\": \"Detalles\",\n      \"areaField\": \"Área\",\n      \"areaPlaceholder\": \"Selecciona un área\",\n      \"releaseDateField\": \"Fecha de novedad\",\n      \"tagsField\": \"Tipo de novedad\",\n      \"tagsPlaceholder\": \"Selecciona tipos\"\n    }\n  }\n}\n"
