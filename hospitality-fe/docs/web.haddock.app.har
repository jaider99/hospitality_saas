            "text": "{\n  \"chart\": {\n    \"current\": \"Actual\",\n    \"empty\": \"No hay datos para el periodo seleccionado.\",\n    \"expenses\": \"Gastos\",\n    \"marginPercent\": \"Margen %\",\n    \"marginToggle\": \"Ver margen\",\n    \"pendingRange\": \"Rango pendiente\",\n    \"previousExpenses\": \"Gastos {{comparison}}\",\n    \"previousMarginPercent\": \"Margen % {{comparison}}\",\n    \"previousSales\": \"Ventas {{comparison}}\",\n    \"sales\": \"Ventas\",\n    \"salesVsExpenses\": \"Ventas vs Gastos\",\n    \"showMarginAriaLabel\": \"Mostrar margen en el gráfico\"\n  },\n  \"comparison\": {\n    \"previousMonth\": {\n      \"chartLabel\": \"Comparativa mensual\",\n      \"label\": \"vs. mes anterior\",\n      \"legend\": \"mes anterior\",\n      \"shortLabel\": \"mes ant.\"\n    },\n    \"previousQuarter\": {\n      \"chartLabel\": \"Comparativa trimestral\",\n      \"label\": \"vs. trimestre anterior\",\n      \"legend\": \"trimestre anterior\",\n      \"shortLabel\": \"trimestre ant.\"\n    },\n    \"previousSemester\": {\n      \"shortLabel\": \"semestre ant.\"\n    },\n    \"previousYear\": {\n      \"chartLabel\": \"Comparativa anual\",\n      \"label\": \"vs. año anterior\",\n      \"labelWithYear\": \"vs. año anterior ({{year}})\",\n      \"legend\": \"año anterior\",\n      \"legendWithYear\": \"año anterior ({{year}})\",\n      \"shortLabel\": \"año ant.\"\n    },\n    \"none\": {\n      \"shortLabel\": \"periodo\",\n      \"label\": \"Sin comparación\",\n      \"legend\": \"sin comparación\"\n    }\n  },\n  \"dates\": {\n    \"selectDate\": \"Selecciona fecha\",\n    \"selectDates\": \"Selecciona fechas\"\n  },\n  \"filters\": {\n    \"currencyMode\": \"Mostrar importes en euros\",\n    \"customizeAriaLabel\": \"Personalizar vista\",\n    \"displayModeAriaLabel\": \"Modo de visualización\",\n    \"info\": \"Cambia el periodo, la comparación y los locales incluidos en la vista de grupo.\",\n    \"infoAriaLabel\": \"Información sobre los filtros\",\n    \"percentMode\": \"Mostrar porcentajes sobre costes\"\n  },\n  \"noData\": \"Sin datos\",\n  \"emptyState\": {\n    \"title\": \"Sube tus documentos y ve el resumen de tu grupo\",\n    \"description\": \"Verás tus ventas, tus costes y tus márgenes de todos tus locales en un vistazo.\",\n    \"action\": \"Subir documentos\"\n  },\n  \"hero\": {\n    \"subtitle\": \"Tu grupo de restaurantes en un vistazo\",\n    \"title\": \"Te damos la bienvenida a haddock\"\n  },\n  \"properties\": {\n    \"all\": \"Todos los locales\",\n    \"count_one\": \"{{count}} local\",\n    \"count_other\": \"{{count}} locales\",\n    \"emptyText\": \"No hay locales.\",\n    \"placeholder\": \"Locales\",\n    \"previousAmount\": \"ant. {{amount}}\",\n    \"searchPlaceholder\": \"Buscar locales\"\n  },\n  \"metrics\": {\n    \"beverageCost\": \"Coste bebidas\",\n    \"margin\": \"Margen Bruto\",\n    \"rawMaterialCost\": \"Coste materia prima\",\n    \"sales\": \"Ventas\",\n    \"staffCost\": \"Coste personal\"\n  },\n  \"status\": {\n    \"error\": \"No hemos podido cargar el resumen.\",\n    \"loading\": \"Cargando el resumen del grupo...\"\n  },\n  \"summary\": {\n    \"beverageCostInfo\": \"Compras de bebidas del periodo seleccionado.\",\n    \"deltaComparison\": \"{{delta}} vs {{comparison}}\",\n    \"infoAriaLabel\": \"Más información sobre {{title}}\",\n    \"rawMaterialCostInfo\": \"Compras de materias primas del periodo seleccionado.\",\n    \"salesInfo\": \"Ventas totales del grupo en el periodo seleccionado.\",\n    \"staffCostInfo\": \"Coste de personal del periodo seleccionado.\"\n  }\n}\n"
