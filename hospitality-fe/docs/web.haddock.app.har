            "text": "{\n  \"dates\": {\n    \"selectDate\": \"Select date\",\n    \"selectDates\": \"Select dates\"\n  },\n  \"distribution\": {\n    \"description\": \"Total spend distribution — top 9 suppliers\",\n    \"empty\": \"No supplier spend in the selected period.\",\n    \"others\": \"Others\",\n    \"title\": \"Total spend by supplier\"\n  },\n  \"evolution\": {\n    \"description\": \"Last 6 months — top 5 suppliers by volume\",\n    \"empty\": \"No supplier spend in the selected period.\",\n    \"title\": \"Supplier spend evolution\"\n  },\n  \"emptyState\": {\n    \"title\": \"Add your suppliers and keep them at hand\",\n    \"description\": \"You'll see their contacts, their payment terms and how much you spend with each one.\",\n    \"action\": \"Add supplier\"\n  },\n  \"hero\": {\n    \"subtitle\": \"Supplier spend consolidated across all selected locations.\",\n    \"title\": \"Suppliers\"\n  },\n  \"list\": {\n    \"columns\": {\n      \"category\": \"Category\",\n      \"lastInvoice\": \"Last invoice\",\n      \"locations\": \"Locations\",\n      \"products\": \"Products\",\n      \"supplier\": \"Supplier\",\n      \"totalSpend\": \"Total spend\"\n    },\n    \"empty\": \"No suppliers found for the selected filters.\",\n    \"export\": \"Export\",\n    \"newSupplier\": \"New supplier\",\n    \"noLastInvoice\": \"No invoice\",\n    \"searchPlaceholder\": \"Search suppliers\",\n    \"selectSupplier\": \"Select {{supplier}}\",\n    \"supplierCount_one\": \"{{count}} supplier\",\n    \"supplierCount_other\": \"{{count}} suppliers\",\n    \"uncategorized\": \"Uncategorized\",\n    \"verifiedSupplier\": \"Verified supplier\"\n  },\n  \"properties\": {\n    \"all\": \"All locations\",\n    \"count_one\": \"{{count}} location\",\n    \"count_other\": \"{{count}} locations\",\n    \"emptyText\": \"No locations.\",\n    \"placeholder\": \"All locations\",\n    \"searchPlaceholder\": \"Search locations\"\n  },\n  \"ranking\": {\n    \"columns\": {\n      \"coverage\": \"Locations with purchases\",\n      \"spend\": \"Spend\",\n      \"supplier\": \"Supplier\"\n    },\n    \"coverage\": \"{{withSpend}}/{{total}} locations\",\n    \"coveragePurchases\": \"{{withSpend}}/{{total}} locations with purchases\",\n    \"coverageShort\": \"{{withSpend}}/{{total}}\",\n    \"empty\": \"No supplier spend in the selected period.\",\n    \"locationsWithoutSpend_one\": \"{{count}} location without purchases\",\n    \"locationsWithoutSpend_other\": \"{{count}} locations without purchases\",\n    \"paginationNext\": \"Next\",\n    \"paginationPrevious\": \"Previous\",\n    \"showing\": \"Showing {{from}}–{{to}} of {{total}}\",\n    \"subtitle_one\": \"{{count}} supplier · sorted by spend\",\n    \"subtitle_other\": \"{{count}} suppliers · sorted by spend\",\n    \"title\": \"Supplier spend ranking\",\n    \"unknownSupplier\": \"Unknown supplier\"\n  },\n  \"status\": {\n    \"error\": \"We couldn't load the suppliers.\",\n    \"loading\": \"Loading suppliers...\"\n  },\n  \"tabs\": {\n    \"summary\": \"Summary\",\n    \"suppliers\": \"Suppliers\"\n  },\n  \"total\": {\n    \"distributionLabel\": \"Supplier spend distribution\",\n    \"empty\": \"No supplier spend in the selected period.\",\n    \"rest_one\": \"Rest ({{count}} more)\",\n    \"rest_other\": \"Rest ({{count}} more)\",\n    \"summary\": \"{{suppliers}} suppliers · {{locations}} locations\",\n    \"title\": \"Total supplier spend\"\n  },\n  \"volume\": {\n    \"amount\": \"Spend\",\n    \"description\": \"Ranking by accumulated subtotal\",\n    \"empty\": \"No supplier spend in the selected period.\",\n    \"title\": \"Top suppliers by purchase volume\"\n  }\n}\n"
