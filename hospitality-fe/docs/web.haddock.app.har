            "mimeType": "application/json",
            "text": "{\n  \"phoneNumbers\": \"Números de teléfono\",\n  \"phoneNumbersSubtitle\": \"Las facturas, tickets y albaranes que envíes por WhatsApp desde estos números se digitalizan automáticamente.\",\n  \"addPhoneNumber\": \"Añadir número de teléfono\",\n  \"phoneNumber\": \"Número de teléfono\",\n  \"phoneNumberPlaceholder\": \"612 345 678\",\n  \"noPhoneNumbers\": \"Aún no hay números de teléfono\",\n  \"deletePhoneNumberConfirmation\": \"¿Estás seguro de que quieres eliminar este número de teléfono?\",\n  \"phoneNumberCreated\": \"Número de teléfono creado\",\n  \"phoneNumberCreationError\": \"Error al crear el número de teléfono\",\n  \"phoneNumberAlreadyExists\": \"Este número de teléfono ya está registrado\",\n  \"phoneNumberDeleted\": \"Número de teléfono eliminado\",\n  \"phoneNumberDeletionError\": \"Error al eliminar el número de teléfono\",\n  \"bannerTitle\": \"Digitaliza documentos por WhatsApp\",\n  \"bannerDescription\": \"Enlaza tu número de teléfono y envíanos tus albaranes, tickets y facturas para que se digitalicen automáticamente\",\n  \"bannerCta\": \"Añadir números de teléfono\",\n  \"useWhatsapp\": \"Por WhatsApp\",\n  \"qrTitle\": \"Enviar documentos por WhatsApp\",\n  \"qrDescription\": \"Escanea el código QR para enviar tus albaranes, tickets y facturas por WhatsApp\",\n  \"qrDescriptionMobile\": \"Pulsa el botón de abajo para abrir una conversación de WhatsApp donde enviar tus albaranes, tickets y facturas\",\n  \"openWhatsapp\": \"Abrir WhatsApp\",\n  \"managePhoneNumbers\": \"Gestionar números de teléfono\",\n  \"addedAt\": \"Añadido el {{date}}\",\n  \"unknownNumber\": \"Este número no está registrado en haddock. Para enviar tus albaranes, tickets y facturas por WhatsApp, añádelo primero desde los ajustes de la plataforma.\",\n  \"scanLimitReached\": \"Has alcanzado el límite de documentos de tu plan de haddock, así que este documento no se ha podido digitalizar. Para seguir enviando albaranes, tickets y facturas por WhatsApp, mejora tu plan.\",\n  \"phoneNumberUpdated\": \"Número de teléfono actualizado\",\n  \"phoneNumberUpdateError\": \"Error al actualizar el número de teléfono\",\n  \"alias\": \"Alias\",\n  \"aliasOptional\": \"Alias (opcional)\",\n  \"aliasPlaceholder\": \"p. ej. Línea de cocina\",\n  \"routingScope\": \"Destino de los documentos\",\n  \"scopeSingle\": \"Solo este local\",\n  \"scopeGroup\": \"Todos los locales del grupo\",\n  \"routeToGroupLabel\": \"Repartir entre los locales del grupo\",\n  \"routeToGroupDescription\": \"Fina distribuye cada documento de este número al local del grupo que le corresponde. Si lo desactivas, siempre se quedan en este local.\",\n  \"inboundFromGroupTitle\": \"Números de otros locales del grupo\",\n  \"inboundFromGroupSubtitle\": \"Estos números están registrados en otros locales de tu grupo y también pueden enviar documentos a este local.\",\n  \"inboundFromGroupOrigin\": \"Registrado en {{property}}\",\n  \"finaNoAccess\": \"Este número solo está vinculado a la subida de documentos. Para hablar con Fina, pide acceso al propietario de tu restaurante.\",\n  \"finaMediaUnsupported\": \"No puedo procesar este archivo. Envíame una foto o un PDF de la factura, ticket o albarán y te ayudo.\",\n  \"finaMediaTooLarge\": \"Este archivo es demasiado grande (máximo 20 MB). Envíame una versión más ligera y te ayudo.\"\n}\n"
