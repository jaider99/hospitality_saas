            "mimeType": "application/json",
            "text": "{\n  \"allStepsCompleted\": \"¡Todos los pasos completados!\",\n  \"billingEntity\": \"Entidad fiscal\",\n  \"billingEntityNumber\": \"Entidad fiscal {{number}}\",\n  \"billingInformationHelper\": \"Esta información aparecerá en tus facturas y nos ayudará a crear correctamente las entidades legales.\",\n  \"createNewBillingEntity\": \"Crear nueva entidad fiscal\",\n  \"firstSteps\": \"PRIMEROS PASOS\",\n  \"fiscalName\": \"Nombre fiscal\",\n  \"fiscalNameRequired\": \"El nombre fiscal es obligatorio\",\n  \"fiscalNamePlaceholder\": \"Mi Restaurante S.L.\",\n  \"home\": {\n    \"advantages\": \"<strong>Ventajas:</strong>\",\n    \"downloadApp\": \"Descarga haddock en tu móvil\",\n    \"downloadSteps\": \"Sigue estos sencillos pasos para poder tener haddock desde tu móvil:\",\n    \"emailUpload\": \"Envía tus facturas por correo electrónico\",\n    \"firstUploads\": \"Sube tus primeros 10 albaranes\",\n    \"firstUploadsDescription\": \"Para empezar tu aventura en haddock, necesitamos que subas 10 albaranes de tus principales proveedores. De este modo empezarás a ver todo lo que haddock puede mostrarte con ¡tan solo 10 albaranes en la plataforma!\",\n    \"getReady\": \"Prepárate para tomar el control total de tu negocio con haddock\",\n    \"haddockDescription\": \"<strong>haddock</strong> es la primera solución que te ayuda a <strong>incrementar la rentabilidad de tu negocio</strong> ofreciéndote la información que necesitas en cada momento.\",\n    \"howWorks\": \"Queremos ayudarte a mejorar la rentabilidad de tu negocio ofreciéndote la información que necesitas en cada momento.\\nEcha un vistazo a este pequeño vídeo para descubrir todo lo que haddock puede hacer por ti. \\nAntes de empezar, necesitamos tu atención durante no más de 2 minutos.\",\n    \"howWorksTitle\": \"Cómo funciona\",\n    \"intro\": \"Intro a haddock\",\n    \"inviteEmployees\": \"Invita a tus primeros empleados\",\n    \"inviteEmployeesDescription\": \"Esto te permitirá ser mucho más eficiente, ya que tus empleados podrán ayudarte con tareas como subir documentos a haddock.\",\n    \"knowhaddock\": \"Conoce haddock\",\n    \"moreInfoHelpCenter\": \"Más información en nuestro\",\n    \"nextStep\": \"Ve al siguiente apartado para continuar\",\n    \"supportAccess\": \"Accede a nuestro centro de soporte para información más detallada y visual:\",\n    \"uploadByEmail\": \"Envía tus documentos o pídele a tu proveedor que los reenvíe a:\",\n    \"welcome\": \"Bienvenid@ a la comunidad haddock. ¿Estás list@ para empezar?\"\n  },\n  \"holdingName\": \"Nombre del holding\",\n  \"holdingNameDescription\": \"Todas las entidades fiscales creadas en este registro se agruparán bajo un mismo holding.\",\n  \"holdingNameRequired\": \"El nombre del holding es obligatorio\",\n  \"holdingNameTitle\": \"Holding\",\n  \"markAsComplete\": \"Marcar como completado\",\n  \"propertyCreationError\": \"No se pudo crear el restaurante. Por favor, revisa tus datos y vuelve a intentarlo.\",\n  \"selectBillingEntity\": \"Selecciona una entidad fiscal\",\n  \"selectedBillingEntity\": \"Entidad fiscal seleccionada\",\n  \"stepsLeft_one\": \"{{count}} paso pendiente\",\n  \"stepsLeft_other\": \"{{count}} pasos pendientes\",\n  \"taxIdRequired\": \"El identificador fiscal es obligatorio\",\n  \"venueInformation\": \"Información del local\",\n  \"groupNeedsRestaurant\": \"Cada grupo debe tener al menos un restaurante.\",\n  \"operationalGroupNeedsRestaurant\": \"Cada grupo operativo debe tener al menos un restaurante.\",\n  \"invalidFiscalEntityReference\": \"La entidad fiscal seleccionada ya no está disponible.\"\n}\n"
          },
