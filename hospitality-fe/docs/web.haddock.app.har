          "content": {
            "size": 9786,
            "mimeType": "application/json",
            "text": "{\n  \"ahaAccount_NotRealAccount\": \"The information of this account is not from a real restaurant, it has been prepared specifically as an example.\",\n  \"ahaAccount_discoverBenefits\": \"Find out <1>how information is displayed</1> once you have uploaded your expenses and sales. You have access with an <3>administrator role</3>, which allows you to see all the information but not modify it.\",\n  \"ahaAccount_discoverHowInfoIsShown\": \"Find out how information is displayed once you have uploaded your expenses and sales. You have access with an administrator role, which allows you to see all the information but not modify it.\",\n  \"ahaAccount_welcomeTo\": \"We welcome you to your\",\n  \"blockedPlan\": \"Your account is not active\",\n  \"blockedSubscriptionBanner\": \"Your account has been restricted due to payment issues. Your data and settings are still stored securely.\",\n  \"blockedSubscriptionBannerNonAdmin\": \"Your account is restricted. Please contact your account manager or support@haddock.app to continue using haddock.\",\n  \"cannotDelete_dishes\": \"To protect the information you enter, you will not be able to delete the dish if it is being used in a menu.\",\n  \"cannotDelete_employee\": \"To protect the information entered, you cannot delete employees with payroll or personnel expenses. As a recommended alternative, mark the employee as inactive.\",\n  \"cannotDelete_preparations\": \"To protect the information entered, you will not be able to delete the preparation if it is used as an ingredient in a dish.\",\n  \"comparatorInterestBadge\": \"Analysis ready\",\n  \"comparatorInterestConfirm\": \"View free comparison\",\n  \"comparatorInterestDescription\": \"Discover which products you could be losing margin on.\",\n  \"comparatorInterestDismiss\": \"Not now\",\n  \"comparatorInterestTitle\": \"We've detected that you're paying higher prices than the market.\",\n  \"confirmChangeCategory\": \"<1>{{categoryName}}</1> has been set as category for the <4>{{num}} selected documents</4>\",\n  \"confirmChangeCategoryToSupplier\": \"<1>{{categoryName}}</1> has been set as category for <3>{{num}} documents</3> from the provider <5>{{supplierName}}</5>\",\n  \"confirmChangeSupplier\": \"<1>{{supplierName}}</1> has been as supplier for the <4>{{num}} selected documents</4>\",\n  \"confirmChangeSupplierCategory\": \"<1>{{supplierName}}</1> has been set as supplier and <4>{{categoryName}}</4> as category for the <7> {{num}} selected documents</7>\",\n  \"delete\": \"Delete\",\n  \"delete_dish\": \"Delete dish?\",\n  \"delete_document\": \"Are you sure you want to delete this document?\",\n  \"delete_employee\": \"Delete employee?\",\n  \"delete_expense\": \"Are you sure you want to delete this expense?\",\n  \"delete_file\": \"Are you sure you want to delete this file?\",\n  \"delete_incident\": \"Delete incident?\",\n  \"delete_ingredient\": \"Delete ingredient?\",\n  \"delete_integration\": \"Are you sure you want to delete this integration?\",\n  \"delete_invitation\": \"The user will not be able to access the restaurant's information in haddock.\",\n  \"delete_payroll\": \"Delete payroll/s?\",\n  \"delete_sale\": \"Are you sure you want to delete this sale?\",\n  \"delete_supplier\": \"Are you sure you want to delete this supplier?\",\n  \"delete_user\": \"Are you sure you want to delete the user {{user}}?\",\n  \"deliveryNoteCreated\": \"Your delivery note has been created\",\n  \"deliveryNoteCreatedDescription\": \"A new delivery note is created based on your reception\",\n  \"deliveryNoteError\": \"Error creating the new delivery note\",\n  \"deliveryNoteErrorDescription\": \"A problem has occurred when creating your delivery note\",\n  \"discard_suggestion_description\": \"If you discard this suggestion the products will remain separated as they currently are. Are you sure you want to discard this recommended grouping?\",\n  \"discardSuggestion\": \"Do you want to discard this suggestion?\",\n  \"discountAvailable\": \"Discount available during the first 24 hours\",\n  \"employee\": \"Are you sure you want to delete this employee?\",\n  \"errorCreated\": \"Creation error.\",\n  \"expenseCreated\": \"Expense created!\",\n  \"expenseCreatedDescription\": \"The new expense has been created correctly, you can now see it next to the other expenses.\",\n  \"expenseCreationError\": \"Creation has failed\",\n  \"expenseCreationErrorDescription\": \"The new expense has NOT been created correctly. Reload the page and try again.\",\n  \"expenseUploadError\": \"Upload again\",\n  \"haddockNoLimit\": \"haddock without limits\",\n  \"inSubscription\": \"in your subscription\",\n  \"manualExpense_title\": \"Close new expense?\",\n  \"newExpenseOk\": \"Expense created\",\n  \"newExpenseOk_description\": \"Expense document successfully created\",\n  \"noNever\": \"No, never\",\n  \"oneTimeOffer\": \"One-time offer\",\n  \"payThroughHaddock\": \"Pay through haddock?\",\n  \"payThroughHaddock_description\": \"Are you interested in being able to use haddock to pay your suppliers?\",\n  \"productDelete_description\": \"Option not available yet. Now that we know you need to remove it, we will work to give you this option very soon.\",\n  \"productsQuickAction_archive_one\": \"Do you want to hide the selected product?\",\n  \"productsQuickAction_archive_other\": \"Do you want to hide the {{count}} selected products?\",\n  \"productsQuickAction_bookmark_one\": \"Do you want to bookmark the selected product?\",\n  \"productsQuickAction_bookmark_other\": \"Do you want to bookmark the {{count}} selected products?\",\n  \"productsQuickAction_delete_one\": \"Do you want to delete the selected product?\",\n  \"productsQuickAction_delete_other\": \"Do you want to delete the {{count}} selected products?\",\n  \"productsQuickAction_unarchive_one\": \"Do you want to show the selected product?\",\n  \"productsQuickAction_unarchive_other\": \"Do you want to show the {{count}} selected products?\",\n  \"productsQuickAction_unbookmark_one\": \"Do you want to unbookmark the selected product?\",\n  \"productsQuickAction_unbookmark_other\": \"Do you want to unbookmark the {{count}} selected products?\",\n  \"productUploadError_description\": \"The product excel could not be imported, make sure you have filled the mandatory fields (in orange) and the values are correct.\",\n  \"productUploadError_reUpload\": \"Upload excel again\",\n  \"productUploadError_title\": \"UPLOAD ERROR\",\n  \"productUploadSuccess_description\": \"The products excel has been successfully imported. You can now see them in your list of products and use them to make price lists.\",\n  \"productUploadSuccess_title\": \"SUCCESSFULLY IMPORTED\",\n  \"requestingName\": \"By requesting the demo you will not receive the discount\",\n  \"requestNow\": \"Request demo\",\n  \"setCategory\": \"Establish <1>{{categoryName}}</1> as category for the <4>{{num}} selected documents?</4>\",\n  \"setCategoryToSupplier\": \"¿Establish <1>{{categoryName}}</1> as category for the supplier <3>{{supplierName}}</3>?\",\n  \"setMethod\": \"¿Establish <1>{{method}}</1> as payment method for the <4>{{num}}  selected documents</4>?\",\n  \"setPayment\": \"¿Mark as <2>{{paid}}</2> the <5>{{num}} selected documents</5>?\",\n  \"setPaymentMethod\": \"¿Mark as <2>{{paid}}</2> and <5>{{method}}</5> as payment method for the <8>{{num}} selected documents</8>?\",\n  \"setSupplier\": \"Establish <1>{{supplierName}}</1> as a supplier for the <4>{{num}} selected documents?</4>\",\n  \"setSupplierCategory\": \"¿Establish <1>{{supplierName}}</1> as a supplier and <4>{{categoryName}}</4> as category for the <7> {{num}} selected documents?</7>\",\n  \"signatureInterest_HrError\": \"HR service temporarily unavailable\",\n  \"signatureInterest_badge\": \"TODAY ONLY!\",\n  \"signatureInterest_confirmAcquisition\": \"I want all 10 signatures for €1\",\n  \"signatureInterest_confirmWithHR\": \"I want Haddock HR and the 10 signatures for €1\",\n  \"signatureInterest_description\": \"Forget about paperwork: sign payrolls, contracts, and shifts in seconds from a single portal.\",\n  \"signatureInterest_dismiss\": \"Not now\",\n  \"signatureInterest_error\": \"An error has occurred while processing your interest. Please try again.\",\n  \"signatureInterest_footNote\": \"*10 signatures to be redeemed in 30 days\",\n  \"signatureInterest_snackConfirm\": \"Perfect! We've received your interest.\",\n  \"signatureInterest_snackDescription\": \"We will contact you soon with more details.\",\n  \"signatureInterest_title\": \"Digitize your team's signatures for €1\",\n  \"signaturesRetention_badge\": \"RECOMMENDED\",\n  \"signaturesRetention_bySignature\": \"by signature\",\n  \"signaturesRetention_confirm\": \"I WANT IT!\",\n  \"signaturesRetention_subtitle\": \"Choose the best annual plan for you\",\n  \"signaturesRetention_title\": \"You have run out of signatures\",\n  \"startNow\": \"Start now!\",\n  \"subscriptionCanceledPopupNonAdminIntro\": \"We are glad to see you again,\",\n  \"subscriptionCanceledPopupNonAdminBody\": \"Your haddock subscription has expired. Your data and settings are still stored securely.\",\n  \"subscriptionCanceledPopupNonAdminSupport\": \"Please contact the account owner or administrator to continue using haddock.\",\n  \"subscriptionCanceledPopupNonAdminEmail\": \"If you prefer, ask them to contact support via chat or by email at support@haddock.app.\",\n  \"subscriptionCanceledPopupAdminIntro\": \"We are glad to see you again,\",\n  \"subscriptionCanceledPopupAdminBody\": \"Your haddock subscription has expired. Your data and settings are still stored securely.\",\n  \"subscriptionCanceledPopupAdminSupport\": \"Please contact support via chat to continue using haddock.\",\n  \"subscriptionCanceledPopupAdminEmail\": \"Or email us at support@haddock.app\",\n  \"tryHaddock\": \"Try haddock without limits. Get a <strong>70% discount</strong> during the first month if you subscribe <strong>today</strong>*.\",\n  \"tryHaddock_snackbarDesktop\": \"Get a <strong>70% discount</strong> during the first month if you subscribe <strong>today</strong>*.\",\n  \"tryHaddock_snackbarMobile\": \"<strong>70% discount</strong> if you subscribe <strong>today</strong>*.\",\n  \"viewDeliveryNote\": \"View delivery note\"\n}\n"
          },
