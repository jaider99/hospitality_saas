Reply\": \"Tu mayor gasto este mes es carne y pescado. Este es el reparto:\",\n  \"chatPromoPopup.tasksReply\": \"Hoy hay un par de cosas que requieren tu atención:\",\n  \"chatPromoPopup.answerTag\": \"Ejemplo\",\n  \"chatPromoPopup.qSales\": \"¿Cuánto he vendido este mes?\",\n  \"chatPromoPopup.salesLabel\": \"Ventas este mes\",\n  \"chatPromoPopup.qSpend\": \"¿En qué estoy gastando más?\",\n  \"chatPromoPopup.spendLabel\": \"Mayores gastos del mes\",\n  \"chatPromoPopup.spendCat1\": \"Carne y pescado\",\n  \"chatPromoPopup.spendCat2\": \"Bebidas\",\n  \"chatPromoPopup.spendCat3\": \"Frutas y verduras\",\n  \"chatPromoPopup.qTasks\": \"¿Qué necesita mi atención hoy?\",\n  \"chatPromoPopup.tasksLabel\": \"Necesita tu atención\",\n  \"chatPromoPopup.task1\": \"3 facturas por conciliar\",\n  \"chatPromoPopup.task2\": \"2 emails a proveedores por enviar\",\n  \"chatPromoPopup.task3\": \"1 entrega sin factura\",\n  \"trialExpiredPopup.title\": \"Tu periodo de prueba de Fina ha terminado\",\n  \"trialExpiredPopup.description\": \"Si quieres seguir trabajando con Fina, háznoslo saber y nos pondremos en contacto contigo.\",\n  \"trialExpiredPopup.thankYouTitle\": \"¡Gracias!\",\n  \"trialExpiredPopup.thankYouDescription\": \"Nos pondremos en contacto contigo pronto.\",\n  \"trialExpiredPopup.errorDescription\": \"Hubo un error. Por favor, inténtalo de nuevo.\",\n  \"incidentDescriptionPlaceholder\": \"La factura incluye una alerta de incidencia en el punteo albarán-factura. Revisa el apartado de Conciliación para resolverla.\",\n  \"tasksHeading\": \"Necesito tu ayuda\",\n  \"tasksHeadingNamed\": \"{{name}}, necesito tu ayuda\",\n  \"tasksHeadingWithCount_one\": \"Necesito tu ayuda con {{count}} cosa\",\n  \"tasksHeadingWithCount_other\": \"Necesito tu ayuda con {{count}} cosas\",\n  \"tasksHeadingWithCountNamed_one\": \"{{name}}, necesito tu ayuda con {{count}} cosa\",\n  \"tasksHeadingWithCountNamed_other\": \"{{name}}, necesito tu ayuda con {{count}} cosas\",\n  \"task