            "text": "{\n  \"documentRejectionReasonPasswordProtected\": \"Documento protegido por contraseña\",\n  \"documentRejectionReasonScanFailed\": \"Hemos tenido un problema al escanear el documento\",\n  \"documentRejectionReasonUnresolvedProperty\": \"No hemos podido asociar el documento a un restaurante\",\n  \"documentRejectionReasonUnsupportedFileType\": \"Documento con un formato no soportado\",\n  \"documentsProcessedBody\": \"¡Buenas noticias!, tus documentos han sido procesados con éxito\",\n  \"documentsProcessedTitle\": \"Documentos procesados\",\n  \"finaBankReconciliationSummaryDescription\": \"El {{date}} concilié {{movements}} y abrí {{incidents}}.\",\n  \"finaBankReconciliationSummaryDescriptionNoIncidents\": \"El {{date}} concilié {{movements}}.\",\n  \"finaBankReconciliationSummaryIncidents_one\": \"{{count}} incidencia de factura pendiente\",\n  \"finaBankReconciliationSummaryIncidents_other\": \"{{count}} incidencias de factura pendiente\",\n  \"finaBankReconciliationSummaryMovements_one\": \"{{count}} movimiento bancario\",\n  \"finaBankReconciliationSummaryMovements_other\": \"{{count}} movimientos bancarios\",\n  \"finaBankReconciliationSummaryTitle\": \"Resumen de conciliación bancaria\",\n  \"finaConciliationSuccessDescription_one\": \"He conciliado {{count}} documento: {{documentsText}}. Importe conciliado: {{conciliatedAmount}}.\",\n  \"finaConciliationSuccessDescription_other\": \"He conciliado {{count}} documentos: {{documentsText}}. Importe conciliado: {{conciliatedAmount}}.\",\n  \"finaConciliationSuccessTitle\": \"He completado la conciliación con éxito\",\n  \"finaDigitalizationSuccessDescription\": \"Se ha digitalizado correctamente uno de tus documentos recibidos.\",\n  \"finaDigitalizationSuccessTitle\": \"Se ha completado la digitalización\",\n  \"finaDigitalizationValidationFailedAdditionalReasons_one\": \"{{count}} motivo adicional\",\n  \"finaDigitalizationValidationFailedAdditionalReasons_other\": \"{{count}} motivos adicionales\",\n  \"finaDigitalizationValidationFailedDescription\": \"He detectado que uno de tus documentos no ha podido ser validado automáticamente. Por favor, revisa el documento\",\n  \"finaDigitalizationValidationFailedFixAction\": \"Corregir documento\",\n  \"finaDigitalizationValidationFailedReasonsAction_one\": \"Ver motivo\",\n  \"finaDigitalizationValidationFailedReasonsAction_other\": \"Ver motivos\",\n  \"finaDigitalizationValidationFailedTitle\": \"Tengo un documento pendiente de revisión\",\n  \"finaDocumentsAction_one\": \"Ver documento\",\n  \"finaDocumentsAction_other\": \"Ver documentos\",\n  \"finaDocumentsAdditionalDocuments_one\": \"{{count}} documento adicional\",\n  \"finaDocumentsAdditionalDocuments_other\": \"{{count}} documentos adicionales\",\n  \"finaDocumentsCollectedDescription_one\": \"Documento subido a haddock.\",\n  \"finaDocumentsCollectedDescription_other\": \"Documentos subidos a haddock.\",\n  \"finaDocumentsCollectedTitle_one\": \"He recolectado {{count}} documento correctamente\",\n  \"finaDocumentsCollectedTitle_other\": \"He recolectado {{count}} documentos correctamente\",\n  \"finaDocumentsRejectedDescription_one\": \"Encontré errores al recolectar el siguiente documento:\",\n  \"finaDocumentsRejectedDescription_other\": \"Encontré errores al recolectar los siguientes documentos:\",\n  \"finaDocumentsRejectedDescriptionWithReason_one\": \"Revisa el documento rechazado: {{documentsText}}. Motivo principal: {{firstReason}}.\",\n  \"finaDocumentsRejectedDescriptionWithReason_other\": \"Revisa {{count}} documentos rechazados: {{documentsText}}. Motivo principal: {{firstReason}}.\",\n  \"finaDocumentsRejectedPrimaryReason\": \"Motivo principal: {{reason}}\",\n  \"finaDocumentsRejectedDialogDescription\": \"Revisa los motivos por los que rechacé tus documentos.\",\n  \"finaDocumentsRejectedDialogTitle\": \"Mis motivos de rechazo\",\n  \"finaDocumentsRejectedTitle_one\": \"He rechazado {{count}} documento\",\n  \"finaDocumentsRejectedTitle_other\": \"He rechazado {{count}} documentos\",\n  \"finaDocumentsRejectedUnknownDocumentName\": \"Documento sin nombre\",\n  \"finaDocumentsRejectedUnknownReason\": \"Motivo desconocido\",\n  \"finaExpenseExportSentDescription_one\": \"He enviado {{count}} documento de {{period}} a {{recipients}}.\",\n  \"finaExpenseExportSentDescription_other\": \"He enviado {{count}} documentos de {{period}} a {{recipients}}.\",\n  \"finaExpenseExportSentTitle\": \"He enviado la exportación al gestor\",\n  \"finaFallbackDescription\": \"Revisa la actividad reciente para más detalles.\",\n  \"finaFallbackTitle\": \"Te envío una notificación {{type}}\",\n  \"finaMissingInvoicesAdditionalSuppliers_one\": \"+ {{count}} proveedor más\",\n  \"finaMissingInvoicesAdditionalSuppliers_other\": \"+ {{count}} proveedores más\",\n  \"finaNegativeDiscrepancyDescription\": \"He detectado una diferencia en contra de {{discrepancyAmount}}. Revisa la incidencia para resolverla.\",\n  \"finaNegativeDiscrepancyTitle\": \"He detectado una discrepancia desfavorable\",\n  \"finaNotFoundDocumentsDescription\": \"Para conciliar la factura, por favor sube los documentos que faltan.\",\n  \"finaNotFoundDocumentsDescription_one\": \"No pude encontrar el documento: {{documentsText}}. Revisa los pendientes.\",\n  \"finaNotFoundDocumentsDescription_other\": \"No pude encontrar {{count}} documentos: {{documentsText}}. Revisa los pendientes.\",\n  \"finaNotFoundDocumentsFallbackDescription\": \"Para conciliar la factura, por favor sube los documentos que faltan.\",\n  \"finaNotFoundDocumentsFallbackTitle\": \"No he podido conciliar la factura por falta de documentos.\",\n  \"finaNotFoundDocumentsTitle\": \"No he podido conciliar la factura de {{supplierName}} del {{invoiceDate}} por falta de documentos.\",\n  \"finaNotFoundDocumentsTitle_one\": \"No he encontrado {{count}} documento\",\n  \"finaNotFoundDocumentsTitle_other\": \"No he encontrado {{count}} documentos\",\n  \"finaOrphanDeliveryNotesDescription_one\": \"{{count}} albarán de {{suppliersCount}} proveedor aún no tiene factura recibida.\",\n  \"finaOrphanDeliveryNotesDescription_other\": \"{{count}} albaranes de {{suppliersCount}} proveedores aún no tienen factura recibida.\",\n  \"finaOrphanDeliveryNotesDialogDescription\": \"Los siguientes albaranes no tienen su factura correspondiente. Haz clic en cada documento para ver los detalles.\",\n  \"finaOrphanDeliveryNotesDialogTitle\": \"Albaranes pendientes de factura\",\n  \"finaOrphanDeliveryNotesTitle_one\": \"He detectado {{count}} proveedor sin factura en {{monthName}} por un total de {{totalAmount}}\",\n  \"finaOrphanDeliveryNotesTitle_other\": \"He detectado {{count}} proveedores sin factura en {{monthName}} por un total de {{totalAmount}}\",\n  \"finaPositiveDiscrepancyDescriptionFallback\": \"Revisa los importes conciliados.\",\n  \"finaPositiveDiscrepancyDescriptionWithAmount\": \"He detectado una diferencia a favor de +{{discrepancyAmount}}.\",\n  \"finaPositiveDiscrepancyTitle\": \"He detectado una discrepancia a favor\",\n  \"finaSupplementaryExpenseExportSentDescription_one\": \"He enviado {{count}} documento atrasado de {{period}} a {{recipients}}.\",\n  \"finaSupplementaryExpenseExportSentDescription_other\": \"He enviado {{count}} documentos atrasados de {{period}} a {{recipients}}.\",\n  \"finaSupplementaryExpenseExportSentTitle\": \"He enviado una exportación complementaria al gestor\",\n  \"uploadDocumentsReminderBody\": \"{{name}}, sube documentos hoy para tener visibilidad sobre el margen de tu restaurante.\",\n  \"uploadDocumentsReminderTitle\": \"haddock te echa de menos\"\n}\n"
