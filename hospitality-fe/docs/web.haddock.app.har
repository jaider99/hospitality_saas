            "text": "{\n  \"badSupportExperience\": \"Tuvimos una mala experiencia con el soporte o la atención\",\n  \"BOMComplexity\": \"Complejidad para hacer los escandallos\",\n  \"chooseAnotherSolution\": \"¿Has optado por otra solución?\",\n  \"chooseProperty\": \"Selecciona un restaurante\",\n  \"closedOrTransferred\": \"Estamos cerrando, traspasando, o cambiando de dueño\",\n  \"closingReason\": \"¿Qué ha pasado con el cierre de tu negocio?\",\n  \"dataErrors\": \"Baja fiabilidad de los datos extraídos\",\n  \"definitivelyClosed\": \"Cierre definitivo del restaurante\",\n  \"demoSetWrongExpectations\": \"La demo generó expectativas que luego no se cumplieron\",\n  \"difficultyUsing\": \"Dificultad de uso o experiencia poco intuitiva\",\n  \"dontKnowHowItWorks\": \"No sé cómo funciona haddock\",\n  \"duplicatedOrMisgroupedProducts\": \"Los productos aparecen duplicados o mal agrupados\",\n  \"expectationsNotMet\": \"haddock no ha cumplido con mis expectativas\",\n  \"expensiveTool\": \"Es una herramienta cara\",\n  \"externalReasons\": \"Motivos internos de mi negocio (ajenos a haddock)\",\n  \"foundCheaperAlternative\": \"Hemos encontrado una alternativa más económica\",\n  \"frequentDataErrors\": \"Errores frecuentes en datos (en documentos, dashboards, etc)\",\n  \"functionalitiesDoNotCoverNeeds\": \"Las funcionalidades actuales no cubren nuestras necesidades\",\n  \"groupManagement\": \"Visión de grupo / Gestión de grupo\",\n  \"hardToNavigate\": \"Cuesta encontrar lo que buscamos o navegar por la herramienta\",\n  \"highCost\": \"El precio no se ajusta a nuestro presupuesto o uso\",\n  \"highDigitisationTime\": \"El tiempo de digitalización es muy alto\",\n  \"highPriceReason\": \"¿Por qué crees que el precio es alto?\",\n  \"HRManagement\": \"Gestión de personal\",\n  \"iHaveFinancialIssues\": \"Tengo problemas financieros y no puedo permitírmelo\",\n  \"integrationIssues\": \"Problemas o limitaciones técnicas con las integraciones\",\n  \"inventories\": \"Inventarios\",\n  \"issueNotResolvedOrVague\": \"No nos resolvieron el problema o nos dieron una respuesta vaga\",\n  \"keyFeaturesMissing\": \"Faltan funciones clave para nuestro flujo de trabajo\",\n  \"lackFollowupOnboarding\": \"Falta de seguimiento y acompañamiento durante la formación inicial\",\n  \"lackOfSupport\": \"No he recibido el apoyo necesario para implementar haddock\",\n  \"lackOfTime\": \"No tenemos suficiente tiempo o personal para usar la herramienta\",\n  \"lackOfTimeForTeam\": \"No hay nadie con tiempo o perfil para liderar la adopción de haddock\",\n  \"lackOfTimeForTools\": \"No tenemos tiempo para incorporar nuevas herramientas ahora mismo\",\n  \"lackOfTimeMissingPerson\": \"La persona asignada ya no está en la empresa o no continuó con la herramienta\",\n  \"missingAssumedIntegrations\": \"Faltaban integraciones clave que se asumieron disponibles\",\n  \"missingERPIntegration\": \"No estáis integrados con mi ERP\",\n  \"missingFeatures\": \"Me faltan funcionalidades\",\n  \"missingPOSIntegration\": \"No estáis integrados con mi Terminal Punto de Venta\",\n  \"missingValuableFeatures\": \"La herramienta no ofrece funciones que realmente nos aporten valor\",\n  \"moreDetails\": \"¿Nos puedes dar un poco más de detalle?\",\n  \"needMoreFeatures\": \"Necesito más funcionalidades\",\n  \"newOwnerContact\": \"¿Nos puedes compartir el contacto del nuevo propietario?\",\n  \"noAnotherSolution\": \"No, dejaré de hacerlo\",\n  \"notEnoughSupport\": \"No he tenido el apoyo necesario\",\n  \"noTimeImplementing\": \"No he dedicado tiempo implementándolo\",\n  \"notMobileFriendly\": \"No está bien adaptado a móvil o pantallas pequeñas\",\n  \"Other\": \"Otro\",\n  \"otherSolutionPreferred\": \"Prefiero usar otra solución\",\n  \"permanentlyClosed\": \"Cerrado permanentemente\",\n  \"priceTooHigh\": \"El precio es muy alto\",\n  \"productIssues\": \"Problemas con el producto o la tecnología\",\n  \"reconciliationTooManual\": \"La conciliación de documentos requiere demasiada intervención manual\",\n  \"reducedCosts\": \"Hemos reducido gastos y eliminado herramientas no esenciales\",\n  \"restaurantClosed\": \"He cerrado mi restaurante\",\n  \"salesDemoMismatch\": \"Lo que vimos en ventas/demo no se reflejó en el producto real\",\n  \"seeYouSoon\": \"Esperamos verte de nuevo en haddock.\",\n  \"shareAnything\": \"Comparte lo que necesites con nosotros\",\n  \"slowResponseTimes\": \"Tardaron mucho en responder a nuestros mensajes\",\n  \"solutionChosen\": \"¿Qué solución has escogido?\",\n  \"requestAccountCancellation\": \"Solicitar cancelación de cuenta\",\n  \"cancelSubscription\": \"Cancelar suscripción\",\n  \"submitError\": \"No hemos podido completar la baja automática. Por favor, contacta con soporte.\",\n  \"alreadySubmitted\": \"Ya se ha enviado una solicitud de cancelación para este restaurante.\",\n  \"supportNotReceived\": \"No he recibido la ayuda esperada\",\n  \"systemNotSupported\": \"Nuestro sistema actual no es compatible o no está soportado\",\n  \"takeAMoment\": \"Lamentamos mucho no haber cumplido con tus expectativas.\",\n  \"thankYou\": \"¡Muchas gracias por responder a las preguntas!\",\n  \"tooManyErrors\": \"No confío en que pueda extraer información precisa porque he identificado varios errores\",\n  \"transferredProperty\": \"El restaurante ha sido traspasado o vendido\",\n  \"unclearExplanationsOrDocs\": \"Las explicaciones y/o documentación no son claras\",\n  \"unmetExpectations\": \"Expectativas, proceso de venta y/o soporte\",\n  \"unstableIntegrations\": \"Integraciones inestables o con errores de sincronización de datos\",\n  \"unusedModules\": \"No uso todos los módulos por lo que me parece caro\",\n  \"validationTooManual\": \"El módulo de validación nos obliga a revisar demasiados casos a mano\",\n  \"whatHasHappenedInYourBusiness\": \"¿Qué ha pasado en tu negocio?\",\n  \"whichExpectationsUnmet\": \"¿Qué expectativas no hemos cumplido?\",\n  \"whichFeaturesYouMiss\": \"¿Qué funcionalidades te faltan?\",\n  \"whichProductIssues\": \"¿Qué problema principal has tenido?\",\n  \"whichProperty\": \"¿Qué restaurante quieres dar de baja?\",\n  \"whyAreYouCanceling\": \"¿Por qué quieres darte de baja?\",\n  \"whyThisSolution\": \"¿Por qué has escogido a ese competidor?\",\n  \"whyYouDidNotLikeSetupProcess\": \"¿Por qué no te ha gustado el proceso de activación?\",\n  \"willDoManually\": \"No, lo haré manualmente\",\n  \"yourFeedback\": \"Nos gustaría aprovechar esta oportunidad para entender mejor tu decisión y mejorar nuestra propuesta para en el futuro verte de nuevo usando haddock para llevar tu restaurante al siguiente nivel.\",\n  \"cancellationEffectiveIn30Days\": \"Tu suscripción seguirá activa hasta el final del periodo de facturación actual y no se renovará después de esa fecha.\",\n  \"cancellationTermsLink\": \"<termsLink>Ver términos y condiciones.</termsLink>\",\n  \"termsAndConditions\": \"términos y condiciones\",\n  \"teamWillContactYou\": \"La baja del servicio se tramitará automáticamente.\"\n}\n"
