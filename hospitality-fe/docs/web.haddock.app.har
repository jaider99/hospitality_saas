          "content": {
            "size": 3590,
            "mimeType": "application/json",
            "text": "{\n  \"addDocument\": \"Add document\",\n  \"addDocuments\": \"Add documents\",\n  \"addFirstDocument\": \"Add your first document\",\n  \"addFirstPayroll\": \"Add your first payroll\",\n  \"addFirstSupplier\": \"Add your first supplier\",\n  \"addFristSale\": \"Add your first sale\",\n  \"connectPOS\": \"Connect POS\",\n  \"connectYourPOS\": \"<strong>Connect your POS</strong> with haddock or manually upload your sales information.\",\n  \"dishes\": \"Create your final recipes from your <4>products</4> and <7>preparations</7>.\",\n  \"expiredPlan\": \"Your plan has expired\",\n  \"expiredPlanExplained\": \"We have a plan that's right for you, keep using haddock with no limitations\",\n  \"handleSuppliers\": \"From here you will be able to handle your <strong>suppliers</strong>, check their info, assign tags, contacts, set up payment configuration, etc\",\n  \"inventories_description\": \"Create warehouses and add products to the inventory to be able to calculate CoGS and variances.\",\n  \"inventories_title\": \"There are no warehouses created\",\n  \"menus\": \"There is no menu created\",\n  \"menus_description\": \"Create menus from your dishes\",\n  \"newSale_manual\": \"Upload manual sale\",\n  \"noDocumentsCTA\": \"Start uploading your first invoices and delivery notes by clicking on <strong>New expense</strong> on your documents section.\",\n  \"noResultFound\": \"No results found\",\n  \"preparations1\": \"Create intermediate preparations\\nto add to your <4>final recipes</4>.\",\n  \"preparations2\": \"Preparations are those recipes that you use in many of your recipes.\\nDo you want to know more? <4>Visit our blog</4>\",\n  \"products\": \"<strong>Controls purchases</strong> and <strong>manages</strong> the output of scanned and/or manually created documents\",\n  \"purchases\": \"Upload or create a <strong>purchase document</strong> to have a price history on this product.\",\n  \"purchasingCosts\": \"From here you will be able to see <strong>your purchases, report and analysis of all your products</strong> extracted from your documents\",\n  \"recipes\": \"It seems that there is no dish or preparation containing this product. You can check it from the recipes module.\",\n  \"recipes_button\": \"Visit recipes module\",\n  \"recipes_title\": \"No recipes exists for this product\",\n  \"resetFilter\": \"Reset filters\",\n  \"salesDetails\": \"From here you will be able to see all your restaurant's <strong>sales</strong>. No matter if they come from your POS, or the ones added manually\",\n  \"salesDetailsCannotView\": \"Your current role does not allow you to view the sales list.\",\n  \"salesInfo\": \"Consult the sales history of the items in your catalogue automatically by connecting your POS. If it is not compatible, upload sales manually.\",\n  \"salesInfo_link\": \"Check POS compatibility\",\n  \"salesInfo_title\": \"Connect your POS and check the results of your sales.\",\n  \"salesLoading_title\": \"Your sales are loading\",\n  \"salesLoading_info\": \"Sales from your POS may take a few minutes to appear. If more than 10 minutes have passed, you can manually refresh the sales.\",\n  \"salesError_title\": \"There was a problem loading your sales\",\n  \"salesError_info\": \"We detected issues with your POS connection. You can try to manually refresh sales to verify the connection.\",\n  \"staffCosts\": \"From here you will be able to handle all your <strong>staff costs</strong>\",\n  \"uploadDocument\": \"Add new document\",\n  \"weSave\": \"We secure your documents so nothing gets lost while you update your plan\",\n  \"yourRoleIn1\": \"Your role in \",\n  \"yourRoleIn2\": \"is document manager. You will be able to upload and edit your documents. You will not be able to access documents uploaded by someone else.\"\n}\n"
          },
