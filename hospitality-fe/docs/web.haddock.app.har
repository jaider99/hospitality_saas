          "cookies": [],
          "content": {
            "size": 4848,
            "mimeType": "application/json",
            "text": "{\n  \"title\": \"Product Changelog\",\n  \"description\": \"Published product updates for customers and internal review.\",\n  \"modes\": {\n    \"user\": \"User\",\n    \"admin\": \"Admin\"\n  },\n  \"areas\": {\n    \"fina\": \"Fina\",\n    \"haddock_hr\": \"haddock HR\"\n  },\n  \"card\": {\n    \"negativeFeedbackAria\": \"Negative feedback\",\n    \"positiveFeedbackAria\": \"Positive feedback\",\n    \"readLess\": \"Read less\",\n    \"readMore\": \"Read more\"\n  },\n  \"empty\": {\n    \"noResults\": \"There are no published updates for this search.\"\n  },\n  \"feedback\": {\n    \"cancel\": \"Cancel\",\n    \"description\": \"Your opinion helps us prioritize the next updates better.\",\n    \"dialogCloseLabel\": \"Close\",\n    \"dialogPrompt\": \"Tell us what you expected from this improvement or what you would change\",\n    \"dialogTitle\": \"What was missing?\",\n    \"inlineTitle\": \"Help us improve\",\n    \"placeholder\": \"What was missing from this improvement?\",\n    \"placeholderDialog\": \"Write your opinion here\",\n    \"submit\": \"Send\",\n    \"submitting\": \"Sending...\"\n  },\n  \"hero\": {\n    \"description\": \"We are always working so your restaurant business keeps growing with us\",\n    \"title\": \"haddock updates\"\n  },\n  \"nav\": {\n    \"label\": \"Updates\"\n  },\n  \"search\": {\n    \"label\": \"Search updates\",\n    \"placeholder\": \"Search by haddock modules...\"\n  },\n  \"states\": {\n    \"loadError\": \"Updates could not be loaded.\",\n    \"retry\": \"Retry\",\n    \"retrying\": \"Retrying...\"\n  },\n  \"tabs\": {\n    \"allWithCount\": \"All ({{count}})\",\n    \"areaWithCount\": \"{{area}} ({{count}})\"\n  },\n  \"toasts\": {\n    \"feedbackError\": \"The feedback could not be sent.\",\n    \"feedbackSuccess\": \"Thanks for your feedback.\"\n  },\n  \"user\": {\n    \"emptyTitle\": \"No published updates\",\n    \"emptyDescription\": \"Customer-ready updates will appear here.\",\n    \"errorTitle\": \"Could not load the changelog\",\n    \"errorDescription\": \"Check whether the changelog is enabled for this restaurant.\"\n  },\n  \"admin\": {\n    \"queueTitle\": \"Review queue\",\n    \"create\": \"Create update\",\n    \"createDraft\": \"Save draft\",\n    \"preview\": \"Preview\",\n    \"accept\": \"Accept\",\n    \"edit\": \"Edit\",\n    \"save\": \"Save\",\n    \"publish\": \"Publish\",\n    \"unpublish\": \"Unpublish\",\n    \"reject\": \"Reject\",\n    \"acceptSuccess\": \"Draft accepted.\",\n    \"updateSuccess\": \"Update saved.\",\n    \"updateError\": \"Could not update the news item.\",\n    \"publishSuccess\": \"Update published.\",\n    \"unpublishSuccess\": \"Update unpublished.\",\n    \"rejectSuccess\": \"Update rejected.\",\n    \"actionError\": \"Could not apply the action.\",\n    \"createSuccess\": \"Draft created.\",\n    \"createError\": \"Could not create the draft.\",\n    \"emptyTitle\": \"No updates in this filter\",\n    \"emptyDescription\": \"Change the filter or create an update.\",\n    \"errorTitle\": \"Could not load admin mode\",\n    \"errorDescription\": \"Check permissions or try again.\",\n    \"noSelectionTitle\": \"Select an update\",\n    \"noSelectionDescription\": \"The detail and preview will appear here.\",\n    \"filterLabel\": \"Filter admin news\",\n    \"areaMissing\": \"Missing area\",\n    \"assignAreaBeforePublish\": \"Assign an area before publishing.\",\n    \"filters\": {\n      \"active\": \"Drafts and blocked\",\n      \"rejected\": \"Rejected\",\n      \"published\": \"Published\",\n      \"all\": \"All\"\n    },\n    \"actionDialog\": {\n      \"reasonLabel\": \"Internal reason (optional)\",\n      \"reasonPlaceholder\": \"Add audit context\",\n      \"accept\": {\n        \"title\": \"Accept blocked item\",\n        \"description\": \"The news item will become a hidden draft so it can be published later.\",\n        \"confirm\": \"Accept\"\n      },\n      \"publish\": {\n        \"title\": \"Publish draft\",\n        \"description\": \"The news item will become visible to customers in the published changelog.\",\n        \"confirm\": \"Publish\"\n      },\n      \"unpublish\": {\n        \"title\": \"Unpublish news item\",\n        \"description\": \"The news item will stop being visible to customers and return to draft.\",\n        \"confirm\": \"Unpublish\"\n      },\n      \"reject\": {\n        \"title\": \"Reject news item\",\n        \"description\": \"The news item will leave the active queue and be recorded as rejected.\",\n        \"confirm\": \"Reject\"\n      }\n    },\n    \"status\": {\n      \"draft\": \"Draft\",\n      \"blocked\": \"Blocked\",\n      \"published\": \"Published\",\n      \"rejected\": \"Rejected\"\n    },\n    \"tags\": {\n      \"new_feature\": \"New feature\",\n      \"improvement\": \"Improvement\",\n      \"automation\": \"Automation\",\n      \"integration\": \"Integration\",\n      \"ai\": \"AI\"\n    },\n    \"createDialog\": {\n      \"title\": \"Create update\",\n      \"description\": \"It will be saved as a hidden draft and published from the preview.\",\n      \"titleField\": \"Title\",\n      \"summaryField\": \"Summary\",\n      \"detailsField\": \"Details\",\n      \"areaField\": \"Area\",\n      \"areaPlaceholder\": \"Select an area\",\n      \"releaseDateField\": \"Release date\",\n      \"tagsField\": \"Update type\",\n      \"tagsPlaceholder\": \"Select types\"\n    }\n  }\n}\n"
          },
