            "text": "{\n  \"action\": \"Action\",\n  \"actions\": \"Actions\",\n  \"actionTooltip\": \"Define what your modifier will do when selected\",\n  \"add\": \"Add\",\n  \"addModifierRule\": \"Add rule in the modifier\",\n  \"addPreparation\": \"Add preparation\",\n  \"addPreparationDescription\": \"This modifier will add a preparation to the original dish.\",\n  \"addProduct\": \"Add product\",\n  \"addProductDescription\": \"This modifier will add a product to the original dish.\",\n  \"addRule\": \"Add rule\",\n  \"addYourFirstRule\": \"Add your first rule\",\n  \"alreadyUsed\": \"Already used\",\n  \"assignedDishes\": \"Assigned dishes\",\n  \"configuredItemsWarningDescription\": \"The following items do not have price or unit base configured correctly. This modifier rule will not calculate costs/consumption correctly until these items are configured:\",\n  \"configuredItemsWarningTitle\": \"not configured correctly\",\n  \"connectDish\": \"Connect dish\",\n  \"connectProductOrPreparation\": \"Connect product or preparation\",\n  \"deleteModifierRule\": \"Remove rule in modifier\",\n  \"deleteModifierRuleConfirmation\": \"Are you sure you want to delete this rule?\",\n  \"editModifierRule\": \"Update rule in the modifier\",\n  \"emptyRulesList\": \"No rules configured for this modifier\",\n  \"emptyRulesListDescription\": \"Add your first rule for this modifier\",\n  \"extraPrice\": \"Extra price\",\n  \"many\": \"Modifiers\",\n  \"modifier\": \"Modifier\",\n  \"modifierAction\": \"Modifier action\",\n  \"modifierCostLosingMoney\": \"The modifier cost exceeds the price increase applied to the article, resulting in a loss\",\n  \"modifierGroup\": \"Modifier group\",\n  \"modifiers\": \"Modifiers\",\n  \"modifierWithoutRulesWarning\": \"This modifier has no action rules configured\",\n  \"noPreparationsFound\": \"No preparations found\",\n  \"noProductsFound\": \"No products found\",\n  \"noQuantityRequired\": \"No quantity needed: the whole product is removed.\",\n  \"numberOfModifiers\": \"Number of modifiers\",\n  \"preparationLink\": \"Preparation link\",\n  \"preparationLinkTooltip\": \"Link to the preparation that affects this modifier\",\n  \"preparations\": \"Preparations\",\n  \"preparationToReplace\": \"Preparation to replace\",\n  \"preparationToReplaceTooltip\": \"Preparation to be replaced by the modifier\",\n  \"productLink\": \"Product link\",\n  \"productLinkTooltip\": \"Link to the product that affects this modifier\",\n  \"productsOrPreparations\": \"Products / Preparations\",\n  \"productToReplace\": \"Product to replace\",\n  \"productToReplaceTooltip\": \"Product to be replaced by the modifier\",\n  \"quantity\": \"Quantity\",\n  \"quantityBasedOnSource\": \"Quantity is taken from the replaced product.\",\n  \"quantityTooltip\": \"Amount of product to be consumed in this modifier\",\n  \"remove\": \"Remove\",\n  \"removePreparation\": \"Remove preparation\",\n  \"removePreparationDescription\": \"This modifier will remove a preparation from the original dish.\",\n  \"removeProduct\": \"Remove product\",\n  \"removeProductDescription\": \"This modifier will remove one item from the original dish.\",\n  \"replace\": \"Replace\",\n  \"replacementPreparation\": \"Replacement preparation\",\n  \"replacementPreparationTooltip\": \"Preparation that will replace the original one when this modifier is applied.\",\n  \"replacementProduct\": \"Replacement product\",\n  \"replacementProductTooltip\": \"Product that will replace the original one when this modifier is applied.\",\n  \"replacePreparation\": \"Replace preparation\",\n  \"replacePreparationDescription\": \"This modifier will replace one preparation with another within the dish.\",\n  \"replaceProduct\": \"Replace product\",\n  \"replaceProductDescription\": \"This modifier will replace one item with another within the dish.\",\n  \"ruleCreationError\": \"An error occurred while attempting to create a new rule in the modifier.\",\n  \"searchModifiersOrModifierGroups\": \"Search modifier groups or modifiers...\",\n  \"searchPreparation\": \"Search preparation\",\n  \"searchProduct\": \"Search product\",\n  \"selectModifierType\": \"Select the type of modifier\",\n  \"selectPreparation\": \"Select preparation\",\n  \"selectProduct\": \"Select product\",\n  \"someModifiersWithoutRulesWarning\": \"Some modifiers in this group have no rules configured\",\n  \"validationPreparationSourceRequired\": \"Preparation source is required\",\n  \"validationPreparationTargetRequired\": \"Preparation target is required\",\n  \"validationProductSourceRequired\": \"Product source is required\",\n  \"validationProductTargetRequired\": \"Product target is required\",\n  \"validationQuantityRequired\": \"The quantity is required\",\n  \"validationUnitOfMeasureRequired\": \"Unit of measure is required\",\n  \"unnamedModifier\": \"Unnamed modifier\"\n}\n"
