            "size": 6042,
            "mimeType": "application/json",
            "text": "{\n  \"tpvConnectedOnly\": \"Only dishes with connected POS items are shown\",\n  \"cards\": {\n    \"avgMargin\": {\n      \"help\": \"Average gross margin of the dishes sold.\",\n      \"label\": \"Average margin\"\n    },\n    \"avgMultiplier\": {\n      \"help\": \"Average sale-price-to-cost ratio.\",\n      \"label\": \"Average multiplier\"\n    },\n    \"maxMargin\": {\n      \"help\": \"The cost breakdown with the highest gross margin over sale price.\",\n      \"label\": \"Top-margin dish\"\n    },\n    \"maxUnits\": {\n      \"help\": \"The cost breakdown with the most units sold.\",\n      \"label\": \"Best-selling dish\"\n    }\n  },\n  \"dates\": {\n    \"selectDate\": \"Select date\",\n    \"selectDates\": \"Select dates\"\n  },\n  \"emptyState\": {\n    \"title\": \"Create your recipes and know your margins\",\n    \"description\": \"You'll see the cost and margin of every dish on your menu.\",\n    \"action\": \"Create recipe\"\n  },\n  \"hero\": {\n    \"subtitle\": \"Dish margin consolidated across all the selected locations.\",\n    \"title\": \"Cost breakdowns\"\n  },\n  \"matrix\": {\n    \"axis\": {\n      \"margin\": \"Margin per dish (€)\",\n      \"units\": \"Units sold\"\n    },\n    \"empty\": \"No dishes with sales and cost in the selected period.\",\n    \"filterAll\": \"All dishes\",\n    \"quadrant\": {\n      \"dog\": \"Low margin & sales\",\n      \"plowhorse\": \"High volume, low margin\",\n      \"puzzle\": \"Opportunity\",\n      \"star\": \"Stars\"\n    },\n    \"quadrantDescription\": {\n      \"dog\": \"Lower margin and sales\",\n      \"plowhorse\": \"Lower margin, more sales\",\n      \"puzzle\": \"Higher margin, fewer sales\",\n      \"star\": \"Higher margin and sales\"\n    },\n    \"groupCategory\": \"Category\",\n    \"groupFamily\": \"Family\",\n    \"groupLocal\": \"Location\",\n    \"subtitle\": \"Popularity versus gross margin for each dish.\",\n    \"title\": \"Sales and gross margin matrix\",\n    \"tooltip\": {\n      \"margin\": \"Margin\",\n      \"marginPerDish\": \"Margin/dish\",\n      \"salePrice\": \"Price\",\n      \"unitCost\": \"Cost\",\n      \"units\": \"Units\"\n    },\n    \"moreMargin\": \"More margin\",\n    \"moreUnits\": \"More units\",\n    \"dishCount_one\": \"{{count}} dish\",\n    \"dishCount_other\": \"{{count}} dishes\",\n    \"filterActiveCount\": \"{{count}} filters\",\n    \"filterFamilyCount\": \"{{value}} families\",\n    \"filterSearchFamily\": \"Search family\"\n  },\n  \"properties\": {\n    \"all\": \"All locations\",\n    \"count_one\": \"{{count}} location\",\n    \"count_other\": \"{{count}} locations\",\n    \"emptyText\": \"No locations.\",\n    \"placeholder\": \"All locations\",\n    \"searchPlaceholder\": \"Search locations\"\n  },\n  \"rankings\": {\n    \"infoAriaLabel\": \"More information about {{title}}\",\n    \"bottomSubtitle\": \"Dishes with the lowest margin over sale price\",\n    \"bottomTitle\": \"Lowest-margin cost breakdowns\",\n    \"topSubtitle\": \"Dishes with the highest margin over sale price\",\n    \"col\": {\n      \"cost\": \"Cost\",\n      \"dish\": \"Dish\",\n      \"margin\": \"Margin\",\n      \"salePrice\": \"Price\",\n      \"units\": \"Units\"\n    },\n    \"empty\": \"No cost breakdowns in the selected period.\",\n    \"rowDetail\": \"Cost {{cost}} · Price {{salePrice}} · {{units}} units\",\n    \"showHigher\": \"Higher\",\n    \"showLower\": \"Lower\",\n    \"subtitle\": \"Dishes with the lowest and highest margin over sale price.\",\n    \"title\": \"Margins\",\n    \"topTitle\": \"Highest-margin cost breakdowns\"\n  },\n  \"status\": {\n    \"empty\": \"No dish sales with a cost breakdown in the selected period.\",\n    \"error\": \"We couldn't load the cost breakdowns.\",\n    \"loading\": \"Loading cost breakdowns...\"\n  },\n  \"tabs\": {\n    \"dishes\": \"Dishes\",\n    \"menus\": \"Menus\",\n    \"modifiers\": \"Modifiers\",\n    \"posCatalog\": \"POS catalog\",\n    \"preparations\": \"Preparations\",\n    \"summary\": \"Summary\"\n  },\n  \"tabsView\": {\n    \"actions\": \"Actions\",\n    \"article\": \"Sales article\",\n    \"articlesCount_one\": \"{{count}} article\",\n    \"articlesCount_other\": \"{{count}} articles\",\n    \"connectDish\": \"Connect dish\",\n    \"link\": \"Cost breakdown / article\",\n    \"location\": \"Location\",\n    \"locationsCount_one\": \"{{count}} location\",\n    \"locationsCount_other\": \"{{count}} locations\",\n    \"metrics\": {\n      \"benefit\": \"Benefit\",\n      \"cost\": \"Cost\",\n      \"margin\": \"Margin\",\n      \"pv\": \"PV\",\n      \"pvp\": \"PVP\"\n    },\n    \"modifierGroupsCount_one\": \"{{count}} group\",\n    \"modifierGroupsCount_other\": \"{{count}} groups\",\n    \"modifiersCount_one\": \"{{count}} modifier\",\n    \"modifiersCount_other\": \"{{count}} modifiers\",\n    \"openLocation\": \"Open in location\",\n    \"search\": \"Search by name\",\n    \"state\": \"Status\",\n    \"status\": {\n      \"connected\": \"Connected\",\n      \"error\": \"Error\",\n      \"new\": \"New\",\n      \"pending\": \"Pending\"\n    },\n    \"unlinked\": \"No linked article\",\n    \"connectArticle\": \"Connect to POS\",\n    \"filters\": {\n      \"sortName\": \"Name (A-Z)\",\n      \"sortPriceDesc\": \"Price (high to low)\",\n      \"sortPriceAsc\": \"Price (low to high)\",\n      \"connectionAll\": \"All connections\",\n      \"connectionConnected\": \"Connected\",\n      \"connectionUnconnected\": \"Not connected\"\n    }\n  },\n  \"uncategorized\": \"Uncategorized\",\n  \"coverage\": \"{{connected}}/{{total}} connected\",\n  \"linkDialog\": {\n    \"alreadyLinked\": \"Already linked: {{name}}\",\n    \"connect\": \"Connect\",\n    \"disconnect\": \"Disconnect\",\n    \"error\": \"Couldn't update the connection.\",\n    \"manageLink\": \"Manage\",\n    \"searchArticle\": \"Search article\",\n    \"searchDish\": \"Search dish\",\n    \"subtitle\": \"{{name}} · {{location}}\",\n    \"titleArticle\": \"Connect to a POS article\",\n    \"titleDish\": \"Connect to a dish\",\n    \"connectAnother\": \"Connect another article\",\n    \"titleCombo\": \"Connect to POS combo\",\n    \"searchCombo\": \"Search combo\"\n  },\n  \"notUsedInDishes\": \"Not used in any dish\",\n  \"usedInDishes_one\": \"Used in {{count}} dish\",\n  \"usedInDishes_other\": \"Used in {{count}} dishes\",\n  \"worst\": {\n    \"empty\": \"No dishes with sales and cost in the selected period.\",\n    \"selectedSubtitle\": \"Lowest total margin within the selection\",\n    \"selectedTitle\": \"Lowest margin\",\n    \"subtitle\": \"Lowest total margin generated\",\n    \"title\": \"Worst-performing dishes\"\n  },\n  \"usedInPrefix\": \"Used in\",\n  \"andMore_one\": \"and {{count}} more\",\n  \"andMore_other\": \"and {{count}} more\"\n}\n"
