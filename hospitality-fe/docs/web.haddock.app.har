ept\",\n  \"digitalizeError_lineItemProductID\": \"Line code\",\n  \"digitalizeError_lineItemQuantity\": \"Line quantity\",\n  \"digitalizeError_lineItemUOM\": \"Line unit of measure\",\n  \"digitalizeError_lineItemUnitPrice\": \"Line unit price\",\n  \"digitalizeError_lineMissingDiscount\": \"Missing discount\",\n  \"digitalizeError_lineWrongQuantity\": \"Incorrect line quantity\",\n  \"digitalizeError_lineWrongTotalPrice\": \"Incorrect line total price\",\n  \"digitalizeError_lineWrongUnitPrice\": \"Incorrect line unit price\",\n  \"digitalizeError_lineWrongUom\": \"Incorrect line UOM\",\n  \"digitalizeError_one\": \"Error\",\n  \"digitalizeError_other\": \"Other (specify in comments)\",\n  \"digitalizeError_missingLines\": \"Missing lines\",\n  \"digitalizeError_product\": \"Product\",\n  \"digitalizeError_productDetails\": \"Products (Details)\",\n  \"digitalizeError_productGrouping\": \"Product grouping\",\n  \"digitalizeError_rejected\": \"Rejected\",\n  \"digitalizeError_rejectedDocument\": \"Rejected document\",\n  \"digitalizeError_supplier\": \"Supplier\",\n  \"digitalizeError_tax\": \"Taxes\",\n  \"digitalizeError_totalAmount\": \"Total amounts\",\n  \"digitalizeErrorDescription_decimals\": \"Amounts do not have decimals (comma missing)\",\n  \"digitalizeErrorDescription_discounts\": \"The discounts have not been captured correctly\",\n  \"digitalizeErrorDescription_documentIssueDate\": \"The date of the document is incorrect\",\n  \"digitalizeErrorDescription_documentNumber\": \"The document number is incorrect\",\n  \"digitalizeErrorDescription_documentType\": \"The document type has been marked incorrectly\",\n  \"digitalizeErrorDescription_duplicated\": \"The document should have been rejected with the reason \\\"duplicate\\\"\",\n  \"digitalizeErrorDescription_lineItemConcept\": \"The line concept is not correct\",\n  \"digitalizeErrorDescription_lineItemProductID\": \"The line product code is not correct\",\n  \"digitalizeErrorDescription_lineItemQuantity\": \"The quantity captured is not correct\",\n  \"digitalizeErrorDescription_lineItemUOM\": \"The unit of measure is not correct\",\n  \"digitalizeErrorDescription_lineItemUnitPrice\": \"The price per unit captured is not correct\",\n  \"digitalizeErrorDescription_productGrouping\": \"The products have not been grouped correctly\",\n  \"digitalizeErrorDescription_rejected\": \"The document should be rejected\",\n  \"digitalizeErrorDescription_supplier\": \"The indicated supplier is not correct\",\n  \"digitalizeErrorDescription_tax\": \"The taxes are not correct (total, breakdown or line tax)\",\n  \"digitalizeErrorDescription_totalAmount\": \"The total or subtotal is not correct\",\n  \"docDeletedCountdown_one\": \"Removed in <strong>{{count}} day</strong>\",\n  \"docDeletedCountdown_other\": \"Removed in <strong>{{count}} days</strong>\",\n  \"documentDate_short\": \"Document date\",\n  \"dueDate\": \"Due date\",\n  \"documentNumber\": \"Document number\",\n  \"documentNumber_short\": \"Document No.\",\n  \"documentPayment\": \"Document payment\",\n  \"doNotAskAgainApplyDirectly\": \"Do not ask for confirmation again, apply directly\",\n  \"duplicated\": \"Duplicated document\",\n  \"edit\": \"Edit document\",\n  \"errorLineItemName\": \"Complete the \\\"Product\\\" field before saving.\",\n  \"errorPendingCorrection\": \"Error pending correction\",\n  \"expenseRecurrent\": \"Recurrent\",\n  \"finalDateTooltip\": \"Until what date should this document be created\",\n  \"repeatIndefinitely\": \"Repeat indefinitely\",\n  \"repeatIndefinitelyTooltip\": \"Turn off to set an end date\",\n  \"fullyReviewed\": \"Document fully reviewed\",\n  \"generalInfo\": \"General information\",\n  \"howToUpload\": \"How to upload documents\",\n  \"imageCount\": \"{{count}} Images\",\n  \"imageCount_one\": \"{{count}} Image\",\n  \"information\": \"Document information\",\n  \"invalidPdf\": \"The PDF file is invalid\",\n  \"invalidType\": \"Invalid document format\",\n  \"keepEditingTheDocument\": \"Keep to modify the document\",\n  \"lastEdit\": \"Last modified\",\n  \"markAsErrorAgain\": \"Mark as error again\",\n  \"markAsSolved\": \"Mark as resolved\",\n  \"missingInformation\": \"Information is missing from the document\",\n  \"missingPages\": \"Missing pages in the document\",\n  \"monthlyPaymentTerm\": \"Payment term in arrears\",\n  \"moreThanOneDocument\": \"More than one document per file\",\n  \"needsChanges\": \"The document still requires changes\",\n  \"needsChangesDescription\": \"The revisions have been updated, but there are still things to review.\",\n  \"noDetails\": \"We will not consider the details\",\n  \"noDetailsDescription\": \"The details of this document will not be considered for the recurrence.\",\n  \"noProductsCategory\": \"Details of documents or suppliers in this category are not displayed in products. To view them, <2>edit the supplier's category here</2>.\",\n  \"noProductsDocumentType\": \"This is an invoice and for this supplier, only delivery note details are shown under products.\",\n  \"noRecurrent\": \"Not repeated\",\n  \"manualExpense\": \"Origin\",\n  \"manuallyCreated\": \"Manually created\",\n  \"notManuallyCreated\": \"Digitalized\",\n  \"notRecurrent\": \"Not recurrent\",\n  \"observationsPlaceholder\": \"Add your observations here...\",\n  \"observationsWarningDescription\": \"This field is for general observations. Incidents should be reported in the Incidents tab.\",\n  \"observationsWarningTitle\": \"Important\",\n  \"onePerUpload\": \"One document per upload\",\n  \"only-images-error\": \"Only images can be uploaded. PDFs are not allowed in this process.\",\n  \"paymentDate\": \"Payment date\",\n  \"paymentStatus_short\": \"Payment status\",\n  \"pdf-encrypted-error\": \"We cannot upload this document as it is password protected.\\nPlease only upload documents that do not require a password to be read.\",\n  \"pdf-invalid-error\": \"We cannot upload this document as it seems to have some issues.\\nPlease double check that the file is ok and try again.\",\n  \"permanentDeletedDocument\": \"Document permanently deleted\",\n  \"poorQuality\": \"Document with poor image quality\",\n  \"processed\": \"Processed document\",\n  \"questionFinanceInvoice\": \"Do you want to finance this invoice?\",\n  \"recurrent\": \"Recurrence\",\n  \"recurrenceRequiresSupplier\": \"A supplier must be assigned to this expense before creating a recurrence. Please edit the expense and assign a supplier first.\",\n  \"recurrentTooltip\": \"Select to have this expense created automatically from now on\",\n  \"recurringMeasure\": \"Repeat every\",\n  \"recurringStartDate\": \"Based on the date of the document\",\n  \"reportDigitalizeError\": \"Report an error\",\n  \"reportDigitalizeErrorDescription\": \"Are there any errors in the digitalization? Let us know what the error is so that the system learns from it and does not repeat itself.\",\n  \"reportDocumentError\": \"Report an error in document\",\n  \"reportedErrorFilter\": \"Error filter\",\n  \"reportErrorCorrectionDescription1\": \"Is there any error in the scanning?\",\n  \"reportErrorCorrectionDescription2\": \"Our team continually reviews notifications and will correct the issue. Please note that changes will be made to the document.\",\n  \"reportErrorCorrectionDescription3\": \"We'll also use this information to improve the system and prevent the problem from recurring.\",\n  \"reportErrorCorrectionTitle\": \"Request correction of an error\",\n  \"reportReasonPlaceholder\": \"Select what problem there is\",\n  \"reportResolutionOptionHaddock\": \"I want haddock to fix it\",\n  \"reportResolutionOptionSelf\": \"I'll fix it\",\n  \"requestDocumentCorrection\": \"Request correction of an error in the document\",\n  \"requestErrorCorrection\": \"Request correction\",\n  \"retrieve\": \"Retrieve document\",\n  \"reviewDocument\": \"Review document\",\n  \"reviewDocumentAlert\": \"Review the details of the document\",