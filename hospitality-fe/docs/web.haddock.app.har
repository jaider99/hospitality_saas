ption\": \"Verify that the mandatory rows are filled in with the correct format.\",\n  \"importProducts\": \"Import products\",\n  \"importProductsExcel\": \"Import products in Excel\",\n  \"infoMergedProduct\": \"This is a merged product visit products section for more information.\",\n  \"insertConversionError\": \"Insert conversion to continue with product merge\",\n  \"internalCode\": \"Internal product code\",\n  \"itemTotal_desktop\": \"Item total\",\n  \"itemTotal\": \"Total\",\n  \"itemTotal_mobile\": \"Total\",\n  \"lastPurchasePrice\": \"Last purchase price\",\n  \"lastReferencePrice\": \"Price of the <strong>last purchase</strong>\",\n  \"lineItems\": {\n    \"amount\": \"Quantity\",\n    \"discountAmount\": \"Applied discount\",\n    \"discountPercentage\": \"Discounts\",\n    \"foreignID\": \"Supplier code\",\n    \"name\": \"Description\",\n    \"nominalPricePerUnit\": \"Unit price\",\n    \"otherFees\": \"Other fees\",\n    \"pricePerUnit\": \"Unit price\",\n    \"priceWithVat\": \"Price with VAT\",\n    \"quantity\": \"Quantity\",\n    \"subtotal\": \"Base\",\n    \"taxGreenDot\": \"Green Dot\",\n    \"taxIbee\": \"IBEE\",\n    \"taxOthers\": \"Other taxes\",\n    \"taxRate\": \"Tax rate\",\n    \"total\": \"Total\",\n    \"type-additionalTaxes\": \"Additional taxes\",\n    \"type-discounts\": \"Discounts\",\n    \"unitOfMeasure\": \"Format\"\n  },\n  \"loadingProducts\": \"Loading products...\",\n  \"makeSureFilledTemplateFields\": \"If all mandatory fields are not filled in there will be an error and the file will not be uploaded.\",\n  \"matchingDescription\": \"Suggestions for new products detected that could already be in haddock. Help us confirm if they are new or if they correspond to one that already exists. We will give you more precise data to help you make better decisions for your business.\",\n  \"merging\": \"Merging...\",\n  \"missingConversion\": \"Missing conversion\",\n  \"missingProducts\": \"Missing a product? Add them here\",\n  