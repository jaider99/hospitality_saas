            "mimeType": "application/json",
            "text": "{\n  \"addSupplier\": \"Add supplier\",\n  \"categorisationInfo\": \"The categorisation shows amounts based on the products identified in each invoice. These values may differ from the dashboard totals, which are calculated at invoice level.\",\n  \"categoryBreakdown\": \"Breakdown by category\",\n  \"comparator\": \"Compare\",\n  \"compare\": \"Compare\",\n  \"compareSuppliers\": \"Compare suppliers\",\n  \"costSales\": \"Cost of sales\",\n  \"dashboardFilters\": \"Dashboard filters\",\n  \"dateDetails\": \"{{date}} details\",\n  \"dateResume\": \"{{date}} summary\",\n  \"detailedDashboard\": \"Detailed dashboard\",\n  \"expensesBreakdown\": \"Expenses breakdown\",\n  \"percentageOverExpenses\": \"{{percentage}} over expenses\",\n  \"percentageOverSales\": \"{{percentage}} over sales\",\n  \"exportExpenses\": \"Expenses\",\n  \"exportSales\": \"Sales\",\n  \"generalView\": \"General view\",\n  \"groupView\": \"Group results\",\n  \"lastExpenses\": \"Latest expenses\",\n  \"lastSales\": \"Latest sales\",\n  \"monthly\": \"Monthly\",\n  \"noDataForPeriod\": \"Looks like there are not any sales or expenses for this period\",\n  \"noExpensesYet\": \"Oops... It looks like there are no expenses yet\",\n  \"noRealTimeDescription\": \"<0>In the general graphs you see the amount of:\\n\\n<2><0><0>All invoices</0></0><1><0>Unreconciled tickets</0></1><2><0>All personnel expenses</0></2></2>\\n\\n*Delivery notes are not shown to ensure that the amount is not duplicated, to see them, activate the dashboard mode \\\"real time\\\"</0>\",\n  \"noRealTimeDescription3\": \"<0>In the general graphs you see the amount of:\\n\\n<2><0><0>All invoices</0></0><1><0>Unreconciled tickets</0></1></2>\\n\\n*Delivery notes are not shown to ensure that the amount is not duplicated, to see them, activate the dashboard mode \\\"real time\\\"</0>\",\n  \"noResultsYet\": \"WE ARE MISSING INFORMATION TO CREATE THE RESULTS\",\n  \"noSalesYet\": \"Oops... It looks like there are no sales yet\",\n  \"quarterly\": \"Quarterly\",\n  \"realTime\": \"Real time\",\n  \"realTimeDescription\": \"<0>In the real time graphs you see the amount of:\\n\\n<2><0><0>Supplier invoices that do not have delivery notes</0> (By showing all delivery notes, we ensure that the amount is not duplicated)</0><1><0>All delivery notes</0> (Allows you to see in real time the expenses that are being generated without having to wait to receive the invoice)</1><2><0>All tickets</0></2><3><0>All personnel expenses</0></3></2></0>\",\n  \"realTimeDescription3\": \"<0>In the real time graphs you see the amount of:\\n\\n<2><0><0>Supplier invoices that do not have delivery notes</0> (By showing all delivery notes, we ensure that the amount is not duplicated)</0><1><0>All delivery notes</0> (Allows you to see in real time the expenses that are being generated without having to wait to receive the invoice)</1><2><0>All tickets</0></2></2></0>\",\n  \"realTimeView\": \"Real time view\",\n  \"salesBreakdown\": \"Sales breakdown\",\n  \"salesExpenses\": \"Sales and expenses\",\n  \"searchAndSelectSuppliers\": \"Search and select which providers you want to compare the expenses of.\",\n  \"seeFullList\": \"See full list\",\n  \"seeGroupView\": \"See group results\",\n  \"selectionLimitReached\": \"You have reached the selection limit\",\n  \"typeProviderName\": \"Type a supplier name\",\n  \"unselectToSelect\": \"You can't select more than {{maxElements}} elements. Deselect some elements to select others.\",\n  \"uploadFirstExpense\": \"Upload invoices/delivery notes in pdf or with a simple photo to  digitize them or create manual expenses.\",\n  \"uploadFirstSale\": \"Connect your POS or upload your restaurant's sales manually by channel, shifts, payment method...\",\n  \"uploadSalesExpenses\": \"Monitor your restaurant's expenses and sales to see the analysis of your restaurant's margin and activity.\",\n  \"weekly\": \"Weekly\",\n  \"withoutVAT\": \"w/o {{ taxName }}\",\n  \"withVAT\": \"w/ {{ taxName }}\",\n  \"yearCount\": \"Year 2022\",\n  \"yearly\": \"Yearly\",\n  \"costModeGeneralTooltip\": \"Calculated from invoices and tickets.\",\n  \"costModeRealtimeTooltip\": \"Calculated from delivery notes received (including reconciled ones).\",\n  \"costLevelProduct\": \"Products\",\n  \"costLevelExpense\": \"Expenses\",\n  \"costLevelProductTooltip\": \"Groups cost by each item's product category (more detail).\",\n  \"costLevelExpenseTooltip\": \"Groups cost by the expense document's category.\"\n}\n"
          },
