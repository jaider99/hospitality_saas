            "text": "{\n  \"activeTab\": \"Activos ({{count}})\",\n  \"allTab\": \"Todos ({{count}})\",\n  \"availabilityClosed\": \"Chat no disponible\",\n  \"availabilityOpen\": \"Chat disponible\",\n  \"attachmentAddButton\": \"Añadir imágenes\",\n  \"attachmentHelp\": \"PNG, JPG o WebP. Hasta {{count}} imágenes de {{size}} MB cada una.\",\n  \"attachmentInvalidType\": \"Solo se pueden adjuntar imágenes PNG, JPG o WebP.\",\n  \"attachmentLabel\": \"Imágenes\",\n  \"attachmentListLabel\": \"Imágenes adjuntas\",\n  \"attachmentMaxFiles\": \"Puedes adjuntar hasta {{count}} imágenes.\",\n  \"attachmentMaxSize\": \"Cada imagen debe ocupar {{size}} MB o menos.\",\n  \"attachmentRemoveButton\": \"Quitar {{name}}\",\n  \"createErrorDescription\": \"No se ha podido crear el ticket. Vuelve a intentarlo en unos minutos.\",\n  \"createErrorTitle\": \"Error al enviar\",\n  \"createSuccessTitle\": \"Ticket creado\",\n  \"createSuccessToast\": \"Ticket de soporte creado\",\n  \"description\": \"Hola, cuéntanos qué necesitas y nuestro equipo te responderá lo antes posible.\",\n  \"descriptionWithName\": \"Hola {{name}}, cuéntanos qué necesitas y nuestro equipo te responderá lo antes posible.\",\n  \"descriptionHelp\": \"{{count}}/5000 caracteres\",\n  \"descriptionLabel\": \"Descripción\",\n  \"descriptionPlaceholder\": \"Describe el problema, qué esperabas que pasara y cualquier detalle relevante.\",\n  \"emailLabel\": \"Email\",\n  \"emptyTicketsDescription\": \"Cuando abras un ticket, aparecerá aquí.\",\n  \"emptyTicketsTitle\": \"Sin tickets en esta vista\",\n  \"eyebrow\": \"Soporte\",\n  \"externalCategoryEmptyError\": \"No hay categorías disponibles.\",\n  \"externalCategoryLabel\": \"Categoría\",\n  \"externalCategoryLoadError\": \"No se han podido cargar las categorías.\",\n  \"externalCategoryPlaceholder\": \"Selecciona una categoría\",\n  \"formDescription\": \"Usaremos estos datos para asociar el ticket a tu usuario.\",\n  \"formTitle\": \"Nuevo ticket\",\n  \"missingEmailError\": \"Tu usuario necesita un email para abrir tickets.\",\n  \"nameLabel\": \"Nombre\",\n  \"noPropertyDescription\": \"Selecciona un restaurante para contactar con soporte.\",\n  \"noPropertyTitle\": \"Sin restaurante seleccionado\",\n  \"openChatButton\": \"Abrir mensajes\",\n  \"replyButton\": \"Enviar respuesta\",\n  \"replyErrorDescription\": \"No se ha podido enviar la respuesta. Vuelve a intentarlo en unos minutos.\",\n  \"replyErrorTitle\": \"Error al responder\",\n  \"replyHelp\": \"{{count}}/5000 caracteres\",\n  \"replyLabel\": \"Respuesta\",\n  \"replyPendingButton\": \"Enviando\",\n  \"replyPlaceholder\": \"Escribe una respuesta...\",\n  \"replySuccessToast\": \"Respuesta enviada\",\n  \"replyUnavailablePlaceholder\": \"Esta conversación ya no admite respuestas desde aquí.\",\n  \"retryButton\": \"Reintentar\",\n  \"solvedTab\": \"Resueltos ({{count}})\",\n  \"submitButton\": \"Enviar ticket\",\n  \"submitPendingButton\": \"Enviando\",\n  \"submitterLabel\": \"Se enviará como\",\n  \"ticketStatus\": {\n    \"closed\": \"Cerrado\",\n    \"hold\": \"En espera\",\n    \"new\": \"Nuevo\",\n    \"open\": \"Abierto\",\n    \"pending\": \"Pendiente\",\n    \"solved\": \"Resuelto\"\n  },\n  \"ticketAttachmentListLabel\": \"Imágenes del comentario\",\n  \"ticketAttachmentOpenLabel\": \"Abrir imagen {{filename}}\",\n  \"ticketCommentAuthorRequester\": \"Tú\",\n  \"ticketCommentAuthorSupport\": \"Soporte\",\n  \"ticketConversationSource\": {\n    \"comment\": \"Formulario\",\n    \"messaging\": \"Chat\"\n  },\n  \"ticketDetailErrorDescription\": \"No se ha podido cargar el detalle del ticket.\",\n  \"ticketDetailErrorTitle\": \"Error al cargar el ticket\",\n  \"ticketDetailLoading\": \"Cargando conversación del ticket\",\n  \"ticketDetailMetadata\": \"{{property}} · Actualizado {{date}}\",\n  \"ticketDetailTitle\": \"Detalle del ticket\",\n  \"ticketOpenDetailLabel\": \"Abrir ticket {{subject}}\",\n  \"ticketReplyUnavailableHelp\": \"Esta conversación y