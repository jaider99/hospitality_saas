            "text": "{\n  \"breakdown\": {\n    \"columns\": {\n      \"item\": \"Category / article\",\n      \"total\": \"Total\"\n    },\n    \"description\": \"Categories and articles consolidated by exact display name in each property.\",\n    \"empty\": \"No sales match this search.\",\n    \"emptyPeriod\": \"No sales in the selected period.\",\n    \"noData\": \"No data\",\n    \"noDataTooltip\": \"No sales recorded for this location in the selected period.\",\n    \"searchPlaceholder\": \"Search category or article\",\n    \"title\": \"Sales breakdown by property\",\n    \"unitsSuffix\": \"units\"\n  },\n  \"channel\": {\n    \"channels\": {\n      \"delivery\": \"Delivery\",\n      \"diningRoom\": \"Dining room\",\n      \"events\": \"Events\",\n      \"other\": \"Other\",\n      \"terrace\": \"Terrace\"\n    },\n    \"description\": \"Breakdown by channel · {{range}}\",\n    \"title\": \"Sales by channel\"\n  },\n  \"comparison\": {\n    \"previousMonth\": {\n      \"label\": \"vs. previous month\",\n      \"shortLabel\": \"previous\"\n    },\n    \"previousQuarter\": {\n      \"label\": \"vs. previous quarter\",\n      \"shortLabel\": \"previous\"\n    },\n    \"previousYear\": {\n      \"label\": \"vs. previous year\",\n      \"labelWithYear\": \"vs. previous year\",\n      \"shortLabel\": \"previous\"\n    },\n    \"none\": {\n      \"label\": \"No comparison\",\n      \"shortLabel\": \"period\",\n      \"legend\": \"no comparison\"\n    }\n  },\n  \"daily\": {\n    \"columns\": {\n      \"location\": \"Location\"\n    },\n    \"empty\": \"No sales for this period.\"\n  },\n  \"dates\": {\n    \"pendingRange\": \"Pending range\",\n    \"selectDate\": \"Select date\",\n    \"selectDates\": \"Select dates\"\n  },\n  \"emptyState\": {\n    \"title\": \"Connect your POS and see how your sales are doing\",\n    \"description\": \"You'll see your revenue, your tickets and your best-selling dishes, location by location.\",\n    \"action\": \"Connect POS\"\n  },\n  \"hero\": {\n    \"title\": \"Sales\"\n  },\n  \"payment\": {\n    \"description\": \"Monthly evolution by method · {{range}}\",\n    \"methods\": {\n      \"appDelivery\": \"Delivery app\",\n      \"bizum\": \"Bizum\",\n      \"card\": \"Card\",\n      \"cash\": \"Cash\",\n      \"other\": \"Other\"\n    },\n    \"title\": \"Sales by payment method\"\n  },\n  \"properties\": {\n    \"all\": \"All properties\",\n    \"count_one\": \"{{count}} property\",\n    \"count_other\": \"{{count}} properties\",\n    \"emptyText\": \"No properties.\",\n    \"other\": \"Other\",\n    \"placeholder\": \"Select properties\",\n    \"searchPlaceholder\": \"Search properties\"\n  },\n  \"status\": {\n    \"breakdownError\": \"We couldn't load the sales breakdown by property.\",\n    \"chartsError\": \"We couldn't load the sales charts.\",\n    \"error\": \"We couldn't load sales.\",\n    \"historyError\": \"We couldn't load the sales history.\",\n    \"historyPartialError\": \"We couldn't load sales for some locations: {{locations}}.\",\n    \"loading\": \"Loading group sales...\",\n    \"summaryError\": \"We couldn't load the sales summary.\"\n  },\n  \"summary\": {\n    \"averageTicketInfo\": \"Total sales ÷ number of tickets. Manual or imported sales are included.\",\n    \"averageTicketNoDataInfo\": \"There are no tickets in this period, so the average ticket can't be calculated.\",\n    \"deltaComparison\": \"{{delta}} vs {{comparison}}\",\n    \"dinersInfo\": \"Number of diners recorded on the period's tickets.\",\n    \"metrics\": {\n      \"averageTicket\": \"Average ticket\",\n      \"diners\": \"Diners\",\n      \"totalSales\": \"Total sales\"\n    },\n    \"noData\": \"No data\",\n    \"noVat\": \"(excl. VAT)\",\n    \"perTicket\": \"/ticket\"\n  },\n  \"tabs\": {\n    \"summary\": \"Summary\"\n  },\n  \"ticketByShift\": {\n    \"description\": \"Daily average by shift · {{range}}\",\n    \"empty\": {\n      \"description\": \"These sales have no diners (manual, imported or ticketless), so the average ticket can't be calculated.\",\n      \"title\": \"No average ticket data\"\n    },\n    \"shifts\": {\n      \"all\": \"Total\",\n      \"morning\": \"Morning\",\n      \"night\": \"Night\",\n      \"noon\": \"Midday\",\n      \"otros\": \"Other\"\n    },\n    \"title\": \"Average ticket by group and shift\"\n  },\n  \"weekdays\": {\n    \"friday\": \"Fri\",\n    \"monday\": \"Mon\",\n    \"saturday\": \"Sat\",\n    \"sunday\": \"Sun\",\n    \"thursday\": \"Thu\",\n    \"tuesday\": \"Tue\",\n    \"wednesday\": \"Wed\"\n  }\n}\n"
