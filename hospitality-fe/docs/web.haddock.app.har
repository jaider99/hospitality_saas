izeError_incorrectVAT\": \"Información de {{ taxName }} incorrecta\",\n  \"digitalizeError_lineItemConcept\": \"Concepto de línea\",\n  \"digitalizeError_lineItemProductID\": \"Código de línea\",\n  \"digitalizeError_lineItemQuantity\": \"Cantidad de línea\",\n  \"digitalizeError_lineItemUOM\": \"Unidad de medida de línea\",\n  \"digitalizeError_lineItemUnitPrice\": \"Precio unitario de línea\",\n  \"digitalizeError_lineMissingDiscount\": \"Falta el descuento en una línea\",\n  \"digitalizeError_lineWrongQuantity\": \"Cantidad de línea incorrecta\",\n  \"digitalizeError_lineWrongTotalPrice\": \"Precio total de línea incorrecto\",\n  \"digitalizeError_lineWrongUnitPrice\": \"Precio unitario de línea incorrecto\",\n  \"digitalizeError_lineWrongUom\": \"Unidad de medida de línea incorrecta\",\n  \"digitalizeError_one\": \"Error\",\n  \"digitalizeError_other\": \"Otros (especificar en comentarios)\",\n  \"digitalizeError_missingLines\": \"Faltan líneas\",\n  \"digitalizeError_product\": \"Producto\",\n  \"digitalizeError_productDetails\": \"Productos (Detalles)\",\n  \"digitalizeError_productGrouping\": \"Agrupación de productos\",\n  \"digitalizeError_rejected\": \"Rechazado\",\n  \"digitalizeError_rejectedDocument\": \"Documento rechazado\",\n  \"digitalizeError_supplier\": \"Proveedor\",\n  \"digitalizeError_tax\": \"Impuestos\",\n  \"digitalizeError_totalAmount\": \"Cantidades totales\",\n  \"digitalizeErrorDescription_decimals\": \"Las cantidades no tienen decimales (falta la coma)\",\n  \"digitalizeErrorDescription_discounts\": \"Los descuentos no han sido capturados correctamente\",\n  \"digitalizeErrorDescription_documentIssueDate\": \"La fecha del documento es incorrecta\",\n  \"digitalizeErrorDescription_documentNumber\": \"El número del documento es incorrecto\",\n  \"digitalizeErrorDescription_documentType\": \"El tipo del documento ha sido marcado incorrectamente\",\n  \"digitalizeErrorDescription_duplicated\": \"El documento debería haber sido rechazado co