          "content": {
            "size": 16431,
            "mimeType": "application/json",
            "text": "{\n  \"author\": \"Autor\",\n  \"availableSoon\": \"Estamos trabajando duro para que esté disponible lo antes posible.\",\n  \"baseUnit\": \"unidades sueltas\",\n  \"baseUnitTooltip\": \"Es la unidad más básica de conversión que extraemos directamente desde la pantalla de configuración del producto.\",\n  \"changePlural\": \"cambios\",\n  \"changeSingle\": \"cambio\",\n  \"closingInventory\": \"Cierre\",\n  \"confirmDeleteTitle\": \"¿Seguro que quieres eliminar este inventario?\",\n  \"connectPosBanner\": \"Es necesario conectar tu TPV para registrar las ventas y calcular el inventario teórico.\",\n  \"editInventory\": \"Editar inventario\",\n  \"editList\": \"Editar lista\",\n  \"emptyStateDescription\": \"Todavía no hay ningún inventario. Crea tu primer inventario ahora.\",\n  \"establishment\": \"Establecimiento\",\n  \"exportInventory\": \"Exportar inventario\",\n  \"exportInventoryDescriptionExcel\": \"Exporta el inventario con los datos actuales para poder editarlo.\",\n  \"exportInventoryDescriptionPDF\": \"Exporta el inventario con campos en blanco para completar manualmente.\",\n  \"exportInventoryError\": \"No se pudo exportar el inventario. Inténtalo de nuevo más tarde.\",\n  \"exportLast\": \"Exportar último inventario\",\n  \"final\": \"Inventario final\",\n  \"goToInventories\": \"Ir a inventarios\",\n  \"hasInitialInventory\": \"Con inventario real\",\n  \"haveEditedProducts\": \"Has editado ({{count}}) productos\",\n  \"initial\": \"Inventario inicial\",\n  \"initialInventorySourceTooltip\": \"Valor obtenido del inventario {{name}} con fecha {{date}}. Las cantidades compradas, vendidas y mermas se calculan desde esa fecha.\",\n  \"inventoriesDescription\": \"Organiza tus existencias de forma más eficaz\",\n  \"inventoryDate\": \"Fecha de inventario\",\n  \"inventoryDateTooltip\": \"La fecha del inventario debe estar comprendida entre su último inventario y la fecha actual para mantener la precisión de los cálculos de CoGS.\",\n  \"inventoryHistory\": \"Histórico de inventarios\",\n  \"inventoryHistory_description\": \"Consulta y exporta el coste total del inventario para tu gestor en un solo click incluyendo todas las secciones de este inventario.\",\n  \"inventoryName\": \"Nombre del inventario\",\n  \"inventoryOf\": \"Inventario de\",\n  \"inventoryTiming\": \"Momento\",\n  \"inventoryTimingTooltip\": \"Inventario de apertura: conteo al inicio del día. Inventario de cierre: conteo al final del día.\",\n  \"inventoryWithoutProducts\": \"No hay productos en este inventario\",\n  \"inWarehouse\": \"En almacén\",\n  \"lastInventory\": \"Último inventario\",\n  \"loadingHistory\": \"Cargando histórico de inventarios...\",\n  \"loadInventoryError\": \"Hubo un error cargando tu inventario\",\n  \"missingConsumedQuantity\": \"Es necesario tener inventarios para calcular el consumo.\",\n  \"missingDeviationQuantity\": \"Es necesario tener el importe consumido para calcular la desviación.\",\n  \"missingInitialQuantity\": \"Es necesario hacer inventario para obtener información precisa.\",\n  \"missingSoldQuantity\": \"Aún no se ha vinculado este producto con un artículo del TPV.\",\n  \"multipleProductFormatsTooltip\": \"{{count}} formatos de producto. Haz click para expandir y seleccionar los elementos individualmente.\",\n  \"multipleSuppliersTooltip\": \"Producto agrupado. Se van a añadir al inventario los {{count}} distintos productos dentro de esta agrupación.\",\n  \"newInventory\": \"Nuevo inventario\",\n  \"newVersion\": \"Nueva versión\",\n  \"newVersion_current\": \"Conservar cantidades\",\n  \"newVersion_empty\": \"Restablecer cantidades a 0\",\n  \"newVersion_resume\": \"Retomar borrador\",\n  \"draftBanner\": \"Tienes cambios sin guardar de una sesión anterior\",\n  \"draftBanner_resume\": \"Retomar\",\n  \"draftBanner_discard\": \"Descartar\",\n  \"noPurchaseHistory\": \"Sin compras\",\n  \"notEnoughDocs\": \"No hay suficientes documentos\",\n  \"notEnoughDocs_description\": \"Para poder acceder a Inventarios tienes que tener al menos 30 documentos y haber subido 15 durante los últimos 30 días.\",\n  \"openInventory\": \"Abrir inventario\",\n  \"openingInventory\": \"Apertura\",\n  \"optionUnavailable\": \"Lo sentimos, esta opción no está disponible todavía.\",\n  \"pastInventories\": \"Inventarios pasados\",\n  \"pastInventories_description\": \"Se muestran los inventarios por orden de exportación de más reciente a menos reciente\",\n  \"performantTheoreticalInventoryLastChanges\": \"Actualizado, últimos cambios: {{date}}\",\n  \"posSales\": \"Ventas TPV\",\n  \"printList\": \"Imprimir lista\",\n  \"product\": \"producto\",\n  \"purchaseFormatTooltip\": \"Es el formato extraído del albarán o factura y proviene del proveedor.\",\n  \"purchasesSinceLastInventory\": \"Compras a partir del último inventario.\",\n  \"purchaseUnits\": \"unidades de compra\",\n  \"quantity\": \"Cantidad\",\n  \"salesSinceLastInventory\": \"Ventas a partir del último inventario.\",\n  \"salesSinceInventoryDate\": \"Ventas desde el inventario {{name}} con fecha {{date}}.\",\n  \"waste\": \"Mermas\",\n  \"wasteSinceLastInventory\": \"Mermas a partir del último inventario.\",\n  \"searchByName\": \"Buscar por nombre\",\n  \"searchInventory\": \"Busca un inventario por mes\",\n  \"searchProducts\": \"Buscar productos en este inventario\",\n  \"selectInventoryTiming\": \"Seleccionar momento...\",\n  \"stockHeld\": \"Inventario realizado\",\n  \"thankYou\": \"Gracias por tu paciencia.\",\n  \"theoretical\": \"Inventario teórico\",\n  \"theoreticalInventoryDateRangeInfo\": \"El inventario teórico calcula las cantidades desde el último inventario real de cada producto. Las compras, ventas y mermas se contabilizan a partir de esa fecha.\",\n  \"totalInventoryValue\": \"Total valor inventario\",\n  \"totalInventoryValueTooltip\": \"Este valor se calcula con el precio de los productos al guardar la versión del inventario.\",\n  \"totalPrice\": \"Precio total\",\n  \"totalUnits\": \"Unidades totales\",\n  \"unitConversionTooltip\": \"La unidad de medida es calculada usando la conversión a unidad base.\",\n  \"units\": \"Unidades\",\n  \"warehouse\": \"almacén\",\n  \"weightedAverageCalculation\": \"Calculado mediante el precio medio ponderado del producto.\",\n  \"withoutStock\": \"Sin stock\",\n  \"reason\": \"Motivo\",\n  \"itemType\": \"Tipo de artículo\",\n  \"itemType.product\": \"Producto\",\n  \"itemType.dish\": \"Plato\",\n  \"wasteRecordReason.theft\": \"Robo\",\n  \"wasteRecordReason.broken\": \"Rotura\",\n  \"wasteRecordReason.personal\": \"Consumo personal\",\n  \"wasteRecordReason.expiration\": \"Caducidad\",\n  \"searchByProductOrDish\": \"Buscar por nombre de producto o plato\",\n  \"editWasteRecord\": \"Editar\",\n  \"deleteWasteRecord\": \"Eliminar\",\n  \"newWasteRecord\": \"Nueva merma\",\n  \"filterWasteRecordsDescription\": \"Filtrar mermas por fecha, tipo y razón\",\n  \"registerWasteRecord\": \"Registrar merma\",\n  \"registerWasteDescription\": \"Registra pérdidas de inventario por robo, rotura, consumo personal o caducidad\",\n  \"selectItem\": \"Seleccionar un artículo\",\n  \"selectReason\": \"Seleccionar un motivo\",\n  \"wasteDate\": \"Fecha de merma\",\n  \"selectWasteDate\": \"Seleccionar fecha de merma\",\n  \"notes\": \"Notas\",\n  \"notesPlaceholder\": \"Añade cualquier detalle adicional sobre esta merma...\",\n  \"wasteRecordCreatedSuccess\": \"Merma registrada correctamente\",\n  \"wasteRecordCreatedError\": \"Error al registrar la merma. Por favor, inténtalo de nuevo.\",\n  \"validationProductRequired\": \"El producto es obligatorio\",\n  \"validationDishRequired\": \"El plato es obligatorio\",\n  \"validationQuantityPositive\": \"La cantidad debe ser mayor que 0\",\n  \"validationUnitRequired\": \"La unidad de medida es requerida\",\n  \"validationReasonRequired\": \"El motivo es requerido\",\n  \"deleteWasteConfirmation\": \"¿Estás seguro de que quieres eliminar la merma de {{name}}?\",\n  \"wasteRecordDeletedSuccess\": \"Merma eliminada correctamente\",\n  \"wasteRecord\": \"merma\",\n  \"editWasteTitle\": \"Editar merma\",\n  \"editWasteDescription\": \"Actualiza el motivo, la cantidad o las notas de esta merma\",\n  \"wasteRecordUpdatedSuccess\": \"Merma actualizada correctamente\",\n  \"wasteRecordUpdatedError\": \"Error al actualizar la merma. Por favor, inténtalo de nuevo.\",\n  \"wasteRecordIngredients\": \"Ingredientes afectados\",\n  \"ingredientName\": \"Ingrediente\",\n  \"lostQuantity\": \"Cantidad perdida\",\n  \"noIngredients\": \"No se encontraron ingredientes\",\n  \"noWasteRecordsFound\": \"No se encontraron mermas\",\n  \"noWasteRecordsFoundDescription\": \"No hay mermas que coincidan con los filtros seleccionados. Intenta ajustar los filtros o registra una nueva merma.\",\n  \"resetFilters\": \"Limpiar filtros\",\n  \"registerWaste\": \"Registrar merma\",\n  \"resetConfirmTitle\": \"Restablecer todas las cantidades?\",\n  \"resetConfirmDescription\": \"Esto restablecerá los {{count}} productos y platos a 0. El valor actual de tu inventario es {{value}}. Puedes editar cantidades individuales antes de guardar.\",\n  \"resetConfirmButton\": \"Restablecer a 0\",\n  \"bulkZeroWarningTitle\": \"La mayoría de cantidades están a 0\",\n  \"bulkZeroWarningDescription\": \"Estás a punto de guardar {{count}} artículos con cantidad 0. Asegúrate de que es intencionado.\",\n  \"saveStaleDraftError\": \"Algunos productos del inventario han cambiado. Hemos descartado tus cambios pendientes; vuelve a introducir las cantidades.\",\n  \"preparationProductions\": {\n    \"tab\": \"Producciones\",\n    \"newProduction\": \"Nueva producción\",\n    \"registerProduction\": \"Registrar producción\",\n    \"registerProductionDescription\": \"Registra la cantidad producida de una preparación local. La unidad se toma de la preparación seleccionada.\",\n    \"preparation\": \"Preparación\",\n    \"selectPreparation\": \"Seleccionar preparación\",\n    \"searchPreparation\": \"Buscar preparaciones\",\n    \"noPreparationsFound\": \"No se encontraron preparaciones\",\n    \"quantityProduced\": \"Cantidad producida\",\n    \"producedAt\": \"Producida el\",\n    \"stockEffectsInfo\": \"Las producciones de preparaciones suman stock a la preparación seleccionada y consumen sus ingredientes en el inventario teórico.\",\n    \"emptyTitle\": \"No se encontraron producciones de preparaciones\",\n    \"emptyDescription\": \"Registra una producción cuando la cocina central termine de elaborar una preparación local.\",\n    \"errorTitle\": \"No se pudieron cargar las producciones de preparaciones\",\n    \"errorDescription\": \"Intenta actualizar la página o revisar los filtros.\",\n    \"createSuccess\": \"Producción de preparación registrada correctamente\",\n    \"createError\": \"Error al registrar la producción de preparación. Por favor, inténtalo de nuevo.\",\n    \"cancelProduction\": \"Cancelar producción\",\n    \"cancelProductionTitle\": \"Cancelar producción de preparación\",\n    \"cancelProductionDescription\": \"Explica por qué debe cancelarse la producción de {{name}}.\",\n    \"cancellationReason\": \"Motivo de cancelación\",\n    \"cancellationReasonPlaceholder\": \"Describe por qué se cancela esta producción\",\n    \"cancelSuccess\": \"Producción de preparación cancelada correctamente\",\n    \"cancelError\": \"Error al cancelar la producción de preparación. Por favor, inténtalo de nuevo.\",\n    \"validationPreparationRequired\": \"Selecciona una preparación\",\n    \"validationProducedAtRequired\": \"Selecciona fecha y hora de producción\",\n    \"status\": {\n      \"completed\": \"Completada\",\n      \"cancelled\": \"Cancelada\"\n    }\n  },\n  \"transfers\": {\n    \"emptyTitle\": \"Todavía no hay transferencias\",\n    \"emptyDescription\": \"Registra una transferencia de formatos de producto o preparaciones a otro establecimiento del mismo grupo. Los niveles de inventario se actualizarán cuando se confirme.\",\n    \"lineSummary_one\": \"{{count}} línea\",\n    \"lineSummary_other\": \"{{count}} líneas\",\n    \"newTransfer\": \"Nueva transferencia\",\n    \"createTitle\": \"Nueva transferencia\",\n    \"createDescription\": \"Mueve stock a otro establecimiento del grupo.\",\n    \"sourceProperty\": \"Establecimiento origen\",\n    \"targetProperty\": \"Establecimiento destino\",\n    \"targetPropertyPlaceholder\": \"Selecciona destino\",\n    \"noTargetProperties\": \"No hay otros establecimientos del grupo disponibles para transferencias.\",\n    \"noAuthorizedTargetProperties\": \"No hay establecimientos de destino disponibles para esta transferencia porque necesitas permiso para crear inventarios en el establecimiento de destino.\",\n    \"lines\": \"Líneas\",\n    \"lineTitle\": \"Línea {{number}}\",\n    \"lineType\": \"Tipo\",\n    \"productFormat\": \"Formato de producto\",\n    \"preparation\": \"Preparación\",\n    \"item\": \"Artículo\",\n    \"itemPlaceholder\": \"Selecciona artículo\",\n    \"itemSearchPlaceholder\": \"Buscar productos o preparaciones\",\n    \"productSearchPlaceholder\": \"Buscar formatos de producto\",\n    \"preparationSearchPlaceholder\": \"Buscar preparaciones\",\n    \"noProductFormatsFound\": \"No se han encontrado formatos de producto\",\n    \"noPreparationsFound\": \"No se han encontrado preparaciones\",\n    \"noItemsFound\": \"No se han encontrado productos ni preparaciones\",\n    \"addLine\": \"Añadir línea\",\n    \"removeLine\": \"Eliminar\",\n    \"quantity\": \"Cantidad\",\n    \"createSuccess\": \"Transferencia registrada correctamente\",\n    \"createError\": \"No se ha podido crear la transferencia. Inténtalo de nuevo.\",\n    \"status\": {\n      \"draft\": \"Borrador\",\n      \"sent\": \"Enviada\",\n      \"received\": \"Recibida\",\n      \"cancelled\": \"Cancelada\"\n    },\n    \"outgoingTab\": \"Enviadas\",\n    \"incomingTab\": \"Recibidas\",\n    \"outgoingEmptyTitle\": \"No hay transferencias enviadas\",\n    \"outgoingEmptyDescription\": \"Envía stock a otro establecimiento.\",\n    \"incomingEmptyTitle\": \"No hay transferencias recibidas\",\n    \"incomingEmptyDescription\": \"Las transferencias entrantes aparecerán aquí.\",\n    \"receive\": \"Recibir\",\n    \"send\": \"Enviar\",\n    \"cancelTransfer\": \"Cancelar transferencia\",\n    \"viewOlder\": \"Ver anteriores\",\n    \"receivedAt\": \"Recibida el\",\n    \"sentAt\": \"Enviada el\",\n    \"createdAt\": \"Creada el\",\n    \"sendSuccess\": \"Transferencia enviada correctamente\",\n    \"sendError\": \"No se ha podido enviar la transferencia. Inténtalo de nuevo.\",\n    \"receiveSuccess\": \"Transferencia recibida correctamente\",\n    \"receiveError\": \"No se ha podido recibir la transferencia. Inténtalo de nuevo.\",\n    \"cancelSuccess\": \"Transferencia cancelada correctamente\",\n    \"cancelError\": \"No se ha podido cancelar la transferencia. Inténtalo de nuevo.\",\n    \"validation\": {\n      \"items\": \"Añade al menos un artículo para crear esta transferencia.\",\n      \"itemLine\": \"Elige un formato de producto o una preparación para esta línea de transferencia.\",\n      \"quantityLine\": \"Introduce una cantidad de transferencia mayor que cero para esta línea.\",\n      \"destination\": \"Elige dónde enviar esta transferencia.\"\n    },\n    \"createAndSend\": \"Crear y enviar transferencia\",\n    \"sendPartialError\": \"Se ha creado el borrador, pero ha fallado el envío. Cierra este diálogo y vuelve a intentar enviarlo o cancela el borrador desde las transferencias enviadas.\",\n    \"cancelledAt\": \"Cancelado el\",\n    \"detailTitle\": \"Detalle de la transferencia\",\n    \"detailDescription\": \"Revisa el contexto de la transferencia y la siguiente acción disponible.\",\n    \"directionSummary\": {\n      \"outgoing\": \"Hacia {{property}}\",\n      \"incoming\": \"Desde {{property}}\"\n    },\n    \"lifecycleTitle\": \"Ciclo de vida\",\n    \"linesTitle\": \"Líneas de la transferencia\",\n    \"d