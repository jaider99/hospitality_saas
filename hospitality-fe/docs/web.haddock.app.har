ents\",\n  \"chatEmptyKpiIncidentsLabel\": \"I found\",\n  \"chatEmptyKpiIncidentsUnit_one\": \"incident\",\n  \"chatEmptyKpiIncidentsUnit_other\": \"incidents\",\n  \"chatEmptyKpiReconciledLabel\": \"I made\",\n  \"chatEmptyKpiReconciledUnit_one\": \"reconciliation\",\n  \"chatEmptyKpiReconciledUnit_other\": \"reconciliations\",\n  \"chatEmptyKpisHeading\": \"Recap of the last 30 days\",\n  \"chatEmptyQuestion\": \"how can I help you today?\",\n  \"chatFeedbackCommentPlaceholder\": \"Tell us more…\",\n  \"chatFeedbackCommentSend\": \"Send feedback\",\n  \"chatFeedbackCommentThanks\": \"Thanks for your feedback!\",\n  \"chatFeedbackError\": \"Couldn't send your feedback. Please try again.\",\n  \"chatFeedbackThumbsDownAria\": \"Bad answer\",\n  \"chatFeedbackThumbsUpAria\": \"Good answer\",\n  \"chatFooterDisclaimer\": \"Fina may make mistakes. Verify important information.\",\n  \"chatFooterHint\": \"Press <0>Enter</0> to send, <1>Shift + Enter</1> for a new line\",\n  \"chatHeaderSubtitleIdle\": \"AI assistant\",\n  \"chatHeaderSubtitleThinking\": \"Thinking…\",\n  \"chatInputPlaceholder\": \"Ask Fina anything…\",\n  \"chatNewConversation\": \"New chat\",\n  \"chatNewConversationAria\": \"Start a new conversation\",\n  \"chatChartEmpty\": \"No sales data for that period.\",\n  \"chatClearConversation\": \"Clear conversation\",\n  \"chatDocumentsEmpty\": \"No documents found with those filters.\",\n  \"chatDocumentTypeInvoice\": \"Invoice\",\n  \"chatDocumentTypeDeliveryNote\": \"Delivery note\",\n  \"chatDocumentTypeTicket\": \"Ticket\",\n  \"chatDocumentTypeDocument\": \"Document\",\n  \"chatDocumentNoScanned\": \"No scanned document\",\n  \"chatDocumentNoScannedShort\": \"Not scanned\",\n  \"chatDocumentViewExpense\": \"View expense\",\n  \"chatDocumentViewExpenseNewTab\": \"View expense in a new tab\",\n  \"chatDocumentOpen\": \"Open\",\n  \"chatDocumentDownloadPdf\": \"Download PDF\",\n  \"chatDocumentDownload\": \"Download\",\n  \"chatDocumentNoDocument\": \"No document\",\n  \"chatExportDownload\": \"Download\",\n  \"chatExportReadyExpiresHint\": \"link valid for 24 h\",\n  \"chatExportPreparingTitle\": \"Preparing your export\",\n  \"chatExportPreparingBody\": \"Too many documents to deliver here. We'll email it to {{email}} within ~15 minutes.\",\n  \"chatExportFailedTitle\": \"Export failed\",\n  \"chatExportSettingsCadenceDescription\": \"How often I'll send the export to your accountant.\",\n  \"chatExportSettingsCadenceTitle\": \"Periodicity\",\n  \"chatExportSettingsCardTitle\": \"Accountant export\",\n  \"chatExportSettingsIncludeTicketsDescription\": \"I'll add POS sale tickets to the export too.\",\n  \"chatExportSettingsIncludeTicketsTitle\": \"Include tickets\",\n  \"chatExportSettingsRecipientsDescription\": \"I'll send the export to these emails.\",\n  \"chatExportSettingsRecipientsTitle\": \"Recipients\",\n  \"chatExportSettingsRowEnabledDescription\": \"I'll send the export to your accountant on the cadence you pick.\",\n  \"chatExportSettingsRowEnabledTitle\": \"Auto-export to accountant\",\n  \"chatPromptListPendingReconciliationSubtitle\": \"I'll show what's still pending to reconcile\",\n  \"chatPromptListPendingReconciliationTitle\": \"List documents pending reconciliation\",\n  \"chatPromptSearchSupplierSubtitle\": \"I'll find their invoices and history\",\n  \"chatPromptSearchSupplierTitle\": \"Search a supplier\",\n  \"chatPromptSendSupplierEmailSubtitle\": \"I'll draft and send it for you\",\n  \"chatPromptSendSupplierEmailTitle\": \"Send email to a supplier\",\n  \"chatPromptUpdateSettingsSubtitle\": \"I'll walk you through your preferences\",\n  \"chatPromptUpdateSettingsTitle\": \"Update Fina's settings\",\n  \"chatSuggestionInvoiceIncidentsSubtitle\": \"I'll check what's missing and with which suppliers\",\n  \"chatSuggestionInvoiceIncidentsTitle\": \"Find invoices with issues\",\n  \"chatSuggestionMyTasksSubtitle\": \"I'll go over what's pending\",\n  \"chatSuggestionMyTasksTitle\": \"Show me my tasks\",\n  \"chatSuggestionTopProductsSubtitle\": \"I'll analyze your sales by item\",\n  \"chatSuggestionTopProductsTitle\": \"Which products sell the most?\",\n  \"chatQuickActionInvoicesWithoutDeliveryNote\": \"Invoices without delivery note\",\n  \"chatQuickActionMyTasks\": \"My tasks\",\n  \"chatQuickActionReconcileThisWeek\": \"Reconcile this week\",\n  \"chatSendAria\": \"Send message\",\n  \"chatSettingsCardTitle\": \"Fina settings\",\n  \"chatSettingsNotActivatedCta\": \"Activate Fina\",\n  \"chatSettingsNotActivatedDescription\": \"Activate Fina to start automating expenses, reconciliations and more.\",\n  \"chatSettingsNotActivatedTitle\": \"Fina isn't set up yet\",\n  \"chatSettingsRowAutoAnalyzeDescription\": \"I'll run an AI review on every reconciliation to flag odd matches.\",\n  \"chatSettingsRowAutoAnalyzeTitle\": \"Analyze reconciliations\",\n  \"chatSettingsRowAutoConciliateDescription\": \"I'll accept invoice ↔ delivery-note matches when there are no discrepancies.\",\n  \"chatSettingsRowAutoConciliateTitle\": \"Auto-reconcile matches\",\n  \"chatSettingsRowBankClassificationDescription\": \"I'll auto-categorize bank movements as they come in.\",\n  \"chatSettingsRowBankClassificationTitle\": \"Bank classification\",\n  \"chatSettingsRowBankReconciliationDescription\": \"I'll match bank movements to your expenses for you.\",\n  \"chatSettingsRowBankReconciliationTitle\": \"Bank reconciliation\",\n  \"chatSettingsRowCollectDocumentsDescription\": \"I'll pull invoices and receipts straight from your supplier inboxes.\",\n  \"chatSettingsRowCollectDocumentsTitle\": \"Collect documents from email\",\n  \"chatSettingsRowCreateIncidentsDescription\": \"I'll open an incident when a reconciliation looks off.\",\n  \"chatSettingsRowCreateIncidentsTitle\": \"Open incidents on discrepancies\",\n  \"chatSettingsRowSendIncidentsDescription\": \"I'll email the supplier about the incident on your behalf.\",\n  \"chatSettingsRowSendIncidentsTitle\": \"Auto-send incident emails\",\n  \"chatSettingsSaved\": \"Saved\",\n  \"chatStatusLive\": \"Live\",\n  \"chatStatusReady\": \"Ready\",\n  \"chatStopAria\": \"Stop generating\",\n  \"chatThinkingStill\": \"Still thinking…\",\n  \"chatToolStatusConciliations\": \"Reviewing your reconciliations…\",\n  \"chatToolStatusExpenses\": \"Reviewing your expenses…\",\n  \"chatToolStatusGeneric\": \"Looking at your data…\",\n  \"chatToolStatusSales\": \"Analysing your sales…\",\n  \"chatTurnStatsThought\": \"Thought for {{seconds}}s\",\n  \"chatTurnStatsTools_one\": \"{{count}} lookup\",\n  \"chatTurnStatsTools_other\": \"{{count}} lookups\",\n  \"chatTypingAria\": \"Fina is thinking\",\n  \"chatUserAvatarFallback\": \"You\",\n  \"classificationReasoning\": \"Classification explanation\",\n  \"clearFilters\": \"Clear filters\",\n  \"confirmDeleteBankConnection\": \"Are you sure you want to remove the connection with {{bankName}}?\",\n  \"connectBankButton\": \"Connect bank account\",\n  \"countryDE\": \"Germany\",\n  \"countryES\": \"Spain\",\n  \"countryFR\": \"France\",\n  \"countryGB\": \"United Kingdom\",\n  \"countryIT\": \"Italy\",\n  \"countryNL\": \"Netherlands\",\n  \"countryPT\": \"Portugal\",\n  \"createRule\": \"Create rule\",\n  \"date\": \"Date\",\n  \"difference\": \"Difference\",\n  \"discrepancy\": \"Discrepancy\",\n  \"discrepancyInFavor\": \"in favor of the supplier. Review the invoices and verify the charge is correct.\",\n  \"discrepancyDescription\": \"There is a discrepancy of\",\n  \"discrepancyDetected\": \"Discrepancy detected\",\n  \"duplicateRule\": \"Duplicate\",\n  \"emptyStateDescription\": \"Here you will see your most recent activity: invoices, reconciliations and detected incidents.\",\n  \"errorLoadingProposals\": \"Error loading reconciliation proposals\",\n  \"errorLoadingTransactions\": \"Error loading transactions\",\n  \"expense\": \"Expense\",\n  \"emptyStateLearnMore\": \"Learn how Fina saves you time\",\n  \"emptyStateSetupCta\": \"Start by connecting your data sources.\",\n  \"emptyStateWelcome\": \"Welcome to Fina\",\n  \"emptyStateWorkWithFinaButton\": \"Work with Fina\",\n  \"feedbackCorrect\": \"Correct proposal\",\n  \"feedbackIncorrect\": \"Incorrect proposal\",\n  \"filterBy\": \"Filter by\",\n  \"giveFeedback\": \"Send feedback\",\n  \"gmailWarningCancelButton\": \"Cancel\",\n  \"gmailWarningDescription\": \"During the connection process, Google will display a security warning\",\n  \"gmailWarningDisclaimer\": \"This warning will disappear once Google completes verification of our application. Your data is safe and protected.\",\n  \"gmailWarningIntro\": \"Our application is currently undergoing verification by Google. Temporarily, you will see a screen like this:\",\n  \"gmailWarningProceedButton\": \"Understood, connect Gmail\",\n  \"gmailWarningScreenshotAlt\": \"Google warning about unverified application\",\n  \"gmailWarningStep1\": \"When Google displays the warning, click on \\\"Advanced settings\\\"\",\n  \"gmailWarningStep2\": \"Click on \\\"Go to haddock (unsafe)\\\"\",\n  \"gmailWarningStep3\": \"Accept the requested permissions and confirm that you trust haddock\",\n  \"gmailWarningStep4\": \"Done! Your email will be securely connected\",\n  \"gmailWarningTitle\": \"Google Notice\",\n  \"gmailWarningWhatToDo\": \"What should you do?\",\n  \"headerDescription\": \"Your administrative and financial AI for your restaurant\",\n  \"income\": \"Income\",\n  \"internalOperation\": \"Internal operation\",\n  \"internalOperationDescription\": \"This operation has been identified as internal (fees, transfers, etc.) and can be reconciled without an invoice.\",\n  \"invoice\": \"Invoice\",\n  \"invoiceTotal\": \"Invoice\",\n  \"institutionsConnect\": \"Connect Bank\",\n  \"institutionsDescription\": \"Select your bank from {{country}}\",\n  \"institutionsEmptyDescription\": \"Try selecting a different country\",\n  \"institutionsEmptyTitle\": \"No banks available\",\n  \"institutionsErrorDescription\": \"Failed to load available banks. Please try again later.\",\n  \"institutionsErrorTitle\": \"Error\",\n  \"institutionsLoading\": \"Loading available banks...\",\n  \"institutionsSelectorPlaceholder\": \"Select country\",\n  \"institutionsTitle\": \"Available Banks\",\n  \"kpiCardMoreInfoAriaLabel\": \"More information\",\n  \"incidentMissingExpense\": \"Missing invoice\",\n  \"incidentMissingExpenseDesc\": \"No corresponding invoice was found for this transaction.\",\n  \"incidentInternalOperation\": \"Internal operation\",\n  \"incidentInternalOperationDesc\": \"Internal bank operation that doesn't require an invoice.\",\n  \"incidentAmountDifference\": \"Amount difference\",\n  \"incidentAmountDifferenceDesc\": \"The transaction and invoice amounts don't match exactly.\",\n  \"incidentClassificationLow\": \"Verify category\",\n  \"incidentClassificationLowDesc\": \"The assigned category has low confidence. Please verify it is correct.\",\n  \"incidentOther\": \"Manual review\",\n  \"incidentOtherDesc\": \"Requires manual review to determine the correct action.\",\n  \"missingInvoice\": \"Missing invoice\",\n  \"missingInvoices\": \"Missing invoices\",\n  \"missingInvoicesDescription\": \"The corresponding invoice was not found. Upload it to be able to reconcile.\",\n  \"multipleMovements\": \"Multiple movements\",\n  \"matchedExpenses\": \"Suggested invoices\",\n  \"proposalFromFina\": \"Proposal from Fina\",\n  \"proposalByFina\": \"Proposal by Fina\",\n  \"proposalReasoning\": \"Proposal reasoning\",\n  \"proposedInvoices\": \"Suggested invoices\",\n  \"noProposedInvoices\": \"No suggested invoices\",\n  \"proposalMultipleTransactions\": \"This proposal groups {{count}} bank movements\",\n  \"proposalDifference\": \"Difference of {{amount}}\",\n  \"proposalOverpaid\": \"Excess of {{amount}}\",\n  \"proposalMatches\": \"Amounts match\",\n  \"acceptProposal\": \"Accept\",\n  \"rejectProposal\": \"Reject\",\n  \"kpisConciliationsLabel\": \"Documents reconciled\",\n  \"kpisConciliationsReadyToPay\": \"{{count}} invoices ready to pay\",\n  \"kpisConciliationsReadyToPay_one\": \"{{count}} invoice ready to pay\",\n  \"kpisConciliationsReadyToPay_other\": \"{{count}} invoices ready to pay\",\n  \"kpisConciliationsStatus\": \"{{conciliated}} reconciled, {{pending}} pending\",\n  \"kpisConciliationsTooltip\": \"Total documents (invoices and delivery notes) that Fina has automatically reconciled.\",\n  \"kpisErrorLoadingData\": \"Unable to load updated data\",\n  \"kpisHeading\": \"Key performance indicators\",\n  \"kpisIncidentsLabel\": \"Detected incidents\",\n  \"kpisIncidentsNothingToResolve\": \"Nothing to resolve\",\n  \"kpisIncidentsResolved\": \"{{count}} resolved\",\n  \"kpisIncidentsResolved_one\": \"{{count}} resolved\",\n  \"kpisIncidentsResolved_other\": \"{{count}} resolved\",\n  \"kpisIncidentsStatus\": \"{{resolved}} resolved, {{pending}} pending\",\n  \"kpisIncidentsStillOpen\": \"Still unresolved\",\n  \"kpisIncidentsTooltip\": \"Issues detected by Fina that may require your attention.\",\n  \"kpisInvoicesCollectedLabel\": \"Collected documents\",\n  \"kpisInvoicesCollectedTooltip\": \"Total number of supplier documents that Fina has collected from company mail. Includes invoices, delivery notes, and receipts.\",\n  \"kpisInvoicesProcessedCorrectly\": \"{{count}} processed correctly\",\n  \"kpisInvoicesProcessedCorrectly_one\": \"{{count}} processed correctly\",\n  \"kpisInvoicesProcessedCorrectly_other\": \"{{count}} processed correctly\",\n  \"kpisInvoicesCount\": \"{{count}} invoices\",\n  \"kpisInvoicesCount_one\": \"{{count}} invoice\",\n  \"kpisInvoicesCount_other\": \"{{count}} invoices\",\n  \"kpisDeliveryNotesCount\": \"{{count}} delivery notes\",\n  \"kpisDeliveryNotesCount_one\": \"{{count}} delivery note\",\n  \"kpisDeliveryNotesCount_other\": \"{{count}} delivery notes\",\n  \"kpisTicketsCount\": \"{{count}} tickets\",\n  \"kpisTicketsCount_one\": \"{{count}} ticket\",\n  \"kpisTicketsCount_other\": \"{{count}} tickets\",\n  \"kpisLastNDays\": \"Last {{days}} days\",\n  \"kpisLastNDays_one\": \"Last {{count}} day\",\n  \"kpisLastNDays_other\": \"Last {{count}} days\",\n  \"kpisMailNotConnected\": \"Email not yet connected\",\n  \"kpisNoConciliations\": \"No reconciliations\",\n  \"kpisNoNewInvoices\": \"No new invoices\",\n  \"kpisBankConciliationLabel\": \"Bank reconciliations\",\n  \"kpisBankConciliationTooltip\": \"Bank transactions reconciled with invoices.\",\n  \"kpisBankConciliationWithDifference\": \"{{count}} with discrepancies\",\n  \"kpisBankConciliationWithDifference_one\": \"{{count}} with discrepancy\",\n  \"kpisBankConciliationWithDifference_other\": \"{{count}} with discrepancies\",\n  \"kpisBankConciliationNone\": \"No bank reconciliations\",\n  \"kpisRetryButton\": \"Retry\",\n  \"mailAccountStatusActive\": \"Active\",\n  \"mailAccountStatusInactive\": \"Inactive\",\n  \"mailAccountStatusSendDisabled\": \"Sending disabled\",\n  \"mailAccountInactiveWarningTitle\": \"We could not authenticate with this account\",\n  \"mailAccountInactiveWarningDescription\": \"Please delete it and reconnect it to resume automatic invoice collection.\",\n  \"disconnectMailAccountTitle\": \"Do you want to disconnect your email account?\",\n  \"disconnectMailAccountDescription\": \"By disconnecting {{email}}, invoices will no longer be automatically collected for any restaurant in the group.\",\n  \"disconnectMailAccountTip\": \"Only want to stop collecting for one restaurant? Disable \\\"Collect invoices from emails\\\" in that specific restaurant's settings.\",\n  \"disconnectMailAccountConfirm\": \"Disconnect\",\n  \"mailConnectGmailButton\": \"Connect Gmail\",\n  \"mailConnectionAddAccountHint\": \"Connect an email account where you receive invoices and Fina will collect the documents automatically.\",\n  \"mailConnectionPermissionWarning\": \"Only the restaurant owner and administrators can link an email account\",\n  \"mailConnectMicrosoftButton\": \"Connect Outlook\",\n  \"mailConnectOtherButton\": \"Other option\",\n  \"mailRequestProviderDescription\": \"We work with Gmail and Outlook. If you use another one, let us know which one so we can add it next.\",\n  \"mailRequestProviderEmailLabel\": \"Your email (optional)\",\n  \"mailRequestProviderNameLabel\": \"Name of your email provider\",\n  \"mailRequestProviderNamePlaceholder\": \"Enter provider name\",\n  \"mailRequestProviderNotifyLabel\": \"Notify me when integrated\",\n  \"mailRequestProviderSubmit\": \"Send preference\",\n  \"mailRequestProviderTitle\": \"Do you use another email provider?\",\n  \"mailMicrosoftTroubleTooltip\": \"Trouble connecting Outlook?\",\n  \"mailMicrosoftHelpTitle\": \"Trouble connecting Outlook?\",\n  \"mailMicrosoftHelpAdminHeading\": \"Is Microsoft asking for administrator approval?\",\n  \"mailMicrosoftHelpAdminIntro\": \"If you see a message saying you need administrator approval when connecting, ask whoever manages your organization's Microsoft 365 to follow these steps:\",\n  \"mailMicrosoftHelpAdminStep1\": \"Open the consent link:\",\n  \"mailMicrosoftHelpAdminStep2\": \"Sign in with their Microsoft 365 administrator account.\",\n  \"mailMicrosoftHelpAdminStep3\": \"Review the requested permissions and click \\\"Accept\\\".\",\n  \"mailMicrosoftHelpAdminStep4\": \"Afterwards, try connecting Outlook again.\",\n  \"mailMicrosoftHelpCopyInstructions\": \"Copy instructions\",\n  \"mailMicrosoftHelpCopyInstructionsText\": \"Hi,\\n\\nA user in our organization needs to connect their Outlook account to the \\\"Outlook haddock integration\\\" app. To authorize it, please follow these steps:\\n\\n1. Open this link: {{url}}\\n2. Sign in with your Microsoft 365 administrator account.\\n3. Review the requested permissions and click \\\"Accept\\\".\\n4. Once done, the user will be able to connect Outlook.\\n\\nThanks.\",\n  \"mailMicrosoftHelpCopySuccess\": \"Instructions copied. Send them to your Microsoft 365 administrator.\",\n  \"mailMicrosoftHelpOtherHeading\": \"Something else?\",\n  \"mailMicrosoftHelpOtherBody\": \"If it's something else, get in touch and we'll help you personally.\",\n  \"mailMicrosoftHelpContactSupport\": \"Contact support\",\n  \"mailMicrosoftConnectAnotherWay\": \"Try connecting another way\",\n  \"mailMicrosoftRejectedAdminInstructionsCta\": \"See administrator instructions\",\n  \"mailMicrosoftRejectedPersonalAccountTitle\": \"This looks like a personal mailbox, not a business one\",\n  \"mailMicrosoftRejectedPersonalAccountBody\": \"We can't pull supplier invoices from a personal Microsoft account like <strong>{{email}}</strong>. If this is the address suppliers send invoices to, we can still set it up — we'll just connect it a different way.\",\n  \"mailMicrosoftRejectedDomainMismatchTitle\": \"<strong>{{email}}</strong> isn't a Microsoft mailbox\",\n  \"mailMicrosoftRejectedDomainMismatchBody\": \"Your email isn't hosted with Microsoft, so the Microsoft sign-in won't work for it. We can still connect it directly — no retyping needed.\",\n  \"mailMicrosoftRejectedDomainMismatchBodyWithProvider\": \"Your email is actually with <strong>{{provider}}</strong>, so the Microsoft sign-in won't work for it. Don't worry — we can connect it directly, no retyping needed.\",\n  \"mailMicrosoftRejectedCta\": \"Continue with the email you tried to connect\",\n  \"mailMicrosoftRejectedSupport\": \"Still having trouble? Contact support and we'll lend a hand.\",\n  \"mailMicrosoftOauthRejectedTitle\": \"Your Microsoft administrator hasn't approved haddock yet\",\n  \"mailMicrosoftOauthRejectedBody\": \"Your organization's Microsoft admin needs to approve the haddock integration before Outlook sign-in works. While you wait, you can connect this email another way.\",\n  \"mailMicrosoftOauthRejectedCta\": \"Connect another way\",\n  \"mailMicrosoftOauthFailedTitle\": \"We couldn't connect your Outlook account\",\n  \"mailGoogleOauthFailedTitle\": \"We couldn't connect your Gmail account\",\n  \"mailOauthFailedBody\": \"Something went wrong during sign-in. Please try again. If the issue continues, contact support.\",\n  \"mailGeneralProviderButton\": \"Other email provider\",\n  \"mailGeneralProviderEmailTitle\": \"Connect another email provider\",\n  \"mailGeneralProviderEmailDescription\": \"Enter your address and we'll configure the rest automatically.\",\n  \"mailGeneralProviderEmailPlaceholder\": \"yourname@yourdomain.com\",\n  \"mailGeneralProviderEmailLabel\": \"Email address\",\n  \"mailGeneralProviderEmailProvidersHint\": \"Compatible with IONOS, Don Dominio, Raiola, Arsys, GoDaddy, Yahoo and many more.\",\n  \"mailGeneralProviderEmailContinue\": \"Continue\",\n  \"mailGeneralProviderEmailDuplicateError\": \"This account is already connected to your group.\",\n  \"mailGeneralProviderEmailNoMxHint\": \"We could not find mail servers for this domain. Check the address or enter the details manually.\",\n  \"mailGeneralProviderCredentialsTitle\": \"Enter your mailbox password\",\n  \"mailGeneralProviderCredentialsDescriptionKnown\": \"We detected your email is from {{provider}}.\",\n  \"mailGeneralProviderCredentialsDescriptionUnknown\": \"Fill in the connection details.\",\n  \"mailGeneralProviderCredentialsPresetLoaded\": \"We loaded the configuration automatically. You only need your password.\",\n  \"mailGeneralProviderCredentialsConsentTitle\": \"What Fina does with this account\",\n  \"mailGeneralProviderCredentialsConsentBullet1\": \"Reads emails with invoices and their attachments, only to process them.\",\n  \"mailGeneralProviderCredentialsConsentBullet2\": \"Sends emails only when you ask it to.\",\n  \"mailGeneralProviderCredentialsConsentBullet3\": \"Does not delete or move any message from your mailbox.\",\n  \"mailGeneralProviderCredentialsConsentFooter\": \"Your password is stored encrypted and only Fina uses it.\",\n  \"mailGeneralProviderCredentialsPasswordLabel\": \"Password\",\n  \"mailGeneralProviderCredentialsPasswordHelper\": \"If you use two-step verification, you need an app password.\",\n  \"mailGeneralProviderCredentialsAdvancedToggle\": \"Advanced settings\",\n  \"mailGeneralProviderCredentialsAdvancedBannerTitle\": \"Where to find this information\",\n  \"mailGeneralProviderCredentialsAdvancedBannerDescription\": \"You can find your server settings (host, port and security) on your email provider's website or control panel. If you can't find them, contact our support team and we'll help you set it up.\",\n  \"mailGeneralProviderCredentialsImapHost\": \"Incoming server (IMAP)\",\n  \"mailGeneralProviderCredentialsImapPort\": \"Port\",\n  \"mailGeneralProviderCredentialsImapSecurity\": \"Security\",\n  \"mailGeneralProviderCredentialsSmtpHost\": \"Outgoing server (SMTP)\",\n  \"mailGeneralProviderCredentialsSmtpPort\": \"Port\",\n  \"mailGeneralProviderCredentialsSmtpSecurity\": \"Security\",\n  \"mailGeneralProviderCredentialsUsername\": \"Username\",\n  \"mailGeneralProviderCredentialsSubmit\": \"Test and connect\",\n  \"mailGeneralProviderCredentialsBack\": \"Back\",\n  \"mailGeneralProviderTestingTitle\": \"Testing your account\",\n  \"mailGeneralProviderTestingImapRow\": \"Testing email receipt\",\n  \"mailGeneralProviderTestingSmtpRow\": \"Testing email sending\",\n  \"mailGeneralProviderSuccessTitle\": \"Done! Fina is connected.\",\n  \"mailGeneralProviderSuccessBody\": \"Fina will check this mailbox for all restaurants in your group. Each invoice will be assigned based on the venue's address.\",\n  \"mailGeneralProviderSuccessAddressWarning\": \"Connect an address for {{restaurantName}} so Fina can correctly assign its invoices.\",\n  \"mailGeneralProviderSuccessDone\": \"Got it\",\n  \"mailGeneralProviderGenericError\": \"We could not connect to this account. Check the details and try again. If the problem persists, contact support.\",\n  \"mailGeneralProviderRateLimitError\": \"You have tried to connect too many times. Try again in an hour.\",\n  \"mailGeneralProviderDuplicateError\": \"This account is already connected to your group.\",\n  \"mailGeneralProviderItBlockedTitle\": \"Your provider does not allow this type of connection\",\n  \"mailGeneralProviderItBlockedDescription\": \"Your IT admin has disabled access for external apps on this account. Copy these instructions and send them so they can enable it.\",\n  \"mailGeneralProviderItBlockedMailBody\": \"Hi,\\n\\nI need to enable IMAP and SMTP access for the haddock app on the account {{email}}.\\n\\nPlease enable external app access or create an app password.\\n\\nThank you.\",\n  \"mailGeneralProviderItBlockedCopyButton\": \"Copy\",\n  \"mailGeneralProviderItBlockedCopied\": \"Copied!\",\n  \"mailGeneralProviderHostNotFoundError\": \"We couldn't connect to the server. Check the server, port, and encryption in the advanced settings.\",\n  \"mailGeneralProviderSendDisabledSuccessNotice\": \"Fina can read invoices from this mailbox, but can't send emails on your behalf until sending is active. Review your SMTP settings or contact support.\",\n  \"mailAccountSendDisabledWarningTitle\": \"Sending disabled\",\n  \"mailAccountSendDisabledWarningDescription\": \"This mailbox receives invoices correctly, but email sending is disabled. Review your SMTP settings.\",\n  \"sendDisabledBannerTitle\": \"Sending disabled\",\n  \"sendDisabledBannerDescription\": \"A connected email account cannot send emails.\",\n  \"mailGeneralProviderSuccessToast\": \"Email account connected\",\n  \"mailGeneralProviderAuthFailError\": \"We couldn't sign in to this account. Check your password. If you use two-step verification, you need an app password.\",\n  \"mailGeneralProviderSmtpFailError\": \"We couldn't verify email sending. Receiving works, but sending is blocked by your provider. You can connect receive-only for now.\",\n  \"mailGeneralProviderSmtpFailContinue\": \"Continue without sending\",\n  \"noCategory\": \"No category\",\n  \"notCategorized\": \"Uncategorized\",\n  \"noDate\": \"No date\",\n  \"noInvoice\": \"No invoice\",\n  \"noInvoiceNumber\": \"No number\",\n  \"noInvoicesLinked\": \"No invoices linked\",\n  \"noProposals\": \"No pending proposals\",\n  \"noSupplier\": \"No supplier\",\n  \"noSupplierAssigned\": \"No supplier\",\n  \"notificationActionResolveProblem\": \"Resolve issue\",\n  \"notificationActionViewDetail\": \"View detail\",\n  \"notificationListAdditional\": \"and {{count}} more\",\n  \"notificationListAdditional_one\": \"and {{count}} more\",\n  \"notificationListAdditional_other\": \"and {{count}} more\",\n  \"notificationListConjunction\": \"and\",\n  \"notificationsHeading\": \"Recent activity\",\n  \"notificationsRetryButton\": \"Retry\",\n  \"other\": \"Other\",\n  \"otherPropertyExpense\": \"Invoice from another property\",\n  \"pendingActionsErrorLoading\": \"Error loading pending tasks\",\n  \"pendingActionsPendingEmailsToSupplier_one\": \"Email pending to send to supplier\",\n  \"pendingActionsPendingEmailsToSupplier_other\": \"Emails pending to send to supplier\",\n  \"pendingActionsPendingInvoicesToReconcile_one\": \"Invoice without discrepancies pending reconciliation\",\n  \"pendingActionsPendingInvoicesToReconcile_other\": \"Invoices without discrepancies pending reconciliation\",\n  \"pendingActionsTitle\": \"Pending tasks\",\n  \"pendingActionsViewConciliations\": \"View reconciliations\",\n  \"pendingActionsViewIncidents\": \"View incidents\",\n  \"pendingReview\": \"Pending review\",\n  \"paidAmount\": \"Paid\",\n  \"collectedAmount\": \"Collected\",\n  \"progress\": \"Progress\",\n  \"proposalDetail\": \"Proposal detail\",\n  \"proposalDetailDescription\": \"Reconciliation proposal details\",\n  \"provider\": \"Supplier\",\n  \"purchase\": \"Purchase\",\n  \"reconciled\": \"Reconciled\",\n  \"reconciliationReasoning\": \"Reconciliation reasoning\",\n  \"reconciliations\": \"Reconciled\",\n  \"requiresReview\": \"Require review\",\n  \"requiresReviewDescription\": \"This movement requires manual review. Verify the information before reconciling.\",\n  \"ruleCondition\": \"Condition\",\n  \"ruleConditionPlaceholder\": \"Select a condition\",\n  \"ruleName\": \"Document name\",\n  \"ruleNamePlaceholder\": \"Enter a name\",\n  \"ruleSupplier\": \"Supplier\",\n  \"ruleSupplierPlaceholder\": \"Select a supplier\",\n  \"settingsAccountingExportsCadenceDescription\": \"How often should I send the export?\",\n  \"settingsAccountingExportsCadenceLabel\": \"Cadence\",\n  \"settingsAccountingExportsCadenceRequired\": \"Pick a cadence.\",\n  \"settingsAccountingExportsCadenceOptionEveryTwoWeeks\": \"Every two weeks\",\n  \"settingsAccountingExportsCadenceOptionMonthly\": \"Monthly\",\n  \"settingsAccountingExportsCadenceOptionQuarterly\": \"Quarterly\",\n  \"settingsAccountingExportsCadenceOptionWeekly\": \"Weekly\",\n  \"settingsAccountingExportsDescription\": \"Set up automatic invoice exports to your accountant on a recurring cadence.\",\n  \"settingsAccountingExportsIncludeTicketsDescription\": \"Want me to include tickets in the export?\",\n  \"settingsAccountingExportsIncludeTicketsLabel\": \"Include tickets\",\n  \"settingsAccountingExportsLoadError\": \"Couldn't load accountant export settings. Try again.\",\n  \"settingsAccountingExportsPreviewLoading\": \"Computing your next-export preview…\",\n  \"settingsAccountingExportsPreviewSummary_one\": \"Your next export fires {{nextFire}}, covering from {{periodStart}} to {{periodEnd}} ({{count}} document currently matches).\",\n  \"settingsAccountingExportsPreviewSummary_other\": \"Your next export fires {{nextFire}}, covering from {{periodStart}} to {{periodEnd}} ({{count}} documents currently match).\",\n  \"settingsAccountingExportsRecipientsAddAction\": \"Add recipient\",\n  \"settingsAccountingExportsRecipientsDescription\": \"Email addresses I'll send the export to.\",\n  \"settingsAccountingExportsRecipientsDuplicate\": \"This recipient is already on the list.\",\n  \"settingsAccountingExportsRecipientsInvalidEmail\": \"Enter a valid email address.\",\n  \"settingsAccountingExportsRecipientsLabel\": \"Recipients\",\n  \"settingsAccountingExportsRecipientsMax\": \"Up to {{max}} recipients are allowed.\",\n  \"settingsAccountingExportsRecipientsPlaceholder\": \"accountant@example.com\",\n  \"settingsAccountingExportsRecipientsRemoveAria\": \"Remove {{email}}\",\n  \"settingsAccountingExportsRecipientsRequired\": \"Add at least one recipient.\",\n  \"settingsAccountingExportsSavedConfirmation\": \"Saved.\",\n  \"settingsAccountingExportsTitle\": \"Accountant exports\",\n  \"settingsAutoAnalyzeLabel\": \"Analyze and suggest reconciliations\",\n  \"status\": \"Status\",\n  \"supplier\": \"Supplier\",\n  \"settingsAutoAnalyzeSubtitle\": \"I will analyze your invoices and delivery notes to suggest reconciliations.\",\n  \"settingsAutoConciliateLabel\": \"Automatically reconcile invoices without discrepancies\",\n  \"settingsAutoConciliateSubtitle\": \"I will save time by accepting reconciliations without discrepancies\",\n  \"settingsAutoSendEmailsLabel\": \"Automatically contact supplier\",\n  \"settingsAutoSendEmailsSubtitle\": \"When there is an incident due to missing documents, Fina will send an email to the supplier without asking for prior approval to try to resolve it.\",\n  \"settingsBankReconciliationLabel\": \"Analyze and suggest bank reconciliations\",\n  \"settingsBankReconciliationSubtitle\": \"I will analyze your invoices and bank movements to suggest reconciliations.\",\n  \"settingsBanksTitle\": \"Banks\",\n  \"settingsCollectDocumentsLabel\": \"Collect invoices from emails\",\n  \"settingsCollectDocumentsSubtitle\": \"I will automatically search for and collect invoices from your emails.\",\n  \"settingsConciliationTitle\": \"Reconciliations\",\n  \"settingsConfigErrorLoading\": \"Error loading configuration\",\n  \"settingsConfigTitle\": \"What do you want me to do for you?\",\n  \"settingsConnectBankLabel\": \"Connect bank account\",\n  \"settingsConnectBankSubtitle\": \"Connect your bank account so Fina can help you with bank reconciliations automatically.\",\n  \"settingsCreateIncidentsLabel\": \"Generate incidents from reconciliations with discrepancies\",\n  \"settingsCreateIncidentsSubtitle\": \"I will automatically create incidents when I find unfavourable discrepancies or missing documents in reconciliations.\",\n  \"settingsDescription\": \"Manage your bank connections and accounts\",\n  \"settingsEmailTitle\": \"Email\",\n  \"settingsOwnedPropertiesTitle\": \"Group venues\",\n  \"settingsOwnedPropertiesAddButton\": \"Add venue\",\n  \"settingsOwnedPropertiesNamePlaceholder\": \"Name\",\n  \"settingsOwnedPropertiesAddressPlaceholder\": \"Address\",\n  \"settingsOwnedPropertiesTaxIdPlaceholder\": \"Tax ID\",\n  \"settingsOwnedPropertiesNotesPlaceholder\": \"Notes\",\n  \"settingsOwnedPropertiesLoadError\": \"Could not load venues\",\n  \"settingsOwnedPropertiesSaveError\": \"Could not save the venue\",\n  \"settingsOwnedPropertiesDeleteError\": \"Could not delete the venue\",\n  \"settingsOwnedPropertiesDeleteConfirmTitle\": \"Delete venue?\",\n  \"settingsOwnedPropertiesDeleteConfirmDescription\": \"\\\"{{name}}\\\" will be permanently removed from the group's venue list.\",\n  \"settingsOwnedPropertiesDescription\": \"These are all the venues you could receive documents for. Fina uses this list to route each document to the right venue, or to label it when it's addressed to a venue you don't manage in Haddock.\",\n  \"settingsOwnedPropertiesInHaddockLabel\": \"In Haddock\",\n  \"settingsOwnedPropertiesBadgeExternal\": \"Not in Haddock\",\n  \"settingsOwnedPropertiesInfoBanner\": \"Fina will collect documents addressed to the venues below. Keep their addresses up to date so it can identify them correctly.\",\n  \"settingsMarkEmailsAsReadLabel\": \"Mark processed emails as read\",\n  \"settingsMarkEmailsAsReadSubtitle\": \"When I upload a document from an email to haddock, I'll mark that email as read in your inbox.\",\n  \"settingsMoveEmailsToFolderLabel\": \"Move processed emails to a folder\",\n  \"settingsMoveEmailsToFolderLoadError\": \"Could not load the folders of your email account.\",\n  \"settingsMoveEmailsToFolderLoading\": \"Loading folders…\",\n  \"settingsMoveEmailsToFolderNone\": \"Don't move\",\n  \"settingsMoveEmailsToFolderSaveError\": \"Could not update the folder. Please try again.\",\n  \"settingsMoveEmailsToFolderSaved\": \"Folder updated\",\n  \"settingsMoveEmailsToFolderSubtitle\": \"When I upload all the documents from an email to haddock, I'll move that email to the folder you choose.\",\n  \"settingsMoveEmailsToFolderUnknown\": \"Unknown folder — choose another\",\n  \"settingsRulesTitle\": \"Recognition rules\",\n  \"settingsSupplierRulesLabel\": \"Supplier recognition rules\",\n  \"settingsSupplierRulesSubtitle\": \"Define rules so Fina can automatically recognize suppliers based on the document name.\",\n  \"settingsTitle\": \"Bank Settings\",\n  \"sidebarAccountingExports\": \"Accountant exports\",\n  \"sidebarBanks\": \"Banks\",\n  \"sidebarBanksAndRules\": \"Banks and rules\",\n  \"sidebarConciliation\": \"Reconciliations\",\n  \"sidebarEmail\": \"Email\",\n  \"sidebarIncidents\": \"Incidents\",\n  \"sidebarProperties\": \"Venues\",\n  \"statusReconciled\": \"Reconciled\",\n  \"statusWithDifferences\": \"Discrepancy\",\n  \"statusNotReconciled\": \"Not reconciled\",\n  \"statusActive\": \"Active\",\n  \"statusError\": \"Error\",\n  \"statusInactive\": \"Inactive\",\n  \"statusPending\": \"Pending\",\n  \"statusPendingReview\": \"Pending review\",\n  \"tabHome\": \"Overview\",\n  \"tabChat\": \"Chat\",\n  \"tabConciliation\": \"Bank Reconciliation\",\n  \"transactionDate\": \"Date\",\n  \"type\": \"Type\",\n  \"unknownAccount\": \"Unknown account\",\n  \"various\": \"Various\",\n  \"viewExpense\": \"View invoice\",\n  \"tabsAccounts\": \"Connected Accounts\",\n  \"tabsConnect\": \"Connect Bank\",\n  \"tabSettings\": \"Settings\",\n  \"tabActivity\": \"Activity\",\n  \"reconciliationExplanation\": \"Reconciliation explanation\",\n  \"wizardDialogTitleConfig\": \"Configure Fina - Your AI Assistant\",\n  \"wizardDialogTitleDiscover\": \"Discover Fina - Your AI Assistant\",\n  \"wizardDialogDescriptionConfig\": \"Configuration wizard to activate Fina, your AI assistant for automatic reconciliations\",\n  \"wizardDialogDescriptionDiscover\": \"Introduction to Fina, your AI assistant for restaurant management\",\n  \"wizardCloseButton\": \"Close\",\n  \"wizardImageAlt\": \"Fina - Your AI Assistant\",\n  \"wizardPromoWith\": \"With Fina save\",\n  \"wizardPromoHours\": \"30h/month\",\n  \"wizardPromoFor\": \"for your restaurant\",\n  \"wizardPromoMobile\": \"With Fina save 30h/month for your restaurant\",\n  \"wizardHeading\": \"Start working with Fina\",\n  \"wizardDescription\": \"Fina automatically reconciles, detects discrepancies, and manages incidents for you. You just review and approve.\",\n  \"wizardTrialBadge\": \"30-day free trial\",\n  \"wizardButtonBack\": \"Back\",\n  \"wizardButtonNext\": \"Next\",\n  \"wizardButtonFinish\": \"Finish and activate\",\n  \"wizardStepEmail\": \"Email\",\n  \"wizardStepAddress\": \"Address\",\n  \"wizardStepConciliation\": \"Reconciliations\",\n  \"wizardStepIncidents\": \"Incidents\",\n  \"wizardStepBank\": \"Bank\",\n  \"wizardStepGroupActivation\": \"Group venues\",\n  \"wizardCarouselMute\": \"Mute\",\n  \"wizardCarouselUnmute\": \"Unmute\",\n  \"wizardCarouselPlay\": \"Play\",\n  \"wizardCarouselPause\": \"Pause\",\n  \"wizardCarouselCta\": \"Try Fina free for 1 month\",\n  \"wizardCarouselCtaPaid\": \"Welcome to Fina\",\n  \"wizardCarouselSlide1Title\": \"Discover how Fina will help you\",\n  \"wizardCarouselSlide1Description\": \"Pol Rosell, founder of Haddock, explains it in 1 minute.\",\n  \"wizardCarouselSlide2Title\": \"Discover how Fina will help you\",\n  \"wizardCarouselSlide2DescriptionBold\": \"Fina automatically distributes each document to its location,\",\n  \"wizardCarouselSlide2DescriptionNormal\": \"so you don't waste hours doing it\",\n  \"wizardCarouselSlide3Title\": \"Discover how Fina will help you\",\n  \"wizardCarouselSlide3DescriptionBold\": \"Automate reconciliation and avoid incorrect payments\",\n  \"wizardCarouselSlide3DescriptionNormal\": \"by detecting differences in time\",\n  \"wizardCarouselSlide4Title\": \"Discover how Fina will help you\",\n  \"wizardCarouselSlide4DescriptionBold\": \"Fina helps you communicate and resolve incidents\",\n  \"wizardCarouselSlide4DescriptionNormal\": \"with suppliers automatically and easily\",\n  \"wizardCarouselSlide5Title\": \"Discover how Fina will help you\",\n  \"wizardCarouselSlide5DescriptionBold\": \"Connect your bank and let Fina reconcile automatically\",\n  \"wizardCarouselSlide5DescriptionNormal\": \"from invoice to payment\",\n  \"wizardEmailStepTitle\": \"1. Connect your email\",\n  \"wizardEmailStepDescription\": \"I will search and collect invoices from your restaurant\",\n  \"wizardEmailAddAnother\": \"Add another email\",\n  \"wizardEmailMarkAsReadTitle\": \"Mark processed emails as read\",\n  \"wizardEmailMarkAsReadDescription\": \"When I upload an email's documents to haddock, I'll mark it as read so you don't have to recheck it. If any document fails, I leave the email unread.\",\n  \"wizardAddressStepTitle\": \"2. Review your location address\",\n  \"wizardAddressStepDescription\": \"Make sure it's correct to avoid future errors\",\n  \"wizardAddressNotConfigured\": \"No address configured\",\n  \"wizardAddressLabel\": \"Location address\",\n  \"wizardAddressPlaceholder\": \"Enter your location address\",\n  \"wizardAddressCancel\": \"Cancel\",\n  \"wizardAddressSave\": \"Save changes\",\n  \"wizardAddressRequired\": \"The restaurant address is required\",\n  \"wizardConciliationStepTitle\": \"3. Reconciliations\",\n  \"wizardConciliationStepDescription\": \"Tell me which options you want me to handle for you\",\n  \"wizardConciliati