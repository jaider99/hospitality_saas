personateInputTitle\": \"Impersonate User\",\n  \"impersonatingAsLabel\": \"Currently impersonating: {{email}}\",\n  \"impersonatingAsLabelWithSuperAdmin\": \"Super Admin {{superAdminEmail}} impersonating: {{impersonatedEmail}}\",\n  \"impersonatingLabel\": \"Impersonating:\",\n  \"impersonatingStatus\": \"Impersonating\",\n  \"logoutError\": \"Logout Error\",\n  \"logoutErrorDescription\": \"Unable to logout. Please try again.\",\n  \"modifyPropertiesButton\": \"Manage\",\n  \"loadPropertiesError\": \"Error loading restaurants\",\n  \"restaurantsList\": \"Restaurants list\",\n  \"recentImpersonations\": {\n    \"title\": \"Recent impersonations\"\n  },\n  \"stopImpersonation\": \"Stop impersonating\",\n  \"switchImpersonation\": {\n    \"title\": \"Switch impersonation?\",\n    \"description\": \"This will finish your impersonation of {{current}} and you will impersonate {{target}}.\",\n    \"confirm\": \"Continue\"\n  },\n  \"stripeCoupon\": \"Coupon\",\n  \"stripePlan\": \"Plan\",\n  \"editGroupNameButton\": \"Edit name\",\n  \"editGroupNameTitle\": \"Edit group name\",\n  \"groupLabel\": \"Group\",\n  \"groupIdLabel\": \"Group ID\",\n  \"groupIdCopied\": \"Group ID copied\",\n  \"groupIdCopyError\": \"Error copying group ID\",\n  \"copyGroupIdAriaLabel\": \"Copy group ID\",\n  \"save\": \"Save\",\n  \"oneTimeCharges\": \"One-time charges\",\n  \"planAiConciliationsLimit\": \"{{count}} AI concil/mo\",\n  \"planDocsLimit\": \"{{count}} docs/mo\",\n  \"planFeatureFina\": \"Fina\",\n  \"planFeaturePointOfControl\": \"Point of control\",\n  \"planSince\": \"Since {{date}}\",\n  \"planUsersLimit\": \"{{count}} users\",\n  \"searchPlans\": \"Search plans...\",\n  \"selectPlan\": \"Select plan...\",\n  \"selectPrice\": \"Select price...\",\n  \"selectSetupFee\": \"Select setup fee...\",\n  \"superAdmin\": \"Super Admin\",\n  \"title\": \"Customer Support Portal\",\n  \"userNotFoundError\": \"User not found\",\n  \"adjustUsage\": {\n    \"button\": \"Adjust usage\",\n    \"title\": \"Adjust document/conciliation usage\",\n    \"helper\": \"Set new used counters for the current period. Lowering a counter grants the customer more remaining quota. Leave a field empty to keep it unchanged.\",\n    \"usedScansLabel\": \"Used digitalised documents\",\n    \"usedAiConciliationsLabel\": \"Used AI conciliations\",\n    \"currentUsage\": \"Current: {{used}} / {{max}}\",\n    \"confirmButton\": \"Adjust usage\"\n  },\n  \"manualSubscription\": {\n    \"addButton\": \"Add manual subscription\",\n    \"addTitle\": \"Add manual subscription\",\n    \"badge\": \"Manual\",\n    \"createButton\": \"Create subscription\",\n    \"deleteConfirmTitle\": \"Delete manual subscription\",\n    \"deleteConfirmDescription\": \"Are you sure you want to delete the manual subscription \\\"{{planName}}\\\" from {{propertyName}}?\",\n    \"deleteButton\": \"Delete\",\n    \"editExpirationTitle\": \"Edit expiration\",\n    \"editExpirationButton\": \"Edit expiration\",\n    \"expirationLabel\": \"Expiration date\",\n    \"newExpirationLabel\": \"New expiration date\",\n    \"planLabel\": \"Plan\",\n    \"planPlaceholder\": \"Select a plan\",\n    \"saveButton\": \"Save\",\n    \"freeTrialLabel\": \"Is a trial\",\n    \"trialBadge\": \"Trial\",\n    \"trialEndedBadge\": \"Trial ended\"\n  },\n  \"stuckOcr\": {\n    \"button\": \"Stuck documents\",\n    \"title\": \"Documents stuck in OCR\",\n    \"loading\": \"Loading stuck documents…\",\n    \"loadError\": \"Couldn't load stuck documents\",\n    \"empty\": \"No documents are stuck in processing\",\n    \"selectAll\": \"Select all\",\n    \"deselectAll\": \"Deselect all\",\n    \"count\": \"{{count}} stuck\",\n    \"stuckSince\": \"Stuck since {{date}}\",\n    \"reprocessButton\": \"Reprocess ({{count}})\",\n    \"reprocessResult\": \"Reprocessed {{successful}} · {{failed}} failed\",\n    \"close\": \"Close\"\n  },\n  \"saleIntegrationHealth\": {\n    \"button\": \"Sales sync\",\n    \"title\": \"Sales sync health\