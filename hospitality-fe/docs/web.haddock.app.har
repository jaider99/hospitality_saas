            "mimeType": "application/json",
            "text": "{\n  \"addContactDetails\": \"Añade los detalles del contacto para {{supplierName}}\",\n  \"addContactsToCommunicate\": \"Añade tus contactos para comunicarte con ellos con un solo clic.\",\n  \"addFirstTag\": \"Añade tu primera etiqueta\",\n  \"Address\": \"Dirección (opcional)\",\n  \"address\": \"Dirección\",\n  \"addSuppliers\": \"Añadir {{count}} proveedores\",\n  \"addTagsAndCategorize\": \"Añade etiquetas y categoriza tus proveedores\",\n  \"assignNotification\": \"¡Ya puedes compartir proveedores entre restaurantes! Visita el enlace del centro de ayuda para más información.\",\n  \"assignReminder\": \"Recuerda que los proveedores se comparten entre restaurantes. Al añadir uno nuevo, también podrás asignarlo a otros restaurantes del grupo.\",\n  \"assignSupplier\": \"Asignar proveedor\",\n  \"cantGroupVerifiedSuppliersDesc\": \"Los datos de empresa de estos proveedores han sido verificados, y por eso no pueden ser modificados o agrupados entre sí. Por favor, incluye solamente un proveedor verificado en la selección.\",\n  \"cantGroupVerifiedSuppliersTitle\": \"No se pueden unificar varios proveedores verificados\",\n  \"cantMergeVerified\": \"Uno de los proveedores seleccionados tiene datos verificados por haddock, y por eso no se puede unificar con otros proveedores.\",\n  \"categorizeSupplierDocuments\": \"Todos los documentos de <3>{{supplier}}</3> tendrán la categoría \\\"<1>{{category}}</1>\\\"\",\n  \"categorizeSupplierDocuments_title\": \"¿Modificar en todos los documentos?\",\n  \"changeSupplierConfig\": \"Cambiar configuración del proveedor\",\n  \"changeSuppliersConfig\": \"Cambiar configuración de los proveedores\",\n  \"chooseHowInvoicesAreInConciliations\": \"Elige si se muestran las facturas de este proveedor en la vista de conciliaciones, y si se intentarán conciliar.\",\n  \"comercialName\": \"Nombre comercial\",\n  \"commercialName\": \"Nombre comercial\",\n  \"confirmProductsSourceChange\": \"Confirmar cambio de tipo de documento\",\n  \"confirmProductsSourceChangeDescription\": \"Cambiar esta configuración afectará a qué documentos se utilizan para calcular los precios de los productos de este proveedor. Los precios de los productos pueden cambiar como resultado.\",\n  \"completeFieldsImport\": \"Completa los campos (nombre comercial) en la siguiente plantilla de excel y súbela en el paso 2.\",\n  \"conciliationBehaviorAlways\": \"Muestra siempre facturas para conciliar (aunque no tengan albaranes)\",\n  \"conciliationBehaviorNever\": \"No mostrar ninguna factura\",\n  \"conciliationBehaviorWithDN\": \"Muestra solo facturas que tengan albaranes\",\n  \"contactPreference\": \"Preferencia de contacto\",\n  \"contacts\": \"Contactos\",\n  \"controlSupplierPaymentMethods\": \"Controla los métodos y plazos de pago de tu proveedor.\",\n  \"createConfirmation\": \"El proveedor se ha creado correctamente\",\n  \"createError\": \"Ha ocurrido un error al crear el proveedor\",\n  \"createSupplier\": \"Crear proveedor\",\n  \"createWithoutVAT\": \"Crear sin NIF\",\n  \"daysBeforeInvoiceData\": \"Número de días desde la fecha de facturación\",\n  \"daysBeginningNextMonth\": \"Número de días a partir del próximo mes\",\n  \"deleteSupplier\": \"¿Eliminar proveedor?\",\n  \"deleteSupplierExplanation\": \" Para proteger la información digitalizada, no se pueden eliminar proveedores con documentos asignados. Edita los documentos y asígnalos a otro proveedor para eliminarlo.\",\n  \"deleteConfirmation\": \"Proveedor eliminado correctamente\",\n  \"deleteSupplierError\": \"Ha ocurrido un error al eliminar el proveedor\",\n  \"documentContextDescription\": \"Instrucciones personalizadas que el OCR utiliza al extraer los documentos de este proveedor.\",\n  \"documentContextError\": \"No se ha podido actualizar el contexto de documentos\",\n  \"documentContextPlaceholder\": \"Escribe una instrucción para guiar la extracción de documentos de este proveedor…\",\n  \"documentContextWarning\": \"⚠️ Este campo no es visible para el usuario final. Solo lo puede modificar el equipo técnico de Haddock.\",\n  \"editDocumentContext\": \"Editar contexto de documentos\",\n  \"exportError\": \"Ha ocurrido un error al exportar los proveedores\",\n  \"exportSuccess\": \"Proveedores exportados correctamente\",\n  \"deleteSupplierSnackbar\": \"Edita los documentos y asígnalos a otro proveedor para eliminarlo.\",\n  \"documentsBelongSupplier\": \"TIENES DOCUMENTOS O PRODUCTOS IMPORTADOS QUE PERTENECEN A ESTE PROVEEDOR\",\n  \"ensureDetailsCorrect\": \"Asegúrate de que los datos son correctos, no podrás editarlos más adelante.\",\n  \"fiscalName\": \"Nombre fiscal\",\n  \"generalInfo\": \"Información general\",\n  \"groupSupplier\": \"Proveedor del grupo\",\n  \"importSuppliers\": \"Importar provedores\",\n  \"importSuppliersExcel\": \"IMPORTAR PROVEEDORES CON EXCEL\",\n  \"insertTitle\": \"Introduce un título\",\n  \"invoicesAndDnReconciliation\": \"Conciliación de facturas y albaranes\",\n  \"invoicesAndDnReconciliationDescription\": \"Si está desactivado, no se muestran en “pendientes de conciliar” los documentos (facturas, albaranes y tickets) de este proveedor. \",\n  \"makesDeliveriesOrInvoices\": \"Realiza entrega con albaranes o tengo factura de los tickets\",\n  \"makesDeliveriesOrInvoicesDescription\": \"Saber si este proveedor entrega albaranes o pides si factura para sus tickets, nos permite generar mejores propuestas de conciliación y optimizar la información de tu dashboard.\",\n  \"modificationsApply\": \"Las modificaciones en el nombre se van a aplicar a todos los documentos que tengan este proveedor\",\n  \"modifyPaymentData\": \"Quieres modificar los datos de pago de los documentos ya creados en el sistema para éste proveedor?\",\n  \"monthlyInArrears\": \"A mes vencido\",\n  \"multipleSuppliers\": \"Múltiples proveedores\",\n  \"newContact\": \"Nuevo contacto\",\n  \"newMerge\": \"Nueva unificación de Proveedores\",\n  \"newNote\": \"Nueva nota\",\n  \"newSupplier\": \"Nuevo proveedor\",\n  \"noContacts\": \"Sin contactos\",\n  \"noDocumentContext\": \"Aún no hay instrucciones. Añade una para guiar la extracción de documentos del OCR.\",\n  \"noSelection\": \"Sin elección\",\n  \"noTags\": \"Sin etiquetas\",\n  \"notes\": \"Notas\",\n  \"numDaysConfiguration\": \"Configuración número de días\",\n  \"orderingInformativeBox\": \"Pedidos disponibles para categorías: materia prima, bebidas, limpieza y consumibles.\",\n  \"paymentMethodDescription\": \"Elige el método de pago predeterminado del proveedor\",\n  \"paymentTerms\": \"Plazo de pago\",\n  \"paymentTermsDescription\": \"Define el plazo de pagos en base a días\",\n  \"position\": \"Cargo\",\n  \"provideDayOfTheMonth\": \"Indique el día del mes\",\n  \"provideNumberOfDays\": \"Indique el número de días\",\n  \"providePaymentTerms\": \"Introduce el plazo de pago pactado\",\n  \"purchaseContact\": \"Contacto de compras\",\n  \"purchaseContactForm\": \"Contacto principal para compras\",\n  \"finaContactForm\": \"Contacto principal para Fina\",\n  \"purchasesTabTitle\": \"Información de pedidos\",\n  \"purchasesTabTitle_dayPickerLabel\": \"Detalles de entrega\",\n  \"purchasesTabTitle_dayPickerSublable1\": \"Número de días que tarda la entrega\",\n  \"purchasesTabTitle_dayPickerSublable1Tooltip\": \"Días que tarda el proveedor en entregar el pedido desde su realización\",\n  \"purchasesTabTitle_dayPickerSublable2\": \"Días de la semana en los que se realiza la entrega\",\n  \"purchasesTabTitle_dayPickerSublable2Tooltip\": \"Días de la semana en los que este proveedor realiza entregas\",\n  \"purchasesTabTitle_desc\": \"Captura información sobre tu proveedor de cara a facilitar la creación de pedidos\",\n  \"purchasesTabTitle_timePicker\": \"Hora límite de envío\",\n  \"purchasesTabTitle_timePickerTooltip\": \"Hasta que hora se le pueden hacer pedidos a este proveedor para que lleguen mañana\",\n  \"reviewSuppliers\": \"Revisa tus proveedores <2>aquí.</2>\",\n  \"searchAndSelect_placeholder\": \"Busca y selecciona proveedor\",\n  \"searchByDescription\": \"Busca por descripción\",\n  \"searchByFields\": \"Busca por nombre\",\n  \"searchingBBDD\": \"Buscando en nuesta base de datos\",\n  \"searchOrTypeTag\": \"Busca o escribe una nueva etiqueta\",\n  \"seeDetailsFromSupplierExpenses\": \"Podrás ver el detalle de <2>{{label}}</2> de este proveedor tanto en productos como en escandallos.\",\n  \"selectSuppliersToMerge\": \"Selecciona aquellos proveedores que quieras unificar\",\n  \"selectSuppliersToMergeWith\": \"Selecciona con qué otros proveedores lo quieres unificar\",\n  \"selectTag\": \"Selecciona una etiqueta\",\n  \"showProductsFrom\": \"¿Qué documentos quieres usar para calcular los precios?\",\n  \"allDocuments\": \"Todos los documentos\",\n  \"similar\": \"Similares\",\n  \"specificMonthDay\": \"Día específico del mes\",\n  \"successAssigningSuppliers_body\": \"Encuéntralo en el listado de proveedores\",\n  \"successAssigningSuppliers_title\": \"Proveedor asignado correctamente\",\n  \"successfulMerged\": \"Proveedores unificados correctamente\",\n  \"supplierCode\": \"Código de proveedor\",\n  \"accountingAccount\": \"Cuenta contable\",\n  \"accountingAccountHelp\": \"Déjalo vacío para usar la cuenta genérica de A3 al exportar (por defecto {{account}}).\",\n  \"accountingAccountInvalid\": \"Usa entre 6 y 12 dígitos o déjalo vacío para usar la cuenta genérica de A3.\",\n  \"sanitaryRegistrationNumberLabel\": \"Nº autorización o Registro Sanitario\",\n  \"supplierCount\": \"{{count}} proveedor\",\n  \"supplierCount_one\": \"{{count}} proveedor\",\n  \"supplierCount_other\": \"{{count}} proveedores\",\n  \"supplierDetails\": \"Datos del proveedor\",\n  \"supplierInfo\": \"Información del proveedor\",\n  \"supplierIsVerified\": \"Los datos de empresa de este proveedor han sido verificados por haddock.\",\n  \"supplierSelected\": \"Proveedor seleccionado\",\n  \"supplierWithoutVAT\": \"Proveedor sin NIF detectado\",\n  \"supplierWithoutVAT_description\": \"Completa con el NIF (empresas) o DNI (autónomos). Esto permite identificar y asignar los documentos al proveedor automáticamente durante la subida\",\n  \"tags\": \"Etiquetas\",\n  \"taxID\": \"NIF / CIF\",\n  \"toDeleteMakeSure\": \"Para eliminar un proveedor, asegurate de que no tienes documentos asociados.\",\n  \"unknownSupplier\": \"Proveedor desconocido\",\n  \"updateError\": \"Fallo al actualizar el proveedor\",\n  \"vatID_error\": \"Ya existe un proveedor con este NIF/CIF\",\n  \"VATNumber\": \"NIF / CIF (recomendado)\",\n  \"verifiedSupplierChangeNotice\": \"Los datos de empresa de este proveedor no se pueden editar porque han sido verificados por haddock.\",\n  \"wantToMoveSupplierDocsCategories\": \"¿Quieres mover a “<1>{{category}}</1>” todos los documentos de <3>{{supplier}}</3>?\",\n  \"whatsappShareUrlHelp\": \"Opcional. Pega el enlace del grupo o chat donde envías los pedidos a este proveedor.\",\n  \"whatsappShareUrlInvalid\": \"Introduce un enlace de WhatsApp válido (grupo o chat).\",\n  \"whatsappShareUrlLabel\": \"Enlace de WhatsApp\",\n  \"writeHere\": \"Escribe aquí\",\n  \"conciliationSupplierLinksTitle\": \"Proveedores relacionados para conciliación factura / albarán\",\n  \"conciliationSupplierLinksDescription\": \"Vincula proveedores cuyos albaranes deban poder conciliarse con las facturas de este proveedor (por ejemplo, un operador logístico que entrega en su nombre).\",\n  \"addConciliationSupplierLink\": \"Añadir proveedor relacionado\",\n  \"conciliationSupplierLinksManualOnlyBadge\": \"Solo conciliación manual\",\n  \"conciliationSupplierLinksManualOnlyTooltip\": \"De momento solo se aplica a la conciliación manual. Pronto funcionará también con las conciliaciones automáticas de Fina.\",\n  \"conciliationSupplierLinkOtherVenueTooltip\": \"Este proveedor no está asignado a este establecimiento. El vínculo sigue activo y puedes eliminarlo desde aquí.\"\n}\n"
