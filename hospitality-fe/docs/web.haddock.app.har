            "mimeType": "application/json",
            "text": "{\n  \"breakdown\": {\n    \"columns\": {\n      \"item\": \"Categoría / artículo\",\n      \"total\": \"Total\"\n    },\n    \"description\": \"Categorías y artículos consolidados por nombre exacto en cada local.\",\n    \"empty\": \"No hay ventas para esta búsqueda.\",\n    \"emptyPeriod\": \"No hay ventas en el periodo seleccionado.\",\n    \"noData\": \"Sin datos\",\n    \"noDataTooltip\": \"Sin ventas registradas en este local para el periodo seleccionado.\",\n    \"searchPlaceholder\": \"Buscar categoría o artículo\",\n    \"title\": \"Desglose de ventas por local\",\n    \"unitsSuffix\": \"Uds\"\n  },\n  \"channel\": {\n    \"channels\": {\n      \"delivery\": \"Delivery\",\n      \"diningRoom\": \"Sala\",\n      \"events\": \"Eventos\",\n      \"other\": \"Otros\",\n      \"terrace\": \"Terraza\"\n    },\n    \"description\": \"Desglose por canal · {{range}}\",\n    \"title\": \"Ventas por canal\"\n  },\n  \"comparison\": {\n    \"previousMonth\": {\n      \"label\": \"vs. mes anterior\",\n      \"shortLabel\": \"anterior\"\n    },\n    \"previousQuarter\": {\n      \"label\": \"vs. trimestre anterior\",\n      \"shortLabel\": \"anterior\"\n    },\n    \"previousYear\": {\n      \"label\": \"vs. año anterior\",\n      \"labelWithYear\": \"vs. año anterior\",\n      \"shortLabel\": \"anterior\"\n    },\n    \"none\": {\n      \"label\": \"Sin comparación\",\n      \"shortLabel\": \"periodo\",\n      \"legend\": \"sin comparación\"\n    }\n  },\n  \"daily\": {\n    \"columns\": {\n      \"location\": \"Local\"\n    },\n    \"empty\": \"No hay ventas para este periodo.\"\n  },\n  \"dates\": {\n    \"pendingRange\": \"Rango pendiente\",\n    \"selectDate\": \"Seleccionar fecha\",\n    \"selectDates\": \"Seleccionar fechas\"\n  },\n  \"emptyState\": {\n    \"title\": \"Conecta tu TPV y descubre cómo van tus ventas\",\n    \"description\": \"Verás tus ingresos, tus tickets y tus platos más vendidos, local por local.\",\n    \"action\": \"Conectar TPV\"\n  },\n  \"hero\": {\n    \"title\": \"Ventas\"\n  },\n  \"payment\": {\n    \"description\": \"Evolución mensual por método · {{range}}\",\n    \"methods\": {\n      \"appDelivery\": \"App delivery\",\n      \"bizum\": \"Bizum\",\n      \"card\": \"Tarjeta\",\n      \"cash\": \"Efectivo\",\n      \"other\": \"Otros\"\n    },\n    \"title\": \"Ventas por método de pago\"\n  },\n  \"properties\": {\n    \"all\": \"Todos los locales\",\n    \"count_one\": \"{{count}} local\",\n    \"count_other\": \"{{count}} locales\",\n    \"emptyText\": \"No hay locales.\",\n    \"other\": \"Otros\",\n    \"placeholder\": \"Selecciona locales\",\n    \"searchPlaceholder\": \"Buscar locales\"\n  },\n  \"status\": {\n    \"breakdownError\": \"No hemos podido cargar el desglose de ventas por local.\",\n    \"chartsError\": \"No hemos podido cargar los gráficos de ventas.\",\n    \"error\": \"No hemos podido cargar las ventas.\",\n    \"historyError\": \"No hemos podido cargar el historial de ventas.\",\n    \"historyPartialError\": \"No hemos podido cargar las ventas de algunos locales: {{locations}}.\",\n    \"loading\": \"Cargando ventas del grupo...\",\n    \"summaryError\": \"No hemos podido cargar el resumen de ventas.\"\n  },\n  \"summary\": {\n    \"averageTicketInfo\": \"Ventas totales ÷ número de tickets. Se tienen en cuenta las ventas manuales o importadas.\",\n    \"averageTicketNoDataInfo\": \"No hay tickets en este periodo, así que no se puede calcular el ticket medio.\",\n    \"deltaComparison\": \"{{delta}} vs. {{comparison}}\",\n    \"dinersInfo\": \"Número de comensales registrados en los tickets del periodo.\",\n    \"metrics\": {\n      \"averageTicket\": \"Ticket medio\",\n      \"diners\": \"Comensales\",\n      \"totalSales\": \"Ventas totales\"\n    },\n    \"noData\": \"Sin datos\",\n    \"noVat\": \"(sin IVA)\",\n    \"perTicket\": \"/ticket\"\n  },\n  \"tabs\": {\n    \"summary\": \"Resumen\"\n  },\n  \"ticketByShift\": {\n    \"description\": \"Promedio diario por franja · {{range}}\",\n    \"empty\": {\n      \"description\": \"Estas ventas no tienen comensales (manuales, importadas o sin tickets), así que no se puede calcular el ticket medio.\",\n      \"title\": \"Sin datos de ticket medio\"\n    },\n    \"shifts\": {\n      \"all\": \"Total\",\n      \"morning\": \"Mañana\",\n      \"night\": \"Noche\",\n      \"noon\": \"Mediodía\",\n      \"otros\": \"Otros\"\n    },\n    \"title\": \"Ticket medio por grupo por turno\"\n  },\n  \"weekdays\": {\n    \"friday\": \"Vie\",\n    \"monday\": \"Lun\",\n    \"saturday\": \"Sáb\",\n    \"sunday\": \"Dom\",\n    \"thursday\": \"Jue\",\n    \"tuesday\": \"Mar\",\n    \"wednesday\": \"Mié\"\n  }\n}\n"
