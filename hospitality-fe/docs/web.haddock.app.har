            "text": "{\n  \"addAnotherSale\": \"Add another sale\",\n  \"addDailySalesAndConnect\": \"Manually add your daily sales. If you have a <1>POS</1>, <4><0>connect it</0></4>\",\n  \"addSaleManually\": \"Add sale manually\",\n  \"addSales\": \"Add sales\",\n  \"allShifts\": \"morning, noon, night\",\n  \"article\": \"Article\",\n  \"articles\": \"Articles\",\n  \"articleUpdateError\": \"An error occurred while updating the article\",\n  \"autoTax\": \"{{tax}} automatic {{ taxName }}\",\n  \"autoTax_tooltip\": \"The {{ taxName }} amount is automatically calculated as the 10% of the base amount.\",\n  \"averageTicket\": \"average ticket\",\n  \"bar\": \"Bar\",\n  \"basicInfo\": \"Basic information\",\n  \"basicInfo_tooltip\": \"Add the sale's basic info (<strong>date</strong>, <strong>seats number</strong> and <strong>description</strong>)\",\n  \"billing\": \"Billing\",\n  \"bomLink\": \"Bill of materials link\",\n  \"changeVatRateModalDescription\": \"If you change the {{ taxName }}, you'll need to introduce all of the prices in the details section. Are you sure?\",\n  \"changeVatRateModalTitle\": \"Are you sure you want to change the {{ taxName }}?\",\n  \"channels\": \"Channels\",\n  \"closeUpload\": \"Close sale upload?\",\n  \"closeUpload_description\": \"The sale will not be saved.\",\n  \"closeUpload_title\": \"Close sale upload?\",\n  \"completeFieldsImport\": \"Complete the fields (date, subtotal, tax, total) in the following excel template and upload it in step 2.\",\n  \"configurationInUserSettings\": \"Configuration in user settings\",\n  \"connectDish\": \"Connect dish\",\n  \"connectMenu\": \"Connect menu\",\n  \"connectPOSToAccessSales\": \"Connect your catalog to have access to your sales\",\n  \"connectPOSToAccessSalesDescription\": \"To see your sold articles with your POS, you need to connect your catalog of products with Square.\",\n  \"createSale\": \"Create sale\",\n  \"dateMustBeValid\": \"Date must be valid\",\n  \"details_tooltip\": \"Add the total sales amount by payment method\",\n  \"dinningRoom\": \"Dining room\",\n  \"editSale\": \"Edit sale\",\n  \"events\": \"Events\",\n  \"hideWithNoSales\": \"Hide articles with 0 sales\",\n  \"importSales\": \"Import sales\",\n  \"importSalesExcel\": \"IMPORT SALES IN EXCEL\",\n  \"allowDuplicates\": \"Allow duplicates\",\n  \"importSuccess_details\": \"Imported sales for {{count}} days ({{minDate}} to {{maxDate}})\",\n  \"infoVat\": \"Sales amount with total / base\",\n  \"infoVat_tooltip\": \"In the \\\"user settings\\\" configuration, you can choose to enter the sales with the total (base+{{ taxName }}) or with the base amount. Both options allow you to have automatic {{ taxName }} calculation.\",\n  \"manualSale\": \"Manual sale\",\n  \"missingFields\": \"There are missing fields\",\n  \"noArticlesRegister\": \"No sales record by article\",\n  \"noArticlesRegister_description\": \"There are no article results in the sales records of your POS.\",\n  \"noBreakdown\": \"No breakdown\",\n  \"noInfo\": \"No sales information\",\n  \"noSales\": \"No sales\",\n  \"noSalesInfo\": \"There are no sales in the specified period\",\n  \"noSalesInfoHint\": \"Try another date range or check your last sales\",\n  \"viewLastSales\": \"View last sales\",\n  \"syncingSales\": \"We're syncing your sales\",\n  \"syncingSalesInfo\": \"The first sales may take a few hours to appear after connecting the POS\",\n  \"options_tooltip\": \"Configure the information you want as part of your sales details (<strong>{{ taxName }}</strong> automatic calculation and <strong>shifts or sale channels</strong>)\",\n  \"posArticle\": \"POS article\",\n  \"saleChannels\": \"Sale channels\",\n  \"saleChannels_tooltip\": \"Add the total sales amount by sale channel\",\n  \"salesByShift\": \"Sales by shift\",\n  \"salesDashboard\": \"Sales dashboard\",\n  \"sampleChannels\": \"dinning room, delivery, terrace...\",\n  \"searchByArticleName\": \"Write the name of the sale item\",\n  \"seats\": \"Seats\",\n  \"selectChannels\": \"Select sale channels\",\n  \"selectShifts\": \"Select shifts\",\n  \"severalErrors\": \"Several errors inside\",\n  \"shifts\": \"Shifts\",\n  \"shifts_tooltip\": \"Add the total sales amount by shift\",\n  \"soldArticleCreated\": \"Sales article correctly connected\",\n  \"soldArticleCreationError\": \"An error occurred while connecting the sales item\",\n  \"soldArticlesTitle\": \"Sold articles\",\n  \"soldArticlesUpdateAdvice\": \"The price of the items is updated on a recurring basis. This update does not include items removed from the Point of Sale Terminal.\",\n  \"source\": \"Source\",\n  \"tabDays\": \"{{days}} days\",\n  \"tabMonths\": \"{{months}} months\",\n  \"terrace\": \"Terrace\",\n  \"TPVConnected\": \"Connected with POS\",\n  \"TPVDisconnected\": \"No connection to POS\",\n  \"units\": \"Units\",\n  \"updateDashboardInfo\": \"Update dashboard information\",\n  \"upload_error\": \"There has been an error uploading the sale\",\n  \"upload_success\": \"The sale creation has finished successfully\",\n  \"uploadSalesReminder\": \"Upload sales or connect your POS to have the result of sales by category. <2><0>Upload sales</0></2>.\",\n  \"viewSale\": \"View sales\",\n  \"viewSales\": \"Sales list\",\n  \"viewSalesDashboard\": \"View in sales dashboard\",\n  \"viewSalesInfo\": \"View sales information\",\n  \"withNoSales\": \"Articles with 0 sales\",\n  \"deletePosApiSaleWarning\": \"To recreate this sale, you'll need to make your POS re-send the sales for that day.\",\n  \"deleteSaleTitle\": \"Delete sale\",\n  \"deleteSaleDescription\": \"This action cannot be undone.\",\n  \"exportArticles\": \"Export articles\",\n  \"exportArticlesDescriptionExcel\": \"Download the articles list in Excel format\",\n  \"exportArticlesDescriptionCsv\": \"Download the articles list in CSV format\",\n  \"exportArticlesError\": \"An error occurred while exporting the articles\",\n  \"articleColumn\": \"Article\",\n  \"typeColumn\": \"Type\",\n  \"categoryColumn\": \"Category\",\n  \"statusColumn\": \"Status\",\n  \"priceExTax\": \"Price (ex-tax)\",\n  \"revenueExTax\": \"Revenue (ex-tax)\",\n  \"costColumn\": \"Cost\",\n  \"profitColumn\": \"Profit\",\n  \"menu\": \"Menu\",\n  \"dish\": \"Dish\",\n  \"status_connected\": \"Connected\",\n  \"status_pending\": \"Pending\",\n  \"status_new\": \"New\",\n  \"status_error\": \"Error\",\n  \"covers\": \"Covers\",\n  \"coversShort\": \"pax\",\n  \"payment\": \"Payment\",\n  \"totalWithVAT\": \"Total with VAT\",\n  \"totalWithoutVAT\": \"Total without VAT\",\n  \"totalWithTax\": \"Total with {{ taxName }}\",\n  \"totalWithoutTax\": \"Total without {{ taxName }}\",\n  \"filter\": \"Filter\",\n  \"export\": \"Export\",\n  \"averageTicketTooltip\": \"Average amount per ticket for this day\",\n  \"paymentCard\": \"Card\",\n  \"paymentCash\": \"Cash\",\n  \"paymentTransfer\": \"Transfer\",\n  \"paymentOnline\": \"Online\",\n  \"paymentVoucher\": \"Voucher\",\n  \"paymentComplimentary\": \"Complimentary\",\n  \"paymentOther\": \"Other\",\n  \"paymentStatusRefund\": \"Refund\",\n  \"statusOpen\": \"Open\",\n  \"statusClosed\": \"Closed\",\n  \"statusVoided\": \"Voided\",\n  \"shiftMorning\": \"Morning\",\n  \"shiftNoon\": \"Noon\",\n  \"shiftNight\": \"Night\",\n  \"totalLabel\": \"Total\",\n  \"ticketDetail\": {\n    \"title\": \"Ticket detail\",\n    \"description\": \"Detailed information about the selected ticket\",\n    \"openedAt\": \"Opened\",\n    \"closedAt\": \"Closed\",\n    \"articles\": \"Articles\",\n    \"payments\": \"Payments\",\n    \"summary\": \"Summary\",\n    \"subtotal\": \"Subtotal\",\n    \"tax\": \"Tax\",\n    \"discount\": \"Discount\",\n    \"tip\": \"Tip\",\n    \"refund\": \"Refund\",\n    \"noArticles\": \"No articles\",\n    \"table\": \"Table\",\n    \"modifiersCount_other\": \"{{count}} modifiers\"\n  },\n  \"connectArticle\": \"Connect sales article\",\n  \"selectArticleToLink\": \"Select the sales article to link with \\\"{{dishName}}\\\"\",\n  \"searchByDescription\": \"Search by description\",\n  \"articleLinkedSuccessfully\": \"Article linked successfully\",\n  \"articlesSuggestions\": \"Articles (Suggestions)\",\n  \"articlesAZ\": \"Articles (A - Z)\",\n  \"articleCategories\": \"Article categories\",\n  \"clearFilters\": \"Clear filters\",\n  \"filterBy\": \"Filter by\",\n  \"filterDescription\": \"Filter articles by status, categories and visibility\",\n  \"showDeletedArticles\": \"Show deleted articles\",\n  \"TPVConnection\": \"POS Connection\",\n  \"opening\": \"Opening\",\n  \"closing\": \"Closing\",\n  \"dashboardTotalTitle\": \"Total sales\",\n  \"dashboardOpeningTitle\": \"Sales by opening\",\n  \"dashboardClosingTitle\": \"Sales by closing\",\n  \"dashboardMetricsTooltip\": \"Sales metrics information\",\n  \"dashboardTotalTooltip\": \"All tickets\",\n  \"dashboardOpeningTooltip\": \"Tickets by opening date\",\n  \"dashboardClosingTooltip\": \"Tickets by closing date\",\n  \"totalWithTip\": \"Total with tip\",\n  \"tip\": \"Tip\"\n}\n"
