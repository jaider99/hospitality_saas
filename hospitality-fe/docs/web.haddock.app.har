            "text": "{\n  \"accountsDescription\": \"View and manage your connected bank accounts\",\n  \"accountsEmptyDescription\": \"Go to the \\\"Connect Bank\\\" tab to add your first bank account.\",\n  \"accountsEmptyTitle\": \"No bank accounts connected yet.\",\n  \"accountsIban\": \"IBAN: ****{{last4}}\",\n  \"accountsLoading\": \"Loading accounts...\",\n  \"accountsTitle\": \"Connected Bank Accounts\",\n  \"accountsUpdated\": \"Updated: {{date}}\",\n  \"activationAccessibilityDescription\": \"Configure Fina AI assistant for your restaurant\",\n  \"activationAutoConciliateLabel\": \"Automatically reconcile invoices without discrepancies\",\n  \"activationAutoConciliateSubtitle\": \"Save time by letting me approve perfectly matching reconciliations.\",\n  \"activationButtonLabel\": \"Work with Fina\",\n  \"activationCloseButton\": \"Close\",\n  \"activationCollectDocumentsLabel\": \"Collect invoices from emails\",\n  \"activationCollectDocumentsSubtitle\": \"I will automatically search for and collect invoices from your emails.\",\n  \"activationConfigTitle\": \"What do you want me to do for you?\",\n  \"activationCreateIncidentsLabel\": \"Generate incidents for discrepancies\",\n  \"activationCreateIncidentsSubtitle\": \"I will automatically create incidents when I find unfavourable discrepancies or missing documents in reconciliations.\",\n  \"activationFreeTrialBadge\": \"Work with Fina for free until December 9th\",\n  \"activationFreeTrialSubtext\": \"No commitment • Only for current customers\",\n  \"activationGreeting\": \"Hello!\",\n  \"activationImageAlt\": \"Fina AI Assistant\",\n  \"activationInfoMessage\": \"Once you enable these options, <1>Fina will start working</1>. You will receive notifications as soon as invoices are reconciled.\",\n  \"activationMultiPropertyReminder\": \"If you manage multiple locations, remember to activate Fina for each one.\",\n  \"activationSubtitle\": \"You're one step away from letting <1>Fina</1> help you\",\n  \"addInvoiceHint\": \"You can add an invoice if the proposal is incorrect\",\n  \"addRecognitionRule\": \"Add rule\",\n  \"aiReconciliation\": \"Reconciled by Fina\",\n  \"aiReconciliationReason\": \"Reconciliation reason\",\n  \"amount\": \"Amount\",\n  \"analyzedWithFina\": \"Analyzed with Fina\",\n  \"addressConfigureButton\": \"Configure address\",\n  \"addressInfoImportance\": \"It is very important to correctly configure your restaurant's address so that Fina can identify and collect only relevant documents, ignoring those from other businesses.\",\n  \"addressInfoMultiProperty\": \"If you have other restaurants with Fina in your group, Fina will automatically add documents destined for them using their addresses.\",\n  \"addressInfoTitle\": \"Fina will collect documents destined for your restaurant\",\n  \"addressNotConfigured\": \"No address configured\",\n  \"addressUpdateButton\": \"Update address\",\n  \"bankAccountConfigure\": \"Configure\",\n  \"bankMovement\": \"Bank movement\",\n  \"bankAccountStatusConnected\": \"Connected\",\n  \"bankAccountStatusDisconnected\": \"Disconnected\",\n  \"bankConfigurationComingSoon\": \"Bank configuration will be available soon\",\n  \"bankConnectionComingSoon\": \"Bank connection will be available soon\",\n  \"bankConnectionFeatureComingSoon\": \"Coming soon: Bank connection\",\n  \"bankConnectionPermissionWarning\": \"Only the restaurant owner and administrators can connect a bank account\",\n  \"categories\": \"Categories\",\n  \"category.unclassified\": \"Uncategorized\",\n  \"category.supplierPayment\": \"Supplier payment\",\n  \"category.salesIncome\": \"Sales\",\n  \"category.cardPayment\": \"Card payment\",\n  \"category.cashDeposit\": \"Cash Deposit\",\n  \"category.deliveryIncome\": \"Delivery\",\n  \"category.supplierRefund\": \"Supplier refund\",\n  \"category.loanReceived\": \"Loan received\",\n  \"category.capitalContribution\": \"Capital contribution\",\n  \"category.bankCommission\": \"Bank Fees\",\n  \"category.bankInterestCharge\": \"Interest charge\",\n  \"category.bankInterestEarned\": \"Interest earned\",\n  \"category.internalTransfer\": \"Internal transfer\",\n  \"category.processorFee\": \"Processor fee\",\n  \"category.posFee\": \"POS fee\",\n  \"category.taxPayment\": \"Tax payment\",\n  \"category.socialSecurity\": \"Social Security\",\n  \"category.licenseFee\": \"License/Fee\",\n  \"category.fine\": \"Fine\",\n  \"category.payroll\": \"Payroll\",\n  \"category.payrollSalary\": \"Payroll\",\n  \"category.employeeReimbursement\": \"Employee reimbursement\",\n  \"category.employeeAdvance\": \"Employee advance\",\n  \"category.utilityBill\": \"Utilities\",\n  \"category.telecomBill\": \"Telecommunications\",\n  \"category.propertyRent\": \"Rent\",\n  \"category.insurance\": \"Insurance\",\n  \"category.equipmentLeasing\": \"Equipment leasing\",\n  \"category.loanRepayment\": \"Loan repayment\",\n  \"category.softwareSubscription\": \"Software\",\n  \"category.professionalService\": \"Professional service\",\n  \"category.accountingServices\": \"Accounting\",\n  \"category.legalServices\": \"Legal\",\n  \"category.consultingServices\": \"Consulting\",\n  \"category.marketingAdvertising\": \"Advertising\",\n  \"category.marketingPromotion\": \"Promotion\",\n  \"category.deliveryPlatformFee\": \"Delivery fee\",\n  \"category.reservationPlatformFee\": \"Reservation fee\",\n  \"category.ownerWithdrawal\": \"Owner withdrawal\",\n  \"category.dividendPayment\": \"Dividends\",\n  \"category.cashWithdrawal\": \"Cash withdrawal\",\n  \"category.customerRefund\": \"Customer refund\",\n  \"category.membershipFee\": \"Membership fee\",\n  \"category.trainingEducation\": \"Training\",\n  \"category.travelExpense\": \"Travel\",\n  \"category.other\": \"Other\",\n  \"category.expensePayment\": \"Invoice Payment\",\n  \"category.cardReceipt\": \"Card Sales\",\n  \"category.deliveryPlatform\": \"Delivery Sales\",\n  \"category.government\": \"Govt. Payments\",\n  \"category.