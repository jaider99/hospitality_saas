            "text": "{\n  \"addAdditionalDetails\": \"Añadir detalles adicionales\",\n  \"addContactEmail\": \"Añadir un email de contacto\",\n  \"addEmailToContact\": \"Añadir email a {{contact}}\",\n  \"chooseEmailContactTarget\": \"Elige a quién añadir el email\",\n  \"contactNamePlaceholder\": \"Ej. Pedidos / Juan\",\n  \"contactNameRequired\": \"Introduce un nombre de contacto\",\n  \"createNewContact\": \"Crear un contacto nuevo\",\n  \"existingContact\": \"Contacto existente\",\n  \"addContactPhone\": \"Añadir un teléfono de contacto\",\n  \"additionalCosts\": \"Costes adicionales\",\n  \"additionalDiscounts\": \"Descuentos adicionales\",\n  \"addWhatsAppGroupLink\": \"Añadir enlace del grupo de WhatsApp\",\n  \"whatsappGroupUrlPlaceholder\": \"https://chat.whatsapp.com/…\",\n  \"contactEmailPlaceholder\": \"proveedor@email.com\",\n  \"contactPhonePlaceholder\": \"600 000 000\",\n  \"addSupplierContactInfoTitle\": \"Añade datos para enviar al proveedor\",\n  \"supplierContactInfoSaved\": \"Datos del proveedor actualizados\",\n  \"attachedFile\": \"Adjunto: {{filename}}\",\n  \"code\": \"Código\",\n  \"code_tooltip\": \"Sólo se pueden relacionar ALBARANES o FACTURAS. \",\n  \"comingSoonBannerTitle\": \"Próximamente: Nuevas mejoras en la revisión de pedidos\",\n  \"comingSoonBannerDescription\": \"Seguimos trabajando en esta página. Muy pronto verás mejoras aquí.\",\n  \"companyName\": \"Nombre empresa\",\n  \"confirmationAlert\": \"Confirmar detalles de envío del pedido\",\n  \"confirmationAlertChecked\": \"Revisar detalles de envío del pedido\",\n  \"confirmDetails\": \"Confirmar detalles\",\n  \"confirmEmailSend\": \"Confirmar envío de email\",\n  \"contactEmail\": \"E-mail Contacto\",\n  \"contactPerson\": \"Persona de contacto\",\n  \"collapseProductFormats\": \"Contraer formatos de {{product}}\",\n  \"createPurchaseGroup\": \"Crear pedidos\",\n  \"deliverOn\": \"Entrega el\",\n  \"deliveryNoteDate\": \"Fecha albarán\",\n  \"destinationAddress\": \"Dirección envio\",\n  \"email\": \"E-mail\",\n  \"emailFieldCc\": \"CC\",\n  \"emailFieldMessage\": \"Mensaje\",\n  \"emailFieldSubject\": \"Asunto\",\n  \"emailFieldTo\": \"Para\",\n  \"emailSentFrom\": \"Este email será enviado desde {{email}}.\",\n  \"errorSavingPurchaseOrder\": \"Error guardando pedido\",\n  \"errorSharingFileDescription\": \"Utiliza la opción de \\\"Descargar en PDF\\\"\",\n  \"expandProductFormats\": \"Expandir formatos de {{product}}\",\n  \"missingPropertyAddressDescription\": \"Configura la dirección de tu restaurante en Ajustes para poder compartir y descargar pedidos.\",\n  \"estimatedTotal\": \"Total estimado\",\n  \"estimatedTotal_desc\": \"Aprox. Según últimas compras, precios con descuento.\",\n  \"exitPurchaseOrder\": \"¡No te preocupes, guardaremos el borrador de tu pedido en \\\"Histórico de pedidos\\\".\",\n  \"finishOrder\": \"Finalizar pedido\",\n  \"shareOrderDescription\": \"Comparte la hoja de pedido con tu proveedor. Podrás descargar el PDF o compartirlo posteriormente desde el histórico de pedidos.\",\n  \"markAsSharedWarning\": \"Al marcar el pedido como compartido, ya no podrás editarlo.\",\n  \"finishAndMarkAsShared\": \"Finalizar y marcar como compartido\",\n  \"manageOnMyOwn\": \"Gestionar por mi cuenta\",\n  \"shareWithAnotherApplication\": \"Compartir con otra aplicación\",\n  \"formatsCount_one\": \"{{count}} formato\",\n  \"formatsCount_other\": \"{{count}} formatos\",\n  \"historicEmptyState\": \"Desde aquí podrás ver el histórico de pedidos. Crea el primero desde <strong>Proveedores</strong>.\",\n  \"historicEmptyTitle\": \"Sin pedidos todavía\",\n  \"historyNoResultsDescription\": \"Prueba a ajustar los filtros o la búsqueda para encontrar el pedido que buscas.\",\n  \"incidence_defectiveItem\": \"Producto defectuoso\",\n  \"incidence_incorrectQuantity\": \"Cantidad incorrecta\",\n  \"incidence_notReceived\": \"No recibido\",\n  \"invalidEmail\": \"El email no es válido. Por favor, verifica la dirección.\",\n  \"isPurchaseOrderCorrect\": \"¿Pedido correcto?\",\n  \"itemReceived\": \"{{quantity}} {{unitOfMeasure}} recibido\",\n  \"markAsShared\": \"Marcar como compartido\",\n  \"markingPurchaseOrderAsSharedDescription\": \"Al hacerlo, el borrador pasará a estar finalizado y no podrás modificarlo. Podrás volver a compartirlo o descargarlo en PDF desde el histórico de pedidos.\",\n  \"markPurchaseOrderAsShared\": \"¿Marcar pedido como compartido?\",\n  \"noPurchaseContactsDescription\": \"Añade un contacto de compra principal para este proveedor en la <a>configuración del proveedor</a>. Esto te permitirá enviar pedidos de compra directamente desde esta pantalla.\",\n  \"noPurchaseContactsTitle\": \"Enviar pedidos por email\",\n  \"noPurchasesWarning\": \"Este producto no tiene historial de compras\",\n  \"number\": \"Número de pedido\",\n  \"number_tooltip\": \"Selecciona primero el tipo de documento para poder relacionarlo con un pedido. Sólo se pueden relacionar ALBARANES o FACTURAS. \",\n  \"order\": \"Pedido de compra\",\n  \"order_one\": \"Pedido\",\n  \"order_other\": \"Compras\",\n  \"orderCount_one\": \"{{count}} producto:\",\n  \"orderCount_other\": \"{{count}} productos:\",\n  \"ordered\": \"Pedido {{quantity}} {{uom}}\",\n  \"ordered_ppu\": \"Pedido {{ppu}}/{{uom}}\",\n  \"purchaseListCreateBannerTitle\": \"Usa tus listas de la compra\",\n  \"purchaseListCreateBannerDescription\": \"Guarda tus listas habituales y pide en un click.\",\n  \"purchaseListCreateCta\": \"Crear lista\",\n  \"purchaseListCreateDialogTitle\": \"Crear lista\",\n  \"purchaseListEditDialogTitle\": \"Editar lista\",\n  \"purchaseListEditCta\": \"Editar\",\n  \"purchaseListDuplicateCta\": \"Duplicar\",\n  \"purchaseListDeleteCta\": \"Eliminar\",\n  \"purchaseListOrderCta\": \"Pedir\",\n  \"purchaseListOrderFromCta\": \"Pedir desde lista\",\n  \"purchaseListDuplicateDialogTitle\": \"Duplicar lista\",\n  \"purchaseListDuplicateDialogDescription\": \"Elige un nombre para la nueva lista. Copiaremos todos l