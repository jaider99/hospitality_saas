ctMailAccountTitle\": \"¿Quieres desconectar tu cuenta de correo?\",\n  \"disconnectMailAccountDescription\": \"Al desconectar {{email}}, dejarán de recolectarse facturas automáticamente en todos los restaurantes del grupo.\",\n  \"disconnectMailAccountTip\": \"¿Solo quieres dejar de recolectar en un restaurante? Desactiva \\\"Recolectar facturas de los emails\\\" en la configuración de ese restaurante específico.\",\n  \"disconnectMailAccountConfirm\": \"Desconectar\",\n  \"mailConnectGmailButton\": \"Conectar Gmail\",\n  \"mailConnectionAddAccountHint\": \"Conecta una cuenta de correo donde recibas facturas y Fina recogerá los documentos automáticamente.\",\n  \"mailConnectionPermissionWarning\": \"Solo el propietario del restaurante y los administradores pueden vincular una cuenta de correo\",\n  \"mailConnectMicrosoftButton\": \"Conectar Outlook\",\n  \"mailConnectOtherButton\": \"Otra opción\",\n  \"mailGeneralProviderButton\": \"Otro proveedor de correo\",\n  \"mailGeneralProviderEmailTitle\": \"Conecta otro proveedor de correo\",\n  \"mailGeneralProviderEmailDescription\": \"Introduce tu dirección y configuraremos el resto automáticamente.\",\n  \"mailGeneralProviderEmailPlaceholder\": \"tunombre@tudominio.com\",\n  \"mailGeneralProviderEmailLabel\": \"Correo electrónico\",\n  \"mailGeneralProviderEmailProvidersHint\": \"Compatible con IONOS, Don Dominio, Raiola, Arsys, GoDaddy, Yahoo y muchos más.\",\n  \"mailGeneralProviderEmailContinue\": \"Continuar\",\n  \"mailGeneralProviderEmailDuplicateError\": \"Esta cuenta ya está conectada a tu grupo.\",\n  \"mailGeneralProviderEmailNoMxHint\": \"No encontramos servidores de correo para este dominio. Comprueba la dirección o introduce los datos manualmente.\",\n  \"mailGeneralProviderCredentialsTitle\": \"Introduce la contraseña de tu buzón\",\n  \"mailGeneralProviderCredentialsDescriptionKnown\": \"Detectamos que tu correo es de {{provider}}.\",\n  \"mailGeneralProviderCredentialsDescriptionUnknown\": \"Completa los datos de conexión.\",\n  \"mailGeneralProviderCredentialsPresetLoaded\": \"Hemos cargado la configuración automáticamente. Solo necesitas tu contraseña.\",\n  \"mailGeneralProviderCredentialsConsentTitle\": \"Qué hace Fina con esta cuenta\",\n  \"mailGeneralProviderCredentialsConsentBullet1\": \"Lee los correos con facturas y sus adjuntos, solo para procesarlos.\",\n  \"mailGeneralProviderCredentialsConsentBullet2\": \"Envía correos únicamente cuando tú se lo pides.\",\n  \"mailGeneralProviderCredentialsConsentBullet3\": \"No borra ni mueve ningún mensaje de tu buzón.\",\n  \"mailGeneralProviderCredentialsConsentFooter\": \"Tu contraseña se guarda cifrada y solo Fina la usa.\",\n  \"mailGeneralProviderCredentialsPasswordLabel\": \"Contraseña\",\n  \"mailGeneralProviderCredentialsPasswordHelper\": \"Si usas verificación en dos pasos, necesitas una contraseña de aplicación.\",\n  \"mailGeneralProviderCredentialsAdvancedToggle\": \"Ajustes avanzados\",\n  \"mailGeneralProviderCredentialsAdvancedBannerTitle\": \"Dónde encontrar esta información\",\n  \"mailGeneralProviderCredentialsAdvancedBannerDescription\": \"Puedes encontrar la configuración de tu servidor (host, puerto y seguridad) en la web o panel de control de tu proveedor de correo. Si no la encuentras, contacta con nuestro soporte y te ayudamos a configurarlo.\",\n  \"mailGeneralProviderCredentialsImapHost\": \"Servidor de entrada (IMAP)\",\n  \"mailGeneralProviderCredentialsImapPort\": \"Puerto\",\n  \"mailGeneralProviderCredentialsImapSecurity\": \"Seguridad\",\n  \"mailGeneralProviderCredentialsSmtpHost\": \"Servidor de salida (SMTP)\",\n  \"mailGeneralProviderCredentialsSmtpPort\": \"Puerto\",\n  \"mailGeneralProviderCredentialsSmtpSecurity\": \"Seguridad\",\n  \"mailGeneralProviderCredentialsUsername\": \"Usuario\",\n  \"mailGeneralProviderCredentialsSubmit\": \"Probar y conectar\",\n  \"mailGeneralProviderCredentialsBack\": \"Atrás\",\n  \"mailGeneralProviderTestingTitle\": \"Probando tu cuenta\",\n  \"mailGeneralProviderTestingImapRow\": \"Probando recepción de correos\",\n  \"mailGeneralProviderTestingSmtpRow\": \"Probando envío de correos\",\n  \"mailGeneralProviderSuccessTitle\": \"¡Listo! Fina está conectada.\",\n  \"mailGeneralProviderSuccessBody\": \"Fina revisará este buzón para todos los restaurantes de tu grupo. Cada factura se asignará según la dirección del local.\",\n  \"mailGeneralProviderSuccessAddressWarning\": \"Conecta una dirección para {{restaurantName}} para que Fina pueda asignarle sus facturas correctamente.\",\n  \"mailGeneralProviderSuccessDone\": \"Entendido\",\n  \"mailGeneralProviderGenericError\": \"No pudimos conectar con esta cuenta. Revisa los datos e inténtalo de nuevo. Si el problema persiste, contacta con soporte.\",\n  \"mailGeneralProviderRateLimitError\": \"Has intentado conectar demasiadas veces. Inténtalo de nuevo en una hora.\",\n  \"mailGeneralProviderDuplicateError\": \"Esta cuenta ya está conectada a tu grupo.\",\n  \"mailGeneralProviderSuccessToast\": \"Cuenta de correo conectada\",\n  \"mailGeneralProviderAuthFailError\": \"No pudimos iniciar sesión con esta cuenta. Comprueba la contraseña. Si usas verificación en dos pasos, necesitas una contraseña de aplicación.\",\n  \"mailGeneralProviderSmtpFailError\": \"No pudimos verificar el envío de correos. La recepción funciona, pero el envío está bloqueado por tu proveedor. Puedes conectar solo la recepción por ahora.\",\n  \"mailGeneralProviderSmtpFailContinue\": \"Continuar sin envío\",\n  \"mailGeneralProviderItBlockedTitle\": \"Tu proveedor no permite este tipo de conexión\",\n  \"mailGeneralProviderItBlockedDescription\": \"Tu administrador de IT ha desactivado el acceso para aplicaciones externas en esta cuenta. Copia estas instrucciones y envíaselas para que lo active.\",\n  \"mailGeneralProviderItBlockedMailBody\": \"Hola,\\n\\nNecesito activar el acceso IMAP y SMTP para la aplicación haddock en la cuenta {{email}}.\\n\\nPor favor, habilita el acceso de aplicaciones externas o crea una contraseña de aplicación.\\n\\nGracias.\",\n  \"mailGeneralProviderItBlockedCopyButton\": \"Copiar\",\n  \"mailGeneralProviderItBlockedCopied\": \"¡Copiado!\",\n  \"mailGeneralProviderHostNotFoundError\": \"No pudimos conectar con el servidor. Comprueba el servidor, el puerto y el cifrado en los ajustes avanzados.\",\n  \"mailGeneralProviderSendDisabledSuccessNotice\": \"Fina puede leer facturas de este buzón, pero no puede enviar correos en tu nombre hasta que el envío esté activo. Revisa los ajustes SMTP o contacta con soporte.\",\n  \"mailAccountSendDisabledWarningTitle\": \"Envío inactivo\",\n  \"mailAccountSendDisabledWarningDescription\": \"Este buzón recibe facturas correctamente, pero el envío de correos está desactivado. Revisa los ajustes SMTP.\",\n  \"sendDisabledBannerTitle\": \"Envío inactivo\",\n  \"sendDisabledBannerDescription\": \"Una cuenta de correo conectada no puede enviar correos.\",\n  \"mailRequestProviderDescription\": \"Trabajamos con Gmail y Outlook. Si usas otro, dinos cuál para que sea el próximo.\",\n  \"mailRequestProviderEmailLabel\": \"Tu correo (opcional)\",\n  \"mailRequestProviderNameLabel\": \"Nombre de tu proveedor de correo\",\n  \"mailRequestProviderNamePlaceholder\": \"Escribe el nombre del proveedor\",\n  \"mailRequestProviderNotifyLabel\": \"Quiero recibir notificación cuando esté integrado\",\n  \"mailRequestProviderSubmit\": \"Enviar preferencia\",\n  \"mailRequestProviderTitle\": \"¿Usas otro proveedor de correo?\",\n  \"mailMicrosoftTroubleTooltip\": \"¿Problemas para conectar Outlook?\",\n  \"mailMicrosoftHelpTitle\": \"¿Problemas para conectar Outlook?\",\n  \"mailMicrosoftHelpAdminHeading\": \"¿Microsoft pide la aprobación de un administrador?\",\n  \"mailMicrosoftHelpAdminIntro\": \"Si al conectar ves un mensaje indicando que necesitas la aprobación de un administrador, pide a quien gestione el Microsoft 365 de tu organización que siga estos pasos:\",\n  \"mailMicrosoftHelpAdminStep1\": \"Abrir el enlace de consentimiento:\",\n  \"mailMicrosoftHelpAdminStep2\": \"Iniciar sesión con su cuenta de administrador de Microsoft 365.\",\n  \"mailMicrosoftHelpAdminStep3\": \"Revisar los permisos y pulsar «Aceptar».\",\n  \"mailMicrosoftHelpAdminStep4\": \"Después, vuelve a intentar conectar Outlook.\",\n  \"mailMicrosoftHelpCopyInstructions\": \"Copiar instrucciones\",\n  \"mailMicrosoftHelpCopyInstructionsText\": \"Hola,\\n\\nUn usuario de nuestra organización necesita conectar su cuenta de Outlook con la aplicación «Outlook haddock integration». Para autorizarla, sigue estos pasos:\\n\\n1. Abre este enlace: {{url}}\\n2. Inicia sesión con tu cuenta de administrador de Microsoft 365.\\n3. Revisa los permisos y pulsa «Aceptar».\\n4. Una vez hecho, el usuario podrá volver a conectar Outlook.\\n\\nGracias.\",\n  \"mailMicrosoftHelpCopySuccess\": \"Instrucciones copiadas. Envíaselas a tu administrador de Microsoft 365.\",\n  \"mailMicrosoftHelpOtherHeading\": \"¿Otro problema?\",\n  \"mailMicrosoftHelpOtherBody\": \"Si es otra cosa, contáctanos y te ayudamos de forma personalizada.\",\n  \"mailMicrosoftHelpContactSupport\": \"Contactar con soporte\",\n  \"mailMicrosoftConnectAnotherWay\": \"Probar conexión de otra manera\",\n  \"mailMicrosoftRejectedAdminInstructionsCta\": \"Ver instrucciones para el administrador\",\n  \"mailMicrosoftRejectedPersonalAccountTitle\": \"Esto parece un buzón personal, no uno de empresa\",\n  \"mailMicrosoftRejectedPersonalAccountBody\": \"No podemos recoger facturas de proveedores desde una cuenta personal de Microsoft como <strong>{{email}}</strong>. Si esta es la dirección a la que tus proveedores envían las facturas, igualmente podemos configurarla — solo que la conectaremos de otra forma.\",\n  \"mailMicrosoftRejectedDomainMismatchTitle\": \"<strong>{{email}}</strong> no es un buzón de Microsoft\",\n  \"mailMicrosoftRejectedDomainMismatchBody\": \"Tu correo no está alojado en Microsoft, así que el inicio de sesión con Microsoft no funcionará. Podemos conectarlo directamente — sin tener que volver a escribirlo.\",\n  \"mailMicrosoftRejectedDomainMismatchBodyWithProvider\": \"Tu correo en realidad está en <strong>{{provider}}</strong>, así que el inicio de sesión con Microsoft no funcionará. Tranquilo — podemos conectarlo directamente, sin tener que volver a escribirlo.\",\n  \"mailMicrosoftRejectedCta\": \"Continuar con el correo que intentaste conectar\",\n  \"mailMicrosoftRejectedSupport\": \"¿Sigues con problemas? Contacta con soporte y te echamos una mano.\",\n  \"mailMicrosoftOauthRejectedTitle\": \"Tu administrador de Microsoft aún no ha aprobado haddock\",\n  \"mailMicrosoftOauthRejectedBody\": \"El administrador de Microsoft de tu organización tiene que aprobar la integración de haddock para que el inicio de sesión con Outlook funcione. Mientras tanto, puedes conectar este correo de otra forma.\",\n  \"mailMicrosoftOauthRejectedCta\": \"Conectarlo de otra forma\",\n  \"mailMicrosoftOauthFailedTitle\": \"No hemos podido conectar tu cuenta de Outlook\",\n  \"mailGoogleOauthFailedTitle\": \"No hemos podido conectar tu cuenta de Gmail\",\n  \"mailOauthFailedBody\": \"Algo ha ido mal durante el inicio de sesión. Inténtalo de nuevo. Si el problema continúa, contacta con soporte.\",\n  \"noCategory\": \"Sin categoría\",\n  \"notCategorized\": \"Sin categorizar\",\n  \"noDate\": \"Sin fecha\",\n  \"noInvoice\": \"Sin factura\",\n  \"noInvoiceNumber\": \"Sin número\",\n  \"noInvoicesLinked\": \"Sin facturas vinculadas\",\n  \"noProposals\": \"No hay propuestas pendientes\",\n  \"noSupplier\": \"Sin proveedor\",\n  \"noSupplierAssigned\": \"Sin proveedor\",\n  \"notificationActionResolveProblem\": \"Resolver problema\",\n  \"notificationActionViewDetail\": \"Ver detalle\",\n  \"notificationListAdditional\": \"y {{count}} más\",\n  \"notificationListAdditional_one\": \"y {{count}} más\",\n  \"notificationListAdditional_other\": \"y {{count}} más\",\n  \"notificationListConjunction\": \"y\",\n  \"notificationsHeading\": \"Actividad reciente\",\n  \"notificationsRetryButton\": \"Reintentar\",\n  \"other\": \"Otro\",\n  \"otherPropertyExpense\": \"Factura de otra propiedad\",\n  \"pendingActionsErrorLoading\": \"Error al cargar las tareas pendientes\",\n  \"pendingActionsPendingEmailsToSupplier_one\": \"Correo pendiente de enviar a proveedor\",\n  \"pendingActionsPendingEmailsToSupplier_other\": \"Correos pendientes de enviar a proveedor\",\n  \"pendingActionsPendingInvoicesToReconcile_one\": \"Factura sin discrepancias pendiente de conciliar\",\n  \"pendingActionsPendingInvoicesToReconcile_other\": \"Facturas sin discrepancias pendientes de conciliar\",\n  \"pendingActionsTitle\": \"Tareas pendientes\",\n  \"pendingActionsViewConciliations\": \"Ver conciliaciones\",\n  \"pendingActionsViewIncidents\": \"Ver incidencias\",\n  \"pendingReview\": \"Pendiente de revisión\",\n  \"paidAmount\": \"Pagado\",\n  \"collectedAmount\": \"Cobrado\",\n  \"progress\": \"Progreso\",\n  \"proposalDetail\": \"Detalle de propuesta\",\n  \"proposalDetailDescription\": \"Detalles de la propuesta de conciliación\",\n  \"provider\": \"Proveedor\",\n  \"purchase\": \"Compra\",\n  \"reconciled\": \"Conciliados\",\n  \"reconciliationReasoning\": \"Razonamiento de conciliación\",\n  \"reconciliations\": \"Conciliados\",\n  \"requiresReview\": \"Requieren revisión\",\n  \"requiresReviewDescription\": \"Este movimiento requiere revisión manual. Verifica la información antes de conciliar.\",\n  \"ruleCondition\": \"Condición\",\n  \"ruleConditionPlaceholder\": \"Selecciona una condición\",\n  \"ruleName\": \"Nombre del documento\",\n  \"ruleNamePlaceholder\": \"Introduce un nombre\",\n  \"ruleSupplier\": \"Proveedor\",\n  \"ruleSupplierPlaceholder\": \"Selecciona un proveedor\",\n  \"settingsAccountingExportsCadenceDescription\": \"¿Con qué frecuencia debo enviar la exportación?\",\n  \"settingsAccountingExportsCadenceLabel\": \"Cadencia\",\n  \"settingsAccountingExportsCadenceRequired\": \"Elige una cadencia.\",\n  \"settingsAccountingExportsCadenceOptionEveryTwoWeeks\": \"Cada dos semanas\",\n  \"settingsAccountingExportsCadenceOptionMonthly\": \"Mensual\",\n  \"settingsAccountingExportsCadenceOptionQuarterly\": \"Trimestral\",\n  \"settingsAccountingExportsCadenceOptionWeekly\": \"Semanal\",\n  \"settingsAccountingExportsDescription\": \"Configura envíos automáticos de facturas a tu gestor en una cadencia recurrente.\",\n  \"settingsAccountingExportsIncludeTicketsDescription\": \"¿Quieres que incluya tickets en la exportación?\",\n  \"settingsAccountingExportsIncludeTicketsLabel\": \"Incluir tickets\",\n  \"settingsAccountingExportsLoadError\": \"No se pudo cargar la configuración. Inténtalo de nuevo.\",\n  \"settingsAccountingExportsPreviewLoading\": \"Calculando la vista previa del próximo envío…\",\n  \"settingsAccountingExportsPreviewSummary_one\": \"Tu próximo envío será el {{nextFire}} y cubrirá del {{periodStart}} al {{periodEnd}} ({{count}} documento coincide).\",\n  \"settingsAccountingExportsPreviewSummary_other\": \"Tu próximo envío será el {{nextFire}} y cubrirá del {{periodStart}} al {{periodEnd}} ({{count}} documentos coinciden).\",\n  \"settingsAccountingExportsRecipientsAddAction\": \"Añadir destinatario\",\n  \"settingsAccountingExportsRecipientsDescription\": \"Direcciones de correo a las que enviaré la exportación.\",\n  \"settingsAccountingExportsRecipientsDuplicate\": \"Este destinatario ya está en la lista.\",\n  \"settingsAccountingExportsRecipientsInvalidEmail\": \"Introduce una dirección de correo válida.\",\n  \"settingsAccountingExportsRecipientsLabel\": \"Destinatarios\",\n  \"settingsAccountingExportsRecipientsMax\": \"Solo se permiten hasta {{max}} destinatarios.\",\n  \"settingsAccountingExportsRecipientsPlaceholder\": \"gestor@ejemplo.com\",\n  \"settingsAccountingExportsRecipientsRemoveAria\": \"Eliminar {{email}}\",\n  \"settingsAccountingExportsRecipientsRequired\": \"Añade al menos un destinatario.\",\n  \"settingsAccountingExportsSavedConfirmation\": \"Guardado.\",\n  \"settingsAccountingExportsTitle\": \"Envíos al gestor\",\n  \"settingsAutoAnalyzeLabel\": \"Analizar y sugerir conciliaciones\",\n  \"status\": \"Estado\",\n  \"supplier\": \"Proveedor\",\n  \"settingsAutoAnalyzeSubtitle\": \"Analizaré tus facturas y albaranes para sugerirte conciliaciones.\",\n  \"settingsAutoConciliateLabel\": \"Conciliar automáticamente facturas sin discrepancias\",\n  \"settingsAutoConciliateSubtitle\": \"Ahorraré tiempo aceptando las conciliaciones sin discrepancias\",\n  \"settingsAutoSendEmailsLabel\": \"Contactar automáticamente al proveedor\",\n  \"settingsAutoSendEmailsSubtitle\": \"Cuando detecte una incidencia por falta de documentos, enviaré un mail sin pedirte aprobación previa para resolverla.\",\n  \"settingsBankReconciliationLabel\": \"Analizar y sugerir conciliaciones bancarias\",\n  \"settingsBankReconciliationSubtitle\": \"Analizaré tus facturas y movimientos bancarios para sugerirte conciliaciones.\",\n  \"settingsBanksTitle\": \"Bancos\",\n  \"settingsCollectDocumentsLabel\": \"Recolectar facturas de los emails\",\n  \"settingsCollectDocumentsSubtitle\": \"Buscaré y recolectaré automáticamente facturas de tus correos electrónicos.\",\n  \"settingsConciliationTitle\": \"Conciliaciones\",\n  \"settingsConfigErrorLoading\": \"Error al cargar la configuración\",\n  \"settingsConfigTitle\": \"¿Qué quieres que haga por ti?\",\n  \"settingsConnectBankLabel\": \"Conectar cuenta bancaria\",\n  \"settingsConnectBankSubtitle\": \"Conecta tu cuenta bancaria para que Fina pueda ayudarte con las conciliaciones bancarias automáticamente.\",\n  \"settingsCreateIncidentsLabel\": \"Generar incidencias de las conciliaciones con discrepancias\",\n  \"settingsCreateIncidentsSubtitle\": \"Crearé incidencias automáticamente cuando encuentre discrepancias desfavorables o por falta de documentos en las conciliaciones.\",\n  \"settingsDescription\": \"Gestiona tus conexiones bancarias y cuentas\",\n  \"settingsEmailTitle\": \"Correo electrónico\",\n  \"settingsOwnedPropertiesTitle\": \"Locales del grupo\",\n  \"settingsOwnedPropertiesAddButton\": \"Añadir local\",\n  \"settingsOwnedPropertiesNamePlaceholder\": \"Nombre\",\n  \"settingsOwnedPropertiesAddressPlaceholder\": \"Dirección\",\n  \"settingsOwnedPropertiesTaxIdPlaceholder\": \"CIF / NIF\",\n  \"settingsOwnedPropertiesNotesPlaceholder\": \"Notas\",\n  \"settingsOwnedPropertiesLoadError\": \"No se pudieron cargar los locales\",\n  \"settingsOwnedPropertiesSaveError\": \"No se pudo guardar el local\",\n  \"settingsOwnedPropertiesDeleteError\": \"No se pudo eliminar el local\",\n  \"settingsOwnedPropertiesDeleteConfirmTitle\": \"¿Eliminar local?\",\n  \"settingsOwnedPropertiesDeleteConfirmDescription\": \"\\\"{{name}}\\\" se eliminará permanentemente de la lista de locales del grupo.\",\n  \"settingsOwnedPropertiesDescription\": \"Estos son todos los locales para los que podrías recibir documentos. Fina usa esta lista para enrutar cada documento al local correcto, o para etiquetarlo cuando va dirigido a un local que no gestionas en Haddock.\",\n  \"settingsOwnedPropertiesInHaddockLabel\": \"En Haddock\",\n  \"settingsOwnedPropertiesBadgeExternal\": \"Sin Haddock\",\n  \"settingsOwnedPropertiesInfoBanner\": \"Fina recolectará documentos dirigidos a los locales de abajo. Asegúrate de que las direcciones estén actualizadas para que pueda identificarlos correctamente.\",\n  \"settingsMarkEmailsAsReadLabel\": \"Marcar como leídos los correos procesados\",\n  \"settingsMarkEmailsAsReadSubtitle\": \"Cuando suba un documento de un correo a haddock, marcaré ese correo como leído en tu bandeja de entrada.\",\n  \"settingsMoveEmailsToFolderLabel\": \"Mover correos procesados a una carpeta\",\n  \"settingsMoveEmailsToFolderLoadError\": \"No se pudieron cargar las carpetas de tu cuenta de correo.\",\n  \"settingsMoveEmailsToFolderLoading\": \"Cargando carpetas…\",\n  \"settingsMoveEmailsToFolderNone\": \"No mover\",\n  \"settingsMoveEmailsToFolderSaveError\": \"No se pudo actualizar la carpeta. Inténtalo de nuevo.\",\n  \"settingsMoveEmailsToFolderSaved\": \"Carpeta actualizada\",\n  \"settingsMoveEmailsToFolderSubtitle\": \"Cuando suba todos los documentos de un correo a haddock, moveré ese correo a la carpeta que elijas.\",\n  \"settingsMoveEmailsToFolderUnknown\": \"Carpeta desconocida — elige otra\",\n  \"settingsRulesTitle\": \"Reglas de reconocimiento\",\n  \"settingsSupplierRulesLabel\": \"Reglas de reconocimiento de proveedores\",\n  \"settingsSupplierRulesSubtitle\": \"Define reglas para que Fina reconozca automáticamente proveedores basándose en el nombre del documento.\",\n  \"settingsTitle\": \"Configuración bancaria\",\n  \"sidebarAccountingExports\": \"Envíos al gestor\",\n  \"sidebarBanks\": \"Bancos\",\n  \"sidebarBanksAndRules\": \"Bancos y reglas\",\n  \"sidebarConciliation\": \"Conciliaciones\",\n  \"sidebarEmail\": \"Correo\",\n  \"sidebarIncidents\": \"Incidencias\",\n  \"sidebarProperties\": \"Locales\",\n  \"statusReconciled\": \"Conciliado\",\n  \"statusWithDifferences\": \"Discrepancia\",\n  \"statusNotReconciled\": \"No conciliada\",\n  \"statusActive\": \"Activo\",\n  \"statusError\": \"Error\",\n  \"statusInactive\": \"Inactivo\",\n  \"statusPending\": \"Pendiente\",\n  \"statusPendingReview\": \"Pendiente revisión\",\n  \"tabHome\": \"Resumen\",\n  \"tabChat\": \"Chat\",\n  \"tabConciliation\": \"Conciliación Bancaria\",\n  \"transactionDate\": \"Fecha\",\n  \"type\": \"Tipo\",\n  \"unknownAccount\": \"Cuenta desconocida\",\n  \"various\": \"Varias\",\n  \"viewExpense\": \"Ver factura\",\n  \"tabsAccounts\": \"Cuentas conectadas\",\n  \"tabsConnect\": \"Conectar banco\",\n  \"tabSettings\": \"Configuración\",\n  \"tabActivity\": \"Actividad\",\n  \"reconciliationExplanation\": \"Explicación de conciliación\",\n  \"wizardDialogTitleConfig\": \"Configura Fina - Tu asistente de IA\",\n  \"wizardDialogTitleDiscover\": \"Descubre Fina - Tu asistente de IA\",\n  \"wizardDialogDescriptionConfig\": \"Wizard de configuración para activar Fina, tu asistente de IA para conciliaciones automáticas\",\n  \"wizardDialogDescriptionDiscover\": \"Introducción a Fina, tu asistente de IA para gestión de restaurantes\",\n  \"wizardCloseButton\": \"Cerrar\",\n  \"wizardImageAlt\": \"Fina - Tu asistente de IA\",\n  \"wizardPromoWith\": \"Con Fina gana\",\n  \"wizardPromoHours\": \"30h/mes\",\n  \"wizardPromoFor\": \"para tu restaurante\",\n  \"wizardPromoMobile\": \"Con Fina gana 30h/mes para tu restaurante\",\n  \"wizardHeading\": \"Empieza a trabajar con Fina\",\n  \"wizardDescription\": \"Fina concilia automáticamente, detecta discrepancias y te gestiona incidencias. Tú solo revisas y apruebas.\",\n  \"wizardTrialBadge\": \"30 días gratis de prueba\",\n  \"wizardButtonBack\": \"Anterior\",\n  \"wizardButtonNext\": \"Siguiente\",\n  \"wizardButtonFinish\": \"Finalizar y activar\",\n  \"wizardStepEmail\": \"Correo\",\n  \"wizardStepAddress\": \"Dirección\",\n  \"wizardStepConciliation\": \"Conciliaciones\",\n  \"wizardStepIncidents\": \"Incidencias\",\n  \"wizardStepBank\": \"Banco\",\n  \"wizardStepGroupActivation\": \"Locales del grupo\",\n  \"wizardCarouselMute\": \"Silenciar\",\n  \"wizardCarouselUnmute\": \"Activar sonido\",\n  \"wizardCarouselPlay\": \"Reproducir\",\n  \"wizardCarouselPause\": \"Pausar\",\n  \"wizardCarouselCta\": \"Prueba Fina 1 mes gratis\",\n  \"wizardCarouselCtaPaid\": \"Bienvenido a Fina\",\n  \"wizardCarouselSlide1Title\": \"Descubre cómo te va a ayudar Fina\",\n  \"wizardCarouselSlide1Description\": \"Pol Rosell, fundador de Haddock, te lo explica en 1 minuto.\",\n  \"wizardCarouselSlide2Title\": \"Descubre cómo te va a ayudar Fina\",\n  \"wizardCarouselSlide2DescriptionBold\": \"Fina reparte automáticamente cada documento a su local,\",\n  \"wizardCarouselSlide2DescriptionNormal\": \"para que tú no pierdas horas haciéndolo\",\n  \"wizardCarouselSlide3Title\": \"Descubre cómo te va a ayudar Fina\",\n  \"wizardCarouselSlide3DescriptionBold\": \"Automatiza la conciliación y evita pagos incorrectos\",\n  \"wizardCarouselSlide3DescriptionNormal\": \"detectando diferencias a tiempo\",\n  \"wizardCarouselSlide4Title\": \"Descubre cómo te va a ayudar Fina\",\n  \"wizardCarouselSlide4DescriptionBold\": \"Fina te ayuda a comunicar y resolver incidencias\",\n  \"wizardCarouselSlide4DescriptionNormal\": \"con proveedores de forma automática y sencilla\",\n  \"wizardCarouselSlide5Title\": \"Descubre cómo te va a ayudar Fina\",\n  \"wizardCarouselSlide5DescriptionBold\": \"Conecta tu banco y deja que Fina concilie automáticamente\",\n  \"wizardCarouselSlide5DescriptionNormal\": \"desde la factura hasta su pago\",\n  \"wizardEmailStepTitle\": \"1. Conecta tu correo\",\n  \"wizardEmailStepDescription\": \"Buscaré y recolectaré facturas de tu restaurante\",\n  \"wizardEmailAddAnother\": \"Añadir otro correo\",\n  \"wizardEmailMarkAsReadTitle\": \"Marcar como leídos los correos procesados\",\n  \"wizardEmailMarkAsReadDescription\": \"Cuando suba a haddock los documentos de un correo, lo marcaré como leído para que no tengas que volver a revisarlo. Si algún documento falla, dejo el correo sin leer.\",\n  \"wizardAddressStepTitle\": \"2. Revisa la dirección de tu local\",\n  \"wizardAddressStepDescription\": \"Mira que esté correcta para evitar futuros errores\",\n  \"wizardAddressNotConfigured\": \"Sin dirección configurada\",\n  \"wizardAddressLabel\": \"Dirección local\",\n  \"wizardAddressPlaceholder\": \"Introduce la dirección de tu local\",\n  \"wizardAddressCancel\": \"Cancelar\",\n  \"wizardAddressSave\": \"Guardar cambios\",\n  \"wizardAddressRequired\": \"La dirección del restaurante es obligatoria\",\n  \"wizardConciliationStepTitle\": \"3. Conciliaciones\",\n  \"wizardConciliationStepDescription\": \"Dime qué opciones quieres que haga por ti\",\n  \"wizardConciliationSuggestTitle\": \"Analizar y sugerir conciliaciones\",\n  \"wizardConciliationSuggestDescription\": \