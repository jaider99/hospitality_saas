            "mimeType": "application/json",
            "text": "{\n  \"accrued\": \"Accrued\",\n  \"accruedAndCompanyContribution\": \"Accrued + company contribution <2>(recommended with the official payroll format)</2>\",\n  \"activeEmployee\": \"Active employee\",\n  \"activeEmployees\": \"Active employees\",\n  \"activeEmployees_desc\": \"They are currently working in your restaurant.\",\n  \"activeInactive\": \"Active or inactive employee\",\n  \"activeInactiveDesc1\": \"This employee is <strong>active</strong>, so he/she will appear in the payroll upload process.\",\n  \"activeInactiveDesc2\": \"Mark it as <strong>inactive</strong> if he/she stops working temporarily or permanently.\",\n  \"inactiveEmployeeDesc1\": \"This employee is <strong>inactive</strong>, so they will not appear in the payroll upload process.\",\n  \"inactiveEmployeeDesc2\": \"Mark them as <strong>active</strong> if they start working in your restaurant again.\",\n  \"addEmployee\": \"Add employee\",\n  \"addEmployee_one\": \"Add employee\",\n  \"addEmployee_other\": \"Add employees\",\n  \"addEmployees_one\": \"Add employee\",\n  \"addEmployees_other\": \"Add employees\",\n  \"addMoreDetails\": \"Add more details\",\n  \"addNewEmployee\": \"Add new employee\",\n  \"addOtherLaborCosts\": \"Add other labor costs\",\n  \"attachFile\": \"Attach file\",\n  \"attachFiles\": \"Attach files\",\n  \"basicInfoAndConfiguration\": \"Basic information and configuration\",\n  \"bulkDuplicateDescription\": \"This will copy the payrolls of {{period}} into the month you select.\",\n  \"copyMonthPayrolls_one\": \"Copy payroll to another month\",\n  \"copyMonthPayrolls_other\": \"Copy payrolls to another month\",\n  \"bulkDuplicateTitle\": \"Duplicate payrolls\",\n  \"byEmployee\": \"By employee\",\n  \"byEmployeeDescription\": \"Payrolls upload and employee creation\",\n  \"chef\": \"Chef\",\n  \"companyContribution\": \"Company contribution\",\n  \"companyCost\": \"Company cost <1>(recommended with A3 payroll format)</1>\",\n  \"companyCostLabel\": \"Company cost\",\n  \"concept\": \"Concept\",\n  \"controlStaffPayrolls\": \"Keep track of <strong>actual staff costs</strong> by adding payrolls, overtime of your employees\",\n  \"createEmployee\": \"Create employee\",\n  \"createRole\": \"Creat role\",\n  \"deletePosition\": \"Delete role\",\n  \"deletePositionConfirm\": \"This role will be deleted. This action cannot be undone.\",\n  \"datePeriod\": \"Date / period\",\n  \"cannotDeletePositionInUse\": \"This role cannot be deleted because it is assigned to one or more employees.\",\n  \"deleteEmployee\": \"Are you sure you want to <2>delete the employee {{name}}</2>?\",\n  \"employeeDeletedSuccess\": \"Employee deleted successfully\",\n  \"employeeCreatedSuccess\": \"Employee created successfully\",\n  \"seeEmployee\": \"View employee\",\n  \"duplicateMonthPayrolls\": \"Duplicate month payrolls\",\n  \"duplicateOtherLaborCosts\": \"Duplicate other labor costs\",\n  \"duplicatePayroll\": \"Duplicate staff cost\",\n  \"duplicatePayrolls\": \"Duplicate payrolls\",\n  \"editOtherLaborCosts\": \"Edit other expenses\",\n  \"editPayroll\": \"Edit payroll\",\n  \"editPayrolls\": \"Edit payrolls\",\n  \"emailPlaceholder\": \"Enter the email address. Eg: capitan@haddock.app\",\n  \"emptyEmployeesNoticeTitle\": \"You need to add employees first\",\n  \"emptyEmployeesNoticeDescription\": \"To upload payrolls, first add your employees on the Staff costs page.\",\n  \"emptyEmployeesNoticeCta\": \"Go to Staff costs\",\n  \"payrollTypeLabel\": \"Enter with:\",\n  \"atLeastOneEmployee\": \"Add at least one employee\",\n  \"uploadError\": \"Payrolls could not be uploaded\",\n  \"editError\": \"Payroll could not be edited\",\n  \"governmentId\": \"Government ID\",\n  \"weeklyHours\": \"Weekly hours\",\n  \"netAmount\": \"Net amount\",\n  \"employee\": \"employee\",\n  \"employeeName\": \"Employee name\",\n  \"employeePayrolls\": \"Employee payrolls\",\n  \"employees\": \"Employees\",\n  \"employees_one\": \"Employee\",\n  \"employerSS\": \"Employer's Social Security\",\n  \"employerSS_short\": \"Employer's S. S.\",\n  \"emptyState_byEmployee\": \"To upload payrolls per employee, you need to have created employees. Click on <strong>\\\"Add employee\\\"</strong> to create your active employees.\",\n  \"emptyUploadPayrolls\": \"Add your employees' payrolls\",\n  \"emptyUploadPayrollsDesc\": \"<strong>Control your actual personnel costs</strong> by adding payroll, overtime and other employee expenses.\",\n  \"errorCreatingPosition\": \"Error creating role\",\n  \"errorDeletingPosition\": \"Error deleting role\",\n  \"errorExtension\": \"Only PDF accepted\",\n  \"errorSize\": \"Maximum size 2MB\",\n  \"expenseUploaded\": \"Expense uploaded!\",\n  \"expenseUploadedDescription\": \"You can now see it in your employee's record and/or profile.\",\n  \"extraTime\": \"Extra time\",\n  \"grossSalary\": \"Gross salary\",\n  \"inactiveEmployees\": \"Inactive employees\",\n  \"inactiveEmployees_desc\": \"They do not work temporarily or permanently in your restaurant\",\n  \"inputPlaceholder_employees\": \"Search by employee name, email or role\",\n  \"introducePayrolls\": \"Introduce payrolls\",\n  \"introduceRole\": \"Introduce the new role\",\n  \"introduceWith\": \"Introduce with\",\n  \"knowMoreBlog\": \"Blog find out more about controlling staff costs\",\n  \"liquidSalary\": \"Basic Annual or Monthly Salary / Hourly Rate + social security payments + taxes (or statuory deductions)\",\n  \"loadingPayrolls\": \"Loading payrolls and preparing the form…\\t\",\n  \"maxProfitPayrolls\": \"Make the most of Haddock, upload payrolls with a breakdown by employee.\",\n  \"myEmployees\": \"My employees\",\n  \"namePlaceholder\": \"Employee name. Eg: Captain Haddock\",\n  \"newPayroll\": \"NEW STAFF COST\",\n  \"newStaffExpense\": \"New staff expense\",\n  \"noAttachedFiles\": \"No attached files\",\n  \"notesAndObservations\": \"Notes and observations\",\n  \"notesAndObservations_placeholder\": \"Write notes or observations related to the employee\",\n  \"other\": \"Other\",\n  \"otherExpenseFromEmployee\": \"{{employee}}'s {{date}} other expenses\",\n  \"otherExpenses\": \"other expenses\",\n  \"otherLaborCosts\": \"Other labor costs\",\n  \"otherLaborCostsDescription\": \"Control of off-payroll overtime and other staff expenses.\",\n  \"payroll\": \"payroll\",\n  \"payrollByEmployeeUploadedDescription\": \"The expense has been uploaded correctly, you can already see it in your staff costs space.\",\n  \"payrollFromEmployee\": \"{{employee}}'s {{date}} payroll\",\n  \"payrolls\": \"Payroll\",\n  \"payrolls_one\": \"Payroll\",\n  \"payrolls_other\": \"Payrolls\",\n  \"payrollsAndOtherCosts\": \"Payrolls and other costs\",\n  \"payrollsTotal\": \"Payrolls total\",\n  \"payrollsTotalAmount\": \"Total payrolls {{amount}}\",\n  \"payrollsUploaded\": \"Payrolls uploaded!\",\n  \"payrollsUploadedDescription\": \"All payrolls have been uploaded correctly, you can already see them in your registry and in the employee's profile.\",\n  \"personnelCost\": \"Personnel cost\",\n  \"preparingDuplicate\": \"Preparing duplication\",\n  \"reason\": \"Reason\",\n  \"recommended\": \"Recommended\",\n  \"recommendedPayrollWithEmployee\": \"Payrolls by employee <1>(Recommended)</1>\",\n  \"removeFromUpload\": \"Remove from this upload\",\n  \"repeatPayroll\": \"Duplicate payroll\",\n  \"rolePosition\": \"Role\",\n  \"searchByMonth\": \"Search by month, employee\",\n  \"seeFromAllEmployees\": \"See for all employees\",\n  \"seeInactive\": \"See inactive\",\n  \"selectAnEmployee\": \"Select an employee\",\n  \"selectOrCreateEmployee\": \"Select an existing employee or create a new one\",\n  \"selectOrCreatePosition\": \"Select or create a position for this employee\",\n  \"selectOrCreateRole\": \"Select or create a role\",\n  \"staffCost\": \"Staff costs\",\n  \"titlePreview\": \"{{date}} {{type}} of {{name}}\",\n  \"titlePreviewNoEmployee\": \"{{date}} {{type}}\",\n  \"totalOtherExpenses\": \"TOTAL other expenses\",\n  \"totalPayrolls\": \"Total payrolls\",\n  \"uploadByEmployee\": \"Upload payrolls by employee\",\n  \"uploadFile\": \"Upload file\",\n  \"uploadOtherCost\": \"Add another expense\",\n  \"uploadPayroll\": \"Add payroll expense\",\n  \"uploadPayroll_one\": \"Add payroll expense\",\n  \"uploadPayroll_other\": \"Record payrolls\",\n  \"uploadPayrolls\": \"Adds and stores payrolls, summaries, etc.\",\n  \"uploadPayrollWihoutEmployee\": \"Total payrolls without breakdown by employee\",\n  \"uploadPayrollWithEmployeeDescription\": \"If you want to upload payrolls by employee, we recommend to do so with the <strong>new payroll upload.</strong>\",\n  \"uploadpPayrollWithEmployee\": \"Upload payrolls with by employee\",\n  \"uploadpPayrollWithEmployeeDescription\": \"If you want to upload payrolls by employee, we recommend to do so with the <strong>new payroll upload.</strong>\",\n  \"uploadStaffPayrolls\": \"Add employee payroll expense\",\n  \"viewComment\": \"view comment\",\n  \"waiter\": \"Waiter\",\n  \"whereCanFindPayrollFormatData\": \"Where can I find this data and which is the difference in the formats?\",\n  \"withoutEmployee\": \"Without employee\",\n  \"withoutEmployees\": \"Without employee breakdown\",\n  \"withoutEmployeesDescription\": \"Payrolls grand total upload\",\n  \"withoutPayrolls\": \"No payrolls or other expenses\",\n  \"writeConcept\": \"Provide the concept\"\n}\n"
