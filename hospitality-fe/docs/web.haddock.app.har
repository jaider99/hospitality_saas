riptionButton\": \"Cancel subscription\",\n    \"cancelSubscriptionSuccess\": \"Subscription cancellation scheduled\",\n    \"confirmUnblockTitle\": \"Confirm unblock\",\n    \"confirmUnblockDescription\": \"Are you sure you want to unblock this restaurant?\",\n    \"confirmBlockTitle\": \"Confirm block\",\n    \"confirmBlockDescription\": \"Are you sure you want to block this restaurant?\",\n    \"confirmDeleteTitle\": \"Confirm deletion\",\n    \"confirmDeleteDescription\": \"Are you sure you want to delete this restaurant? It can be recovered later.\",\n    \"confirmForceActiveTitle\": \"Confirm force active\",\n    \"confirmForceActiveDescription\": \"Are you sure you want to force activation of this restaurant? This will allow access even if inactive.\",\n    \"confirmForceActiveBlockedWarning\": \"If this restaurant is already blocked, this action will have no effect.\",\n    \"confirmForceActiveDateLabel\": \"Select until when it will be force-activated:\",\n    \"confirmRemoveForceActiveTitle\": \"Confirm remove force active\",\n    \"confirmRemoveForceActiveDescription\": \"Are you sure you want to remove the forced activation of this restaurant?\",\n    \"confirmCancelSubscriptionTitle\": \"Confirm subscription cancellation\",\n    \"confirmCancelSubscriptionDescription\": \"Are you sure you want to cancel this restaurant's subscription at the end of the current period?\",\n    \"cancel\": \"Cancel\",\n    \"scansPerMonth\": \"{{count}} scans/mo\",\n    \"usersCount\": \"{{count}} users\",\n    \"aiConciliationsPerMonth\": \"{{count}} AI concil/mo\",\n    \"sectionSubscription\": \"Subscription\",\n    \"sectionBilling\": \"Billing\",\n    \"sectionDetails\": \"Property & people\",\n    \"groupBilling\": \"Billing\",\n    \"groupSubscription\": \"Subscription\",\n    \"groupData\": \"Data\",\n    \"groupDanger\": \"Danger zone\",\n    \"usageAi\": \"AI conciliations\",\n    \"owner\": \"Owner\",\n    \"contactEmail\": \"Contact email\",\n    \"usersLabel\"