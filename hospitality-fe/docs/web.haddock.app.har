            "mimeType": "application/json",
            "text": "{\n  \"acceptableDifference\": \"Diferencia aceptable\",\n  \"accessData\": \"Datos de acceso\",\n  \"activateAlert\": \"Activar alerta\",\n  \"addMember\": \"Añadir usuario\",\n  \"addOtherMember\": \"Añadir otro usuario\",\n  \"addGroup\": \"Añadir grupo\",\n  \"addOperationalGroup\": \"Añadir grupo operativo\",\n  \"addRestaurant\": \"Añadir restaurante\",\n  \"addRestaurantTargetGroupUnavailable\": \"Este grupo ya no está disponible. Cierra el diálogo e inténtalo otra vez desde la lista de restaurantes.\",\n  \"cannotDelete_employee\": \"El empleado tiene gastos de personal.\",\n  \"cannotCancelAccount\": \"No se puede cancelar la cuenta\",\n  \"cancelSubscription\": \"Cancelar suscripción\",\n  \"changePassword\": \"Cambiar contraseña\",\n  \"changePlan\": \"Cambiar plan\",\n  \"checkoutSupportCenter\": \"Tienes alguna duda? Consulta nuestro centro de soporte\",\n  \"codeFriend\": \"Código: AMIGO\",\n  \"connectHaddock\": \"Conecta haddock con todos tus softwares\",\n  \"createDataFailed\": \"No se ha podido crear.\",\n  \"createGroup\": \"Crear grupo\",\n  \"createOperationalGroup\": \"Crear grupo operativo\",\n  \"createNewUser\": \"Crear nuevo usuario\",\n  \"createNewUser_loading\": \"Creando usuario...\",\n  \"createRestaurant\": \"Crear restaurante\",\n  \"creatingGroup\": \"Creando grupo...\",\n  \"creatingOperationalGroup\": \"Creando grupo operativo...\",\n  \"creatingRestaurant\": \"Creando restaurante...\",\n  \"currentPlan\": \"Plan actual\",\n  \"deleteDemoRestaurant\": \"Eliminar restaurante de demostración\",\n  \"deleteInvitationAction\": \"Cancelar invitación\",\n  \"deleteUser_description\": \"El usuario no podrá acceder a ningún restaurante.\",\n  \"deleteUserAction\": \"Eliminar usuario\",\n  \"deleteUserExplanation\": \"El usuario dejará de tener acceso a este restaurante pero la información introducida por el usuario se guardará. Se mantendrá el acceso de los otros restaurantes a los que el usuario esté invitado.\",\n  \"deleteUserInvitation\": \"¿Cancelar invitación del usuario?\",\n  \"deleteUserTitle\": \"¿Eliminar usuario?\",\n  \"digitalizedDocuments\": \"Documentos digitalizados\",\n  \"docLimitExceeded\": \"Límite de documentos superado\",\n  \"editInvitedUser\": \"Editar usuario invitado\",\n  \"expirationDate\": \"Fecha de finalización\",\n  \"freeTrial\": \"Período de prueba\",\n  \"trialBadge\": \"Período de prueba\",\n  \"trialEndedBadge\": \"Trial finalizado\",\n  \"graphAndSummaryAmount\": \"¿Cómo quieres ver los importes de los gráficos y resúmenes de tu dashboard?\",\n  \"groupNameRequired\": \"El nombre del grupo es obligatorio\",\n  \"operationalGroup\": \"Grupo operativo\",\n  \"operationalGroupName\": \"Nombre del grupo operativo\",\n  \"operationalGroupNameRequired\": \"El nombre del grupo operativo es obligatorio\",\n  \"operationalGroupTooltip\": \"Los restaurantes del mismo grupo operativo comparten productos, recetas/escandallos y configuración operativa.\",\n  \"operationalGroupTooltipAriaLabel\": \"Información sobre el grupo operativo\",\n  \"graphsVat_included\": \"Ver gráficos e importes CON {{ taxName }}\",\n  \"graphsVat_notIncluded\": \"Ver gráficos e importes SIN {{ taxName }}\",\n  \"hideOtherIntegrations\": \"Ocultar otras integraciones\",\n  \"howUploadSales\": \"¿Cómo quieres subir las ventas?\",\n  \"importantLinks\": \"Enlaces importantes\",\n  \"info\": \"Información\",\n  \"invitationInProgress\": \"Invitación a <strong>{{inviteEmail}}</strong> en curso\",\n  \"invitationLink\": \"Enlace de invitación\",\n  \"invitationSent\": \"Invitación a <strong>{{inviteEmail}}</strong> enviada\",\n  \"invitationSent_error\": \"NO HEMOS PODIDO ENVIAR TU INVITACIÓN\",\n  \"invitationSent_errorDescription\": \"<p>¡Vaya! Sentimos mucho decirte que ha habido un problema a la hora de enviar la invitación...</p><br/><p>Comprueba que la dirección esté bien escrita o que el correo no pertenezca ya a alguien de tu equipo.</p>\",\n  \"invitationSent_ok\": \"¡INVITACIÓN ENVIADA CORRECTAMENTE!\",\n  \"inviteUser\": \"Invitar usuario\",\n  \"inviteUsers\": \"Invitar empleados\",\n  \"learnAboutPos\": \"Saber más sobre el TPV de {{pos}}\",\n  \"legalWarning\": \"Aviso legal\",\n  \"limitReached\": \"Límite de documentos superado.\",\n  \"link\": \"Enlace:\",\n  \"liteFunctionalities\": \"LITE es la versión simplificada de haddock: con las funcionalidades más básicas y con la subida de foto a un solo click.\",\n  \"myAccount\": \"Mi cuenta\",\n  \"myIntegrations\": \"Mis integraciones\",\n  \"myPlan\": \"Mi plan\",\n  \"myTeam\": \"Mi equipo\",\n  \"newUserRole\": \"Define el rol del usuario invitado\",\n  \"nextBilling\": \"Próxima facturación\",\n  \"noRenewalDate\": \"Sin fecha de renovación\",\n  \"scheduledCancellation\": \"Cancelación programada\",\n  \"scheduledCancellationDate\": \"Se cancelará el {{date}}\",\n  \"trialEndsAt\": \"Fin del periodo de prueba\",\n  \"noLocation\": \"Sin ubicación\",\n  \"onceDeletedDemoRestaurant\": \"Una vez eliminado de tu lista, no lo podrás recuperar. Podemos tardar unas horas en quitarlo de la lista.\",\n  \"onlyOwnerOrAdminCanCancel\": \"Solo el propietario o un administrador de esta cuenta puede enviar una solicitud de cancelación.\",\n  \"pendingInvitation\": \"Invitación pendiente\",\n  \"planDetails\": \"Detalles del plan\",\n  \"privacyPol\": \"Política de privacidad\",\n  \"processInvitation\": \"(invitación en curso)\",\n  \"processInvitation_tooltip\": \"El usuario invitado podrá acceder a haddock una vez finalizado el registro\",\n  \"proFunctionalities\": \"Conciliación de albaranes/facturas <br/> Control de gastos de personal <br/> Control de incidencias\",\n  \"propertyAcces\": \"Marca en que restaurantes tendrá acceso\",\n  \"purchasableDefaultValueSwitchLabel\": \"Permitir que los nuevos productos se puedan pedir\",\n  \"recomendClickReconciliations\": \"Te propondremos conciliaciones para que las puedas realizar en un solo clic y ahorrar tiempo.\",\n  \"reconciliateVat_included\": \"Conciliar CON {{ taxName }}\",\n  \"reconciliateVat_notIncluded\": \"Conciliar SIN {{ taxName }}\",\n  \"reconciliateVatDescription\": \"¿Cómo quieres conciliar tus documentos?\",\n  \"reconciliationsDifference\": \"También te vamos a recomendar conciliaciones con esta diferencia.\",\n  \"referralLinkDescription\": \"¡Comparte este enlace y el código de descuento y gana recompensas!\",\n  \"requestAccountCancellation\": \"Solicitar cancelación de cuenta\",\n  \"resendEmail\": \"Reenviar correo\",\n  \"propertySegmentationProfile\": \"Sobre tu negocio\",\n  \"propertySegmentationProfilePainsEmpty\": \"Nos ayuda a adaptar la plataforma a tus necesidades.\",\n  \"propertySegmentationProfileFields\": {\n    \"businessTypes\": \"Tipo de local\",\n    \"cuisineTypes\": \"Tipo de cocina\",\n    \"openMonths\": \"Meses de apertura\",\n    \"erp\": \"ERP\",\n    \"employeeRange\": \"Empleados\",\n    \"annualRevenueRange\": \"Facturación anual\"\n  },\n  \"propertySegmentationProfileSummaries\": {\n    \"openMonths\": {\n      \"allYear\": \"Todo el año\",\n      \"allYearExcept\": \"Todo el año excepto {{months}}\"\n    }\n  },\n  \"restaurantConfiguration\": \"Configuración de restaurante\",\n  \"restaurantImage\": \"Imágen del restaurante\",\n  \"restaurantLogo\": \"Logotipo del restaurante\",\n  \"salesUpload\": \"SUBIDA DE VENTAS\",\n  \"sendInvitation\": \"Enviar invitación\",\n  \"showOtherIntegrations\": \"Mostrar otras integraciones\",\n  \"storage\": \"Almacenamiento\",\n  \"supportCenter\": \"Centro de soporte\",\n  \"termsAndCond\": \"Términos y condiciones\",\n  \"toKeepEnjoying\": \"Para seguir disfrutando de todas las funcionalidades de haddock,\",\n  \"toKeepUsing\": \"Para seguir utilizando haddock,\",\n  \"updateDataFailed\": \"No se ha podido actualizar.\",\n  \"updateYourPlan\": \"actualiza tu plan\",\n  \"updateYourPlanNow\": \"¡Actualiza tu plan!\",\n  \"upgradePlanAddUsers\": \"Actualiza tu plan para añadir más usuarios\",\n  \"uploadedDocs\": \"Documentos subidos\",\n  \"uploadImage\": \"Subir imagen\",\n  \"uploadImageLimitExceed\": \"La imagen no puede ser superior a {{limit}}.\",\n  \"uploadImageMustBeImage\": \"El fichero a subir debe ser una imagen.\",\n  \"uploadLogo\": \"Subir logotipo\",\n  \"upsLimitDocsReached\": \"¡Vaya! Has alcanzado la cantidad máxima de documentos digitalizados de tu plan.\",\n  \"userAlreadyInvited\": \"Este usuario ya está invitado\",\n  \"userDetails\": \"Detalles usuario\",\n  \"userInhaddock\": \"Este usuario ya está en haddock\",\n  \"userInhaddockExplanation\": \"El usuario con esta dirección de correo electrónico ya forma parte del restaurante.\",\n  \"viewInvoices\": \"Facturas\",\n  \"weWillSendInvitationEmail\": \"Recibirá una invitación para poder registrarse y acceder a haddock.\",\n  \"showPastSubscriptions\": \"Mostrar suscripciones pasadas\",\n  \"hidePastSubscriptions\": \"Ocultar suscripciones pasadas\",\n  \"pastSubscriptions\": \"Suscripciones pasadas\",\n  \"fina\": \"Fina\",\n  \"includedFeatures\": \"Características incluidas\",\n  \"scansPerMonth\": \"{{count}} documentos/mes\",\n  \"usersLimit\": \"{{count}} usuarios\",\n  \"aiConciliationsPerMonth\": \"{{count}} conciliaciones IA/mes\",\n  \"expired\": \"Caducado\",\n  \"noActiveSubscriptions\": \"Sin suscripciones activas\",\n  \"subscriptionStatusNotActive\": \"No activa\",\n  \"subscriptionStatusIncomplete\": \"Incompleta\",\n  \"subscriptionStatusIncompleteExpired\": \"Expirada\",\n  \"subscriptionStatusPastDue\": \"Pago pendiente\",\n  \"subscriptionStatusCanceled\": \"Cancelada\",\n  \"subscriptionStatusUnpaid\": \"Impagada\",\n  \"subscriptionStatusPaused\": \"Pausada\",\n  \"subscriptionStatusTrialEnded\": \"Prueba terminada\",\n  \"extendedByHaddockUntil\": \"Prorrogado por haddock hasta el {{date}}\",\n  \"propertyOperationalType\": \"Tipo de propiedad\",\n  \"propertyOperationalTypeVenue\": \"Local\",\n  \"propertyOperationalTypeCentralKitchen\": \"Cocina central\"\n}\n"
