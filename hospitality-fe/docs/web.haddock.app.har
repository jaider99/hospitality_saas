            "text": "{\n  \"advanced\": \"Advanced reconciliation\",\n  \"aiAnalized\": \"Analyzed with AI\",\n  \"aiAnalizedAt\": \"Analyzed with AI on {{date}}\",\n  \"aiConciliationAnalyzing\": \"Analyzing...\",\n  \"analyzedByFina\": \"Analyzed by Fina\",\n  \"analyzedByFinaAt\": \"Analyzed by Fina on {{date}}\",\n  \"dateTimeConnector\": \"at\",\n  \"aiProcessed\": \"Reconciled with AI\",\n  \"analyzeWithAi\": \"Analyze with AI\",\n  \"analyzeWithFina\": \"Analyze with Fina\",\n  \"anyDiference\": \"Any difference? Any missing document?\",\n  \"approved\": \"No discrepancies\",\n  \"availableDocuments\": \"Available documents\",\n  \"byItself\": \"The ticket will be reconciled directly with the invoice\",\n  \"closeReconciliation\": \"Close reconciliation?\",\n  \"deliveryNotesSelection\": \"Delivery notes selection\",\n  \"dueIn\": \"Expires in {{time}}\",\n  \"eAnalyzeWithAi\": \"Reanalyze with AI\",\n  \"reanalyzeWithFina\": \"Reanalyze with Fina\",\n  \"editAndUndoReconciliation\": \"Edit document and undo reconciliation?\",\n  \"editAndUndoReconciliation_description\": \"Editing this document will undo the reconciliation of the related documents.\",\n  \"emptyState_reconciliation\": \"You can now reconcile invoices and delivery notes much <strong> more efficiently with haddock. </strong> Get started now!\",\n  \"errorAIReconcilingDocuments\": \"An error occurred while reconciling your documents with AI.\",\n  \"feedbackAIConciliationDescription\": \"Description\",\n  \"feedbackAIConciliationPlaceholder\": \"1) What the AI did wrong\\n2) What it should have done instead\",\n  \"feedbackSubmitError\": \"Error sending the report. Please try again.\",\n  \"feedbackSubmittedSuccess\": \"Report sent successfully. Thank you for your collaboration!\",\n  \"highDifference_description\": \"There is an imbalance of {{value}}.\",\n  \"highDifference_title\": \"Too high difference\",\n  \"highDifferenceTitle\": \"Reconciling with an imbalance?\",\n  \"incidentDetected\": \"Incident detected\",\n  \"lookUpAndSelect\": \"Select the documents you want to reconcile with this invoice:\",\n  \"makeFirstReconciliation\": \"Make your first reconciliation\",\n  \"manualReconciliation\": \"Manual reconciliation\",\n  \"many\": \"Reconciled\",\n  \"missingDocuments\": \"Missing documents\",\n  \"negativeDiscrepancy\": \"Unfavorable Discrepancy\",\n  \"noChildrenInvoice_description\": \"Don't you have any delivery notes to reconcile with this invoice?\",\n  \"noChildrenInvoice_title\": \"Invoice without delivery notes\",\n  \"noChildrenTicket_description\": \"Don't you have an invoice for this ticket?\",\n  \"noChildrenTicket_title\": \"Ticket without invoice\",\n  \"noDeliveryNotes\": \"Without documents\",\n  \"notAvailableDocuments\": \"There are no documents available to select\",\n  \"notInvoice\": \"Not invoice\",\n  \"notRelatedDocuments\": \"The invoice will be reconciled without associated documents\",\n  \"overdueAgo\": \"Expired {{time}} ago\",\n  \"pendingDocs\": \"Pending documents\",\n  \"pendingInvoices\": \"Pending invoices\",\n  \"positiveDiscrepancy\": \"Favorable Discrepancy\",\n  \"recentReconciliations\": \"Recent reconciliations\",\n  \"recomended\": \"Recommended reconciliations\",\n  \"reconcile\": \"Reconcile\",\n  \"reconcile_manually\": \"Manually reconcile\",\n  \"reject\": \"Reject\",\n  \"reportAIConciliationError\": \"Report AI Conciliation Error\",\n  \"reportAIConciliationErrorDescription\": \"Describe the error you found in the automatic conciliation. Your report will help us improve.\",\n  \"reportIssue\": \"Report issue\",\n  \"resultError_description\": \"We could not reconcile your documents from your supplier {{supplier}}.\",\n  \"resultError_title\": \"reconciliation error\",\n  \"resultOk_description\": \"Documents from {{supplier}} have been successfully reconciled. You can view this reconciliation in the \\\" RECONCILED\\\" tab.\",\n  \"resultOk_title\": \"reconciliation done!\",\n  \"resultsValidation\": \"Verification of results and reconciliation\",\n  \"searchBy\": \"Search by supplier or invoice number\",\n  \"seeReconciledDocuments\": \"See reconciled documents\",\n  \"selectAIDecisionsFilter\": \"Select AI decisions to filter\",\n  \"selectCategoriesFilter\": \"Select categories to filter\",\n  \"selectDeliveryNotes\": \"Select delivery notes\",\n  \"successfullyReconciledDocuments\": \"Documents successfully reconciled\",\n  \"undo\": \"Undo reconciliation\",\n  \"undoQuestion\": \"Undo reconciliation?\",\n  \"validateResult\": \"Check that the result is correct and reconcile the documents.\",\n  \"viewingDocumentsBetween\": \"Showing documents from the last 90 days\",\n  \"willNotSave\": \"The reconciliation for these documents will not be saved\",\n  \"withDifferenceOf\": \"The documents will be reconciled with a difference of {{difference}}\",\n  \"withoutDocumentNumber\": \"No document number\",\n  \"differenceExplanationAriaLabel\": \"Explanation\"\n}\n"
