            "mimeType": "application/json",
            "text": "{\n  \"1pass\": \"Primer pase\",\n  \"2pass\": \"Segundo pase\",\n  \"3pass\": \"Tercer pase\",\n  \"4pass\": \"Cuarto pase\",\n  \"5pass\": \"Quinto pase\",\n  \"6pass\": \"Sexto pase\",\n  \"7pass\": \"Séptimo pase\",\n  \"8pass\": \"Octavo pase\",\n  \"9pass\": \"Noveno pase\",\n  \"addDish\": \"Añadir plato\",\n  \"addDishesToCalculate\": \"Añade los platos para que calculemos el <strong>coste</strong>, <strong>beneficio</strong> y <strong>margen</strong> del menú.\",\n  \"addDishInfo\": \"Introduce los platos que integran este menú\",\n  \"addMenuDishError\": \"Ha ocurrido un error al añadir el plato al menú\",\n  \"basePrice\": \"Precio base\",\n  \"connectMenuEmptyState\": \"No hay escandallos de menús en tu cuenta\",\n  \"connectMenuEmptyStateText\": \"Crea los escandallos de tus menús para conectarlos con las ventas de tu TPV\",\n  \"createMenu\": \"Crear menú\",\n  \"deleteMenuDishError\": \"Ha ocurrido un error al eliminar el plato del menú\",\n  \"dishDetails\": \"Detalles del plato\",\n  \"editDish\": \"Editar plato\",\n  \"editMenuDish\": \"Editar plato en menú\",\n  \"emptyState_dishesDesc\": \"Realiza los escandallos de los platos para añadirlos a tus menús.\",\n  \"exitPageToCreate\": \"Para crear el escandallo de un nuevo menú es necesario salir de esta página.\",\n  \"includedDishes\": \"Platos incluidos en este menú\",\n  \"informationOf_menu\": \"Información del menú\",\n  \"many\": \"Menús\",\n  \"menu\": \"Menú\",\n  \"menuCreationError\": \"Ha ocurrido un error al crear el menú\",\n  \"menuDeleteError \": \"Ha ocurrido un error al eliminar el menú\",\n  \"menuDuplicateError\": \"Ha ocurrido un error al duplicar el menú\",\n  \"menuItemPOS\": \"Menú en TPV:\",\n  \"menuName\": \"Nombre del menú\",\n  \"menuPass\": \"Pase en el menú\",\n  \"menuTagCreateError\": \"Ha ocurrido un error al crear la etiqueta del menú\",\n  \"menuUpdateError \": \"Ha ocurrido un error al actualizar el menú\",\n  \"newMenu\": \"Nuevo menú\",\n  \"noResultsDesc_dishes\": \"Puedes <1>crear un nuevo plato</1>.\",\n  \"notSupportedTPV\": \"Vinculación de menús no disponible\",\n  \"notSupportedTPV_description\": \"Tu TPV actualmente solo permite vincular platos. Si bien estamos trabajando en ello, la vinculación de menús no está disponible todavía.\",\n  \"options_menu\": \"Menú por opciones\",\n  \"options_menu_description\": \"Menú con varias opciones para elegir en cada pase.\",\n  \"options_menus\": \"Menús por opciones\",\n  \"passes\": \"pases\",\n  \"passes_description\": \"Número de pases (entrante, principal, postre, etc.)\",\n  \"portions\": \"raciones\",\n  \"priceSurcharge\": \"Suplemento de precio\",\n  \"searchAndSelectDish\": \"Busca y selecciona un plato\",\n  \"searchByMenuName\": \"Buscar por nombre de menú\",\n  \"section\": \"Sección\",\n  \"selectDish\": \"Selecciona un plato\",\n  \"servingSize\": \"Tamaño ración\",\n  \"servingSize_description\": \"Porcentaje de la ración estándar \\ndefinida en el escandallo.\",\n  \"summaryTitle\": \"Resumen por menú\",\n  \"tasting_menu\": \"Menú degustación\",\n  \"tasting_menu_description\": \"Menú con platos predefinidos, sin opción de elección.\",\n  \"tasting_menus\": \"Menús degustación\",\n  \"tax\": \"Impuestos\",\n  \"totalPrice\": \"Precio total\",\n  \"TPVSincronizedDish\": \"Plato sincronizado desde el TPV\",\n  \"type\": \"Tipo de menú\",\n  \"updateMenuDishError\": \"Ha ocurrido un error al actualizar el plato del menú\"\n}\n"
