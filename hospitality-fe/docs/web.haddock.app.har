            "mimeType": "application/json",
            "text": "{\n  \"launcher\": {\n    \"ariaLabel\": \"Open Clara support chat\",\n    \"unreadAriaLabel\": \"Open Clara support chat, new response available\",\n    \"tooltip\": \"Contact Clara\"\n  },\n  \"panel\": {\n    \"ariaLabel\": \"Clara support chat\"\n  },\n  \"header\": {\n    \"title\": \"Clara\",\n    \"subtitle\": \"haddock support assistant\",\n    \"newChat\": \"New chat\",\n    \"newChatAriaLabel\": \"Start a new Clara chat\",\n    \"showConversations\": \"Show conversations\",\n    \"hideConversations\": \"Hide conversations\",\n    \"minimize\": \"Minimize Clara\"\n  },\n  \"welcome\": {\n    \"title\": \"Ask Clara for haddock support\",\n    \"description\": \"Describe what is happening and Clara will help with your haddock support question.\"\n  },\n  \"suggestions\": {\n    \"posSetup\": \"How do I configure my POS\",\n    \"hrInfo\": \"I want to know more about haddock HR\",\n    \"documentsBySupplier\": \"How do I filter documents by supplier\"\n  },\n  \"conversation\": {\n    \"ariaLabel\": \"Clara support conversation\"\n  },\n  \"conversationList\": {\n    \"ariaLabel\": \"Clara conversations\",\n    \"title\": \"Conversations\",\n    \"untitled\": \"New Clara chat\",\n    \"noPreview\": \"No messages yet\",\n    \"empty\": \"No conversations yet\",\n    \"loading\": \"Loading conversations...\",\n    \"loadingConversation\": \"Loading conversation...\",\n    \"listError\": \"Could not load Clara conversations.\",\n    \"detailError\": \"Could not load this Clara conversation.\",\n    \"archive\": \"Archive chat\",\n    \"archiveError\": \"Could not archive this Clara chat.\",\n    \"back\": \"Back to conversations\",\n    \"unread\": \"New response\"\n  },\n  \"messages\": {\n    \"assistantLabel\": \"Clara\",\n    \"userLabel\": \"You\",\n    \"analyzing\": \"I'm reviewing the case...\",\n    \"analyzingIntros\": {\n      \"reviewRequest\": \"Okay, I'll review your request.\",\n      \"answerSoon\": \"I'll have an answer for you shortly.\",\n      \"checkingDetails\": \"Let me check the details and get back to you.\"\n    },\n    \"typing\": \"Clara is typing\",\n    \"moreInformation\": \"More information\",\n    \"copyAnswer\": \"Copy answer\",\n    \"copiedAnswer\": \"Answer copied\",\n    \"showMoreSources\": \"Show {{count}} more sources\",\n    \"showMoreSources_one\": \"Show {{count}} more source\",\n    \"showMoreSources_other\": \"Show {{count}} more sources\",\n    \"mockAnswer\": \"Thanks for the context. Clara can help route this support request and point you to the right next step.\"\n  },\n  \"composer\": {\n    \"ariaLabel\": \"Message for Clara\",\n    \"placeholder\": \"Write to Clara...\",\n    \"checking\": \"Checking your message...\",\n    \"send\": \"Send message\"\n  },\n  \"handoff\": {\n    \"ctaLabel\": \"Open support chat\",\n    \"inputDisabledPlaceholder\": \"Conversation transferred to the support team\"\n  },\n  \"feedback\": {\n    \"helpfulAriaLabel\": \"The answer was helpful\",\n    \"notHelpfulAriaLabel\": \"The answer was not helpful\",\n    \"helpfulTooltip\": \"Helpful\",\n    \"notHelpfulTooltip\": \"Not helpful\",\n    \"contactSupportPrompt\": \"Would you like to contact the support team?\",\n    \"noteTitle\": \"Tell us what went wrong\",\n    \"noteDescription\": \"Your note will help the support team review Clara's answer.\",\n    \"noteLabel\": \"Feedback note\",\n    \"notePlaceholder\": \"What was missing, incorrect, or unclear?\",\n    \"noteClose\": \"Close\",\n    \"noteCancel\": \"Cancel\",\n    \"noteSubmit\": \"Send feedback\",\n    \"noteSubmitting\": \"Sending...\",\n    \"noteRequiredError\": \"Add a note before sending the feedback.\",\n    \"noteLengthError\": \"The note must be 2000 characters or fewer.\",\n    \"noteSubmitError\": \"Could not send the feedback. Please try again.\"\n  }\n}\n"
