            "size": 3024,
            "mimeType": "application/json",
            "text": "{\n  \"cards\": {\n    \"costTrend\": {\n      \"help\": \"Variación del gasto total frente al periodo de comparación.\",\n      \"label\": \"Tendencia de coste\"\n    },\n    \"maxIncrease\": {\n      \"help\": \"Mayor subida de precio de un producto frente a la comparación.\",\n      \"label\": \"Mayor subida de precio\"\n    },\n    \"priceIncreases\": {\n      \"help\": \"Productos cuyo precio medio ha subido frente al periodo de comparación.\",\n      \"label\": \"Productos con subida de precio\"\n    },\n    \"totalSpend\": {\n      \"help\": \"Gasto en compras durante el periodo seleccionado.\",\n      \"label\": \"Gasto total\"\n    }\n  },\n  \"dates\": {\n    \"selectDate\": \"Selecciona fecha\",\n    \"selectDates\": \"Selecciona fechas\"\n  },\n  \"deviations\": {\n    \"badge\": {\n      \"missingFormat\": \"Falta formato\",\n      \"nonCanonical\": \"No canónico\"\n    },\n    \"canonicalUnit\": \"Unidad canónica\",\n    \"empty\": \"No hay desviaciones de formato o unidad en el periodo seleccionado.\",\n    \"subtitle\": \"Productos cuyas compras no cuadran con un formato o unidad canónica.\",\n    \"suggestedUnit\": \"Unidad sugerida: {{unit}}\",\n    \"title\": \"Formatos por producto y local / Desviaciones\",\n    \"unknownUnit\": \"Sin definir\"\n  },\n  \"hero\": {\n    \"subtitle\": \"Compra de productos consolidada en todos los locales seleccionados.\",\n    \"title\": \"Productos\"\n  },\n  \"priceVariation\": {\n    \"col\": {\n      \"current\": \"Precio actual\",\n      \"previous\": \"Precio anterior\",\n      \"product\": \"Producto\",\n      \"variation\": \"Variación\"\n    },\n    \"empty\": \"No hay variaciones de precio en el periodo seleccionado.\",\n    \"title\": \"Mayor variación de precio\"\n  },\n  \"properties\": {\n    \"all\": \"Todos los locales\",\n    \"count_one\": \"{{count}} local\",\n    \"count_other\": \"{{count}} locales\",\n    \"emptyText\": \"Sin locales.\",\n    \"placeholder\": \"Todos los locales\",\n    \"searchPlaceholder\": \"Buscar locales\"\n  },\n  \"status\": {\n    \"empty\": \"No hay compras de productos en el periodo seleccionado.\",\n    \"error\": \"No hemos podido cargar los productos.\"\n  },\n  \"table\": {\n    \"badge\": {\n      \"missingFormat\": \"Falta formato\",\n      \"unitDeviation\": \"Conflicto de unidad\"\n    },\n    \"col\": {\n      \"averagePrice\": \"Precio medio\",\n      \"formats\": \"Formatos\",\n      \"locations\": \"Locales\",\n      \"priceVariation\": \"Variación\",\n      \"product\": \"Producto\",\n      \"quantity\": \"Cantidad\",\n      \"totalSpend\": \"Gasto total\",\n      \"unit\": \"Unidad\"\n    },\n    \"empty\": \"No hay productos en el periodo seleccionado.\",\n    \"searchPlaceholder\": \"Buscar productos\",\n    \"title\": \"Productos\",\n    \"unknownUnit\": \"—\"\n  },\n  \"tabs\": {\n    \"productos\": \"Productos\",\n    \"resumen\": \"Resumen\"\n  },\n  \"topSpend\": {\n    \"col\": {\n      \"locations\": \"Locales\",\n      \"product\": \"Producto\",\n      \"quantity\": \"Cantidad\",\n      \"spend\": \"Gasto\"\n    },\n    \"empty\": \"No hay compras de productos en el periodo seleccionado.\",\n    \"title\": \"Top productos por gasto\"\n  },\n  \"unitSource\": {\n    \"automatic\": \"Automática\",\n    \"conflicted\": \"En conflicto\",\n    \"manual\": \"Manual\",\n    \"not-seen\": \"Sin detectar\"\n  }\n}\n"
