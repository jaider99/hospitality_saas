            "text": "{\n  \"launcher\": {\n    \"ariaLabel\": \"Abrir el chat de soporte con Clara\",\n    \"unreadAriaLabel\": \"Abrir el chat de soporte con Clara, hay una respuesta nueva\",\n    \"tooltip\": \"Contactar con Clara\"\n  },\n  \"panel\": {\n    \"ariaLabel\": \"Chat de soporte con Clara\"\n  },\n  \"header\": {\n    \"title\": \"Clara\",\n    \"subtitle\": \"Asistenta de soporte de haddock\",\n    \"newChat\": \"Nuevo chat\",\n    \"newChatAriaLabel\": \"Empezar un nuevo chat con Clara\",\n    \"showConversations\": \"Mostrar conversaciones\",\n    \"hideConversations\": \"Ocultar conversaciones\",\n    \"minimize\": \"Minimizar Clara\"\n  },\n  \"welcome\": {\n    \"title\": \"Pide soporte a Clara sobre haddock\",\n    \"description\": \"Cuéntale qué ocurre y Clara te ayudará con tu consulta de soporte sobre haddock.\"\n  },\n  \"suggestions\": {\n    \"posSetup\": \"Cómo configuro mi TPV\",\n    \"hrInfo\": \"Quiero saber más sobre haddock HR\",\n    \"documentsBySupplier\": \"Cómo filtro los documentos por proveedor\"\n  },\n  \"conversation\": {\n    \"ariaLabel\": \"Conversación de soporte con Clara\"\n  },\n  \"conversationList\": {\n    \"ariaLabel\": \"Conversaciones de Clara\",\n    \"title\": \"Conversaciones\",\n    \"untitled\": \"Nuevo chat con Clara\",\n    \"noPreview\": \"Sin mensajes todavía\",\n    \"empty\": \"Aún no hay conversaciones\",\n    \"loading\": \"Cargando conversaciones...\",\n    \"loadingConversation\": \"Cargando conversación...\",\n    \"listError\": \"No se han podido cargar las conversaciones de Clara.\",\n    \"detailError\": \"No se ha podido cargar esta conversación de Clara.\",\n    \"archive\": \"Archivar chat\",\n    \"archiveError\": \"No se ha podido archivar este chat de Clara.\",\n    \"back\": \"Volver a conversaciones\",\n    \"unread\": \"Respuesta nueva\"\n  },\n  \"messages\": {\n    \"assistantLabel\": \"Clara\",\n    \"userLabel\": \"Tú\",\n    \"analyzing\": \"Estoy revisando el caso...\",\n    \"analyzingIntros\": {\n      \"reviewRequest\": \"Vale, voy a revisar tu solicitud.\",\n      \"answerSoon\": \"Enseguida te doy la respuesta.\",\n      \"checkingDetails\": \"Déjame comprobarlo y te digo algo.\"\n    },\n    \"typing\": \"Clara está escribiendo\",\n    \"moreInformation\": \"Más información\",\n    \"copyAnswer\": \"Copiar respuesta\",\n    \"copiedAnswer\": \"Respuesta copiada\",\n    \"showMoreSources\": \"Ver {{count}} fuentes más\",\n    \"showMoreSources_one\": \"Ver {{count}} fuente más\",\n    \"showMoreSources_other\": \"Ver {{count}} fuentes más\",\n    \"mockAnswer\": \"Gracias por el contexto. Clara puede ayudarte a orientar esta solicitud de soporte y llevarte al siguiente paso adecuado.\"\n  },\n  \"composer\": {\n    \"ariaLabel\": \"Mensaje para Clara\",\n    \"placeholder\": \"Escribe a Clara...\",\n    \"checking\": \"Comprobando tu mensaje...\",\n    \"send\": \"Enviar mensaje\"\n  },\n  \"handoff\": {\n    \"ctaLabel\": \"Abrir chat de soporte\",\n    \"inputDisabledPlaceholder\": \"Conversación transferida al equipo de soporte\"\n  },\n  \"feedback\": {\n    \"helpfulAriaLabel\": \"La respuesta ha sido útil\",\n    \"notHelpfulAriaLabel\": \"La respuesta no ha sido útil\",\n    \"helpfulTooltip\": \"Ha sido útil\",\n    \"notHelpfulTooltip\": \"No ha sido útil\",\n    \"contactSupportPrompt\": \"¿Quieres contactar con el equipo de soporte?\",\n    \"noteTitle\": \"Cuéntanos qué ha fallado\",\n    \"noteDescription\": \"Tu nota ayudará al equipo de soporte a revisar la respuesta de Clara.\",\n    \"noteLabel\": \"Nota de feedback\",\n    \"notePlaceholder\": \"¿Qué faltaba, era incorrecto o no quedaba claro?\",\n    \"noteClose\": \"Cerrar\",\n    \"noteCancel\": \"Cancelar\",\n    \"noteSubmit\": \"Enviar feedback\",\n    \"noteSubmitting\": \"Enviando...\",\n    \"noteRequiredError\": \"Añade una nota antes de enviar el feedback.\",\n    \"noteLengthError\": \"La nota debe tener 2000 caracteres o menos.\",\n    \"noteSubmitError\": \"No se ha podido enviar el feedback. Inténtalo de nuevo.\"\n  }\n}\n"
          },
