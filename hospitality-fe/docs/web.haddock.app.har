            "text": "{\n  \"dates\": {\n    \"selectDate\": \"Seleccionar fecha\",\n    \"selectDates\": \"Seleccionar fechas\"\n  },\n  \"distribution\": {\n    \"description\": \"Distribución del gasto total — top 9 proveedores\",\n    \"empty\": \"No hay gasto de proveedores en el periodo seleccionado.\",\n    \"others\": \"Otros\",\n    \"title\": \"Total gastos por proveedor\"\n  },\n  \"evolution\": {\n    \"description\": \"Últimos 6 meses — top 5 proveedores por volumen\",\n    \"empty\": \"No hay gasto de proveedores en el periodo seleccionado.\",\n    \"title\": \"Evolución del gasto por proveedor\"\n  },\n  \"emptyState\": {\n    \"title\": \"Añade tus proveedores y tenlos a mano\",\n    \"description\": \"Verás sus contactos, sus condiciones de pago y cuánto gastas con cada uno.\",\n    \"action\": \"Añadir proveedor\"\n  },\n  \"hero\": {\n    \"subtitle\": \"Gasto por proveedor consolidado de todos los locales seleccionados.\",\n    \"title\": \"Proveedores\"\n  },\n  \"list\": {\n    \"columns\": {\n      \"category\": \"Categoría\",\n      \"lastInvoice\": \"Última factura\",\n      \"locations\": \"Locales\",\n      \"products\": \"Productos\",\n      \"supplier\": \"Proveedor\",\n      \"totalSpend\": \"Gasto total\"\n    },\n    \"empty\": \"No hay proveedores para los filtros seleccionados.\",\n    \"export\": \"Exportar\",\n    \"newSupplier\": \"Nuevo proveedor\",\n    \"noLastInvoice\": \"Sin factura\",\n    \"searchPlaceholder\": \"Buscar proveedores\",\n    \"selectSupplier\": \"Seleccionar {{supplier}}\",\n    \"supplierCount_one\": \"{{count}} proveedor\",\n    \"supplierCount_other\": \"{{count}} proveedores\",\n    \"uncategorized\": \"Sin categoría\",\n    \"verifiedSupplier\": \"Proveedor verificado\"\n  },\n  \"properties\": {\n    \"all\": \"Todos los locales\",\n    \"count_one\": \"{{count}} local\",\n    \"count_other\": \"{{count}} locales\",\n    \"emptyText\": \"No hay locales.\",\n    \"placeholder\": \"Todos los locales\",\n    \"searchPlaceholder\": \"Buscar locales\"\n  },\n  \"ranking\": {\n    \"columns\": {\n      \"coverage\": \"Locales con compras\",\n      \"spend\": \"Gasto\",\n      \"supplier\": \"Proveedor\"\n    },\n    \"coverage\": \"{{withSpend}}/{{total}} locales\",\n    \"coveragePurchases\": \"{{withSpend}}/{{total}} locales con compras\",\n    \"coverageShort\": \"{{withSpend}}/{{total}}\",\n    \"empty\": \"No hay gasto de proveedores en el periodo seleccionado.\",\n    \"locationsWithoutSpend_one\": \"{{count}} local sin compras\",\n    \"locationsWithoutSpend_other\": \"{{count}} locales sin compras\",\n    \"paginationNext\": \"Siguiente\",\n    \"paginationPrevious\": \"Anterior\",\n    \"showing\": \"Mostrando {{from}}–{{to}} de {{total}}\",\n    \"subtitle_one\": \"{{count}} proveedor · ordenado por gasto\",\n    \"subtitle_other\": \"{{count}} proveedores · ordenado por gasto\",\n    \"title\": \"Ranking de gasto por proveedor\",\n    \"unknownSupplier\": \"Proveedor desconocido\"\n  },\n  \"status\": {\n    \"error\": \"No hemos podido cargar los proveedores.\",\n    \"loading\": \"Cargando proveedores...\"\n  },\n  \"tabs\": {\n    \"summary\": \"Resumen\",\n    \"suppliers\": \"Proveedores\"\n  },\n  \"total\": {\n    \"distributionLabel\": \"Distribución del gasto por proveedor\",\n    \"empty\": \"No hay gasto de proveedores en el periodo seleccionado.\",\n    \"rest_one\": \"Resto ({{count}} más)\",\n    \"rest_other\": \"Resto ({{count}} más)\",\n    \"summary\": \"{{suppliers}} proveedores · {{locations}} locales\",\n    \"title\": \"Gasto total proveedores\"\n  },\n  \"volume\": {\n    \"amount\": \"Gasto\",\n    \"description\": \"Ranking por subtotal acumulado\",\n    \"empty\": \"No hay gasto de proveedores en el periodo seleccionado.\",\n    \"title\": \"Principales proveedores por volumen de compra\"\n  }\n}\n"
