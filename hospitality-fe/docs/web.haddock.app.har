            "mimeType": "application/json",
            "text": "{\n  \"1pass\": \"First pass\",\n  \"2pass\": \"Second pass\",\n  \"3pass\": \"Third pass\",\n  \"4pass\": \"Fourth pass\",\n  \"5pass\": \"Fifth pass\",\n  \"6pass\": \"Sixth pass\",\n  \"7pass\": \"Seventh pass\",\n  \"8pass\": \"Eighth pass\",\n  \"9pass\": \"Ninth pass\",\n  \"addDish\": \"Add dish\",\n  \"addDishesToCalculate\": \"Add the dishes so we can calculate the <strong>cost</strong>, <strong>profit</strong> and <strong>margin</strong> of the menu.\",\n  \"addDishInfo\": \"Enter the dishes that make up this menu\",\n  \"addMenuDishError\": \"An error occurred while adding the dish to the menu\",\n  \"basePrice\": \"Base price\",\n  \"connectMenuEmptyState\": \"There are no menus in your account\",\n  \"connectMenuEmptyStateText\": \"Create the price tags for your menus to connect them with the sales of your POS\",\n  \"createMenu\": \"Create menu\",\n  \"deleteMenuDishError\": \"An error occurred while removing the dish from the menu\",\n  \"dishDetails\": \"Dish details\",\n  \"editDish\": \"Edit dish\",\n  \"editMenuDish\": \"Edit dish in menu\",\n  \"emptyState_dishesDesc\": \"Make the costings of the dishes to add them to your menus.\",\n  \"exitPageToCreate\": \"To create a bill of materials of a new menu it is necessary to leave this page.\",\n  \"includedDishes\": \"Dishes included in this menu\",\n  \"informationOf_menu\": \"Menu information\",\n  \"many\": \"Menus\",\n  \"menu\": \"Menu\",\n  \"menuCreationError\": \"An error occurred while creating the menu\",\n  \"menuDeleteError \": \"An error occurred while deleting the menu\",\n  \"menuDuplicateError\": \"An error occurred while duplicating the menu\",\n  \"menuItemPOS\": \"POS Menu:\",\n  \"menuName\": \"Menu name\",\n  \"menuPass\": \"Pass in the menu\",\n  \"menuTagCreateError\": \"An error occurred while creating the menu tag\",\n  \"menuUpdateError \": \"An error occurred while updating the menu\",\n  \"newMenu\": \"New menu\",\n  \"noResultsDesc_dishes\": \"You can <1>create a new dish</1>.\",\n  \"notSupportedTPV\": \"Menu linking not available\",\n  \"notSupportedTPV_description\": \"Your TPV currently only allows you to link plates. If we are still working on it, the menu link is still not available.\",\n  \"options_menu\": \"Menu by options\",\n  \"options_menu_description\": \"Menu with several options to choose from at each pass.\",\n  \"options_menus\": \"Menus by options\",\n  \"passes\": \"passes\",\n  \"passes_description\": \"Number of passes (starter, main course, dessert, etc.)\",\n  \"portions\": \"portions\",\n  \"priceSurcharge\": \"Price surcharge\",\n  \"searchAndSelectDish\": \"Search and select a dish\",\n  \"searchByMenuName\": \"Search by menu name\",\n  \"section\": \"Section\",\n  \"selectDish\": \"Select a dish\",\n  \"servingSize\": \"Serving size\",\n  \"servingSize_description\": \"Percentage of the standard defined ratio in the recipe.\",\n  \"summaryTitle\": \"Summary by menu\",\n  \"tasting_menu\": \"Tasting menu\",\n  \"tasting_menu_description\": \"Menu with predefined dishes, without the option to choose.\",\n  \"tasting_menus\": \"Tasting menus\",\n  \"tax\": \"Taxes\",\n  \"totalPrice\": \"Total price\",\n  \"TPVSincronizedDish\": \"Dish synchronized from the POS\",\n  \"type\": \"Menu type\",\n  \"updateMenuDishError\": \"An error occurred while updating the menu item\"\n}\n"
