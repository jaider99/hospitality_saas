            "mimeType": "application/json",
            "text": "{\n  \"addAnotherSale\": \"Subir otra venta\",\n  \"addDailySalesAndConnect\": \"Introduce manualmente las ventas diarias de tu restaurante. Y si tienes <1>TPV</1>, <4><0>conéctalo</0></4>\",\n  \"addSaleManually\": \"Añadir venta manualmente\",\n  \"addSales\": \"Añadir ventas\",\n  \"allShifts\": \"mañana, mediodía y noche\",\n  \"article\": \"Artículo\",\n  \"articles\": \"Artículos\",\n  \"articleUpdateError\": \"Ha ocurrido un error al actualizar el artículo\",\n  \"autoTax\": \"{{tax}} {{ taxName }} automático\",\n  \"autoTax_tooltip\": \"El importe del {{ taxName }} se calcula automáticamente como el 10% del importe de la base.\",\n  \"averageTicket\": \"Ticket medio\",\n  \"bar\": \"Barra\",\n  \"basicInfo\": \"Información básica\",\n  \"basicInfo_tooltip\": \"Introduce la información básica de la venta (<strong>fecha</strong>, Nº de <strong>comensales</strong> y <strong>descripción</strong>)\",\n  \"billing\": \"Facturación\",\n  \"bomLink\": \"Vínculo Escandallo\",\n  \"changeVatRateModalDescription\": \"Si cambias el {{ taxName }}, tendrás que volver a introducir todos los precios en la sección de detalles. Seguro que quieres hacerlo?\",\n  \"changeVatRateModalTitle\": \"Seguro que quieres cambiar el {{ taxName }}?\",\n  \"channels\": \"Canales\",\n  \"closeUpload\": \"¿Cerrar subir venta?\",\n  \"closeUpload_description\": \"La venta no se guardará.\",\n  \"closeUpload_title\": \"¿cerrar subir venta?\",\n  \"completeFieldsImport\": \"Completa los campos (fecha, subtotal, impuesto, total) en la siguiente plantilla de excel y súbela en el paso 2.\",\n  \"configurationInUserSettings\": \"Configuración en ajustes de usuario\",\n  \"connectDish\": \"Conectar plato\",\n  \"connectMenu\": \"Conectar menú\",\n  \"connectPOSToAccessSales\": \"Conecta tu catálogo para acceder a tus ventas\",\n  \"connectPOSToAccessSalesDescription\": \"Para ver los artículos vendidos con tu TPV, necesitas conectar tu catálogo de productos con Square.\",\n  \"createSale\": \"Crear venta\",\n  \"dateMustBeValid\": \"La fecha debe ser válida\",\n  \"details_tooltip\": \"Introduce los importes de las ventas con desglose por el método de pago.\",\n  \"dinningRoom\": \"Comedor\",\n  \"editSale\": \"Editar venta\",\n  \"events\": \"Eventos\",\n  \"hideWithNoSales\": \"Ocultar artículos con 0 ventas\",\n  \"importSales\": \"Importar ventas\",\n  \"importSalesExcel\": \"IMPORTAR VENTAS EN EXCEL\",\n  \"allowDuplicates\": \"Permitir duplicados\",\n  \"importSuccess_details\": \"Se importaron ventas de {{count}} días ({{minDate}} a {{maxDate}})\",\n  \"infoVat\": \"Importe de venta con el total / base\",\n  \"infoVat_tooltip\": \"En la configuración de “ajustes de usuario”, puedes elegir introducir las ventas con el total (base+{{ taxName }}) o con el importe base. Las dos opciones permiten tener el cálculo de {{ taxName }} automático.\",\n  \"manualSale\": \"Venta manual\",\n  \"missingFields\": \"Falta completar campos\",\n  \"noArticlesRegister\": \"No hay registro de ventas por artículo\",\n  \"noArticlesRegister_description\": \"No existen resultados de artículos en el historial de ventas de tu TPV.\",\n  \"noBreakdown\": \"Sin desglose\",\n  \"noInfo\": \"Sin información de ventas\",\n  \"noSales\": \"No hay ventas\",\n  \"noSalesInfo\": \"No hay ventas para el periodo seleccionado\",\n  \"noSalesInfoHint\": \"Prueba con otro rango de fechas o consulta tus últimas ventas\",\n  \"viewLastSales\": \"Ver últimas ventas\",\n  \"syncingSales\": \"Estamos sincronizando tus ventas\",\n  \"syncingSalesInfo\": \"Las primeras ventas pueden tardar unas horas en aparecer tras conectar el TPV\",\n  \"options_tooltip\": \"Configura que información quieres introducir en los detalles de la venta (cálculo automático del <strong>{{ taxName }}</strong> y activación de <strong>turnos y canales de venta</strong>)\",\n  \"posArticle\": \"Artículo de TPV\",\n  \"saleChannels\": \"Canales de venta\",\n  \"saleChannels_tooltip\": \"Introduce el importe total de las ventas segmentadas por los diferentes canales de venta\",\n  \"salesByShift\": \"Ventas por turnos\",\n  \"salesDashboard\": \"Dashboard de ventas\",\n  \"sampleChannels\": \"comedor, delivery, terraza...\",\n  \"searchByArticleName\": \"Escribe el nombre del artículo de venta\",\n  \"seats\": \"Comensales\",\n  \"selectChannels\": \"Selecciona los canales de venta\",\n  \"selectShifts\": \"Selecciona los turnos\",\n  \"severalErrors\": \"Varios errores dentro\",\n  \"shifts\": \"Turnos\",\n  \"shifts_tooltip\": \"Introduce el importe total de las ventas segmentadas por turnos\",\n  \"soldArticleCreated\": \"Artículo de venta conectado correctamente\",\n  \"soldArticleCreationError\": \"Ha ocurrido un error al conectar el artículo de venta\",\n  \"soldArticlesTitle\": \"Artículos vendidos\",\n  \"soldArticlesUpdateAdvice\": \"El precio de los artículos se actualiza de forma recurrente. Esta actualización no incluye artículos eliminados del Terminal Punto de Venta.\",\n  \"source\": \"Fuente\",\n  \"tabDays\": \"{{days}} días\",\n  \"tabMonths\": \"{{months}} meses\",\n  \"terrace\": \"Terraza\",\n  \"TPVConnected\": \"Conectado con TPV\",\n  \"TPVDisconnected\": \"Sin conexión con TPV\",\n  \"units\": \"Unidades\",\n  \"updateDashboardInfo\": \"Actualizar información del dashboard\",\n  \"upload_error\": \"Ha ocurrido un error al subir la venta\",\n  \"upload_success\": \"La subida de la venta se ha completado correctamente\",\n  \"uploadSalesReminder\": \"Sube las ventas o conecta tu TPV para tener el resultado sobre ventas por categoría. <2><0>Subir ventas</0></2>\",\n  \"viewSale\": \"Ver ventas\",\n  \"viewSales\": \"Lista de ventas\",\n  \"viewSalesDashboard\": \"Ver en el dashboard de ventas\",\n  \"viewSalesInfo\": \"Ver información de ventas\",\n  \"withNoSales\": \"Artículos con 0 ventas\",\n  \"deletePosApiSaleWarning\": \"Para recrear esta venta, necesitarás que tu TPV vuelva a enviar las ventas de ese día.\",\n  \"deleteSaleTitle\": \"Eli