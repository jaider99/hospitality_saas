# Database connection URL (for PostgreSQL instance)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hospitality?schema=public"

# Qdrant Vector DB Connection URL
QDRANT_URL="http://localhost:6333"

# Redis Cache Connection URL
REDIS_URL="redis://localhost:6379"

# JSON Web Token Secret
JWT_SECRET="super-secret-key-123"

# Gemini 2.0 Flash Developer API Key (from Google AI Studio)
GEMINI_API_KEY="your-gemini-api-key-here"

# Server Port
PORT=8000

# Webhook URL for background worker (Optional, fallback to API_DOMAIN)
# WEBHOOK_URL=http://localhost:8000

